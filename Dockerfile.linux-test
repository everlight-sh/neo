# Verifies the complete toolchain on native ARM64 or x86-64 Linux: the compiler
# is built from a published native release, must rebuild itself identically,
# and then runs every native test case (tests/verify_linux.sh). Nothing here
# needs Python. openssl and Go are live TLS and HTTP peers for the network cases.
FROM golang:1.25.1-bookworm AS go-tools
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends clang lld binutils openssl curl tar gzip ca-certificates procps && rm -rf /var/lib/apt/lists/*
COPY --from=go-tools /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /neo
COPY install.sh install.sh
RUN NEO_HOME=/opt/neo-seed sh install.sh --version 0.2.4
COPY compiler compiler
COPY runtime runtime
COPY stdlib stdlib
COPY examples examples
COPY docs docs
COPY bench bench
COPY neo neo
COPY neo.toml neo.toml
COPY tests tests
CMD ["sh", "tests/verify_linux.sh"]
