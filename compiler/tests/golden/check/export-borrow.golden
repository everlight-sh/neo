check export-borrow.neo
reference-exit 1
reference-ok false
reference-error type <dir>/export-borrow.neo 1:20 borrow parameters require an internal array or record type
reference-error type <dir>/export-borrow.neo 1:8 export signatures must use ABI scalar types
exit 1
stdout (error <dir>/export-borrow.neo 1:20 borrow parameters require an internal array or record type)\n
=== export-borrow.neo
export fn exported(borrow a:Arr u8 _) -> i64 = len(a)
fn main() -> i64 = 0
