; Native entry points whose stack changes require assembly. The Linux
; worker ABI is the one the Python reference used (neoc/kernel_workers.py,
; v0.2.4 tag). After clone, the child starts on the supplied stack, waits on
; the generation futex, and claims jobs with atomic counters. Pool offsets 0,
; 8, 16, 24, 32, and 40 hold the generation, function, context, next chunk,
; end, and pending count.
import "std:strings"
import "text.neo"

fn na_module(borrow code:Arr u8 _) -> Arr u8 _
  = let escaped=loop (i=0, out=tx_empty()) while i<len(code)
      next (i+1,let b=tx_byte(code,i) in
        if b==10 || b==34 || b==92 then tx_hex_byte(push(out,'\\'),b) else push(out,u8(b))) yield out in
    concat("module asm \"",escaped,"\"\n")

fn na_worker_arm64() -> Arr u8 _
  = ".section .text.neo_spawn_thread,\"ax\"
.p2align 4
.global neo_spawn_thread
.hidden neo_spawn_thread
.type neo_spawn_thread,%function
neo_spawn_thread:
  sub x1, x1, #16
  str x0, [x1]
  movz x0, #0x0f00
  movk x0, #0x5, lsl #16
  mov x2, #0
  mov x3, #0
  mov x4, #0
  mov x8, #220
  svc #0
  cbz x0, .Lneo_worker_child
  ret
.Lneo_worker_child:
  ldr x19, [sp]
  mov w20, #0
.Lneo_worker_wait:
  ldar w21, [x19]
  cmp w21, w20
  b.ne .Lneo_worker_job
  mov x0, x19
  mov x1, #128
  mov w2, w20
  mov x3, #0
  mov x8, #98
  svc #0
  b .Lneo_worker_wait
.Lneo_worker_job:
  mov w20, w21
  ldr x22, [x19, #8]
  ldr x23, [x19, #16]
  ldr x24, [x19, #32]
  add x25, x19, #24
.Lneo_worker_claim:
  ldaxr x9, [x25]
  add x10, x9, #1
  stlxr w11, x10, [x25]
  cbnz w11, .Lneo_worker_claim
  cmp x9, x24
  b.ge .Lneo_worker_done
  mov x0, x23
  mov x1, x9
  blr x22
  b .Lneo_worker_claim
.Lneo_worker_done:
  add x26, x19, #40
.Lneo_worker_release:
  ldaxr x9, [x26]
  sub x10, x9, #1
  stlxr w11, x10, [x26]
  cbnz w11, .Lneo_worker_release
  cbnz x10, .Lneo_worker_wait
  mov x0, x26
  mov x1, #129
  mov x2, #1
  mov x8, #98
  svc #0
  b .Lneo_worker_wait
.size neo_spawn_thread, .-neo_spawn_thread"

fn na_worker_x86_64() -> Arr u8 _
  = ".section .text.neo_spawn_thread,\"ax\"
.p2align 4
.global neo_spawn_thread
.hidden neo_spawn_thread
.type neo_spawn_thread,@function
neo_spawn_thread:
  subq $16, %rsi
  movq %rdi, 0(%rsi)
  movq $0x50f00, %rdi
  xorl %edx, %edx
  xorl %r10d, %r10d
  xorl %r8d, %r8d
  movl $56, %eax
  syscall
  testq %rax, %rax
  jz .Lneo_worker_child
  retq
.Lneo_worker_child:
  movq 0(%rsp), %rbx
  xorl %r12d, %r12d
.Lneo_worker_wait:
  movl 0(%rbx), %eax
  cmpl %r12d, %eax
  jne .Lneo_worker_job
  movq %rbx, %rdi
  movl $128, %esi
  movl %r12d, %edx
  xorl %r10d, %r10d
  movl $202, %eax
  syscall
  jmp .Lneo_worker_wait
.Lneo_worker_job:
  movl %eax, %r12d
  movq 8(%rbx), %r13
  movq 16(%rbx), %r14
  movq 32(%rbx), %r15
.Lneo_worker_claim:
  movl $1, %esi
  lock xaddq %rsi, 24(%rbx)
  cmpq %r15, %rsi
  jge .Lneo_worker_done
  movq %r14, %rdi
  callq *%r13
  jmp .Lneo_worker_claim
.Lneo_worker_done:
  lock decq 40(%rbx)
  jnz .Lneo_worker_wait
  leaq 40(%rbx), %rdi
  movl $129, %esi
  movl $1, %edx
  movl $202, %eax
  syscall
  jmp .Lneo_worker_wait
.size neo_spawn_thread, .-neo_spawn_thread"

; Fibers save the platform's callee-saved registers and floating point
; control state. The task resumes at its saved return address.
fn na_fiber_entry(borrow name:Arr u8 _, darwin:bool) -> Arr u8 _
  = let symbol=if darwin then concat("_",name) else name in
    concat(".globl ",symbol,"\n",if darwin then ".private_extern " else ".hidden ",
      symbol,"\n",symbol,":\n")

fn na_fiber_arm64(darwin:bool) -> Arr u8 _
  = concat(na_fiber_entry("neo_fiber_swap",darwin), "stp x19, x20, [x0, #0]
  stp x21, x22, [x0, #16]
  stp x23, x24, [x0, #32]
  stp x25, x26, [x0, #48]
  stp x27, x28, [x0, #64]
  stp x29, x30, [x0, #80]
  mov x9, sp
  str x9, [x0, #96]
  stp d8, d9, [x0, #104]
  stp d10, d11, [x0, #120]
  stp d12, d13, [x0, #136]
  stp d14, d15, [x0, #152]
  mrs x9, fpcr
  str x9, [x0, #168]
  mrs x9, fpsr
  str x9, [x0, #176]
  ldp x19, x20, [x1, #0]
  ldp x21, x22, [x1, #16]
  ldp x23, x24, [x1, #32]
  ldp x25, x26, [x1, #48]
  ldp x27, x28, [x1, #64]
  ldp x29, x30, [x1, #80]
  ldr x9, [x1, #96]
  mov sp, x9
  ldp d8, d9, [x1, #104]
  ldp d10, d11, [x1, #120]
  ldp d12, d13, [x1, #136]
  ldp d14, d15, [x1, #152]
  ldr x9, [x1, #168]
  msr fpcr, x9
  ldr x9, [x1, #176]
  msr fpsr, x9
  ret
",
      na_fiber_entry("neo_fiber_init",darwin), "str x3, [x0, #0]
  str x2, [x0, #8]
  adr x9, Lneo_fiber_boot
  str x9, [x0, #88]
  str x1, [x0, #96]
  ret
Lneo_fiber_boot:
  mov x0, x19
  blr x20
  brk #0")

fn na_fiber_x86_64(darwin:bool) -> Arr u8 _
  = concat(na_fiber_entry("neo_fiber_swap",darwin), "movq %rbx, 0(%rdi)
  movq %rbp, 8(%rdi)
  movq %r12, 16(%rdi)
  movq %r13, 24(%rdi)
  movq %r14, 32(%rdi)
  movq %r15, 40(%rdi)
  leaq 8(%rsp), %rax
  movq %rax, 48(%rdi)
  movq (%rsp), %rax
  movq %rax, 56(%rdi)
  stmxcsr 64(%rdi)
  fnstcw 68(%rdi)
  movq 0(%rsi), %rbx
  movq 8(%rsi), %rbp
  movq 16(%rsi), %r12
  movq 24(%rsi), %r13
  movq 32(%rsi), %r14
  movq 40(%rsi), %r15
  ldmxcsr 64(%rsi)
  fldcw 68(%rsi)
  movq 48(%rsi), %rsp
  jmpq *56(%rsi)
",
      na_fiber_entry("neo_fiber_init",darwin), "movq %rcx, 16(%rdi)
  movq %rdx, 24(%rdi)
  movq %rsi, 48(%rdi)
  leaq Lneo_fiber_boot(%rip), %rax
  movq %rax, 56(%rdi)
  movl $8064, 64(%rdi)
  movw $895, 68(%rdi)
  retq
Lneo_fiber_boot:
  movq %r12, %rdi
  callq *%r13
  ud2")

fn na_runtime(borrow target:Arr u8 _, borrow ir:Arr u8 _, partition:i64) -> Arr u8 _
  = let arm=str_starts(target,"arm64-") || str_starts(target,"aarch64-") in
    let darwin=str_find(target,"-apple-").present in
    let workers=if (partition==1 && !darwin) || str_find(ir,"@neo_spawn_thread(").present then
      concat(if partition==2 then "" else na_module(if arm then na_worker_arm64() else na_worker_x86_64()),
        "declare hidden i64 @neo_spawn_thread(ptr, ptr)\n") else tx_empty() in
    let fibers=if partition==1 || str_find(ir,"@neo_fiber_swap(").present || str_find(ir,"@neo_fiber_init(").present then
      let code=if arm then na_fiber_arm64(darwin) else na_fiber_x86_64(darwin) in
      concat(if partition==2 then "" else na_module(concat(".text\n.p2align 4\n",code)),
        "declare hidden void @neo_fiber_swap(ptr, ptr)\ndeclare hidden void @neo_fiber_init(ptr, ptr, ptr, ptr)\n")
      else tx_empty() in
    concat(workers,fibers)
