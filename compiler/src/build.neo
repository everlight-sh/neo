; Link native-emitted IR. A bootstrap object is available for seed tests.
import "std:fs"
import "std:process"
import "std:random"
import "std:sha256"
import "std:strings"
import "std:time"
import "text.neo"
import "paths.neo"
import "project_fs.neo"
import "ast.neo"
import "modules.neo"
import "startup.neo"

fn bd_path_end(borrow path:Arr u8 _, i:i64) -> i64
  = loop (j=i) while j<len(path) && tx_byte(path,j)!=58 next (j+1) yield j

effect(fs,env) fn bd_clang() -> Arr u8 _
  = let configured=env_get("NEO_CLANG") in
    if configured.present then
      let path=pt_abspath(configured.value) in if fs_executable(path) then path else tx_empty()
    else bd_find_tool("clang")

effect(fs,env) fn bd_find_tool(borrow name:Arr u8 _) -> Arr u8 _
  = if len(name)==0 then tx_empty() else
    if tx_has(name,47) then let path=pt_abspath(name) in if fs_executable(path) then path else tx_empty() else
    let search=env_get("PATH") in let path=if search.present then search.value else "/usr/bin:/bin" in
      loop (i=0, found=tx_empty()) while i<=len(path) && len(found)==0
        next (bd_path_end(path,i)+1,
              let candidate=pt_abspath(pt_join(pt_slice(path,i,bd_path_end(path,i)),name)) in
              if fs_executable(candidate) then candidate else tx_empty()) yield found

effect(env,unsafe) fn bd_environment() -> Arr Arr u8 _ _
  = let base=load_ptr(runtime_state(),0) in if base==null() then md_words() else
    loop (i=0, out=md_words()) while load_ptr(base,i*8)!=null()
      next (i+1,let p=load_ptr(base,i*8) in let count=rt_cstrlen(p) in
            check count>=0 in push(out,view(p,count))) yield out

type BdPoll = { status:ProcessStatus, pending:bool, output:Arr u8 _ }
effect(process,fs,time) fn bd_poll(process:Process, borrow previous:Arr u8 _, capture:bool, quiet:bool) -> BdPoll
  = let status=process_status(process) in
    let output=process_try_read(process,1,4096) in let errors=process_try_read(process,2,4096) in
    let wrote_output=if output.ok && !capture then print_out(output.value) else int_ok(0) in
    let wrote_errors=if errors.ok && !quiet then print_error(errors.value) else int_ok(0) in
    let data_ready=(output.ok && len(output.value)>0) || (errors.ok && len(errors.value)>0) in
    let paused=if status.running && !data_ready then sleep_ms(1) else int_ok(0) in
    let collected=if capture && output.ok && len(previous)<1048576 then concat(previous,output.value) else previous in
    BdPoll { status=status, pending=status.ok && (status.running || data_ready), output=collected }

; quiet: the tool's error output is dropped, for an attempt that is repeated
; with its errors shown when it fails.
effect(process,fs,env,time,unsafe) fn bd_run(borrow clang:Arr u8 _, borrow arguments:Arr Arr u8 _ _, capture:bool, quiet:bool) -> BdPoll
  = using child=process_start(clang,arguments,bd_environment()) in
    let closed=process_close_input(child) in
    loop (poll=bd_poll(child,tx_empty(),capture,quiet)) while poll.pending
      next (bd_poll(child,poll.output,capture,quiet)) yield poll
effect(process,fs,env,time,unsafe) fn bd_execute(borrow clang:Arr u8 _, borrow arguments:Arr Arr u8 _ _, capture:bool) -> BdPoll
  = bd_run(clang,arguments,capture,false)

; Where Neo keeps what it can reuse between builds, or "": NEO_CACHE_DIR, else
; the user's cache directory.
effect(env,fs) fn bd_cache_base() -> Arr u8 _
  = let named=env_get("NEO_CACHE_DIR") in let shared=env_get("XDG_CACHE_HOME") in let home=env_get("HOME") in
    let base=if named.present && len(named.value)>0 then named.value
      else if shared.present && len(shared.value)>0 then pt_join(shared.value,"neo")
      else if home.present && len(home.value)>0 then pt_join(pt_join(home.value,".cache"),"neo") else tx_empty() in
    if len(base)==0 then base else pt_abspath(base)

; A tool's identity for cache keys: its path and size, read without running
; it. An updated Clang at the same path has another size.
effect(fs,unsafe) fn bd_tool_identity(borrow path:Arr u8 _) -> Arr u8 _
  = let opened=file_open(path,0) in if !opened.ok then tx_empty() else
    let size=rt_file_size(opened.value) in let closed=file_close(opened.value) in
    if size<=0 then tx_empty() else concat(path,":",int_text(size))

fn bd_exit_code(status:ProcessStatus) -> i64
  = if !status.ok then 127 else if status.signal!=0 then 128+status.signal else status.exit_code

effect(env,fs) fn bd_runtime() -> Arr u8 _
  = let configured=env_get("NEO_RUNTIME") in if configured.present then pt_abspath(configured.value) else
    let invoked=cli_arg(0) in pt_join(pt_head(pt_realpath(invoked.value)),"neo-runtime.o")

fn bd_target_valid(borrow target:Arr u8 _) -> bool
  = let arm=str_starts(target,"arm64-") || str_starts(target,"aarch64-") in
    let linux=str_find(target,"-linux").present in let darwin=str_find(target,"-apple-").present in
    ((linux && (arm || str_starts(target,"x86_64-"))) || (darwin && arm)) && len(target)<128 &&
    loop (i=0, ok=true) while ok && i<len(target)
      next (i+1,let c=tx_byte(target,i) in (c>=48 && c<=57) || (c>=97 && c<=122) || c==45 || c==46 || c==95) yield ok

effect(fs,process) fn bd_error(borrow message:Arr u8 _) -> unit
  = let wrote=print_error(concat("neoc: ",message,"\n")) in process_exit(1)

fn bd_compile_arguments(borrow config:BdConfig, borrow ir:Arr u8 _, borrow object:Arr u8 _, borrow remarks:Arr u8 _) -> Arr Arr u8 _ _
  = push(push(push(push(bd_compile_flags(config,remarks),"-c"),ir),"-o"),object)

fn bd_compile_flags(borrow config:BdConfig, borrow remarks:Arr u8 _) -> Arr Arr u8 _ _
  = let target=config.target in
    let args=push(push(push(push(push(md_words(),concat("--target=",target)),concat("-O",config.level)),
      "-Wno-override-module"),"-ffunction-sections"),"-fdata-sections") in
    let args=if str_starts(target,"arm64-") || str_starts(target,"aarch64-") then push(args,"-mno-outline-atomics") else args in
    ; x86-64: start every loop on a 32-byte boundary, so a hot loop's speed
    ; does not depend on where the code before it happens to end.
    let args=if str_starts(target,"x86_64-") then push(args,"-falign-loops=32") else args in
    ; Release builds expand the short pure functions the emitter marks.
    let args=if tx_equal(config.level,"2") || tx_equal(config.level,"3") then push(push(args,"-mllvm"),"-inlinehint-threshold=2000") else args in
    ; Linux code is position independent whichever way Clang was configured
    ; and whether or not it also links (bd_build_arguments).
    let args=if str_find(target,"-linux").present then push(args,"-fPIE") else args in
    if len(remarks)==0 then args else push(push(args,"-fsave-optimization-record"),concat("-foptimization-record-file=",remarks))

fn bd_link_arguments(borrow config:BdConfig, borrow object:Arr u8 _, borrow libraries:Arr Arr u8 _ _, borrow output:Arr u8 _) -> Arr Arr u8 _ _
  = let target=config.target in let args=push(push(push(md_words(),concat("--target=",target)),"-nostdlib"),object) in
    let args=md_words_append(args,libraries) in
    let args=if len(config.runtime)>0 then push(args,config.runtime) else args in
    let args=push(push(args,"-o"),output) in bd_link_tail(config,args)

; One Clang run that compiles the module and links it: a build then starts
; one tool instead of two.
fn bd_build_arguments(borrow config:BdConfig, borrow ir:Arr u8 _, borrow libraries:Arr Arr u8 _ _, borrow output:Arr u8 _) -> Arr Arr u8 _ _
  = let args=md_words_append(push(push(bd_compile_flags(config,""),"-nostdlib"),ir),libraries) in
    let args=if len(config.runtime)>0 then push(args,config.runtime) else args in
    let args=push(push(args,"-o"),output) in bd_link_tail(config,args)

; The platform's link options. The program's explicit ABI exports are link
; roots, so section collection keeps one that nothing in the program calls.
fn bd_link_tail(borrow config:BdConfig, move args:Arr Arr u8 _ _) -> Arr Arr u8 _ _
  = let apple=str_find(config.target,"-apple-").present in
    let args=loop (i=0, all=args) while i<len(config.exports)
      next (i+1,push(all,concat("-Wl,-u,",if apple then "_" else "",md_word(config.exports,i)))) yield all in
    if apple then push(push(args,"-lSystem"),"-Wl,-dead_strip")
    else push(push(args,"-static"),"-Wl,-e,_start,--no-undefined,--gc-sections")

; The names of the program's explicit exports, outside the runtime.
fn bd_export_roots(borrow m:Mods) -> Arr Arr u8 _ _
  = loop (k=0, out=md_words()) while k<len(m.fns)
      next (k+1,if pt_within(md_path(m,k),m.runtime) then out else let ids=md_list(m.fns,k) in
        loop (i=0, all=out) while i<len(ids)
          next (i+1,let f=md_node(m,tx_at(ids,i)) in
            if ast_flag(f,fl_exported()) && !ast_flag(f,fl_external()) then push(all,md_str(m,f.a)) else all) yield all) yield out

fn md_words_append(move args:Arr Arr u8 _ _, borrow extra:Arr Arr u8 _ _) -> Arr Arr u8 _ _
  = loop (i=0, all=args) while i<len(extra) next (i+1,push(all,md_word(extra,i))) yield all

; undefined: what `nm -u` printed for the executable, when scanned (a
; profiled build whose nm ran), as the reference compiler reports it.
type BdLink = { compile_ns:i64, link_ns:i64, remarks:Arr u8 _, digest:Arr u8 _, undefined:Arr u8 _, scanned:bool }

effect(time) fn bd_clock() -> i64 = monotonic_ns().value
fn bd_elapsed(start:i64, finish:i64) -> i64 = if finish<start then 0 else finish-start

effect(fs) fn bd_file_digest(borrow path:Arr u8 _) -> BytesResult
  = let opened=file_open(path,0) in
    if !opened.ok then bytes_error(opened.error.code,opened.error.message,0) else
    let result=loop (part=file_read_chunk(opened.value,65536),hash=sha256_stream_start())
      while part.ok && len(part.value)>0 next (file_read_chunk(opened.value,65536),sha256_stream_add(hash,part.value))
      yield if part.ok then bytes_ok(tx_hex_bytes("",sha256_stream_finish(hash))) else part in
    let closed=file_close(opened.value) in
    if !closed.ok && result.ok then bytes_error(closed.error.code,closed.error.message,0) else result

effect(process,fs,env,time,unsafe) fn bd_link_profile(borrow config:BdConfig, borrow ir:Arr u8 _, borrow library:Arr u8 _, borrow output:Arr u8 _, profile:bool) -> BdLink
  = let empty=BdLink { compile_ns=0,link_ns=0,remarks="",digest="",undefined="",scanned=false } in
    let entropy=random_bytes(16) in if !entropy.ok then let failed=bd_error(entropy.error.message) in empty else
    let parent=pt_head(output) in let stage=pt_join(parent,concat(".neo-link-",tx_hex_bytes(tx_empty(),entropy.value))) in
    let created=fs_mkdir(stage) in if !created.ok then let failed=bd_error(concat("cannot create build directory: ",created.error.message)) in empty else
    let name=pt_tail(output) in
    let source=pt_join(stage,if tx_equal(name,"module.ll") then "input.ll" else "module.ll") in
    let object=pt_join(stage,if tx_equal(name,"module.o") then "input.o" else "module.o") in
    let dependency=pt_join(stage,if tx_equal(name,"dependency.o") then "library.o" else "dependency.o") in
    let remark_file=pt_join(stage,if tx_equal(name,"optimization.yaml") then "remarks.yaml" else "optimization.yaml") in
    let binary=pt_join(stage,name) in
    let saved=fs_write(source,ir) in
    let prepared=if len(library)==0 then int_ok(0) else fs_write(dependency,library) in
    let libraries=if len(library)==0 then md_words() else push(md_words(),dependency) in
    let started=bd_clock() in
    ; A profiled build times the two steps apart. Any other build tries one
    ; run first, and repeats it as two to say which step failed.
    let direct=if profile || !saved.ok || !prepared.ok then 1
      else bd_exit_code(bd_run(config.clang,bd_build_arguments(config,source,libraries,binary),false,true).status) in
    let compiled=if direct==0 then 0 else if saved.ok && prepared.ok then bd_exit_code(bd_execute(config.clang,bd_compile_arguments(config,source,object,if profile then remark_file else ""),false).status) else 1 in
    let after_compile=bd_clock() in
    let linked=if direct==0 then 0 else if compiled==0 then bd_exit_code(bd_execute(config.clang,bd_link_arguments(config,object,libraries,binary),false).status) else 1 in
    let finished=bd_clock() in
    let remarks=if profile && compiled==0 then fs_read(remark_file).value else "" in
    let digest=if profile && linked==0 then bd_file_digest(binary).value else "" in
    let symbols=if profile && linked==0 then bd_undefined_symbols(config,binary) else BdScan { ok=false, output="" } in
    let published=if linked==0 then fs_rename(binary,output) else int_error(5,if compiled!=0 then "Clang could not compile the LLVM IR" else "Clang could not link the executable",0) in
    let removed_ir=fs_remove(source) in let removed_object=fs_remove(object) in
    let removed_library=if len(library)>0 then fs_remove(dependency) else int_ok(0) in
    let removed_remarks=if profile then fs_remove(remark_file) else int_ok(0) in
    let removed_binary=if published.ok then int_ok(0) else fs_remove(binary) in
    let removed_stage=fs_rmdir(stage) in
    let checked=if !saved.ok then bd_error(concat("cannot write LLVM IR: ",saved.error.message))
    else if !prepared.ok then bd_error(concat("cannot stage the dependency object: ",prepared.error.message))
    else if !published.ok then bd_error(published.error.message)
    else if !removed_stage.ok then bd_error(concat("could not remove build directory: ",removed_stage.error.message)) else noop() in
    BdLink { compile_ns=bd_elapsed(started,after_compile),link_ns=bd_elapsed(after_compile,finished),remarks=remarks,digest=digest,
      undefined=symbols.output,scanned=symbols.ok }

; What `nm -u` prints for a linked executable, run quietly: nm on the PATH,
; else llvm-nm beside Clang or on the PATH. ok: one of them ran and succeeded.
type BdScan = { ok:bool, output:Arr u8 _ }
effect(process,fs,env,time,unsafe) fn bd_undefined_symbols(borrow config:BdConfig, borrow binary:Arr u8 _) -> BdScan
  = let beside=pt_join(pt_head(config.clang),"llvm-nm") in let found=bd_find_tool("nm") in
    let tool=if len(found)>0 then found else if fs_executable(beside) then beside else bd_find_tool("llvm-nm") in
    if len(tool)==0 then BdScan { ok=false, output="" } else
    let run=bd_run(tool,push(push(md_words(),"-u"),binary),true,true) in
    BdScan { ok=bd_exit_code(run.status)==0, output=run.output }

effect(process,fs,env,time,unsafe) fn bd_link(borrow config:BdConfig, borrow ir:Arr u8 _, borrow output:Arr u8 _) -> unit
  = let linked=bd_link_profile(config,ir,"",output,false) in noop()

; exports: the program's explicit ABI exports (bd_export_roots), kept by the link.
type BdConfig = { clang:Arr u8 _, runtime:Arr u8 _, target:Arr u8 _, level:Arr u8 _, error:Arr u8 _, exports:Arr Arr u8 _ _ }
effect(process,fs,env,time,unsafe) fn bd_configuration(borrow requested:Arr u8 _, seed:bool, borrow level:Arr u8 _) -> BdConfig
  = let clang=bd_clang() in
    let config=BdConfig { clang=clang, runtime=tx_empty(), target=tx_empty(), level=level, error=tx_empty(), exports=md_words() } in
    if len(clang)==0 then config with { error="Clang executable not found" } else
    let env_target=env_get("NEO_TARGET") in let target=if len(requested)>0 then requested else env_target.value in
    if seed then
      let runtime=bd_runtime() in let metadata=fs_read(concat(runtime,".target")) in
      if !metadata.ok then config with { error=concat("cannot read bootstrap runtime target beside ",runtime) } else
      let triple=str_trim(metadata.value) in
      if !bd_target_valid(triple) then config with { error=concat("unsupported bootstrap runtime target ",triple) }
      else if len(target)>0 && !tx_equal(target,triple) then config with { error="bootstrap runtime does not match the requested target" }
      else config with { runtime=runtime, target=triple }
    else
      let probe=if len(target)>0 then target else bd_detect_target(clang) in
      if len(probe)==0 then config with { error="could not detect the Clang target" }
      else if !bd_target_valid(probe) then config with { error=concat("unsupported target ",probe) }
      else config with { target=probe }

; Clang's default target. It is asked once per Clang and remembered in the
; cache directory, since starting Clang costs as much as a small build's own work.
effect(process,fs,env,time,unsafe) fn bd_detect_target(borrow clang:Arr u8 _) -> Arr u8 _
  = let base=bd_cache_base() in let tool=bd_tool_identity(clang) in
    let note=if len(base)==0 || len(tool)==0 then tx_empty()
      else pt_join(base,concat("target-",tx_hex_bytes(tx_empty(),sha256(tool)))) in
    let known=if len(note)==0 then tx_empty() else str_trim(fs_read(note).value) in
    if bd_target_valid(known) then known else
    let probe=bd_execute(clang,push(md_words(),"-print-target-triple"),true) in
    let target=if bd_exit_code(probe.status)==0 then str_trim(probe.output) else tx_empty() in
    let saved=if len(note)>0 && bd_target_valid(target) && pf_mkdirs(base).ok then fs_atomic_replace(note,concat(target,"\n")) else int_ok(0) in
    target
