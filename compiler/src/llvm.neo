; LLVM lowering for Neo functions. The source entry point is exposed
; as neo_entry, ready for a platform startup wrapper to call.
import "std:strings"
import "text.neo"
import "ast.neo"
import "lex.neo"
import "dump.neo"
import "modules.neo"
import "check.neo"
import "intrinsics.neo"
import "native_asm.neo"
import "native_crypto.neo"
import "regions.neo"

type CgValue = { ty:i64, elem:i64, depth:i64, record:i64, operand:Arr u8 _ }
; moves: uses of the binding that take its own reference (see cg_plan).
; parts: fields of a kept record taken out of it (see cg_parts).
type CgBinding = { name:i64, value:CgValue, live:Arr u8 _, moves:Arr i64 _, parts:Arr i64 _ }
type CgState = { text:Arr u8 _, globals:Arr u8 _, allocas:Arr u8 _, serial:i64, block:i64, value:CgValue, error:i64,
                 function:i64, name:Arr u8 _, line:i64, target:Arr u8 _, views:bool, runtime:bool,
                 par:Arr i64 _ }
; par: in a par clone, the program's par-mode functions (rg_par_set), else empty.
type CgProgram = { text:Arr u8 _, report:TcReport }

fn cg_type(ty:i64) -> Arr u8 _
  = if ty==n_t_i64() then "i64" else if ty==n_t_f64() then "double" else if ty==n_t_bool() then "i1"
    else if ty==n_t_u8() || ty==n_t_unit() then "i8" else if ty==n_t_u16() then "i16"
    else if ty==n_t_i32() then "i32" else if ty==n_t_arr() then "%ax_arr"
    else if ty==n_t_ref() then "{ i64, i64 }" else "ptr"
fn cg_record_name(id:i64) -> Arr u8 _ = concat("%neo_record_",int_text(id))
fn cg_type_of(borrow value:CgValue) -> Arr u8 _ = if value.ty==n_t_rec() then cg_record_name(value.record) else cg_type(value.ty)
fn cg_return(borrow value:CgValue) -> Arr u8 _ = if value.ty==n_t_unit() then "void" else cg_type_of(value)
fn cg_value(ty:i64, borrow operand:Arr u8 _) -> CgValue = CgValue { ty=ty, elem=0, depth=0, record=-1, operand=operand }
fn cg_unit() -> CgValue = cg_value(n_t_unit(),"0")
fn cg_array_value(borrow element:CgValue, borrow operand:Arr u8 _) -> CgValue
  = cg_value(n_t_arr(),operand) with { elem=if element.ty==n_t_arr() then element.elem else element.ty,
    depth=element.depth+1, record=element.record }
fn cg_element(borrow array:CgValue) -> CgValue
  = if array.depth>1 then array with { depth=array.depth-1, operand=tx_empty() }
    else cg_value(array.elem,"") with { record=array.record }
fn cg_declaration(borrow m:Mods, id:i64) -> CgValue
  = let t=md_node(m,id) in if t.kind==n_t_arr() then cg_array_value(cg_declaration(m,t.a),"")
    else cg_value(t.kind,"") with { record=if t.kind==n_t_rec() then tc_find_record(m,t.a) else if t.kind==n_t_fn() then id
      else if t.kind==n_t_ref() then md_resource_type(m,t.a) else -1 }
fn cg_supported(borrow value:CgValue) -> bool
  = let kind=if value.ty==n_t_arr() then value.elem else value.ty in
    tc_scalar(kind) || ((kind==n_t_fn() || kind==n_t_ref()) && value.record>=0) || (kind==n_t_rec() && value.record>=0)
fn cg_typed(borrow value:CgValue) -> Arr u8 _ = concat(cg_type_of(value)," ",value.operand)
fn cg_write(move s:CgState, borrow text:Arr u8 _) -> CgState = s with { text=concat(s.text,text) }
fn cg_reg(id:i64) -> Arr u8 _ = concat("%v",int_text(id))
fn cg_label(id:i64) -> Arr u8 _ = if id<0 then "entry" else concat("b",int_text(id))
fn cg_jump(move s:CgState, id:i64) -> CgState = cg_write(s,concat("  br label %",cg_label(id),"\n"))
fn cg_block(move s:CgState, id:i64) -> CgState = cg_write(s with { block=id },concat(cg_label(id),":\n"))
fn cg_branch(move s:CgState, borrow cond:Arr u8 _, yes:i64, no:i64) -> CgState
  = cg_write(s,concat("  br i1 ",cond,", label %",cg_label(yes),", label %",cg_label(no),"\n"))
fn cg_ins(move s:CgState, ty:i64, borrow instruction:Arr u8 _) -> CgState
  = let register=cg_reg(s.serial) in
    cg_write(s with { serial=s.serial+1, value=cg_value(ty,register) },concat("  ",register," = ",instruction,"\n"))
fn cg_ins_value(move s:CgState, borrow value:CgValue, borrow instruction:Arr u8 _) -> CgState
  = let emitted=cg_ins(s,value.ty,instruction) in emitted with { value=value with { operand=emitted.value.operand } }
fn cg_bytes(borrow symbol:Arr u8 _, borrow bytes:Arr u8 _, terminated:bool) -> Arr u8 _
  = let encoded=loop (i=0, out=tx_empty()) while i<len(bytes)
      next (i+1,tx_hex_byte(push(out,'\\'),tx_byte(bytes,i))) yield out in
    concat(symbol," = private unnamed_addr constant [",int_text(len(bytes)+(if terminated then 1 else 0)),
      " x i8] c\"",encoded,if terminated then "\\00" else "","\"\n")

fn cg_guard(move s:CgState, borrow bad:Arr u8 _, borrow message:Arr u8 _, precondition:bool) -> CgState
  = let fail=s.serial in let good=fail+1 in
    let symbol=concat("@neo_failure_",int_text(s.function),"_",int_text(fail)) in
    let handler=if precondition then "@neo_precondition_trap" else "@neo_runtime_trap" in
    let s=s with { serial=good+1, globals=concat(s.globals,cg_bytes(symbol,message,true)) } in
    let s=cg_block(cg_branch(s,bad,fail,good),fail) in
    cg_block(cg_write(s,concat("  call void ",handler,"(ptr ",symbol,")\n  unreachable\n")),good)

fn cg_arithmetic_guard(move s:CgState, borrow message:Arr u8 _) -> CgState
  = let diagnostic=concat(message," at ",s.name,":",int_text(s.line)) in cg_guard(s,s.value.operand,diagnostic,false)

fn cg_string(move s:CgState, borrow bytes:Arr u8 _) -> CgState
  ; Specializations and repeated lowering can reuse the same AST literal.
  = let symbol=concat("@neo_bytes_",int_text(s.function),"_",int_text(s.serial)) in
    let operand=concat("{ ptr ",symbol,", i64 ",int_text(len(bytes)),", i64 1, ptr inttoptr (i64 1 to ptr) }") in
    s with { serial=s.serial+1, globals=concat(s.globals,cg_bytes(symbol,bytes,false)),
      value=cg_array_value(cg_value(n_t_u8(),""),operand) }

fn cg_extract(move s:CgState, borrow array:CgValue, field:i64, ty:i64) -> CgState
  = cg_ins(s,ty,concat("extractvalue ",cg_typed(array),", ",int_text(field)))
fn cg_storage(borrow element:CgValue) -> Arr u8 _ = if element.ty==n_t_bool() then "i8" else cg_type_of(element)
fn cg_offset(move s:CgState, borrow storage:Arr u8 _, borrow data:Arr u8 _, borrow index:Arr u8 _) -> CgState
  = cg_ins(s,n_t_ptr(),concat("getelementptr ",storage,", ptr ",data,", i64 ",index))
fn cg_load_element(move s:CgState, borrow array:CgValue, borrow index:CgValue) -> CgState
  = let element=cg_element(array) in let storage=cg_storage(element) in
    let s=cg_extract(s,array,0,n_t_ptr()) in let s=cg_offset(s,storage,s.value.operand,index.operand) in
    let loaded=cg_ins_value(s,element,concat("load ",storage,", ptr ",s.value.operand,", align 1")) in
    if element.ty!=n_t_bool() then loaded else cg_ins(loaded,n_t_bool(),concat("trunc i8 ",loaded.value.operand," to i1"))

; Each array or record expression owns its managed references. Bindings and
; parameters keep theirs until scope exit. String literals are immortal.
fn cg_managed(borrow value:CgValue) -> bool = value.ty==n_t_rec() || value.ty==n_t_arr()
fn cg_ref_name(borrow value:CgValue, retain:bool) -> Arr u8 _
  = let action=if retain then "@neo_retain" else "@neo_release" in
    if value.ty==n_t_rec() then concat(action,"_record_",int_text(value.record)) else action
fn cg_ref_call(borrow value:CgValue, retain:bool) -> Arr u8 _
  = concat("  call void ",cg_ref_name(value,retain),"(",cg_typed(value),")\n")
fn cg_retain(move s:CgState, borrow value:CgValue) -> CgState
  = if cg_managed(value) then cg_write(s,cg_ref_call(value,true)) else s
fn cg_release(move s:CgState, borrow value:CgValue) -> CgState
  = if cg_managed(value) then cg_write(s,cg_ref_call(value,false)) else s

; Only a raw byte view has no owner. Detach it before storing it in an
; owning aggregate or before releasing storage that its data may alias.
fn cg_own_view(move s:CgState) -> CgState
  = let value=s.value in
    if s.views && value.ty==n_t_arr() && value.depth==1 && value.elem==n_t_u8() then
      cg_ins_value(s,value,concat("call %ax_arr @neo_own_view(",cg_typed(value),")")) else s

fn cg_width(elem:i64) -> i64
  = if elem==n_t_i64() || elem==n_t_f64() || elem==n_t_ptr() || elem==n_t_fn() then 8
    else if elem==n_t_ref() then 16 else if elem==n_t_i32() then 4 else if elem==n_t_u16() then 2 else 1
fn cg_stride(borrow element:CgValue) -> Arr u8 _
  = if cg_managed(element) then concat("ptrtoint (ptr getelementptr (",cg_storage(element),", ptr null, i64 1) to i64)")
    else int_text(cg_width(element.ty))
fn cg_byte_count(move s:CgState, borrow element:CgValue, borrow length:Arr u8 _) -> CgState
  = if !cg_managed(element) && cg_width(element.ty)==1 then s with { value=cg_value(n_t_i64(),length) }
    else cg_checked_arithmetic(s,"mul",length,cg_stride(element))
fn cg_slot_symbol(borrow element:CgValue, retain:bool) -> Arr u8 _
  = concat("@neo.slot.",if retain then "retain." else "release.",
    if element.ty==n_t_rec() then concat("record.",int_text(element.record)) else "array")
fn cg_array_allocate(move s:CgState, borrow element:CgValue, borrow length:Arr u8 _) -> CgState
  = let managed=cg_managed(element) in let s=cg_byte_count(s,element,length) in
    let s=if managed then cg_checked_arithmetic(s,"add",s.value.operand,"32") else s in
    let s=cg_ins(s,n_t_ptr(),concat("call ptr @ax_heap_alloc(i64 ",s.value.operand,")")) in let payload=s.value.operand in
    ; The allocator aligns the reference header. Bit 1 records that the
    ; payload begins with a destructor, stride, and element count.
    let s=cg_offset(s,"i8",payload,if managed then "-14" else "-16") in let control=s.value.operand in
    let s=if !managed then s with { value=cg_value(n_t_ptr(),payload) } else
      let s=cg_write(s,concat("  call void @neo.init.elements(ptr ",payload,", ptr ",cg_slot_symbol(element,false),
        ", i64 ",cg_stride(element),", i64 ",length,")\n")) in cg_offset(s,"i8",payload,"32") in
    let data=s.value.operand in
    let s=cg_ins(s,n_t_arr(),concat("insertvalue %ax_arr poison, ptr ",data,", 0")) in
    let s=cg_ins(s,n_t_arr(),concat("insertvalue ",cg_typed(s.value),", i64 ",length,", 1")) in
    let s=cg_ins(s,n_t_arr(),concat("insertvalue ",cg_typed(s.value),", i64 1, 2")) in
    let s=cg_ins(s,n_t_arr(),concat("insertvalue ",cg_typed(s.value),", ptr ",control,", 3")) in
    s with { value=cg_array_value(element,s.value.operand) }

fn cg_store_element(move s:CgState, borrow array:CgValue, borrow index:Arr u8 _, borrow value:CgValue) -> CgState
  = let element=cg_element(array) in let s=cg_extract(s,array,0,n_t_ptr()) in
    let s=cg_offset(s,cg_storage(element),s.value.operand,index) in
    let location=s.value.operand in
    let s=if element.ty==n_t_bool() then cg_ins(s,n_t_u8(),concat("zext ",cg_typed(value)," to i8"))
      else s with { value=value } in
    cg_write(s,concat("  store ",cg_typed(s.value),", ptr ",location,", align 1\n"))

fn cg_copy_array(move s:CgState, borrow array:CgValue, borrow target:CgValue, borrow offset:Arr u8 _, borrow length:Arr u8 _) -> CgState
  = let s=cg_extract(s,array,0,n_t_ptr()) in let source=s.value.operand in
    let element=cg_element(target) in let s=cg_extract(s,target,0,n_t_ptr()) in
    let s=cg_offset(s,cg_storage(element),s.value.operand,offset) in let destination=s.value.operand in
    let s=cg_byte_count(s,element,length) in
    let s=cg_write(s,concat("  call void @llvm.memcpy.p0.p0.i64(ptr ",destination,", ptr ",source,", i64 ",s.value.operand,", i1 false)\n")) in
    if !cg_managed(element) then s else cg_write(s,concat("  call void @neo.visit.elements(ptr ",destination,", ptr ",
      cg_slot_symbol(element,true),", i64 ",cg_stride(element),", i64 ",length,")\n"))

fn cg_bind(name:i64, borrow value:CgValue) -> CgBinding = CgBinding { name=name, value=value, live=tx_empty(), moves=tx_ints(), parts=tx_ints() }
fn cg_listed(borrow ids:Arr i64 _, id:i64) -> bool
  = loop (i=0, found=false) while !found && i<len(ids) next (i+1,tx_at(ids,i)==id) yield found
fn cg_joined(borrow a:Arr i64 _, borrow b:Arr i64 _) -> Arr i64 _
  = arr(i in 0..len(a)+len(b)) if i<len(a) then tx_at(a,i) else tx_at(b,i-len(a))
fn cg_binding(borrow env:Arr CgBinding _, i:i64) -> CgBinding
  = if i>=0 && i<len(env) then env[i] else cg_bind(-1,cg_unit())
fn cg_binding_index(borrow m:Mods, borrow env:Arr CgBinding _, name:i64) -> i64
  = let text=md_str(m,name) in
    loop (i=len(env)-1) while i>=0 && !tx_equal(text,md_str(m,cg_binding(env,i).name)) next (i-1) yield i
fn cg_lookup(borrow m:Mods, borrow env:Arr CgBinding _, name:i64) -> CgValue
  = cg_binding(env,cg_binding_index(m,env,name)).value

fn cg_move_owner(borrow m:Mods, borrow env:Arr CgBinding _, move s:CgState, id:i64) -> CgState
  = let n=md_node(m,id) in
    let flag=if n.kind!=n_var() then tx_empty() else cg_binding(env,cg_binding_index(m,env,n.a)).live in
    if len(flag)==0 then s else cg_write(s,concat("  store i1 false, ptr ",flag,", align 1\n"))
fn cg_new_owner(move s:CgState) -> CgState
  = let flag=cg_reg(s.serial) in
    let s=s with { serial=s.serial+1, allocas=concat(s.allocas,"  ",flag," = alloca i1, align 1\n"), value=cg_value(n_t_ptr(),flag) } in
    cg_write(s,concat("  store i1 true, ptr ",flag,", align 1\n"))
fn cg_cleanup(borrow m:Mods, move s:CgState, borrow binding:CgBinding, destructor:i64) -> CgState
  = if len(binding.live)==0 then cg_release_rest(m,s,binding.value,binding.parts,-1) else
    let result=s.value in let run=s.serial in let done=run+1 in
    let s=cg_ins(s with { serial=done+1 },n_t_bool(),concat("load i1, ptr ",binding.live,", align 1")) in
    let s=cg_block(cg_branch(s,s.value.operand,run,done),run) in
    let s=cg_retain(s,binding.value) in
    let s=cg_write(s,concat("  call void ",cg_symbol(m,destructor),"(",cg_typed(binding.value),")\n")) in
    cg_release(cg_block(cg_jump(s,done),done),binding.value) with { value=result }
fn cg_symbol(borrow m:Mods, id:i64) -> Arr u8 _
  = let f=md_node(m,id) in let abi=tc_abi_boundary(f) in
    if !abi && !m.stable_symbols && tx_at(m.shared,tx_at(m.owners,id))!=1 then concat("@neo_fn_",int_text(id)) else
    let name=if abi then md_str(m,f.a) else concat("neo.fn.",md_str(m,f.a)) in
    let escaped=loop (i=0, out=tx_empty()) while i<len(name)
      next (i+1,let b=tx_byte(name,i) in if b>=128 then tx_hex_byte(push(out,'\\'),b) else push(out,u8(b))) yield out in
    concat("@\"",escaped,"\"")

; Direct calls lend managed arguments. A parameter without `move` keeps the
; caller's reference: a lexical argument is passed without a retain, a
; temporary is released by the caller after the call, and the callee does not
; release it on exit. `move` parameters are still handed over. Each such
; function is lowered once under cg_lent_symbol; its ordinary symbol is a
; wrapper with the owning convention for function values, addresses,
; destructors and the entry point. ABI boundary functions are never split.
fn cg_counted(borrow m:Mods, borrow value:CgValue) -> bool
  = if value.ty==n_t_arr() then true else if value.ty!=n_t_rec() || value.record<0 then false else
    let fields=md_node(m,value.record).b in
    loop (i=0, found=false) while !found && i<ast_list_len(m.ast,fields)
      next (i+1,cg_counted(m,cg_field_type(m,fields,i))) yield found
fn cg_parameter_lent(borrow m:Mods, p:Node) -> bool = p.f!=1 && cg_counted(m,cg_declaration(m,p.b))
fn cg_lends(borrow m:Mods, f:Node) -> bool
  = !tc_abi_boundary(f) && !ast_flag(f,fl_variadic()) &&
    loop (i=0, found=false) while !found && i<ast_list_len(m.ast,f.b)
      next (i+1,cg_parameter_lent(m,md_node(m,ast_list_at(m.ast,f.b,i)))) yield found
fn cg_lent_symbol(borrow m:Mods, id:i64) -> Arr u8 _
  = let symbol=cg_symbol(m,id) in let size=len(symbol) in
    if size>1 && tx_byte(symbol,size-1)==34 then concat(pt_slice(symbol,0,size-1),".lent\"") else concat(symbol,".lent")
fn cg_lent_arguments(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, f:Node, list:i64) -> CgReads
  = loop (i=0, a=CgReads { state=s, values=arr(j in 0..0) cg_unit(), owned=tx_ints() })
      while a.state.error<0 && i<ast_list_len(m.ast,list)
      next (i+1,let id=ast_list_at(m.ast,list,i) in
        if i<ast_list_len(m.ast,f.b) && cg_parameter_lent(m,md_node(m,ast_list_at(m.ast,f.b,i))) then
          let read=cg_read(m,fns,env,a.state,id) in
          CgReads { state=read.state, values=push(a.values,read.state.value), owned=push(a.owned,if read.borrowed then 0 else 1) }
        else let lowered=cg_expr(m,fns,env,a.state,id) in
          CgReads { state=lowered, values=push(a.values,lowered.value), owned=push(a.owned,0) }) yield a

; Ownership plans. An owned binding (a computed let value, a parameter the
; callee owns, a loop state) is retained at each use and released when its
; scope ends. When every path through the scope ends in one last use that
; hands the value to an owner (a result, a field value, a `with` base, a loop's
; initial value, a push/set operand, an argument for an owning parameter),
; those uses take the binding's own reference instead: no retain there and no
; release at the end. A buffer handed on this way stays uniquely referenced,
; which is what lets push and set update it in place.
; When only one branch of an `if` hands the value on, the other branch
; releases it as it ends: its entry in moves is -1-branch (cg_branch_drops).
; state: 0 the name is not used, 1 taken on every path, 2 kept and released.
; field: when not -1, the plan is that of the field path name.field alone (see
; cg_parts): reading name.g for another field g is not a use of it, while
; reading name as a whole or name.field is.
type CgPlan = { state:i64, moves:Arr i64 _ }
fn cg_plan_unused() -> CgPlan = CgPlan { state=0, moves=tx_ints() }
fn cg_plan_kept() -> CgPlan = CgPlan { state=2, moves=tx_ints() }
fn cg_plan_taken(id:i64) -> CgPlan = CgPlan { state=1, moves=push(tx_ints(),id) }
fn cg_named(borrow m:Mods, a:i64, b:i64) -> bool = a==b || tx_equal(md_str(m,a),md_str(m,b))
; The plan of expression first when later is the plan of what runs after it:
; once a later expression uses the name, an earlier one cannot hold its last use.
fn cg_plan_then(borrow m:Mods, borrow fns:Arr i64 _, first:i64, name:i64, field:i64, taking:bool, later:CgPlan) -> CgPlan
  = if later.state!=0 then later else cg_plan(m,fns,first,name,field,taking)
; Whether expression id is the variable name or a field path of it (one that
; goes through name.field when field is not -1).
fn cg_rooted(borrow m:Mods, id:i64, name:i64, field:i64) -> bool
  = let n=md_node(m,id) in
    if n.kind==n_field() then
      let base=md_node(m,n.a) in
      if base.kind==n_var() then cg_named(m,base.a,name) && (field<0 || cg_named(m,n.b,field)) else cg_rooted(m,n.a,name,field)
    else n.kind==n_var() && cg_named(m,n.a,name)
; Whether expression id is what the plan follows: the variable name, or
; name.field when field is not -1.
fn cg_is_target(borrow m:Mods, id:i64, name:i64, field:i64) -> bool
  = let n=md_node(m,id) in
    if field<0 then n.kind==n_var() && cg_named(m,n.a,name)
    else if n.kind!=n_field() || !cg_named(m,n.b,field) then false
    else let base=md_node(m,n.a) in base.kind==n_var() && cg_named(m,base.a,name)
; An argument that is lent or only observed, and reads the binding directly
; (the variable or a field path of it), stays unretained until its call runs.
; Nothing evaluated after it may take the binding: the taker could update or
; free the buffer the pending argument still points to. Any other expression
; in such a position yields a value of its own, so its reads are over by then.
fn cg_plan_held(borrow m:Mods, borrow fns:Arr i64 _, first:i64, name:i64, field:i64, later:CgPlan) -> CgPlan
  = if later.state==0 then cg_plan(m,fns,first,name,field,false)
    else if later.state==1 && cg_rooted(m,first,name,field) then cg_plan_kept() else later
fn cg_plan_list(borrow m:Mods, borrow fns:Arr i64 _, list:i64, name:i64, field:i64, taking:bool) -> CgPlan
  = loop (i=ast_list_len(m.ast,list)-1, plan=cg_plan_unused()) while i>=0
      next (i-1,let id=ast_list_at(m.ast,list,i) in
        if taking then cg_plan_then(m,fns,id,name,field,true,plan) else cg_plan_held(m,fns,id,name,field,plan)) yield plan
; Whether argument i of a call is handed over: every operand of push, set and
; the byte writers (decl -1), the first part of concat (decl -2), or an
; argument for an owning parameter of the function decl.
fn cg_argument_owned(borrow m:Mods, decl:i64, i:i64) -> bool
  = if decl== -2 then i==0 else if decl<0 then true else let f=md_node(m,decl) in
    i<ast_list_len(m.ast,f.b) && !(cg_lends(m,f) && cg_parameter_lent(m,md_node(m,ast_list_at(m.ast,f.b,i))))
; Arguments run in order and the call runs after all of them. A plain `x` (or
; the field `x.f` a field plan follows) in an owning position can therefore be
; the call's last use of it even when a later argument reads it: that read is
; over, and owns what it keeps, before the callee can change it. Later
; arguments are quiet when none of them takes it and none is it, or a field
; path of it, lent: that one would still point into it during the call.
type CgArguments = { plan:CgPlan, quiet:bool }
fn cg_plan_argument(borrow m:Mods, borrow fns:Arr i64 _, n:Node, name:i64, field:i64, decl:i64, i:i64, later:CgArguments) -> CgArguments
  = let id=ast_list_at(m.ast,n.b,i) in let owned=cg_argument_owned(m,decl,i) in
    let held=!owned && cg_rooted(m,id,name,field) in
    let own=cg_plan(m,fns,id,name,field,owned) in let plan=later.plan in
    let merged=if plan.state==0 then own
      else if held then (if plan.state==1 then cg_plan_kept() else plan)
      else if owned && plan.state==2 && later.quiet && cg_is_target(m,id,name,field) then cg_plan_taken(id)
      else plan in
    CgArguments { plan=merged, quiet=later.quiet && !held && own.state!=1 }
fn cg_plan_arguments(borrow m:Mods, borrow fns:Arr i64 _, n:Node, name:i64, field:i64, decl:i64) -> CgPlan
  = loop (i=ast_list_len(m.ast,n.b)-1, all=CgArguments { plan=cg_plan_unused(), quiet=true }) while i>=0
      next (i-1,cg_plan_argument(m,fns,n,name,field,decl,i,all)) yield all.plan
; Only the operands of the buffer operations (push, set, byte_copy,
; byte_write_le, byte_slice, and concat's first part) and arguments for owning
; parameters of a direct call are handed over; every other callee is assumed
; to observe its arguments.
fn cg_plan_call(borrow m:Mods, borrow fns:Arr i64 _, n:Node, name:i64, field:i64) -> CgPlan
  = let callee=md_str(m,n.a) in
    if str_find(" push set byte_copy byte_write_le byte_slice ",concat(" ",callee," ")).present then cg_plan_arguments(m,fns,n,name,field,-1)
    else if tx_equal(callee,"concat") then cg_plan_arguments(m,fns,n,name,field,-2)
    else if md_is_builtin(m,callee) then cg_plan_list(m,fns,n.b,name,field,false) else
    let id=md_find_decl(m,fns,n.a) in if id<0 then cg_plan_list(m,fns,n.b,name,field,false) else
    cg_plan_arguments(m,fns,n,name,field,id)
; Initial values run once and in order; the condition and successors repeat,
; so a use there is never the last; the yield runs once at the end.
fn cg_plan_loop(borrow m:Mods, borrow fns:Arr i64 _, n:Node, name:i64, field:i64) -> CgPlan
  = let count=ast_list_len(m.ast,n.a) in
    let shadowed=loop (i=0, found=false) while !found && i<count
      next (i+1,cg_named(m,md_node(m,ast_list_at(m.ast,n.a,i)).a,name)) yield found in
    let result=if shadowed then cg_plan_unused() else cg_plan(m,fns,n.d,name,field,true) in
    let inside=if shadowed || result.state!=0 then result else
      if cg_plan(m,fns,n.b,name,field,false).state!=0 || cg_plan_list(m,fns,n.c,name,field,false).state!=0 then cg_plan_kept()
      else cg_plan_unused() in
    loop (i=count-1, plan=inside) while i>=0
      next (i-1,cg_plan_then(m,fns,md_node(m,ast_list_at(m.ast,n.a,i)).c,name,field,true,plan)) yield plan
; `x with { ... }` takes x after its field values (see cg_with_owned). For a
; field plan it is a use of the whole record, unless it replaces that field:
; then the old value is dropped, not read (cg_with_value and cg_record_expr
; leave a taken field alone), so only the new field values can use it. A
; literal evaluates its values in the type's field order (cg_record_fill),
; whatever order they are written in.
fn cg_plan_record(borrow m:Mods, borrow fns:Arr i64 _, n:Node, name:i64, field:i64) -> CgPlan
  = let base=md_node(m,n.a) in
    if n.kind==n_with() && base.kind==n_var() && cg_named(m,base.a,name) then
      (if field<0 then cg_plan_taken(n.a) else if tc_named_node(m,n.b,field)<0 then cg_plan_kept()
       else cg_plan_values(m,fns,n.b,name,field))
    else if n.kind==n_with() then cg_plan_then(m,fns,n.a,name,field,true,cg_plan_values(m,fns,n.b,name,field))
    else let record=tc_find_record(m,n.a) in if record<0 then cg_plan_kept() else
    let fields=md_node(m,record).b in
    loop (i=ast_list_len(m.ast,fields)-1, plan=cg_plan_unused()) while i>=0
      next (i-1,let init=tc_named_node(m,n.b,md_node(m,ast_list_at(m.ast,fields,i)).a) in
        if init<0 then cg_plan_kept() else cg_plan_then(m,fns,md_node(m,init).b,name,field,true,plan)) yield plan
; The values of a `with`, which run in the order they are written.
fn cg_plan_values(borrow m:Mods, borrow fns:Arr i64 _, list:i64, name:i64, field:i64) -> CgPlan
  = loop (i=ast_list_len(m.ast,list)-1, plan=cg_plan_unused()) while i>=0
      next (i-1,cg_plan_then(m,fns,md_node(m,ast_list_at(m.ast,list,i)).b,name,field,true,plan)) yield plan
; The plan of name (or name.field) over expression id when nothing after it
; uses the name. taking: the expression's value is handed to an owner.
; A let value is read lexically (cg_read), which shares a variable's
; reference, so only a field plan takes one there: a taken field read is
; owned by the reader.
fn cg_plan(borrow m:Mods, borrow fns:Arr i64 _, id:i64, name:i64, field:i64, taking:bool) -> CgPlan
  = let n=md_node(m,id) in let kind=n.kind in
    if id<0 || kind==n_num() || kind==n_flt() || kind==n_bool() || kind==n_byte() || kind==n_str() then cg_plan_unused()
    else if kind==n_var() then
      if !cg_named(m,n.a,name) then cg_plan_unused()
      else if taking && field<0 then cg_plan_taken(id) else cg_plan_kept()
    else if kind==n_let() || kind==n_using() then
      cg_plan_then(m,fns,n.b,name,field,kind==n_let() && field>=0,
        if cg_named(m,n.a,name) then cg_plan_unused() else cg_plan(m,fns,n.c,name,field,true))
    else if kind==n_if() then
      let yes=cg_plan(m,fns,n.b,name,field,true) in let no=cg_plan(m,fns,n.c,name,field,true) in
      if yes.state==0 && no.state==0 then cg_plan(m,fns,n.a,name,field,false)
      else if yes.state==1 && no.state==1 then CgPlan { state=1, moves=cg_joined(yes.moves,no.moves) }
      else if yes.state==1 then CgPlan { state=1, moves=push(yes.moves,-1-n.c) }
      else if no.state==1 then CgPlan { state=1, moves=push(no.moves,-1-n.b) } else cg_plan_kept()
    else if kind==n_check() then cg_plan_then(m,fns,n.a,name,field,false,cg_plan(m,fns,n.b,name,field,true))
    else if kind==n_bin() then
      let right=cg_plan(m,fns,n.c,name,field,false) in
      ; The right operand of && and || may not run.
      if n.a!=10 && n.a!=11 then cg_plan_then(m,fns,n.b,name,field,false,right)
      else if right.state==0 then cg_plan(m,fns,n.b,name,field,false) else cg_plan_kept()
    else if kind==n_un() || kind==n_cast() then cg_plan(m,fns,n.b,name,field,false)
    else if kind==n_len() then cg_plan(m,fns,n.a,name,field,false)
    else if kind==n_field() then
      if field<0 then cg_plan(m,fns,n.a,name,field,false)
      else if cg_is_target(m,id,name,field) then (if taking then cg_plan_taken(id) else cg_plan_kept())
      else if md_node(m,n.a).kind==n_var() then cg_plan_unused()
      else cg_plan(m,fns,n.a,name,field,false)
    else if kind==n_index() then cg_plan_then(m,fns,n.a,name,field,false,cg_plan(m,fns,n.b,name,field,false))
    else if kind==n_sum() || kind==n_arrc() then
      ; The body repeats, so a use inside it is never the last.
      if !cg_named(m,n.a,name) && cg_plan(m,fns,n.d,name,field,false).state!=0 then cg_plan_kept()
      else cg_plan_then(m,fns,n.b,name,field,false,cg_plan(m,fns,n.c,name,field,false))
    else if kind==n_loop() then cg_plan_loop(m,fns,n,name,field)
    else if kind==n_reclit() || kind==n_with() then cg_plan_record(m,fns,n,name,field)
    else if kind==n_call() then cg_plan_call(m,fns,n,name,field)
    else cg_plan_kept()
fn cg_moves(borrow m:Mods, borrow fns:Arr i64 _, id:i64, name:i64) -> Arr i64 _
  = let plan=cg_plan(m,fns,id,name,-1,true) in if plan.state==1 then plan.moves else tx_ints()
; Field takes. A record binding's fields are released where the binding is:
; at the end of its scope, or at the end of a branch that the other branch
; handed it on from (cg_branch_drops). When a field that holds references has
; a last use before that point which hands it on (its own plan, cg_plan with
; that field), that use takes the record's reference to the field instead, and
; the release leaves the field out: a buffer in a record that a function owns
; is then handed on uniquely referenced, so push and set update it in place.
; Triples of a scope (-1 for the end of the binding's scope, or the branch
; node whose end releases the binding), a field index, and a use that takes
; the field or -1-branch for the other branch of an `if` that releases it.
; expressions: id is a list of expressions (loop successors).
fn cg_parts_in(borrow m:Mods, borrow fns:Arr i64 _, borrow value:CgValue, id:i64, name:i64, expressions:bool, scope:i64,
               move out:Arr i64 _) -> Arr i64 _
  = let fields=md_node(m,value.record).b in
    loop (i=0, all=out) while i<ast_list_len(m.ast,fields)
      next (i+1,if !cg_counted(m,cg_field_type(m,fields,i)) then all else
        let field=md_node(m,ast_list_at(m.ast,fields,i)).a in
        let plan=if expressions then cg_plan_list(m,fns,id,name,field,true) else cg_plan(m,fns,id,name,field,true) in
        if plan.state!=1 then all else
        loop (k=0, triples=all) while k<len(plan.moves)
          next (k+1,push(push(push(triples,scope),i),tx_at(plan.moves,k))) yield triples) yield all
; The field takes of a binding whose own plan has these moves: over its whole
; scope when nothing takes it, inside each branch that releases it, or over
; its whole scope when it is handed on on every path (cg_parts_dropped).
fn cg_parts(borrow m:Mods, borrow fns:Arr i64 _, borrow value:CgValue, id:i64, name:i64, expressions:bool, borrow moves:Arr i64 _) -> Arr i64 _
  = if value.ty!=n_t_rec() || value.record<0 || !cg_counted(m,value) then tx_ints()
    else if len(moves)==0 then cg_parts_in(m,fns,value,id,name,expressions,-1,tx_ints())
    else if cg_all_uses(moves) then cg_parts_dropped(m,fns,value,id,name,expressions,moves) else
    loop (k=0, out=tx_ints()) while k<len(moves)
      next (k+1,let entry=tx_at(moves,k) in
        if entry>=0 then out else cg_parts_in(m,fns,value,-1-entry,name,false,-1-entry,out)) yield out
; Whether every entry of moves is a use, none a -1-branch entry.
fn cg_all_uses(borrow moves:Arr i64 _) -> bool
  = loop (i=0, ok=true) while ok && i<len(moves) next (i+1,tx_at(moves,i)>=0) yield ok
; A binding handed on on every path, where nothing releases it. A field plan
; that takes the field on every path before that means each hand-over is a
; `with` replacing the field (any other use of the record would be a later use
; of the field, see cg_plan_record), so it takes the field the same way. Each
; such `with` then must not release the old field: the triples (-2, index,
; base) mark them (cg_with_value), after the takes (-1, index, use).
; A branch where the field plan does not take the field (a -1-branch entry)
; may hand the record on itself, with the field in it or replaced by a `with`
; that releases it as usual: such a branch's hand-overs are not marked, so
; the field is taken on the other paths, as a JSON writer appends to its
; buffer unless it fails. A branch that ends before the hand-over would have
; to release the field itself; then the field is not taken at all.
fn cg_parts_dropped(borrow m:Mods, borrow fns:Arr i64 _, borrow value:CgValue, id:i64, name:i64, expressions:bool,
                    borrow moves:Arr i64 _) -> Arr i64 _
  = let fields=md_node(m,value.record).b in
    loop (i=0, all=tx_ints()) while i<ast_list_len(m.ast,fields)
      next (i+1,if !cg_counted(m,cg_field_type(m,fields,i)) then all else
        let field=md_node(m,ast_list_at(m.ast,fields,i)).a in
        let plan=if expressions then cg_plan_list(m,fns,id,name,field,true) else cg_plan(m,fns,id,name,field,true) in
        if plan.state!=1 then all else
        let kept=loop (k=0, out=CgFieldKept { moves=tx_ints(), handed=true }) while out.handed && k<len(plan.moves)
          next (k+1,let entry=tx_at(plan.moves,k) in if entry>=0 then out else
            let inner=cg_branch_moves(m,fns,-1-entry,name,moves) in
            CgFieldKept { moves=cg_joined(out.moves,inner), handed=len(inner)>0 }) yield out in
        if !kept.handed then all else
        let taken=loop (k=0, triples=all) while k<len(plan.moves)
          next (k+1,let entry=tx_at(plan.moves,k) in
            if entry<0 then triples else push(push(push(triples,-1),i),entry)) yield triples in
        loop (k=0, triples=taken) while k<len(moves)
          next (k+1,if cg_listed(kept.moves,tx_at(moves,k)) then triples
            else push(push(push(triples,-2),i),tx_at(moves,k))) yield triples) yield all
; The hand-overs inside the branches that keep a field (cg_parts_dropped).
type CgFieldKept = { moves:Arr i64 _, handed:bool }
; The hand-overs of binding name inside branch that are among its moves, or
; none when the binding is handed on after the branch.
fn cg_branch_moves(borrow m:Mods, borrow fns:Arr i64 _, branch:i64, name:i64, borrow moves:Arr i64 _) -> Arr i64 _
  = let plan=cg_plan(m,fns,branch,name,-1,true) in
    let inside=loop (k=0, found=false) while !found && k<len(plan.moves)
      next (k+1,tx_at(plan.moves,k)>=0 && cg_listed(moves,tx_at(plan.moves,k))) yield found in
    if plan.state==1 && inside then plan.moves else tx_ints()
; Whether parts marks the `with` on base as leaving the field at index alone.
fn cg_part_dropped(borrow parts:Arr i64 _, index:i64, base:i64) -> bool
  = loop (i=0, found=false) while !found && i+2<len(parts)
      next (i+3,tx_at(parts,i)== -2 && tx_at(parts,i+1)==index && tx_at(parts,i+2)==base) yield found
; Whether parts lists the use (or -1-branch entry) id.
fn cg_part_listed(borrow parts:Arr i64 _, id:i64) -> bool
  = loop (i=2, found=false) while !found && i<len(parts) next (i+3,tx_at(parts,i)==id) yield found
; Whether parts takes the field at index within scope.
fn cg_part_field(borrow parts:Arr i64 _, scope:i64, index:i64) -> bool
  = loop (i=0, found=false) while !found && i+1<len(parts) next (i+3,tx_at(parts,i)==scope && tx_at(parts,i+1)==index) yield found
; Releases a binding's value where scope ends, except the fields its parts
; took or released on the way. The current value is kept.
fn cg_release_rest(borrow m:Mods, move s:CgState, borrow value:CgValue, borrow parts:Arr i64 _, scope:i64) -> CgState
  = let result=s.value in
    if value.ty!=n_t_rec() || value.record<0 || !cg_part_listed_scope(parts,scope) then cg_release(s,value) else
    let fields=md_node(m,value.record).b in
    loop (i=0, out=s) while i<ast_list_len(m.ast,fields)
      next (i+1,let field=cg_field_type(m,fields,i) in
        if !cg_managed(field) || cg_part_field(parts,scope,i) then out else
        let got=cg_field_get(out,value,field,i) in cg_release(got,got.value) with { value=result }) yield out
fn cg_part_listed_scope(borrow parts:Arr i64 _, scope:i64) -> bool
  = loop (i=0, found=false) while !found && i<len(parts) next (i+3,tx_at(parts,i)==scope) yield found

fn cg_abi_types(borrow m:Mods, f:Node) -> Arr u8 _
  = let count=ast_list_len(m.ast,f.b) in
    let fixed=loop (i=0, out=tx_empty()) while i<count
      next (i+1,let param=md_node(m,ast_list_at(m.ast,f.b,i)) in
        concat(out,if i==0 then "" else ", ",cg_type(md_node(m,param.b).kind))) yield out in
    if !ast_flag(f,fl_variadic()) then fixed else concat(fixed,if count==0 then "..." else ", ...")

fn cg_runtime_signature(borrow name:Arr u8 _) -> Arr u8 _
  = if tx_equal(name,"ax_heap_alloc") then "ptr(i64)"
    else if tx_equal(name,"ax_free") || tx_equal(name,"ax_print_bytes") then "void(ptr, i64)"
    else if tx_equal(name,"ax_parse_i64") then "i64(ptr, ptr)"
    else if tx_equal(name,"ax_usage") then "void(ptr, ptr)"
    else if tx_equal(name,"ax_print_i64") || tx_equal(name,"ax_exit") then "void(i64)"
    else if tx_equal(name,"ax_print_f64") then "void(double)"
    else if tx_equal(name,"ax_runtime_init") || tx_equal(name,"ax_trap") || tx_equal(name,"ax_precondition_failed") then "void(ptr)"
    else tx_empty()

fn cg_runtime_owner(borrow m:Mods, id:i64) -> bool = pt_within(md_path(m,tx_at(m.owners,id)),m.runtime)
fn cg_runtime_check(borrow m:Mods, borrow fns:Arr i64 _) -> TcReport
  = let names="ax_runtime_init ax_exit ax_trap ax_precondition_failed ax_usage ax_parse_i64 ax_print_i64 ax_print_f64 ax_print_bytes ax_heap_alloc ax_free" in
    loop (i=0, out=TcReport { result=tc_type(n_t_unit()), module=-1 }) while out.result.value.ty>0 && i<len(names)
      next (md_word_end(names,i)+1,let name=pt_slice(names,i,md_word_end(names,i)) in
        let id=md_find_decl(m,fns,bk_get(m.base,0,name)) in let f=md_node(m,id) in
        let signature=concat(cg_return(cg_declaration(m,f.c)),"(",cg_abi_types(m,f),")") in
        if id>=0 && cg_runtime_owner(m,id) && ast_flag(f,fl_exported()) && !ast_flag(f,fl_external()) &&
          tx_equal(signature,cg_runtime_signature(name)) then out else
        TcReport { result=tc_error(id,concat("runtime must export ",name," with signature ",cg_runtime_signature(name))),
          module=if id<0 then -1 else tx_at(m.owners,id) }) yield out

; Runtime source definitions may supply the ABI used by generated code.
; The wrapper's own symbols always remain reserved.
fn cg_abi_reserved(borrow name:Arr u8 _, executable:bool, runtime_export:bool) -> bool
  = str_starts(name,"neo_fn_") || str_starts(name,"neo_bytes_") || str_starts(name,"neo_failure_") ||
    str_starts(name,"neo_par_") || str_starts(name,"neo_region_") || tx_equal(name,"neo_heap_mode") ||
    str_find(" neo_entry neo_retain neo_release neo_own_view neo_runtime_trap neo_precondition_trap ax_runtime_state ax_native_alloc_stats ",concat(" ",name," ")).present ||
    str_find(" neo_spawn_thread neo_fiber_swap neo_fiber_init ",concat(" ",name," ")).present ||
    (executable && (str_starts(name,"neo_arg_") || tx_equal(name,"_start") || tx_equal(name,"neo_process_start"))) ||
    (!runtime_export && (if executable then len(cg_runtime_signature(name))>0 else tx_equal(name,"ax_heap_alloc") || tx_equal(name,"ax_free")))

fn cg_checked_arithmetic(move s:CgState, borrow op:Arr u8 _, borrow a:Arr u8 _, borrow b:Arr u8 _) -> CgState
  = let s=cg_ins(s,0,concat("call { i64, i1 } @llvm.s",op,".with.overflow.i64(i64 ",a,", i64 ",b,")")) in
    let pair=s.value.operand in
    let s=cg_ins(s,n_t_bool(),concat("extractvalue { i64, i1 } ",pair,", 1")) in
    let s=cg_arithmetic_guard(s,"integer overflow") in cg_ins(s,n_t_i64(),concat("extractvalue { i64, i1 } ",pair,", 0"))

; Runtime sources use machine arithmetic for system words and byte patterns,
; just as they do in the bootstrap compiler.
fn cg_integer_arithmetic(move s:CgState, borrow op:Arr u8 _, borrow a:Arr u8 _, borrow b:Arr u8 _) -> CgState
  = if s.runtime then cg_ins(s,n_t_i64(),concat(op," i64 ",a,", ",b)) else cg_checked_arithmetic(s,op,a,b)

fn cg_binary(move s:CgState, op:i64, borrow a:CgValue, borrow b:CgValue) -> CgState
  = let float=a.ty==n_t_f64() in
    if op>=24 && op<=28 then
      let word=if op==24 then "add" else if op==25 then "sub" else if op==26 then "mul" else if op==27 then "div" else "rem" in
      if float then cg_ins(s,a.ty,concat("f",word," ",cg_typed(a),", ",b.operand))
      else if op<=26 then cg_integer_arithmetic(s,word,a.operand,b.operand)
      else if s.runtime then cg_ins(s,a.ty,concat("s",word," ",cg_typed(a),", ",b.operand))
      else let s=cg_ins(s,n_t_bool(),concat("icmp eq i64 ",a.operand,", -9223372036854775808")) in let minimum=s.value.operand in
        let s=cg_ins(s,n_t_bool(),concat("icmp eq i64 ",b.operand,", -1")) in
        let s=cg_ins(s,n_t_bool(),concat("and i1 ",minimum,", ",s.value.operand)) in
        let s=cg_arithmetic_guard(s,"integer division overflow") in cg_ins(s,a.ty,concat("s",word," ",cg_typed(a),", ",b.operand))
    else
      let prefix=if float then "o" else if a.ty==n_t_u8() || a.ty==n_t_u16() then "u" else "s" in
      let predicate=if op==6 then (if float then "oeq" else "eq") else if op==7 then (if float then "une" else "ne")
        else concat(prefix,if op==8 then "le" else if op==9 then "ge" else if op==22 then "lt" else "gt") in
      cg_ins(s,n_t_bool(),concat(if float then "fcmp " else "icmp ",predicate," ",cg_typed(a),", ",b.operand))

fn cg_cast(move s:CgState, to:i64, borrow value:CgValue) -> CgState
  = if value.ty==n_t_f64() then
      let s=cg_ins(s,n_t_bool(),concat("fcmp oge double ",value.operand,", 0xC3E0000000000000")) in let low=s.value.operand in
      let s=cg_ins(s,n_t_bool(),concat("fcmp olt double ",value.operand,", 0x43E0000000000000")) in
      let s=cg_ins(s,n_t_bool(),concat("and i1 ",low,", ",s.value.operand)) in
      let s=cg_ins(s,n_t_bool(),concat("xor i1 ",s.value.operand,", true")) in
      cg_ins(cg_arithmetic_guard(s,"float to integer out of range"),to,concat("fptosi ",cg_typed(value)," to i64"))
    else let op=if to==n_t_f64() then "sitofp" else if to!=n_t_i64() then "trunc" else if value.ty==n_t_i32() then "sext" else "zext" in
    cg_ins(s,to,concat(op," ",cg_typed(value)," to ",cg_type(to)))

fn cg_phi(move s:CgState, borrow yes:CgValue, yes_block:i64, borrow no:CgValue, no_block:i64) -> CgState
  = if yes.ty==n_t_unit() then s with { value=cg_unit() }
    else cg_ins_value(s,yes,concat("phi ",cg_type_of(yes)," [ ",yes.operand,", %",cg_label(yes_block),
      " ], [ ",no.operand,", %",cg_label(no_block)," ]"))

; The other branch of an `if` handed these bindings, or fields of them, on
; (see cg_plan and cg_parts), so the branch that ends here releases them, once
; its value no longer views them.
fn cg_branch_drops(borrow m:Mods, borrow env:Arr CgBinding _, move s:CgState, branch:i64) -> CgState
  = loop (i=0, out=s) while i<len(env)
      next (i+1,let binding=cg_binding(env,i) in
        let whole=if cg_listed(binding.moves,-1-branch) then cg_release_rest(m,cg_own_view(out),binding.value,binding.parts,branch) else out in
        if !cg_part_listed(binding.parts,-1-branch) then whole else
        let viewed=cg_own_view(whole) in let result=viewed.value in
        let fields=md_node(m,binding.value.record).b in
        loop (k=0, code=viewed) while k+2<len(binding.parts)
          next (k+3,if tx_at(binding.parts,k+2)!= -1-branch then code else
            let index=tx_at(binding.parts,k+1) in
            let got=cg_field_get(code,binding.value,cg_field_type(m,fields,index),index) in
            cg_release(got,got.value) with { value=result }) yield code) yield out

fn cg_if(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, n:Node) -> CgState
  = let s=cg_expr(m,fns,env,s,n.a) in if s.error>=0 then s else
    let yes=s.serial in let no=yes+1 in let join=no+1 in let cond=s.value.operand in
    let s=cg_branch(s with { serial=join+1 },cond,yes,no) in
    let s=cg_expr(m,fns,env,cg_block(s,yes),n.b) in if s.error>=0 then s else
    let s=cg_branch_drops(m,env,s,n.b) in
    let left=s.value in let left_block=s.block in
    let s=cg_expr(m,fns,env,cg_block(cg_jump(s,join),no),n.c) in if s.error>=0 then s else
    let s=cg_branch_drops(m,env,s,n.c) in
    let right=s.value in let right_block=s.block in
    cg_phi(cg_block(cg_jump(s,join),join),left,left_block,right,right_block)

; Else-if chains over one scalar lower to an LLVM switch, as neoc/llvm.py
; does: each test compares a variable or a field path of one (i64, u8 or u16)
; with constants, joined by ||, and the chain has at least four distinct
; values (a match on an enum's tag is such a chain). No binder sits between
; the tests, so equal paths are the same binding, read once and without a
; trap. A value an earlier arm tested is dead, and so is an arm without new
; values. The chain ends at the first test of anything else, which is lowered
; as usual in the default arm.
; ifs: the chain's `if` nodes; values and arms: each case and the index of the
; `if` whose branch it selects; fallback: the else branch of the last `if`.
type CgChain = { scrutinee:i64, ifs:Arr i64 _, values:Arr i64 _, arms:Arr i64 _, fallback:i64 }
type CgCases = { scrutinee:i64, values:Arr i64 _, ok:bool }
fn cg_no_cases() -> CgCases = CgCases { scrutinee=-1, values=tx_ints(), ok=false }
; The integer value of an i64 or byte literal, or of a u16 cast of one.
fn cg_case_constant(borrow m:Mods, id:i64) -> CgCases
  = let n=md_node(m,id) in
    if n.kind==n_num() && n.b!=1 then CgCases { scrutinee=-1, values=push(tx_ints(),n.a), ok=true }
    else if n.kind==n_byte() then CgCases { scrutinee=-1, values=push(tx_ints(),n.a), ok=true }
    else if n.kind==n_cast() && md_node(m,n.a).kind==n_t_u16() && md_node(m,n.b).kind==n_num() && md_node(m,n.b).b!=1 then
      CgCases { scrutinee=-1, values=push(tx_ints(),bit_and(md_node(m,n.b).a,65535)), ok=true }
    else cg_no_cases()
; The type of a variable or field path read from env, or unit.
fn cg_path_type(borrow m:Mods, borrow env:Arr CgBinding _, id:i64) -> CgValue
  = let n=md_node(m,id) in
    if n.kind==n_var() then cg_lookup(m,env,n.a)
    else if n.kind!=n_field() then cg_unit() else
    let base=cg_path_type(m,env,n.a) in if base.ty!=n_t_rec() || base.record<0 then cg_unit() else
    let fields=md_node(m,base.record).b in let index=cg_field_index(m,fields,n.b) in
    if index<0 then cg_unit() else cg_field_type(m,fields,index)
fn cg_case_test(borrow m:Mods, borrow env:Arr CgBinding _, x:i64, k:i64, scrutinee:i64) -> CgCases
  = let constant=cg_case_constant(m,k) in let ty=cg_path_type(m,env,x).ty in
    if !constant.ok || cg_path_root(m,x)<0 || !(ty==n_t_i64() || ty==n_t_u8() || ty==n_t_u16()) then cg_no_cases()
    else if scrutinee>=0 && !cg_same_path(m,x,scrutinee) then cg_no_cases()
    else constant with { scrutinee=x }
; (x, constants) when cond is x == k1 || x == k2 ... over the scrutinee (any
; variable or field path when scrutinee is -1).
fn cg_case_values(borrow m:Mods, borrow env:Arr CgBinding _, cond:i64, scrutinee:i64) -> CgCases
  = let n=md_node(m,cond) in
    if n.kind==n_bin() && n.a==11 then
      let left=cg_case_values(m,env,n.b,scrutinee) in if !left.ok then left else
      let right=cg_case_values(m,env,n.c,left.scrutinee) in if !right.ok then right else
      left with { values=cg_joined(left.values,right.values) }
    else if n.kind!=n_bin() || n.a!=6 then cg_no_cases() else
    let direct=cg_case_test(m,env,n.b,n.c,scrutinee) in if direct.ok then direct else cg_case_test(m,env,n.c,n.b,scrutinee)
type CgChainScan = { chain:CgChain, node:i64, done:bool }
fn cg_switch_chain(borrow m:Mods, borrow env:Arr CgBinding _, id:i64) -> CgChain
  = let start=CgChain { scrutinee=-1, ifs=tx_ints(), values=tx_ints(), arms=tx_ints(), fallback=-1 } in
    let scan=loop (c=CgChainScan { chain=start, node=id, done=false }) while !c.done
      next (let n=md_node(m,c.node) in let found=if n.kind==n_if() then cg_case_values(m,env,n.a,c.chain.scrutinee) else cg_no_cases() in
        if !found.ok then c with { done=true } else
        let arm=len(c.chain.ifs) in
        let added=loop (i=0, out=c.chain) while i<len(found.values)
          next (i+1,let value=tx_at(found.values,i) in if cg_listed(out.values,value) then out
            else out with { values=push(out.values,value), arms=push(out.arms,arm) }) yield out in
        CgChainScan { chain=added with { scrutinee=found.scrutinee, ifs=push(added.ifs,c.node), fallback=n.c }, node=n.c, done=false }) yield c in
    scan.chain
; A case value as an LLVM literal of the scrutinee's width (signed).
fn cg_case_literal(value:i64, ty:i64) -> Arr u8 _
  = let bits=if ty==n_t_u8() then 256 else if ty==n_t_u16() then 65536 else 0 in
    if bits==0 then int_text(value) else
    let low=bit_and(value,bits-1) in int_text(if low>=bits/2 then low-bits else low)
type CgArms = { state:CgState, values:Arr CgValue _, blocks:Arr i64 _ }
; The bindings an arm's path leaves: its own branch, then the else branch of
; each enclosing `if` of the chain, innermost first (as nested ifs would).
fn cg_arm_drops(borrow m:Mods, borrow env:Arr CgBinding _, move s:CgState, borrow chain:CgChain, branch:i64, depth:i64) -> CgState
  = let s=cg_branch_drops(m,env,s,branch) in
    loop (j=depth, code=s) while j>=1 next (j-1,cg_branch_drops(m,env,code,tx_at(chain.ifs,j))) yield code
fn cg_switch(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, n:Node, borrow chain:CgChain) -> CgState
  = let s=cg_expr(m,fns,env,s,chain.scrutinee) in if s.error>=0 then s else
    let x=s.value in let count=len(chain.ifs) in let first=s.serial in let other=first+count in let join=other+1 in
    let live=loop (k=0, arms=0) while k<count next (k+1,if cg_listed(chain.arms,k) then arms+1 else arms) yield arms in
    let cases=loop (i=0, text=tx_empty()) while i<len(chain.values)
      next (i+1,concat(text," ",cg_type_of(x)," ",cg_case_literal(tx_at(chain.values,i),x.ty),
        ", label %",cg_label(first+tx_at(chain.arms,i)))) yield text in
    let s=cg_write(s with { serial=join+1 },concat("  switch ",cg_typed(x),", label %",cg_label(other)," [",cases,
      " ] ; neo.switch ",int_text(n.line),":",int_text(n.col)," cases ",int_text(len(chain.values))," arms ",int_text(live+1),"\n")) in
    let arms=loop (k=0, a=CgArms { state=s, values=arr(j in 0..0) cg_unit(), blocks=tx_ints() }) while a.state.error<0 && k<=count
      next (k+1,if k<count && !cg_listed(chain.arms,k) then a else
        let branch=if k<count then md_node(m,tx_at(chain.ifs,k)).b else chain.fallback in
        let lowered=cg_expr(m,fns,env,cg_block(a.state,first+k),branch) in if lowered.error>=0 then a with { state=lowered } else
        let ended=cg_arm_drops(m,env,lowered,chain,branch,if k<count then k else count-1) in
        CgArms { state=cg_jump(ended,join), values=push(a.values,ended.value), blocks=push(a.blocks,ended.block) }) yield a in
    if arms.state.error>=0 then arms.state else
    let s=cg_block(arms.state,join) in let result=cg_arg(arms.values,0) in
    if result.ty==n_t_unit() then s with { value=cg_unit() } else
    let incoming=loop (i=0, text=tx_empty()) while i<len(arms.values)
      next (i+1,concat(text,if i==0 then "" else ", ","[ ",cg_arg(arms.values,i).operand,", %",cg_label(tx_at(arms.blocks,i))," ]")) yield text in
    cg_ins_value(s,result,concat("phi ",cg_type_of(result)," ",incoming))

fn cg_short_circuit(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, n:Node) -> CgState
  = let left=s.value in let left_block=s.block in let rhs=s.serial in let join=rhs+1 in
    let s=if n.a==10 then cg_branch(s with { serial=join+1 },left.operand,rhs,join)
      else cg_branch(s with { serial=join+1 },left.operand,join,rhs) in
    let s=cg_expr(m,fns,env,cg_block(s,rhs),n.c) in if s.error>=0 then s else
    let right=s.value in let right_block=s.block in
    cg_phi(cg_block(cg_jump(s,join),join),left,left_block,right,right_block)

type CgArgs = { state:CgState, values:Arr CgValue _ }
fn cg_arg(borrow values:Arr CgValue _, i:i64) -> CgValue
  = if i>=0 && i<len(values) then values[i] else cg_unit()
fn cg_arguments(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, list:i64, keep:bool) -> CgArgs
  = loop (i=0, a=CgArgs { state=s, values=arr(j in 0..0) cg_unit() }) while a.state.error<0 && i<ast_list_len(m.ast,list)
      next (i+1, let lowered=cg_expr(m,fns,env,a.state,ast_list_at(m.ast,list,i)) in
        let lowered=if keep && lowered.error<0 then cg_own_view(lowered) else lowered in
        CgArgs { state=lowered, values=push(a.values,lowered.value) }) yield a
fn cg_arg_text(borrow values:Arr CgValue _) -> Arr u8 _
  = loop (i=0, out=tx_empty()) while i<len(values)
      next (i+1,concat(out,if i==0 then "" else ", ",cg_typed(cg_arg(values,i)))) yield out

; Operands that are only read: a lexical binding lends its reference for the
; operation, and only a temporary (owned=1) has to be released afterwards.
; A binding keeps its reference to the end of its scope unless a planned last
; use takes it, which cg_plan never allows while an earlier operand borrows it.
type CgReads = { state:CgState, values:Arr CgValue _, owned:Arr i64 _ }
; The parts of a concat: the first is taken when this is its binding's last
; use (see cg_plan_call), the others are observed.
fn cg_read_arguments(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, list:i64) -> CgReads
  = loop (i=0, a=CgReads { state=s, values=arr(j in 0..0) cg_unit(), owned=tx_ints() })
      while a.state.error<0 && i<ast_list_len(m.ast,list)
      next (i+1,let id=ast_list_at(m.ast,list,i) in let n=md_node(m,id) in
        let taken=i==0 && n.kind==n_var() && cg_listed(cg_binding(env,cg_binding_index(m,env,n.a)).moves,id) in
        let read=if taken then CgRead { state=cg_expr(m,fns,env,a.state,id),borrowed=false } else cg_read(m,fns,env,a.state,id) in
        CgReads { state=read.state, values=push(a.values,read.state.value), owned=push(a.owned,if read.borrowed then 0 else 1) }) yield a
fn cg_release_owned(move s:CgState, borrow values:Arr CgValue _, borrow owned:Arr i64 _) -> CgState
  = loop (i=0, out=s) while i<len(values)
      next (i+1,if tx_at(owned,i)!=0 then cg_release(out,cg_arg(values,i)) else out) yield out

type CgCopy = { state:CgState, offset:Arr u8 _ }
; Copies the parts from index first on into target at offset start and
; releases those this concat owns.
fn cg_concat_parts(move s:CgState, borrow values:Arr CgValue _, borrow owned:Arr i64 _, borrow target:CgValue,
                   first:i64, borrow start:Arr u8 _) -> CgState
  = loop (i=first, copy=CgCopy { state=s, offset=start }) while i<len(values)
      next (i+1, let part=cg_arg(values,i) in let measured=cg_extract(copy.state,part,1,n_t_i64()) in
        let length=measured.value.operand in let copied=cg_copy_array(measured,part,target,copy.offset,length) in
        let released=if tx_at(owned,i)!=0 then cg_release(copied,part) else copied in
        let advanced=cg_ins(released,n_t_i64(),concat("add i64 ",copy.offset,", ",length)) in
        CgCopy { state=advanced, offset=advanced.value.operand }) yield copy.state
fn cg_concat_copy(move s:CgState, borrow values:Arr CgValue _, borrow owned:Arr i64 _, borrow total:Arr u8 _) -> CgState
  = let s=cg_array_allocate(s,cg_element(cg_arg(values,0)),total) in let result=s.value in
    cg_concat_parts(s,values,owned,result,0,"0") with { value=result }
; grow: the first part is a value of this concat's own (a temporary or a
; binding's last use). When it holds the only reference to a byte buffer with
; room for the whole text, the other parts are written after its end, so text
; built by repeated concat grows in amortised linear time. Parts that share
; that buffer hold references of their own, which rules the case out.
fn cg_concat(move s:CgState, borrow values:Arr CgValue _, borrow owned:Arr i64 _, grow:bool) -> CgState
  = let lengths=loop (i=0, copy=CgCopy { state=s, offset="0" }) while i<len(values)
      next (i+1, let part=cg_extract(copy.state,cg_arg(values,i),1,n_t_i64()) in
        let total=cg_checked_arithmetic(part,"add",copy.offset,part.value.operand) in
        CgCopy { state=total, offset=total.value.operand }) yield copy in
    let total=lengths.offset in let first=cg_arg(values,0) in let element=cg_element(first) in
    if !grow || len(values)<2 || cg_managed(element) || cg_width(element.ty)!=1 then cg_concat_copy(lengths.state,values,owned,total) else
    let tested=cg_ins(lengths.state,n_t_bool(),concat("call i1 @neo_spare(",cg_typed(first),", i64 ",total,", i64 0)")) in
    let direct=tested.serial in let copy=direct+1 in let done=copy+1 in
    let s=cg_block(cg_branch(tested with { serial=done+1 },tested.value.operand,direct,copy),direct) in
    let s=cg_extract(s,first,1,n_t_i64()) in
    let s=cg_concat_parts(s,values,owned,first,1,s.value.operand) in
    let s=cg_ins_value(s,first,concat("insertvalue ",cg_typed(first),", i64 ",total,", 1")) in
    let updated=s.value in let direct_end=s.block in
    let s=cg_concat_copy(cg_block(cg_jump(s,done),copy),values,owned,total) in let result=s.value in let copy_end=s.block in
    cg_phi(cg_block(cg_jump(s,done),done),updated,direct_end,result,copy_end)

; Whether expression id always yields the only reference to its buffer: a
; new array, or the result of an operation that updates a unique operand in
; place and otherwise copies it. Nothing needs to test such an operand.
fn cg_fresh(borrow m:Mods, id:i64) -> bool
  = let n=md_node(m,id) in
    if n.kind==n_arrc() then !cg_range_empty(m,n)
    else n.kind==n_call() && str_find(" set push byte_copy byte_write_le concat byte_uninit ",concat(" ",md_str(m,n.a)," ")).present
; A comprehension over a literal empty range, the usual spelling of an empty array.
fn cg_range_empty(borrow m:Mods, n:Node) -> bool
  = let lo=md_node(m,n.b) in let hi=md_node(m,n.c) in lo.kind==n_num() && hi.kind==n_num() && hi.a<=lo.a

; push and set consume their array operand. When that operand holds the only
; reference to its buffer (a temporary: any binding or field that also named
; it would own a reference of its own), the buffer is updated in place; push
; additionally needs the block's spare capacity. Otherwise the result is a
; fresh copy, whose size class leaves room for the following pushes.
; fresh: the operand is known to be unique (cg_fresh), so set needs no test.
fn cg_array_edit(move s:CgState, borrow values:Arr CgValue _, append:bool, fresh:bool) -> CgState
  = let original=cg_arg(values,0) in let element=cg_element(original) in
    let s=cg_extract(s,original,1,n_t_i64()) in let length=s.value.operand in
    let s=if append then cg_checked_arithmetic(s,"add",length,"1") else s in let size=s.value.operand in
    let prepared=cg_own_view(s with { value=cg_arg(values,if append then 1 else 2) }) in let value=prepared.value in
    let index=if append then cg_value(n_t_i64(),length) else cg_arg(values,1) in
    if fresh && !append then
      let s=if !cg_managed(value) then prepared else let old=cg_load_element(prepared,original,index) in cg_release(old,old.value) in
      cg_store_element(s,original,index.operand,value) with { value=original } else
    let tested=if !append then cg_ins(prepared,n_t_bool(),concat("call i1 @neo_unique(",cg_typed(original),")")) else
      let bytes=cg_byte_count(prepared,element,size) in
      cg_ins(bytes,n_t_bool(),concat("call i1 @neo_spare(",cg_typed(original),", i64 ",bytes.value.operand,
        ", i64 ",if cg_managed(element) then "32" else "0",")")) in
    let direct=tested.serial in let copy=direct+1 in let done=copy+1 in
    let s=cg_block(cg_branch(tested with { serial=done+1 },tested.value.operand,direct,copy),direct) in
    let s=if append || !cg_managed(value) then s else let old=cg_load_element(s,original,index) in cg_release(old,old.value) in
    let s=cg_store_element(s,original,index.operand,value) in
    let s=if !append then s with { value=original } else
      ; An aggregate block records its element count for the final release.
      let s=if !cg_managed(element) then s else
        let data=cg_extract(s,original,0,n_t_ptr()) in let slot=cg_offset(data,"i8",data.value.operand,"-16") in
        cg_write(slot,concat("  store i64 ",size,", ptr ",slot.value.operand,", align 8\n")) in
      cg_ins_value(s,original,concat("insertvalue ",cg_typed(original),", i64 ",size,", 1")) in
    let updated=s.value in let direct_end=s.block in
    let s=cg_array_allocate(cg_block(cg_jump(s,done),copy),element,size) in let result=s.value in
    let s=cg_copy_array(s,original,result,"0",length) in
    let s=if append || !cg_managed(value) then s else let old=cg_load_element(s,result,index) in cg_release(old,old.value) in
    let s=cg_release(cg_store_element(s,result,index.operand,value),original) in let copy_end=s.block in
    cg_phi(cg_block(cg_jump(s,done),done),updated,direct_end,result,copy_end)

fn cg_byte_bounds(move s:CgState, borrow offset:Arr u8 _, borrow limit:Arr u8 _, borrow message:Arr u8 _) -> CgState
  = let s=cg_ins(s,n_t_bool(),concat("icmp slt i64 ",offset,", 0")) in let low=s.value.operand in
    let s=cg_ins(s,n_t_bool(),concat("icmp sgt i64 ",offset,", ",limit)) in
    let s=cg_ins(s,n_t_bool(),concat("or i1 ",low,", ",s.value.operand)) in cg_arithmetic_guard(s,message)

fn cg_byte_read(move s:CgState, borrow bytes:CgValue, borrow offset:Arr u8 _, borrow width:Arr u8 _, owned:bool) -> CgState
  = let s=cg_ins(s,n_t_i64(),concat("sub i64 ",width,", 1")) in let before=s.value.operand in
    let s=cg_ins(s,n_t_i64(),concat("and i64 ",width,", ",before)) in
    let s=cg_ins(s,n_t_bool(),concat("icmp ne i64 ",s.value.operand,", 0")) in let uneven=s.value.operand in
    let s=cg_ins(s,n_t_bool(),concat("icmp ugt i64 ",before,", 7")) in
    let s=cg_ins(s,n_t_bool(),concat("or i1 ",uneven,", ",s.value.operand)) in
    let s=cg_arithmetic_guard(s,"byte read width") in
    let s=cg_extract(s,bytes,1,n_t_i64()) in
    let s=cg_ins(s,n_t_i64(),concat("sub i64 ",s.value.operand,", ",width)) in
    let s=cg_byte_bounds(s,offset,s.value.operand,"byte read bounds") in
    let s=cg_extract(s,bytes,0,n_t_ptr()) in let s=cg_offset(s,"i8",s.value.operand,offset) in
    let loaded=if tx_equal(width,"8") then
      cg_ins(s,n_t_i64(),concat("load i64, ptr ",s.value.operand,", align 1"))
    else if tx_equal(width,"4") then
      let word=cg_ins(s,n_t_i32(),concat("load i32, ptr ",s.value.operand,", align 1")) in
      cg_ins(word,n_t_i64(),concat("zext i32 ",word.value.operand," to i64"))
    else cg_ins(s,n_t_i64(),concat("call i64 @neo.bytes.read(ptr ",s.value.operand,", i64 ",width,")")) in
    if owned then cg_release(loaded,bytes) else loaded

; byte_copy and byte_write_le consume the buffer they write to, like set: a
; unique buffer is written in place and any other is copied first. An operand
; that shares the buffer holds a reference of its own, so it is never unique.
; The result names the buffer to write: the original, or its copy.
fn cg_byte_target(move s:CgState, borrow original:CgValue, borrow length:Arr u8 _, fresh:bool) -> CgState
  = if fresh then s with { value=original } else
    let tested=cg_ins(s,n_t_bool(),concat("call i1 @neo_unique(",cg_typed(original),")")) in
    let direct=tested.block in let copy=tested.serial in let done=copy+1 in
    let s=cg_block(cg_branch(tested with { serial=done+1 },tested.value.operand,done,copy),copy) in
    let s=cg_array_allocate(s,cg_element(original),length) in let result=s.value in
    let s=cg_release(cg_copy_array(s,original,result,"0",length),original) in let copy_end=s.block in
    cg_phi(cg_block(cg_jump(s,done),done),original,direct,result,copy_end)

fn cg_byte_copy(move s:CgState, borrow original:CgValue, borrow offset:Arr u8 _, borrow source:CgValue, fresh:bool) -> CgState
  = let s=cg_extract(s,original,1,n_t_i64()) in let length=s.value.operand in
    let s=cg_extract(s,source,1,n_t_i64()) in let count=s.value.operand in
    let s=cg_ins(s,n_t_i64(),concat("sub i64 ",length,", ",count)) in
    let s=cg_byte_bounds(s,offset,s.value.operand,"byte write bounds") in
    let s=cg_byte_target(s,original,length,fresh) in let result=s.value in
    cg_release(cg_copy_array(s,source,result,offset,count),source) with { value=result }

fn cg_byte_write(move s:CgState, borrow original:CgValue, borrow offset:Arr u8 _, borrow number:Arr u8 _, borrow width:Arr u8 _, fresh:bool) -> CgState
  = let s=cg_ins(s,n_t_bool(),concat("icmp ugt i64 ",width,", 8")) in
    let s=cg_arithmetic_guard(s,"byte write width") in
    let s=cg_extract(s,original,1,n_t_i64()) in let length=s.value.operand in
    let s=cg_ins(s,n_t_i64(),concat("sub i64 ",length,", ",width)) in
    let s=cg_byte_bounds(s,offset,s.value.operand,"byte write bounds") in
    let s=cg_byte_target(s,original,length,fresh) in let result=s.value in
    let s=cg_extract(s,result,0,n_t_ptr()) in let s=cg_offset(s,"i8",s.value.operand,offset) in
    cg_write(s,concat("  call void @neo.bytes.write(ptr ",s.value.operand,", i64 ",number,", i64 ",width,")\n")) with { value=result }

fn cg_byte_slice(move s:CgState, borrow bytes:CgValue, borrow lo:Arr u8 _, borrow hi:Arr u8 _) -> CgState
  = let s=cg_extract(s,bytes,1,n_t_i64()) in let length=s.value.operand in
    let s=cg_ins(s,n_t_bool(),concat("icmp sgt i64 ",hi,", ",length)) in
    let s=cg_arithmetic_guard(s,"byte slice bounds") in let s=cg_byte_bounds(s,lo,hi,"byte slice bounds") in
    let s=cg_ins(s,n_t_i64(),concat("sub i64 ",hi,", ",lo)) in let size=s.value.operand in
    let s=cg_ins(s,n_t_bool(),concat("icmp eq i64 ",size,", 0")) in
    let empty=s.serial in let nonempty=empty+1 in let done=nonempty+1 in
    let s=cg_branch(s with { serial=done+1 },s.value.operand,empty,nonempty) in
    let s=cg_jump(cg_release(cg_block(s,empty),bytes),done) in
    let s=cg_extract(cg_block(s,nonempty),bytes,0,n_t_ptr()) in
    let s=cg_offset(s,"i8",s.value.operand,lo) in
    let s=cg_ins_value(s,bytes,concat("insertvalue ",cg_typed(bytes),", ",cg_typed(s.value),", 0")) in
    let s=cg_ins_value(s,bytes,concat("insertvalue ",cg_typed(s.value),", i64 ",size,", 1")) in
    cg_phi(cg_block(cg_jump(s,done),done),bytes with { operand="zeroinitializer" },empty,s.value,nonempty)

fn cg_byte_builtin(move s:CgState, borrow name:Arr u8 _, borrow values:Arr CgValue _, fresh:bool) -> CgState
  = let first=cg_arg(values,0) in let second=cg_arg(values,1) in let third=cg_arg(values,2) in
    if tx_equal(name,"byte_read_le") then cg_byte_read(s,first,second.operand,third.operand,true)
    else if tx_equal(name,"byte_copy") then cg_byte_copy(s,first,second.operand,third,fresh)
    else if tx_equal(name,"byte_write_le") then cg_byte_write(s,first,second.operand,third.operand,cg_arg(values,3).operand,fresh)
    else cg_byte_slice(s,first,second.operand,third.operand)

fn cg_syscall(move s:CgState, borrow values:Arr CgValue _, fork:bool, id:i64) -> CgState
  = if len(s.target)==0 then s with { error=id } else
    let arm=str_starts(s.target,"arm64-") || str_starts(s.target,"aarch64-") in
    let darwin=str_find(s.target,"-apple-").present in
    ; Darwin returns the child indicator in x1. Linux ARM64 implements
    ; fork with clone(SIGCHLD) and a null child stack.
    let code=if darwin && fork then "svc #0x80\\0Ab.cs 1f\\0Acbz x1, 2f\\0Amov x0, #0\\0Ab 2f\\0A1: neg x0, x0\\0A2:"
      else if darwin then "svc #0x80\\0Acneg x0, x0, cs" else if arm then "svc #0" else "syscall" in
    let args=if !fork then values else
      let number=if darwin then "2" else if arm then "220" else "57" in
      arr(i in 0..7) cg_value(n_t_i64(),if i==0 then number else if i==1 && arm && !darwin then "17" else "0") in
    let constraints=if darwin then "={x0},={x1},0,1,{x2},{x3},{x4},{x5},{x16},~{memory},~{cc}"
      else if arm then "={x0},0,{x1},{x2},{x3},{x4},{x5},{x8},~{memory},~{cc}"
      else "={rax},{rdi},{rsi},{rdx},{r10},{r8},{r9},{rax},~{rcx},~{r11},~{memory},~{cc}" in
    let operands=loop (i=1, out=tx_empty()) while i<7
      next (i+1,concat(out,cg_typed(cg_arg(args,i)),", ")) yield out in
    let result=cg_ins(s,n_t_i64(),concat("call ",if darwin then "{ i64, i64 }" else "i64", " asm sideeffect \"",code,
      "\", \"",constraints,"\"(",operands,cg_typed(cg_arg(args,0)),")")) in
    if darwin then cg_ins(result,n_t_i64(),concat("extractvalue { i64, i64 } ",result.value.operand,", 0")) else result

fn cg_byte_view(move s:CgState, borrow data:CgValue, borrow size:CgValue) -> CgState
  = let s=cg_ins(s,n_t_arr(),concat("insertvalue %ax_arr zeroinitializer, ",cg_typed(data),", 0")) in
    cg_ins_value(s,cg_array_value(cg_value(n_t_u8(),""),""),concat("insertvalue ",cg_typed(s.value),", ",cg_typed(size),", 1"))

fn cg_intrinsic(move s:CgState, borrow name:Arr u8 _, borrow values:Arr CgValue _, result:i64, id:i64) -> CgState
  = let a=cg_arg(values,0) in let b=cg_arg(values,1) in
    if str_starts(name,"wrapping_") || str_starts(name,"bit_") then
      let start=if str_starts(name,"bit_") then 4 else 9 in
      cg_ins(s,result,concat(pt_slice(name,start,len(name))," ",cg_typed(a),", ",b.operand))
    else if tx_equal(name,"mul_high") then
      let s=cg_ins(s,0,concat("zext ",cg_typed(a)," to i128")) in let left=s.value.operand in
      let s=cg_ins(s,0,concat("zext ",cg_typed(b)," to i128")) in
      let s=cg_ins(s,0,concat("mul i128 ",left,", ",s.value.operand)) in
      let s=cg_ins(s,0,concat("lshr i128 ",s.value.operand,", 64")) in cg_ins(s,result,concat("trunc i128 ",s.value.operand," to i64"))
    else if tx_equal(name,"shift_left") || tx_equal(name,"shift_right") || tx_equal(name,"arithmetic_shift_right") then
      let op=if tx_equal(name,"shift_left") then "shl" else if tx_equal(name,"shift_right") then "lshr" else "ashr" in
      let s=cg_ins(s,n_t_i64(),concat("and ",cg_typed(b),", 63")) in cg_ins(s,result,concat(op," ",cg_typed(a),", ",s.value.operand))
    else if tx_equal(name,"byte_swap64") then cg_ins(s,result,concat("call i64 @llvm.bswap.i64(",cg_typed(a),")"))
    else if tx_equal(name,"count_trailing_zeros") then cg_ins(s,result,concat("call i64 @llvm.cttz.i64(",cg_typed(a),", i1 false)"))
    else if tx_equal(name,"sqrt") then cg_ins(s,result,concat("call double @llvm.sqrt.f64(",cg_typed(a),")"))
    else if tx_equal(name,"float_bits") || tx_equal(name,"bits_float") then cg_ins(s,result,concat("bitcast ",cg_typed(a)," to ",cg_type(result)))
    else if tx_equal(name,"ptr_to_i64") || tx_equal(name,"ptr_from_i64") then
      cg_ins(s,result,concat(if result==n_t_i64() then "ptrtoint " else "inttoptr ",cg_typed(a)," to ",cg_type(result)))
    else if tx_equal(name,"stack_alloc") then cg_ins(s,result,concat("alloca i8, ",cg_typed(a),", align 16"))
    else if tx_equal(name,"runtime_state") then s with { value=cg_value(n_t_ptr(),"@ax_runtime_state") }
    else if tx_equal(name,"aes_hardware") then cg_ins(s,result,"call i1 @neo_crypto_hardware()")
    else if bi_crypto(name) then cg_ins(s,result,concat("call i64 @neo_crypto_",name,"(",cg_arg_text(values),")"))
    else if tx_equal(name,"allocation_stats_enabled") then cg_ins(s,result,"load i1, ptr @ax_native_alloc_stats, align 1")
    else if tx_equal(name,"counter_ticks") || tx_equal(name,"counter_frequency") then
      if !str_starts(s.target,"arm64-") && !str_starts(s.target,"aarch64-") then s with { error=id } else
      let instruction=if tx_equal(name,"counter_ticks") then "isb\\0Amrs $0, cntvct_el0" else "mrs $0, cntfrq_el0" in
      cg_ins(s,result,concat("call i64 asm sideeffect \"",instruction,"\", \"=r,~{memory}\"()"))
    else if str_starts(name,"invoke_") then
      let params=if len(values)==2 then cg_typed(b) else concat(cg_typed(b),", ",cg_typed(cg_arg(values,2))) in
      if result==n_t_unit() then cg_write(s with { value=cg_unit() },concat("  call void ",a.operand,"(",params,")\n")) else
      cg_ins(s,result,concat("call ",cg_type(result)," ",a.operand,"(",params,")"))
    else if tx_equal(name,"syscall6") || tx_equal(name,"fork_syscall") then cg_syscall(s,values,tx_equal(name,"fork_syscall"),id)
    else if tx_equal(name,"spawn_thread") then
      if !str_find(s.target,"-linux").present then s with { error=id } else
      cg_ins(cg_write(s,"  store i64 1, ptr @neo_threads, align 8\n"),result,concat("call i64 @neo_spawn_thread(",cg_arg_text(values),")"))
    else if tx_equal(name,"fiber_swap") || tx_equal(name,"fiber_init") then
      if len(s.target)==0 then s with { error=id } else
      cg_write(s with { value=cg_unit() },concat("  call void @neo_",name,"(",cg_arg_text(values),")\n"))
    else if tx_equal(name,"handler_call") then
      let view=cg_byte_view(s,b,cg_arg(values,2)) in
      cg_ins_value(view,view.value,concat("call %ax_arr ",a.operand,"(",cg_typed(view.value),")"))
    else let s=cg_offset(s,"i8",a.operand,b.operand) in let address=s.value.operand in
      let volatile=if str_starts(name,"volatile_") then "volatile " else "" in
      if tx_equal(name,"ptr_add") then s
      else if str_starts(name,"atomic_") then cg_atomic(s,name,values,result,address)
      else if bi_load(name) then cg_ins(s,result,concat("load ",volatile,cg_type(result),", ptr ",address,", align 1"))
      else if bi_store(name) then cg_write(s with { value=cg_unit() },concat("  store ",volatile,cg_typed(cg_arg(values,2)),", ptr ",address,", align 1\n"))
      else s with { error=id }

fn cg_atomic(move s:CgState, borrow name:Arr u8 _, borrow values:Arr CgValue _, result:i64, borrow address:Arr u8 _) -> CgState
  = let width=if bi_memory_type(name)==n_t_i32() then "4" else "8" in
    let value=cg_arg(values,2) in
    if str_starts(name,"atomic_load_") then cg_ins(s,result,concat("load atomic ",cg_type(result),", ptr ",address," acquire, align ",width))
    else if str_starts(name,"atomic_store_") then
      cg_write(s with { value=cg_unit() },concat("  store atomic ",cg_typed(value),", ptr ",address," release, align ",width,"\n"))
    else let pair=cg_ins(s,0,concat("cmpxchg ptr ",address,", ",cg_typed(value),", ",cg_typed(cg_arg(values,3))," acq_rel acquire, align 8")) in
      cg_ins(pair,result,concat("extractvalue { i64, i1 } ",pair.value.operand,", 0"))

fn cg_indirect(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, n:Node,
               borrow callback:CgValue) -> CgState
  = let signature=md_node(m,callback.record) in let result=cg_declaration(m,signature.b) in
    let args=cg_arguments(m,fns,env,s,n.b,false) in if args.state.error>=0 then args.state else
    let s=cg_ins(args.state,n_t_bool(),concat("icmp eq ptr ",callback.operand,", null")) in
    let s=cg_arithmetic_guard(s,"inactive callback") in
    let call=concat("call ",cg_return(result)," ",callback.operand,"(",cg_arg_text(args.values),")") in
    if result.ty==n_t_unit() then cg_write(s with { value=cg_unit() },concat("  ",call,"\n")) else cg_ins_value(s,result,call)

fn cg_adopt(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, id:i64, n:Node,
            borrow owner:CgValue, borrow arena:CgValue) -> CgState
  = let finalize=concat("@neo_arena_finalizer_",int_text(id)) in let ty=cg_type_of(owner) in
    let destructor=md_resource_drop(m,fns,owner.record) in
    let wrapper=concat("define internal void ",finalize,"(ptr %box) {\nentry:\n  %value = load ",ty,
      ", ptr %box, align 8\n  call void ",cg_symbol(m,destructor),"(",ty," %value)\n  ret void\n}\n") in
    let s=cg_extract(s with { globals=concat(s.globals,wrapper) },arena,0,n_t_i64()) in let token=s.value.operand in
    let s=cg_release(s,arena) in
    let s=cg_ins(s,n_t_ptr(),concat("call ptr @ax_alloc(i64 ptrtoint (ptr getelementptr (",ty,", ptr null, i64 1) to i64))")) in
    let box=s.value.operand in
    let s=cg_write(s,concat("  store ",cg_typed(owner),", ptr ",box,", align 8\n")) in
    let register=cg_symbol(m,tc_named_fn(m,fns,"rt_arena_register")) in
    let s=cg_ins(s,n_t_i64(),concat("call i64 ",register,"(i64 ",token,", ptr ",box,", ptr ",finalize,")")) in
    let slot=s.value.operand in let s=cg_ins(s,n_t_bool(),concat("icmp slt i64 ",slot,", 0")) in
    let s=cg_arithmetic_guard(s,"resource arena is closed or full") in
    let s=cg_move_owner(m,env,s,ast_list_at(m.ast,n.b,0)) in
    let ref=cg_declaration(m,n.e) in
    let s=cg_ins_value(s,ref,concat("insertvalue ",cg_type_of(ref)," zeroinitializer, i64 ",token,", 0")) in
    cg_ins_value(s,ref,concat("insertvalue ",cg_typed(s.value),", i64 ",slot,", 1"))

fn cg_reference(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, id:i64, n:Node,
                borrow name:Arr u8 _) -> CgState
  = if tx_equal(name,"ref_null") then s with { value=cg_declaration(m,n.e) with { operand="zeroinitializer" } }
    else let args=cg_arguments(m,fns,env,s,n.b,false) in if args.state.error>=0 then args.state else
    let first=cg_arg(args.values,0) in
    if tx_equal(name,"adopt") then cg_adopt(m,fns,env,args.state,id,n,first,cg_arg(args.values,1))
    else let s=cg_extract(args.state,first,0,n_t_i64()) in let token=s.value.operand in
    let s=cg_extract(s,first,1,n_t_i64()) in let slot=s.value.operand in
    if tx_equal(name,"ref_release") then
      let fn_name=cg_symbol(m,tc_named_fn(m,fns,"rt_arena_release")) in
      cg_write(s with { value=cg_unit() },concat("  call void ",fn_name,"(i64 ",token,", i64 ",slot,")\n"))
    else let fn_name=cg_symbol(m,tc_named_fn(m,fns,"rt_arena_lookup")) in
    let s=cg_ins(s,n_t_ptr(),concat("call ptr ",fn_name,"(i64 ",token,", i64 ",slot,")")) in let box=s.value.operand in
    if tx_equal(name,"ref_live") then cg_ins(s,n_t_bool(),concat("icmp ne ptr ",box,", null"))
    else let s=cg_ins(s,n_t_bool(),concat("icmp eq ptr ",box,", null")) in
    let s=cg_arithmetic_guard(s,"borrow of a closed resource reference") in
    let result=cg_declaration(m,n.e) in
    let s=cg_ins_value(s,result,concat("load ",cg_type_of(result),", ptr ",box,", align 8")) in cg_retain(s,s.value)

fn cg_call(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, id:i64, n:Node) -> CgState
  = let name=md_str(m,n.a) in
    if tx_equal(name,"noop") then s with { value=cg_unit() }
    else if tx_equal(name,"null") then s with { value=cg_value(n_t_ptr(),"null") }
    else if tx_equal(name,"addr") || tx_equal(name,"function") then
      let arg=md_node(m,ast_list_at(m.ast,n.b,0)) in let decl=md_find_decl(m,fns,arg.a) in
      s with { value=if tx_equal(name,"addr") then cg_value(n_t_ptr(),cg_symbol(m,decl))
        else cg_declaration(m,n.e) with { operand=cg_symbol(m,decl) } }
    else if tx_equal(name,"function_null") then s with { value=cg_declaration(m,n.e) with { operand="null" } }
    else if tx_equal(name,"callback_address") then
      let lowered=cg_expr(m,fns,env,s,ast_list_at(m.ast,n.b,0)) in lowered with { value=cg_value(n_t_ptr(),lowered.value.operand) }
    else if tx_equal(name,"serve") || tx_equal(name,"serve_effect") then
      let port=cg_expr(m,fns,env,s,ast_list_at(m.ast,n.b,0)) in if port.error>=0 then port else
      let arg=md_node(m,ast_list_at(m.ast,n.b,1)) in let handler=md_find_decl(m,fns,arg.a) in
      cg_ins(port,n_t_i64(),concat("call i64 @ax_serve(",cg_typed(port.value),", ptr ",cg_symbol(m,handler),")"))
    else if tx_equal(name,"adopt") || tx_equal(name,"borrow_ref") || tx_equal(name,"ref_live") ||
      tx_equal(name,"ref_release") || tx_equal(name,"ref_null") then cg_reference(m,fns,env,s,id,n,name)
    else if tx_equal(name,"data") then
      let id=ast_list_at(m.ast,n.b,0) in let arg=md_node(m,id) in
      let bytes=if arg.kind==n_var() then s with { value=cg_lookup(m,env,arg.a) } else cg_string(s,md_str(m,arg.a)) in
      cg_extract(bytes,bytes.value,0,n_t_ptr())
    else if tx_equal(name,"byte_uninit") then
      let size=cg_expr(m,fns,env,s,ast_list_at(m.ast,n.b,0)) in
      if size.error>=0 then size else cg_array_allocate(size,cg_value(n_t_u8(),""),size.value.operand)
    else if tx_equal(name,"view") then
      let args=cg_arguments(m,fns,env,s,n.b,false) in if args.state.error>=0 then args.state else
      cg_byte_view(args.state,cg_arg(args.values,0),cg_arg(args.values,1))
    else if tx_equal(name,"concat") then
      let parts=cg_read_arguments(m,fns,env,s,n.b) in if parts.state.error>=0 then parts.state else
      cg_concat(parts.state with { line=n.line },parts.values,parts.owned,
        tx_at(parts.owned,0)==1 && md_node(m,ast_list_at(m.ast,n.b,0)).kind!=n_str())
    else if tx_equal(name,"push") || tx_equal(name,"set") then
      let args=cg_arguments(m,fns,env,s,n.b,false) in if args.state.error>=0 then args.state else
      cg_array_edit(args.state with { line=n.line },args.values,tx_equal(name,"push"),cg_fresh(m,ast_list_at(m.ast,n.b,0)))
    else if tx_equal(name,"byte_equal") then cg_byte_equal(m,fns,env,s,n.b)
    else if tx_equal(name,"byte_read_le") then
      let bytes=cg_read(m,fns,env,s,ast_list_at(m.ast,n.b,0)) in if bytes.state.error>=0 then bytes.state else
      let source=bytes.state.value in
      let offset=cg_expr(m,fns,env,bytes.state,ast_list_at(m.ast,n.b,1)) in if offset.error>=0 then offset else
      let position=offset.value.operand in
      let width=cg_expr(m,fns,env,offset,ast_list_at(m.ast,n.b,2)) in if width.error>=0 then width else
      cg_byte_read(width with { line=n.line },source,position,width.value.operand,!bytes.borrowed)
    else if bi_bytes(name) then
      let args=cg_arguments(m,fns,env,s,n.b,false) in if args.state.error>=0 then args.state else
      cg_byte_builtin(args.state with { line=n.line },name,args.values,cg_fresh(m,ast_list_at(m.ast,n.b,0)))
    else if md_is_builtin(m,name) then
      let signature=bi_signature(name) in if signature.result<=0 then s with { error=id } else
      let args=cg_arguments(m,fns,env,s,n.b,false) in if args.state.error>=0 then args.state else
      cg_intrinsic(args.state,name,args.values,signature.result,id)
    else let callback=cg_lookup(m,env,n.a) in
    if callback.ty==n_t_fn() then cg_indirect(m,fns,env,s,n,callback) else
    let callee=md_find_decl(m,fns,n.a) in let result=cg_declaration(m,md_node(m,callee).c) in
    if callee<0 || !cg_supported(result) then s with { error=id } else
    let f=md_node(m,callee) in let lends=cg_lends(m,f) in
    let args=if lends then cg_lent_arguments(m,fns,env,s,f,n.b) else
      let owned=cg_arguments(m,fns,env,s,n.b,false) in CgReads { state=owned.state, values=owned.values, owned=tx_ints() } in
    if args.state.error>=0 then args.state else
    let signature=if ast_flag(f,fl_variadic()) then concat(" (",cg_abi_types(m,f),")") else "" in
    let s=loop (i=0, out=args.state) while i<ast_list_len(m.ast,f.b)
      next (i+1,let p=md_node(m,ast_list_at(m.ast,f.b,i)) in
        if md_resource_consumed(m,f,p) then cg_move_owner(m,env,out,ast_list_at(m.ast,n.b,i)) else out) yield out in
    let target=if tx_at(s.par,callee)==1 then concat(cg_par_symbol(callee),if lends then ".lent" else "")
      else if lends then cg_lent_symbol(m,callee) else cg_symbol(m,callee) in
    let call=concat("call ",cg_return(result),signature," ",target,"(",cg_arg_text(args.values),")") in
    let called=if result.ty==n_t_unit() then cg_write(s with { value=cg_unit() },concat("  ",call,"\n")) else
      cg_ins_value(s,result,call) in
    cg_release_owned(called,args.values,args.owned)

type CgRange = { header:i64, work:i64, latch:i64, done:i64, iterator:Arr u8 _, successor:Arr u8 _, lo:Arr u8 _, hi:Arr u8 _ }
fn cg_counted_head(move s:CgState, borrow r:CgRange, borrow other_phi:Arr u8 _) -> CgState
  = let initial=s.block in let s=cg_block(cg_jump(s,r.header),r.header) in
    let s=cg_write(s,concat("  ",r.iterator," = phi i64 [ ",r.lo,", %",cg_label(initial)," ], [ ",r.successor,", %",cg_label(r.latch)," ]\n",other_phi)) in
    let s=cg_ins(s,n_t_bool(),concat("icmp slt i64 ",r.iterator,", ",r.hi)) in
    cg_block(cg_branch(s,s.value.operand,r.work,r.done),r.work)
fn cg_counted_tail(move s:CgState, borrow r:CgRange) -> CgState
  = let s=cg_block(cg_jump(s,r.latch),r.latch) in
    let s=cg_write(s,concat("  ",r.successor," = add i64 ",r.iterator,", 1\n")) in
    cg_block(cg_jump(s,r.header),r.done)
; A sum has no evaluation order, so its float total may be regrouped: that is
; what lets LLVM add several terms per step.
fn cg_sum_add(move s:CgState, ty:i64, borrow left:Arr u8 _, borrow right:Arr u8 _) -> CgState
  = if ty==n_t_i64() then cg_integer_arithmetic(s,"add",left,right)
    else cg_ins(s,n_t_f64(),concat("fadd reassoc double ",left,", ",right))

fn cg_sum_record(borrow m:Mods, move body:CgState, borrow previous:CgValue) -> CgState
  = let value=body.value in let fields=md_node(m,value.record).b in
    let zero=value with { operand="zeroinitializer" } in
    loop (i=0, s=body with { value=zero }) while i<ast_list_len(m.ast,fields)
      next (i+1,let record=s.value in let field=cg_field_type(m,fields,i) in
        let s=cg_field_get(s,previous,field,i) in let left=s.value.operand in
        let s=cg_field_get(s,value,field,i) in
        let updated=cg_sum_add(s,field.ty,left,s.value.operand) in
        cg_ins_value(updated,record,concat("insertvalue ",cg_typed(record),", ",cg_typed(updated.value),", ",int_text(i)))) yield s

; A record total is kept in a stack slot, which LLVM splits into one scalar
; total per field. A record-typed phi would hide them from its loop passes.
fn cg_sum_slot(borrow m:Mods, move s:CgState, move body:CgState, borrow r:CgRange, borrow accumulator:Arr u8 _) -> CgState
  = let term=body.value in let result=term with { operand=accumulator } in
    let record=cg_type_of(result) in let slot=concat(accumulator,".total") in
    let loaded=cg_ins_value(body,result,concat("load ",record,", ptr ",slot,", align 8")) in
    let previous=loaded.value in
    let added=cg_sum_record(m,loaded with { value=term },previous) in
    let updated=cg_write(added,concat("  store ",cg_typed(added.value),", ptr ",slot,", align 8\n")) in
    let s=cg_write(s with { serial=updated.serial,globals=concat(s.globals,updated.globals),
      allocas=concat(updated.allocas,"  ",slot," = alloca ",record,", align 8\n") },
      concat("  store ",record," zeroinitializer, ptr ",slot,", align 8\n")) in
    let tail=cg_counted_tail(cg_write(cg_counted_head(s,r,"") with { block=updated.block },updated.text),r) in
    cg_write(tail,concat("  ",accumulator," = load ",record,", ptr ",slot,", align 8\n")) with { value=result }

fn cg_sum_range(borrow m:Mods, move s:CgState, move body:CgState, borrow r:CgRange, borrow accumulator:Arr u8 _) -> CgState
  = let ty=body.value.ty in let result=body.value with { operand=accumulator } in
    let body=body with { line=s.line } in
    if ty==n_t_rec() then cg_sum_slot(m,s,body,r,accumulator) else
    let updated=cg_sum_add(body,ty,accumulator,body.value.operand) in
    let initial=if ty==n_t_i64() then "0" else if ty==n_t_f64() then "0.0" else "zeroinitializer" in
    let phi=concat("  ",accumulator," = phi ",cg_type_of(result)," [ ",initial,
      ", %",cg_label(s.block)," ], [ ",updated.value.operand,", %",cg_label(r.latch)," ]\n") in
    let head=cg_counted_head(s with { serial=updated.serial,allocas=updated.allocas,globals=concat(s.globals,updated.globals) },r,phi) in
    cg_counted_tail(cg_write(head with { block=updated.block },updated.text),r) with { value=result }

fn cg_range(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, id:i64, n:Node) -> CgState
  = if cg_par_wanted(m,s,n) then cg_par_range(m,fns,env,s,id,n) else
    let s=cg_expr(m,fns,env,s,n.b) in if s.error>=0 then s else let lo=s.value.operand in
    let s=cg_expr(m,fns,env,s,n.c) in if s.error>=0 then s else let hi=s.value.operand in
    let header=s.serial in let work=header+1 in let latch=work+1 in let done=latch+1 in
    let iterator=cg_reg(done+1) in let successor=cg_reg(done+2) in let accumulator=cg_reg(done+3) in
    let range=CgRange { header=header, work=work, latch=latch, done=done, iterator=iterator, successor=successor, lo=lo, hi=hi } in
    let inner=push(env,cg_bind(n.a,cg_value(n_t_i64(),iterator))) in
    ; Lower the body first to learn its element type. All registers and
    ; blocks it reserves stay distinct from the surrounding allocation code.
    let body=cg_expr(m,fns,inner,s with { text=tx_empty(), globals=tx_empty(), serial=done+4, block=work },n.d) in
    if body.error>=0 then body else if n.kind==n_sum() then
      cg_sum_range(m,s with { line=n.line },body,range,accumulator)
    else if !cg_supported(body.value) then s with { error=id }
    ; An empty array is a constant, like an empty string: nothing to allocate.
    else if cg_range_empty(m,n) then let empty=cg_string(s,tx_empty()) in
      empty with { value=cg_array_value(body.value,empty.value.operand) } else
    let body=cg_own_view(body) in
    let s=s with { serial=body.serial, globals=concat(s.globals,body.globals), allocas=body.allocas, line=n.line } in
    let s=cg_integer_arithmetic(s,"sub",hi,lo) in
    let s=cg_array_allocate(s,body.value,s.value.operand) in let array=s.value in
    let s=cg_counted_head(s,range,"") in
    let s=cg_write(s with { block=body.block },body.text) in
    let s=cg_ins(s,n_t_i64(),concat("sub i64 ",iterator,", ",lo)) in
    let s=cg_store_element(s,array,s.value.operand,body.value) in
    cg_counted_tail(s,range) with { value=array }

; Parallel regions (regions.neo). In a par clone, a candidate comprehension
; is outlined into @neo_region_<function>_<serial>(ptr %ctx, i64 %chunk),
; which lowers the body sequentially over one chunk of the range. The context
; holds lo, the iteration count, the chunk count, the output (the array, or
; the buffer of chunk totals) and the bindings the body names. ax_chunks (or
; ax_chunks_work with the reference's work estimate) picks the chunks, so a
; float total depends on the worker count (as in the reference compiler) but
; not on scheduling: chunk totals are added in chunk order.
fn cg_par_symbol(id:i64) -> Arr u8 _ = concat("@neo_par_",int_text(id))
fn cg_par_wanted(borrow m:Mods, borrow s:CgState, n:Node) -> bool
  = len(s.par)>0 && str_find(s.target,"-linux").present && rg_candidate(m,n)
fn cg_par_captures(borrow m:Mods, borrow env:Arr CgBinding _, borrow names:Arr i64 _) -> Arr CgBinding _
  = loop (i=0, out=arr(j in 0..0) cg_bind(-1,cg_unit())) while i<len(env)
      next (i+1,let b=cg_binding(env,i) in
        if b.name>=0 && rg_named(m,names,b.name) then push(out,cg_bind(b.name,b.value)) else out) yield out
fn cg_par_context(borrow captured:Arr CgBinding _, totals:bool) -> Arr u8 _
  = let fields=loop (i=0, out=tx_empty()) while i<len(captured)
      next (i+1,concat(out,", ",cg_type_of(cg_binding(captured,i).value))) yield out in
    concat("{ i64, i64, i64, ",if totals then "ptr" else "%ax_arr",fields," }")
fn cg_par_field(move s:CgState, borrow context:Arr u8 _, borrow pointer:Arr u8 _, k:i64) -> CgState
  = cg_ins(s,n_t_ptr(),concat("getelementptr ",context,", ptr ",pointer,", i32 0, i32 ",int_text(k)))
fn cg_par_load(move s:CgState, borrow context:Arr u8 _, k:i64, borrow value:CgValue) -> CgState
  = let s=cg_par_field(s,context,"%ctx",k) in cg_ins_value(s,value,concat("load ",cg_type_of(value),", ptr ",s.value.operand))
fn cg_par_store(move s:CgState, borrow context:Arr u8 _, borrow pointer:Arr u8 _, k:i64, borrow value:CgValue) -> CgState
  = let s=cg_par_field(s,context,pointer,k) in cg_write(s,concat("  store ",cg_typed(value),", ptr ",s.value.operand,"\n"))

; Worker safety (regions.neo): what lowered code may refer to on a worker
; thread. A called function is lowered again (sequentially) and checked in
; turn; path holds its callers, so recursion is refused.
fn cg_par_safe(borrow m:Mods, borrow fns:Arr i64 _, borrow s:CgState, borrow code:Arr u8 _, borrow path:Arr i64 _) -> bool
  = if rg_indirect(code) then false else let refs=rg_refs(code) in
    loop (i=0, ok=true) while ok && i<len(refs) next (i+1,cg_par_ref(m,fns,s,md_word(refs,i),path)) yield ok
fn cg_par_ref(borrow m:Mods, borrow fns:Arr i64 _, borrow s:CgState, borrow name:Arr u8 _, borrow path:Arr i64 _) -> bool
  = if str_starts(name,"llvm.") || str_starts(name,"neo_failure_") || str_starts(name,"neo_bytes_") ||
      tx_equal(name,"neo_runtime_trap") || tx_equal(name,"neo_precondition_trap") || tx_equal(name,"neo.bytes.read") then true
    else if str_starts(name,"neo_retain_record_") || str_starts(name,"neo_release_record_") then
      let record=rg_number(name,if str_starts(name,"neo_retain_") then 18 else 19) in
      record>=0 && !cg_counted(m,cg_value(n_t_rec(),"") with { record=record })
    else if !str_starts(name,"neo_fn_") then false else
    let callee=rg_number(name,7) in let f=md_node(m,callee) in
    if callee<0 || f.kind!=n_fn() || ast_flag(f,fl_effect()) || cg_listed(path,callee) then false else
    let lowered=cg_function(m,fns,callee,false,s.target,s.views,false,false) in
    let lent=len(name)>5 && bytes_match_at(name,len(name)-5,".lent") in
    lowered.error<0 && cg_par_safe(m,fns,s,if lent then rg_first(lowered.text) else lowered.text,push(path,callee))

type CgLoads = { state:CgState, env:Arr CgBinding _ }
type CgRegion = { state:CgState, ok:bool, element:CgValue, code:Arr u8 _ }
; The region function. This chunk's part of the count iterations starts at
; chunk*q+min(chunk,r) for q, r = count divmod chunks: no product overflows.
fn cg_par_region(borrow m:Mods, borrow fns:Arr i64 _, borrow captured:Arr CgBinding _, borrow s:CgState, n:Node,
                 borrow context:Arr u8 _, borrow symbol:Arr u8 _, totals:bool) -> CgRegion
  = let r=s with { text=tx_empty(), globals=tx_empty(), allocas=tx_empty(), block=-1, value=cg_unit(), par=tx_ints() } in
    let r=cg_par_load(r,context,0,cg_value(n_t_i64(),"")) in let low=r.value.operand in
    let r=cg_par_load(r,context,1,cg_value(n_t_i64(),"")) in let count=r.value.operand in
    let r=cg_par_load(r,context,2,cg_value(n_t_i64(),"")) in let chunks=r.value.operand in
    let r=cg_par_load(r,context,3,cg_value(if totals then n_t_ptr() else n_t_arr(),"")) in let output=r.value.operand in
    let loads=loop (i=0, out=CgLoads { state=r, env=arr(j in 0..0) cg_bind(-1,cg_unit()) }) while i<len(captured)
      next (i+1,let b=cg_binding(captured,i) in let loaded=cg_par_load(out.state,context,4+i,b.value) in
        CgLoads { state=loaded, env=push(out.env,cg_bind(b.name,loaded.value)) }) yield out in
    let r=cg_ins(loads.state,n_t_i64(),concat("udiv i64 ",count,", ",chunks)) in let q=r.value.operand in
    let r=cg_ins(r,n_t_i64(),concat("urem i64 ",count,", ",chunks)) in let rest=r.value.operand in
    let r=cg_ins(r,n_t_i64(),concat("mul i64 %chunk, ",q)) in let base=r.value.operand in
    let r=cg_ins(r,n_t_bool(),concat("icmp ult i64 %chunk, ",rest)) in let longer=r.value.operand in
    let r=cg_ins(r,n_t_i64(),concat("select i1 ",longer,", i64 %chunk, i64 ",rest)) in
    let r=cg_ins(r,n_t_i64(),concat("add i64 ",base,", ",r.value.operand)) in
    let r=cg_ins(r,n_t_i64(),concat("add i64 ",low,", ",r.value.operand)) in let first=r.value.operand in
    let r=cg_ins(r,n_t_i64(),concat("zext i1 ",longer," to i64")) in
    let r=cg_ins(r,n_t_i64(),concat("add i64 ",q,", ",r.value.operand)) in
    let r=cg_ins(r,n_t_i64(),concat("add i64 ",first,", ",r.value.operand)) in let last=r.value.operand in
    let header=r.serial in let work=header+1 in let latch=work+1 in let done=latch+1 in
    let iterator=cg_reg(done+1) in let accumulator=cg_reg(done+3) in
    let range=CgRange { header=header, work=work, latch=latch, done=done, iterator=iterator, successor=cg_reg(done+2), lo=first, hi=last } in
    let inner=push(loads.env,cg_bind(n.a,cg_value(n_t_i64(),iterator))) in
    let body=cg_expr(m,fns,inner,r with { text=tx_empty(), globals=tx_empty(), serial=done+4, block=work },n.d) in
    let element=body.value with { operand=tx_empty() } in
    if body.error>=0 || !cg_supported(body.value) || (!totals && cg_counted(m,body.value)) then
      CgRegion { state=body, ok=false, element=element, code=tx_empty() } else
    let r=if totals then
        let total=cg_sum_range(m,r,body,range,accumulator) in let value=total.value in
        let at=cg_offset(total,cg_type_of(element),output,"%chunk") in
        cg_write(at,concat("  store ",cg_typed(value),", ptr ",at.value.operand,", align 8\n"))
      else
        let body=cg_own_view(body) in
        let r=r with { serial=body.serial, globals=concat(r.globals,body.globals), allocas=body.allocas } in
        let r=cg_write(cg_counted_head(r,range,"") with { block=body.block },body.text) in
        let r=cg_ins(r,n_t_i64(),concat("sub i64 ",iterator,", ",low)) in
        cg_counted_tail(cg_store_element(r,cg_array_value(element,output),r.value.operand,body.value),range) in
    CgRegion { state=r, ok=true, element=element,
      code=concat("define internal void ",symbol,"(ptr %ctx, i64 %chunk) {\nentry:\n",r.allocas,r.text,"  ret void\n}\n\n") }

; A region whose body cannot be outlined (an unsupported or counted element)
; is lowered sequentially, as is everything inside it.
fn cg_par_range(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, id:i64, n:Node) -> CgState
  = let par=s.par in let totals=n.kind==n_sum() in let start=s in
    let s=cg_expr(m,fns,env,s,n.b) in if s.error>=0 then s else let lo=s.value.operand in
    let s=cg_expr(m,fns,env,s,n.c) in if s.error>=0 then s else let hi=s.value.operand in
    let walk=rg_walk(m,fns,rg_none(),n.d) in
    let captured=cg_par_captures(m,env,walk.names) in
    let context=cg_par_context(captured,totals) in
    let symbol=concat("@neo_region_",int_text(s.function),"_",int_text(s.serial)) in
    let region=cg_par_region(m,fns,captured,s,n,context,symbol,totals) in
    if !region.ok then cg_range(m,fns,env,start with { par=tx_ints() },id,n) with { par=par } else
    let shared=cg_par_safe(m,fns,s,region.code,tx_ints()) in
    let dispatcher=if shared then "ax_par_for_shared" else "ax_par_for" in
    let cost=if shared then walk.cost else -1 in
    let element=region.element in
    let s=s with { serial=region.state.serial, line=n.line, globals=concat(s.globals,region.state.globals,region.code) } in
    ; The count is max(hi-lo, 0); the difference is checked, as the sequential array's length is.
    let s=cg_integer_arithmetic(s,"sub",hi,lo) in let difference=s.value.operand in
    let s=cg_ins(s,n_t_bool(),concat("icmp sgt i64 ",hi,", ",lo)) in
    let s=cg_ins(s,n_t_i64(),concat("select i1 ",s.value.operand,", i64 ",difference,", i64 0")) in let count=s.value.operand in
    let s=cg_ins(s,n_t_i64(),if cost>=0 then concat("call i64 @ax_chunks_work(i64 ",count,", i64 ",int_text(cost),")")
      else concat("call i64 @ax_chunks(i64 ",count,")")) in let chunks=s.value.operand in
    let s=cg_ins(s,n_t_i64(),concat("mul i64 ",chunks,", ptrtoint (ptr getelementptr (",cg_type_of(element),", ptr null, i64 1) to i64)")) in
    let bytes=s.value.operand in
    let s=if totals then cg_ins(s,n_t_ptr(),concat("call ptr @ax_alloc(i64 ",bytes,")")) else cg_array_allocate(s,element,difference) in
    let output=s.value in let pointer=cg_reg(s.serial) in
    let s=s with { serial=s.serial+1, allocas=concat(s.allocas,"  ",pointer," = alloca ",context,", align 8\n") } in
    let s=cg_par_store(s,context,pointer,0,cg_value(n_t_i64(),lo)) in
    let s=cg_par_store(s,context,pointer,1,cg_value(n_t_i64(),count)) in
    let s=cg_par_store(s,context,pointer,2,cg_value(n_t_i64(),chunks)) in
    let s=cg_par_store(s,context,pointer,3,output) in
    let s=loop (i=0, out=s) while i<len(captured)
      next (i+1,cg_par_store(out,context,pointer,4+i,cg_binding(captured,i).value)) yield out in
    ; Forked children count references in shared pages: make counting atomic.
    let s=if shared then s else cg_write(s,"  store i64 1, ptr @neo_threads, align 8\n") in
    let s=cg_write(s,concat("  call void @",dispatcher,"(i64 ",chunks,", ptr ",symbol,", ptr ",pointer,")\n",
      "; neo-region {\"fn\":\"",rg_display(s.name),"\",\"pos\":[",int_text(n.line),",",int_text(n.col),
      "],\"kind\":\"",if totals then "sum" else "arr","\",\"dispatcher\":\"",dispatcher,"\",\"work_cost\":",
      if cost>=0 then int_text(cost) else "null","}\n")) in
    if !totals then s with { value=output } else
    let header=s.serial in let work=header+1 in let latch=work+1 in let done=latch+1 in
    let range=CgRange { header=header, work=work, latch=latch, done=done, iterator=cg_reg(done+1),
      successor=cg_reg(done+2), lo="0", hi=chunks } in
    let at=cg_offset(s with { text=tx_empty(), globals=tx_empty(), serial=done+4, block=work },cg_type_of(element),output.operand,range.iterator) in
    let term=cg_ins_value(at,element,concat("load ",cg_type_of(element),", ptr ",at.value.operand,", align 8")) in
    let total=cg_sum_range(m,s,term,range,cg_reg(done+3)) in
    cg_write(total,concat("  call void @ax_free(ptr ",output.operand,", i64 ",bytes,")\n"))

fn cg_loop_initial(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, list:i64) -> CgArgs
  = loop (i=0, a=CgArgs { state=s, values=arr(j in 0..0) cg_unit() }) while a.state.error<0 && i<ast_list_len(m.ast,list)
      next (i+1, let state=md_node(m,ast_list_at(m.ast,list,i)) in let lowered=cg_expr(m,fns,env,a.state,state.c) in
        let lowered=if lowered.error<0 then cg_own_view(lowered) else lowered in
        CgArgs { state=lowered, values=push(a.values,lowered.value) }) yield a

fn cg_loop_phi(move s:CgState, borrow value:CgValue, borrow initial:CgValue, initial_block:i64, borrow updated:CgValue, back:i64) -> CgState
  = cg_write(s,concat("  ",value.operand," = phi ",cg_type_of(value)," [ ",initial.operand,", %",cg_label(initial_block),
      " ], [ ",updated.operand,", %",cg_label(back)," ]\n"))

fn cg_loop(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, n:Node) -> CgState
  = let initial=cg_loop_initial(m,fns,env,s,n.a) in if initial.state.error>=0 then initial.state else
    let s=initial.state in let count=len(initial.values) in
    let header=s.serial in let step=header+1 in let done=step+1 in let first=done+1 in
    let values=arr(i in 0..count) cg_arg(initial.values,i) with { operand=cg_reg(first+i) } in
    ; Each state's old value is dead after the successors, and after the yield
    ; on the way out: either may take it (1) instead of releasing it (0).
    let stepped=loop (i=0, taken=tx_ints()) while i<count
      next (i+1,let state=md_node(m,ast_list_at(m.ast,n.a,i)) in
        push(taken,if cg_counted(m,cg_arg(values,i)) && cg_plan_list(m,fns,n.c,state.a,-1,true).state==1 then 1 else 0)) yield taken in
    let yielded=loop (i=0, taken=tx_ints()) while i<count
      next (i+1,let state=md_node(m,ast_list_at(m.ast,n.a,i)) in
        push(taken,if cg_counted(m,cg_arg(values,i)) && cg_plan(m,fns,n.d,state.a,-1,true).state==1 then 1 else 0)) yield taken in
    ; A state that is not taken whole may still have fields taken (cg_parts),
    ; by the successors (early) or by the yield (late).
    let early=arr(i in 0..count) let state=md_node(m,ast_list_at(m.ast,n.a,i)) in
      cg_parts(m,fns,cg_arg(values,i),n.c,state.a,true,
        if tx_at(stepped,i)==1 then cg_plan_list(m,fns,n.c,state.a,-1,true).moves else tx_ints()) in
    let late=arr(i in 0..count) let state=md_node(m,ast_list_at(m.ast,n.a,i)) in
      cg_parts(m,fns,cg_arg(values,i),n.d,state.a,false,
        if tx_at(yielded,i)==1 then cg_plan(m,fns,n.d,state.a,-1,true).moves else tx_ints()) in
    let inner=loop (i=0, bindings=env) while i<count
      next (i+1,let state=md_node(m,ast_list_at(m.ast,n.a,i)) in
        let step=if tx_at(stepped,i)==1 then cg_plan_list(m,fns,n.c,state.a,-1,true).moves else tx_ints() in
        let last=if tx_at(yielded,i)==1 then cg_plan(m,fns,n.d,state.a,-1,true).moves else tx_ints() in
        let parts=if i>=0 && i<len(early) && i<len(late) then cg_joined(early[i],late[i]) else tx_ints() in
        push(bindings,cg_bind(state.a,cg_arg(values,i)) with { moves=cg_joined(step,last), parts=parts })) yield bindings in
    ; Reserve phi names before lowering the condition and successors. Their
    ; final block is the back-edge predecessor, even if a successor branches.
    let cond=cg_expr(m,fns,inner,s with { text=tx_empty(), globals=tx_empty(), serial=first+count, block=header },n.b) in
    if cond.error>=0 then cond else
    let updated=cg_arguments(m,fns,inner,cond with { text=tx_empty(), globals=tx_empty(), block=step },n.c,true) in
    if updated.state.error>=0 then updated.state else
    let back=updated.state.block in let origin=s.block in
    let s=cg_block(cg_jump(s with { serial=updated.state.serial, allocas=updated.state.allocas,
      globals=concat(s.globals,cond.globals,updated.state.globals) },header),header) in
    let s=loop (i=0, code=s) while i<count
      next (i+1,cg_loop_phi(code,cg_arg(values,i),cg_arg(initial.values,i),origin,cg_arg(updated.values,i),back)) yield code in
    let s=cg_write(s with { block=cond.block },cond.text) in
    let s=cg_write(cg_block(cg_branch(s,cond.value.operand,step,done),step) with { block=back },updated.state.text) in
    let s=loop (i=0, code=s) while i<count
      next (i+1,if tx_at(stepped,i)==1 then code else
        cg_release_rest(m,code,cg_arg(values,i),if i>=0 && i<len(early) then early[i] else tx_ints(),-1)) yield code in
    let result=cg_expr(m,fns,inner,cg_block(cg_jump(s,header),done),n.d) in
    if result.error>=0 then result else
    loop (i=0, code=cg_own_view(result)) while i<count
      next (i+1,if tx_at(yielded,i)==1 then code else
        cg_release_rest(m,code,cg_arg(values,i),if i>=0 && i<len(late) then late[i] else tx_ints(),-1)) yield code

fn cg_show(borrow m:Mods, id:i64) -> Arr u8 _
  = let n=md_node(m,id) in
    if n.kind==n_num() then int_text(n.a)
    else if n.kind==n_bool() then if n.a==0 then "false" else "true"
    else if n.kind==n_var() then md_str(m,n.a)
    else if n.kind==n_str() then tx_repr(md_str(m,n.a),true)
    else if n.kind==n_byte() then tx_repr(push(tx_empty(),u8(n.a)),true)
    else if n.kind==n_bin() then concat("(",cg_show(m,n.b)," ",lx_sym_text(n.a)," ",cg_show(m,n.c),")")
    else if n.kind==n_un() then concat(lx_sym_text(n.a),cg_show(m,n.b))
    else if n.kind==n_index() then concat(cg_show(m,n.a),"[",cg_show(m,n.b),"]")
    else if n.kind==n_len() then concat("len(",cg_show(m,n.a),")")
    else if n.kind==n_cast() then concat(dp_scalar(md_node(m,n.a).kind),"(",cg_show(m,n.b),")")
    else if n.kind==n_call() then
      let args=loop (i=0, out=tx_empty()) while i<ast_list_len(m.ast,n.b)
        next (i+1,concat(out,if i==0 then "" else ", ",cg_show(m,ast_list_at(m.ast,n.b,i)))) yield out in
      concat(md_str(m,n.a),"(",args,")")
    else dp_expr(tx_empty(),m.ast,id)

fn cg_assertion(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState,
    predicate:i64, borrow message:Arr u8 _, precondition:bool) -> CgState
  = let s=cg_expr(m,fns,env,s,predicate) in if s.error>=0 then s else
    let s=cg_ins(s,n_t_bool(),concat("xor i1 ",s.value.operand,", true")) in
    cg_guard(s,s.value.operand,message,precondition)

fn cg_field_index(borrow m:Mods, list:i64, name:i64) -> i64
  = let text=md_str(m,name) in
    loop (i=0, index=-1) while index<0 && i<ast_list_len(m.ast,list)
      next (i+1,let field=md_node(m,ast_list_at(m.ast,list,i)) in if tx_equal(md_str(m,field.a),text) then i else -1) yield index
fn cg_field_type(borrow m:Mods, fields:i64, index:i64) -> CgValue
  = cg_declaration(m,md_node(m,ast_list_at(m.ast,fields,index)).b)
fn cg_field_get(move s:CgState, borrow base:CgValue, borrow field:CgValue, index:i64) -> CgState
  = cg_ins_value(s,field,concat("extractvalue ",cg_typed(base),", ",int_text(index)))

type CgRead = { state:CgState, borrowed:bool }

; Only lexical observations can run while an earlier operand is borrowed.
fn cg_observer(borrow m:Mods, id:i64) -> bool
  = let n=md_node(m,id) in let kind=n.kind in
    if kind==n_field() || kind==n_len() then cg_observer(m,n.a)
    else if kind==n_un() || kind==n_cast() then cg_observer(m,n.b)
    else if kind==n_bin() then cg_observer(m,n.b) && cg_observer(m,n.c)
    else if kind==n_index() then cg_observer(m,n.a) && cg_observer(m,n.b)
    else kind==n_var() || kind==n_num() || kind==n_flt() || kind==n_bool() || kind==n_byte() || kind==n_str()

; Whether the binding at the root of a variable or field read has a use that
; takes it.
fn cg_root_taken(borrow m:Mods, borrow env:Arr CgBinding _, id:i64) -> bool
  = let n=md_node(m,id) in
    if n.kind==n_field() then cg_root_taken(m,env,n.a)
    else if n.kind!=n_var() then false
    else let binding=cg_binding(env,cg_binding_index(m,env,n.a)) in len(binding.moves)>0 || len(binding.parts)>0

; A lexical binding owns its storage through an observation. A temporary
; instead transfers its reference to the observer, which must release it.
fn cg_read(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, id:i64) -> CgRead
  = let n=md_node(m,id) in
    if n.kind==n_var() then CgRead { state=s with { value=cg_lookup(m,env,n.a) },borrowed=true }
    else if n.kind==n_field() then cg_read_field(m,fns,env,s,n,id)
    else CgRead { state=cg_expr(m,fns,env,s,id),borrowed=false }

; A field that cg_with_owned hands to its own replacement, or that a field
; take (cg_parts) hands on, is read without a retain and owned by the reader:
; the record's reference to it is given up.
fn cg_read_field(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, n:Node, id:i64) -> CgRead
  = let root=cg_path_root(m,id) in
    let owner=if root>=0 then cg_binding(env,cg_binding_index(m,env,md_node(m,root).a)) else cg_bind(-1,cg_unit()) in
    let taken=root>=0 && (cg_listed(owner.moves,id) || cg_part_listed(owner.parts,id)) in
    let base=cg_read(m,fns,env,s,n.a) in if base.state.error>=0 then base else
    let value=base.state.value in let fields=md_node(m,value.record).b in let index=cg_field_index(m,fields,n.b) in
    let field=cg_field_get(base.state,value,cg_field_type(m,fields,index),index) in
    let state=if base.borrowed then field else cg_release(cg_retain(field,field.value),value) in
    CgRead { state=state,borrowed=base.borrowed && !taken }

fn cg_byte_equal(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, list:i64) -> CgState
  = let first_id=ast_list_at(m.ast,list,0) in let second_id=ast_list_at(m.ast,list,1) in
    let left=if cg_observer(m,second_id) then cg_read(m,fns,env,s,first_id)
      else CgRead { state=cg_expr(m,fns,env,s,first_id),borrowed=false } in
    if left.state.error>=0 then left.state else
    let first=left.state.value in let right=cg_read(m,fns,env,left.state,second_id) in
    if right.state.error>=0 then right.state else
    let second=right.state.value in
    let equal=cg_ins(right.state,n_t_bool(),concat("call i1 @neo.bytes.equal(",cg_typed(first),", ",cg_typed(second),")")) in
    let state=if right.borrowed then equal else cg_release(equal,second) in
    if left.borrowed then state else cg_release(state,first)

; release: the record in s.value owns the fields a `with` replaces, so their
; old values are released.
fn cg_record_fill(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, list:i64, literal:bool, release:bool) -> CgState
  = let fields=md_node(m,s.value.record).b in
    let count=if literal then ast_list_len(m.ast,fields) else ast_list_len(m.ast,list) in
    loop (i=0, code=s) while code.error<0 && i<count
      next (i+1,let initial=code.value in
        let field=md_node(m,ast_list_at(m.ast,fields,i)) in
        let init=md_node(m,if literal then tc_named_node(m,list,field.a) else ast_list_at(m.ast,list,i)) in
        let index=if literal then i else cg_field_index(m,fields,init.a) in
        let lowered=cg_expr(m,fns,env,code,init.b) in if lowered.error>=0 then lowered else
        let lowered=cg_own_view(lowered) in
        let value=lowered.value in let previous=cg_field_type(m,fields,index) in
        let lowered=if release && !literal && cg_managed(previous) then
          let extracted=cg_field_get(lowered,initial,previous,index) in cg_release(extracted,extracted.value) else lowered in
        cg_ins_value(lowered,initial,concat("insertvalue ",cg_typed(initial),", ",cg_typed(value),", ",int_text(index)))) yield code
; Retains the fields of the record in s.value that the `with` values in list
; do not replace, which a copy of it then shares.
fn cg_retain_kept(borrow m:Mods, move s:CgState, list:i64) -> CgState
  = let record=s.value in let fields=md_node(m,record.record).b in
    loop (i=0, out=s) while i<ast_list_len(m.ast,fields)
      next (i+1,let field=cg_field_type(m,fields,i) in
        if !cg_managed(field) || tc_named_node(m,list,md_node(m,ast_list_at(m.ast,fields,i)).a)>=0 then out else
        let got=cg_field_get(out,record,field,i) in cg_retain(got,got.value) with { value=record }) yield out

; Whether expression id reads binding name other than as name.g for a field g
; different from spare.
fn cg_mentions(borrow m:Mods, id:i64, name:i64, spare:i64) -> bool
  = let n=md_node(m,id) in let kind=n.kind in
    if id<0 || kind==n_num() || kind==n_flt() || kind==n_bool() || kind==n_byte() || kind==n_str() then false
    else if kind==n_var() then cg_named(m,n.a,name)
    else if kind==n_field() then
      let record=md_node(m,n.a) in
      if record.kind==n_var() && cg_named(m,record.a,name) then cg_named(m,n.b,spare) else cg_mentions(m,n.a,name,spare)
    else if kind==n_let() || kind==n_using() then
      cg_mentions(m,n.b,name,spare) || (!cg_named(m,n.a,name) && cg_mentions(m,n.c,name,spare))
    else if kind==n_if() then cg_mentions(m,n.a,name,spare) || cg_mentions(m,n.b,name,spare) || cg_mentions(m,n.c,name,spare)
    else if kind==n_check() || kind==n_index() then cg_mentions(m,n.a,name,spare) || cg_mentions(m,n.b,name,spare)
    else if kind==n_bin() then cg_mentions(m,n.b,name,spare) || cg_mentions(m,n.c,name,spare)
    else if kind==n_un() || kind==n_cast() then cg_mentions(m,n.b,name,spare)
    else if kind==n_len() then cg_mentions(m,n.a,name,spare)
    else if kind==n_sum() || kind==n_arrc() then
      cg_mentions(m,n.b,name,spare) || cg_mentions(m,n.c,name,spare) || (!cg_named(m,n.a,name) && cg_mentions(m,n.d,name,spare))
    else if kind==n_call() then cg_mentions_list(m,n.b,name,spare,false)
    else if kind==n_reclit() then cg_mentions_list(m,n.b,name,spare,true)
    else if kind==n_with() then cg_mentions(m,n.a,name,spare) || cg_mentions_list(m,n.b,name,spare,true)
    else if kind==n_loop() then
      let shadowed=loop (i=0, found=false) while !found && i<ast_list_len(m.ast,n.a)
        next (i+1,cg_named(m,md_node(m,ast_list_at(m.ast,n.a,i)).a,name)) yield found in
      let initial=loop (i=0, found=false) while !found && i<ast_list_len(m.ast,n.a)
        next (i+1,cg_mentions(m,md_node(m,ast_list_at(m.ast,n.a,i)).c,name,spare)) yield found in
      initial || (!shadowed && (cg_mentions(m,n.b,name,spare) || cg_mentions_list(m,n.c,name,spare,false) || cg_mentions(m,n.d,name,spare)))
    else true
; The same over a list of expressions, or of field values (n_finit: b value).
fn cg_mentions_list(borrow m:Mods, list:i64, name:i64, spare:i64, fields:bool) -> bool
  = loop (i=0, found=false) while !found && i<ast_list_len(m.ast,list)
      next (i+1,let item=ast_list_at(m.ast,list,i) in
        cg_mentions(m,if fields then md_node(m,item).b else item,name,spare)) yield found
; Whether two expressions are the same variable or the same field path of one.
fn cg_same_path(borrow m:Mods, a:i64, b:i64) -> bool
  = let x=md_node(m,a) in let y=md_node(m,b) in
    if x.kind==n_var() then y.kind==n_var() && cg_named(m,x.a,y.a)
    else x.kind==n_field() && y.kind==n_field() && cg_named(m,x.b,y.b) && cg_same_path(m,x.a,y.a)
; The variable at the root of a field path, or -1.
fn cg_path_root(borrow m:Mods, id:i64) -> i64
  = let n=md_node(m,id) in if n.kind==n_var() then id else if n.kind==n_field() then cg_path_root(m,n.a) else -1
; The field of the root variable that a field path goes through, or -1 for the variable itself.
fn cg_path_top(borrow m:Mods, id:i64) -> i64
  = let n=md_node(m,id) in if n.kind!=n_field() then -1 else
    if md_node(m,n.a).kind==n_var() then n.b else cg_path_top(m,n.a)
; The read of base.field that the new value id of that field can take from the
; record, or -1. The value must reach it through first operands that are
; handed over: push, set, byte_copy, byte_write_le, concat's first part, owning
; parameters, or a `with` on base.field itself
; (which then takes that record the same way). No other argument on the way
; may read the field's subtree or the variable as a whole (cg_mentions), since
; the field may already have been changed in place when it runs.
fn cg_chain_take(borrow m:Mods, borrow fns:Arr i64 _, id:i64, base:i64, field:i64, name:i64, spare:i64) -> i64
  = let n=md_node(m,id) in
    if n.kind==n_field() then (if cg_named(m,n.b,field) && cg_same_path(m,n.a,base) then id else -1)
    else if n.kind==n_with() then
      let record=md_node(m,n.a) in
      if record.kind==n_field() && cg_named(m,record.b,field) && cg_same_path(m,record.a,base) then n.a else -1
    else if n.kind!=n_call() || ast_list_len(m.ast,n.b)<1 then -1 else
    let callee=md_str(m,n.a) in let edits=str_find(" push set byte_copy byte_write_le concat ",concat(" ",callee," ")).present in
    let decl=if edits || md_is_builtin(m,callee) then -1 else md_find_decl(m,fns,n.a) in
    if !edits && (decl<0 || !cg_argument_owned(m,decl,0)) then -1 else
    let alone=loop (k=1, clear=true) while clear && k<ast_list_len(m.ast,n.b)
      next (k+1,!cg_mentions(m,ast_list_at(m.ast,n.b,k),name,spare)) yield clear in
    if !alone then -1 else cg_chain_take(m,fns,ast_list_at(m.ast,n.b,0),base,field,name,spare)
; `x with { ... }` as the last use of x (or of the field path it was taken
; from). The record is taken as it stands, so nothing is retained. Field
; values are computed first; a replaced field's old value is released after
; all of them, because a later value may still read it, unless its own new
; value took it (cg_chain_take), which keeps a uniquely owned buffer unique
; for an in-place push or set. Nothing after a taking value may read that
; field's subtree or the variable as a whole.
; stale: 1 when the old value of a replaced field has to be released.
type CgFields = { state:CgState, values:Arr CgValue _, slots:Arr i64 _, stale:Arr i64 _ }
fn cg_with_value(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move all:CgFields, n:Node, i:i64,
                 borrow owner:CgBinding, borrow record:CgValue) -> CgFields
  = let fields=md_node(m,record.record).b in let init=md_node(m,ast_list_at(m.ast,n.b,i)) in
    let index=cg_field_index(m,fields,init.a) in let top=cg_path_top(m,n.a) in let spare=if top<0 then init.a else top in
    let quiet=loop (k=i+1, clear=true) while clear && k<ast_list_len(m.ast,n.b)
      next (k+1,!cg_mentions(m,md_node(m,ast_list_at(m.ast,n.b,k)).b,owner.name,spare)) yield clear in
    let taken=if quiet then cg_chain_take(m,fns,init.b,n.a,init.a,owner.name,spare) else -1 in
    let scope=if taken<0 then env else push(env,owner with { moves=push(tx_ints(),taken) }) in
    let lowered=cg_expr(m,fns,scope,all.state,init.b) in
    if lowered.error>=0 then all with { state=lowered } else
    let lowered=cg_own_view(lowered) in
    ; A field taken before this `with` (cg_parts_dropped) is no longer the record's.
    let dropped=md_node(m,n.a).kind==n_var() && cg_part_dropped(owner.parts,index,n.a) in
    CgFields { state=lowered, values=push(all.values,lowered.value), slots=push(all.slots,index),
      stale=push(all.stale,if taken<0 && !dropped && cg_managed(cg_field_type(m,fields,index)) then 1 else 0) }
fn cg_with_owned(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, n:Node, borrow owner:CgBinding) -> CgState
  = let record=s.value in let fields=md_node(m,record.record).b in
    let lowered=loop (i=0, all=CgFields { state=s, values=arr(j in 0..0) cg_unit(), slots=tx_ints(), stale=tx_ints() })
      while all.state.error<0 && i<ast_list_len(m.ast,n.b)
      next (i+1,cg_with_value(m,fns,env,all,n,i,owner,record)) yield all in
    if lowered.state.error>=0 then lowered.state else
    let released=loop (i=0, code=lowered.state) while i<len(lowered.values)
      next (i+1,if tx_at(lowered.stale,i)==0 then code else
        let slot=tx_at(lowered.slots,i) in
        let old=cg_field_get(code,record,cg_field_type(m,fields,slot),slot) in cg_release(old,old.value)) yield code in
    loop (i=0, code=released with { value=record }) while i<len(lowered.values)
      next (i+1,cg_ins_value(code,record,concat("insertvalue ",cg_typed(code.value),", ",
        cg_typed(cg_arg(lowered.values,i)),", ",int_text(tx_at(lowered.slots,i))))) yield code
fn cg_record_expr(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, n:Node) -> CgState
  = if n.kind==n_reclit() then
      let value=cg_value(n_t_rec(),"zeroinitializer") with { record=tc_find_record(m,n.a) } in
      cg_record_fill(m,fns,env,s with { value=value },n.b,true,false)
    else let root=cg_path_root(m,n.a) in
      let owner=if root>=0 then cg_binding(env,cg_binding_index(m,env,md_node(m,root).a)) else cg_bind(-1,cg_unit()) in
      if cg_listed(owner.moves,n.a) then
        ; The base is read without a retain: a variable's plan or the field
        ; value that contains this `with` hands it over.
        let taken=cg_read(m,fns,env,s,n.a) in if taken.state.error>=0 then taken.state else
        cg_with_owned(m,fns,env,taken.state,n,owner)
      else if md_node(m,n.a).kind==n_var() && len(owner.parts)>0 then
        ; The binding may have given up a field this `with` replaces (see
        ; cg_plan_record), so the copy retains only the fields it keeps.
        let read=cg_read(m,fns,env,s,n.a) in if read.state.error>=0 then read.state else
        cg_record_fill(m,fns,env,cg_retain_kept(m,read.state,n.b),n.b,false,false) else
      let base=cg_expr(m,fns,env,s,n.a) in if base.error>=0 then base else
      cg_record_fill(m,fns,env,base,n.b,false,true)

fn cg_expr(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, id:i64) -> CgState
  = let n=md_node(m,id) in let kind=n.kind in let s=s with { line=n.line } in
    if kind==n_num() then s with { value=cg_value(n_t_i64(),int_text(n.a)) }
    else if kind==n_flt() then s with { value=cg_value(n_t_f64(),tx_hex("0x",n.a,16)) }
    else if kind==n_bool() then s with { value=cg_value(n_t_bool(),if n.a==0 then "false" else "true") }
    else if kind==n_byte() then s with { value=cg_value(n_t_u8(),int_text(n.a)) }
    else if kind==n_str() then cg_string(s,md_str(m,n.a))
    else if kind==n_var() then
      let binding=cg_binding(env,cg_binding_index(m,env,n.a)) in let value=binding.value in
      if cg_listed(binding.moves,id) then s with { value=value } else cg_retain(s with { value=value },value)
    else if kind==n_if() then
      let chain=cg_switch_chain(m,env,id) in if len(chain.values)>=4 then cg_switch(m,fns,env,s,n,chain) else cg_if(m,fns,env,s,n)
    else if kind==n_call() then cg_call(m,fns,env,s,id,n)
    else if kind==n_arrc() || kind==n_sum() then cg_range(m,fns,env,s,id,n)
    else if kind==n_loop() then cg_loop(m,fns,env,s,n)
    else if kind==n_reclit() || kind==n_with() then cg_record_expr(m,fns,env,s,n)
    else if kind==n_field() then
      let read=cg_read_field(m,fns,env,s,n,id) in
      if read.state.error>=0 || !read.borrowed then read.state else cg_retain(read.state,read.state.value)
    else if kind==n_check() then
      let message=concat("check failed: ",cg_show(m,n.a)," at ",int_text(n.line),":",int_text(n.col)) in
      let s=cg_assertion(m,fns,env,s,n.a,message,false) in if s.error>=0 then s else cg_expr(m,fns,env,s,n.b)
    else if kind==n_len() || kind==n_index() then
      let base=if kind==n_len() || cg_observer(m,n.b) then cg_read(m,fns,env,s,n.a)
        else CgRead { state=cg_expr(m,fns,env,s,n.a),borrowed=false } in
      if base.state.error>=0 then base.state else
      let array=base.state.value in
      let read=if kind==n_len() then cg_extract(base.state,array,1,n_t_i64()) else
        let s=cg_expr(m,fns,env,base.state,n.b) in if s.error>=0 then s else
        let loaded=cg_load_element(s,array,s.value) in cg_retain(loaded,loaded.value) in
      if base.borrowed || read.error>=0 then read else cg_release(read,array)
    else if kind==n_let() then
      ; Another name for a lexical value shares that binding's reference; only
      ; a computed value is owned by the let and released after its body.
      let bound=cg_read(m,fns,env,s,n.b) in if bound.state.error>=0 then bound.state else let value=bound.state.value in
      ; The named binding may be taken while this name is still in use (see
      ; cg_plan), so then the alias holds a reference of its own.
      let exposed=bound.borrowed && cg_counted(m,value) && cg_root_taken(m,env,n.b) in
      let shared=bound.borrowed && !exposed in
      let held=if exposed then cg_retain(bound.state,value) else bound.state in
      let moves=if shared || !cg_counted(m,value) then tx_ints() else cg_moves(m,fns,n.c,n.a) in
      let parts=if shared then tx_ints() else cg_parts(m,fns,value,n.c,n.a,false,moves) in
      let body=cg_expr(m,fns,push(env,cg_bind(n.a,value) with { moves=moves, parts=parts }),held,n.c) in
      if body.error>=0 || shared || len(moves)>0 || !cg_managed(value) then body else cg_release_rest(m,cg_own_view(body),value,parts,-1)
    else if kind==n_bin() || kind==n_un() || kind==n_cast() || kind==n_using() then
      let s=cg_expr(m,fns,env,s,n.b) in if s.error>=0 then s else let value=s.value in
      if kind==n_using() then
        let owner=cg_new_owner(cg_move_owner(m,env,s,n.b)) in
        let binding=cg_bind(n.a,value) with { live=owner.value.operand } in
        let body=cg_expr(m,fns,push(env,binding),owner,n.c) in
        if body.error>=0 then body else cg_cleanup(m,cg_own_view(body),binding,n.e)
      else if kind==n_cast() then cg_cast(s with { line=n.line },md_node(m,n.a).kind,value)
      else if kind==n_un() then
        if n.a==29 then cg_ins(s,n_t_bool(),concat("xor i1 ",value.operand,", true"))
        else if value.ty==n_t_f64() then cg_ins(s,n_t_f64(),concat("fneg ",cg_typed(value)))
        else cg_integer_arithmetic(s with { line=n.line },"sub","0",value.operand)
      else if n.a==10 || n.a==11 then cg_short_circuit(m,fns,env,s,n)
      else let s=cg_expr(m,fns,env,s,n.c) in if s.error>=0 then s else cg_binary(s with { line=n.line },n.a,value,s.value)
    else s with { error=id }

type CgParams = { env:Arr CgBinding _, text:Arr u8 _, ok:bool }
type CgSizes = { state:CgState, env:Arr CgBinding _ }
fn cg_sizes(borrow m:Mods, move state:CgState, borrow params:Arr CgBinding _, list:i64) -> CgSizes
  = loop (i=0, sizes=CgSizes { state=state, env=params }) while i<ast_list_len(m.ast,list)
      next (i+1, let p=md_node(m,ast_list_at(m.ast,list,i)) in let t=md_node(m,p.b) in
        if t.kind!=n_t_arr() || tx_equal(md_str(m,t.b),"_") || cg_binding_index(m,sizes.env,t.b)>=0 then sizes else
        let measured=cg_extract(sizes.state,cg_binding(params,i).value,1,n_t_i64()) in
        CgSizes { state=measured, env=push(sizes.env,cg_bind(t.b,measured.value)) }) yield sizes
fn cg_owned_parameters(borrow m:Mods, move s:CgState, borrow params:Arr CgBinding _, list:i64) -> CgSizes
  = loop (i=0, out=CgSizes { state=s, env=params }) while i<len(params)
      next (i+1,let p=md_node(m,ast_list_at(m.ast,list,i)) in
        if p.f!=1 || md_resource_type(m,p.b)<0 || i<0 || i>=len(out.env) then out else
        let owner=cg_new_owner(out.state) in
        let bound=cg_binding(params,i) with { live=owner.value.operand } in
        CgSizes { state=owner, env=set(out.env,i,bound) }) yield out
fn cg_preconditions(borrow m:Mods, borrow fns:Arr i64 _, borrow env:Arr CgBinding _, move s:CgState, list:i64) -> CgState
  = loop (i=0, code=s) while code.error<0 && i<ast_list_len(m.ast,list)
      next (i+1,let param=md_node(m,ast_list_at(m.ast,list,i)) in
        loop (j=0, checked=code) while checked.error<0 && j<ast_list_len(m.ast,param.c)
          next (j+1,let predicate=ast_list_at(m.ast,param.c,j) in
            cg_assertion(m,fns,env,checked,predicate,cg_show(m,predicate),true)) yield checked) yield code
; The owning entry of a lending function: it forwards its arguments, then
; releases those the lowered body only borrowed.
; Whether text has at most limit lines.
fn cg_short(borrow text:Arr u8 _, limit:i64) -> bool
  = loop (i=0, lines=0) while i<len(text) && lines<=limit
      next (i+1,lines+(if tx_byte(text,i)==10 then 1 else 0)) yield lines<=limit

fn cg_owning_wrapper(borrow m:Mods, f:Node, borrow linkage:Arr u8 _, borrow result:CgValue, borrow symbol:Arr u8 _,
                     borrow lent:Arr u8 _, borrow p:CgParams) -> Arr u8 _
  = let call=concat("call ",cg_return(result)," ",lent,"(",p.text,")\n") in
    let releases=loop (i=0, out=tx_empty()) while i<len(p.env)
      next (i+1,if cg_parameter_lent(m,md_node(m,ast_list_at(m.ast,f.b,i))) then
        concat(out,cg_ref_call(cg_binding(p.env,i).value,false)) else out) yield out in
    concat("define ",linkage,cg_return(result)," ",symbol,"(",p.text,") {\nentry:\n",
      if result.ty==n_t_unit() then concat("  ",call,releases,"  ret void\n}\n\n")
      else concat("  %result = ",call,releases,"  ret ",cg_type_of(result)," %result\n}\n\n"))
fn cg_function(borrow m:Mods, borrow fns:Arr i64 _, id:i64, entry:bool, borrow target:Arr u8 _, views:bool, source_runtime:bool, shared:bool) -> CgState
  = cg_function_mode(m,fns,id,entry,target,views,source_runtime,shared,tx_ints())
; par (rg_par_set): an entry calls main's par clone when main has one; any
; other function given a non-empty par is lowered as its par clone.
fn cg_function_mode(borrow m:Mods, borrow fns:Arr i64 _, id:i64, entry:bool, borrow target:Arr u8 _, views:bool, source_runtime:bool,
                    shared:bool, borrow par:Arr i64 _) -> CgState
  = let f=md_node(m,id) in let result=cg_declaration(m,f.c) in let clone=!entry && len(par)>0 in
    let name=md_str(m,f.a) in let symbol=if entry then "@neo_entry" else if clone then cg_par_symbol(id) else cg_symbol(m,id) in
    let diagnostic_id=if entry then len(m.ast.nodes)/11+id else if clone then 2*(len(m.ast.nodes)/11)+id else id in
    let start=CgState { text=tx_empty(), globals=tx_empty(), allocas=tx_empty(), serial=0, block=-1, value=cg_unit(), error=-1,
      function=diagnostic_id, name=name, line=f.line, target=target, views=views, runtime=cg_runtime_owner(m,id),
      par=if clone then par else tx_ints() } in
    let runtime_export=source_runtime && ast_flag(f,fl_exported()) && start.runtime in
    if tc_abi_boundary(f) && cg_abi_reserved(name,len(target)>0,runtime_export) then start with { error=id } else
    if ast_flag(f,fl_external()) then cg_write(start,concat("declare ",cg_return(result)," ",symbol,"(",cg_abi_types(m,f),")\n")) else
    let lends=!entry && cg_lends(m,f) in
    let p=loop (i=0, params=CgParams { env=arr(j in 0..0) cg_bind(-1,cg_unit()), text=tx_empty(), ok=true })
      while params.ok && i<ast_list_len(m.ast,f.b)
      next (i+1, let param=md_node(m,ast_list_at(m.ast,f.b,i)) in
            let value=cg_declaration(m,param.b) with { operand=concat("%p",int_text(i)) } in
            ; A parameter this function owns, other than a resource it must drop.
            let owned=!entry && cg_counted(m,value) && !(lends && cg_parameter_lent(m,param)) && md_resource_type(m,param.b)<0 in
            let moves=if owned then cg_moves(m,fns,f.d,param.a) else tx_ints() in
            let parts=if owned then cg_parts(m,fns,value,f.d,param.a,false,moves) else tx_ints() in
            CgParams { env=push(params.env,cg_bind(param.a,value) with { moves=moves, parts=parts }),
              text=concat(params.text,if i==0 then "" else ", ",cg_typed(value)), ok=cg_supported(value) }) yield params in
    if !p.ok || !cg_supported(result) then start with { error=id } else
    let exported=ast_flag(f,fl_exported()) in
    ; Prevent loop idiom recognition from turning memcpy or memset into a
    ; recursive call to the very runtime function being defined.
    let libc=runtime_export && str_find(" memcpy memmove memset memcmp bcmp bzero calloc memset_pattern16 ",concat(" ",name," ")).present in
    let linkage=if entry || exported then "" else if shared then "hidden " else "internal " in
    let owners=cg_owned_parameters(m,start,p.env,f.b) in
    let sizes=cg_sizes(m,owners.state,owners.env,f.b) in
    let ready=if entry || exported then cg_preconditions(m,fns,sizes.env,sizes.state,f.b) else sizes.state in
    if ready.error>=0 then ready else
    let body=if entry then
      let call=concat("call ",cg_return(result)," ",if tx_at(par,id)==1 then cg_par_symbol(id) else cg_symbol(m,id),"(",p.text,")") in
      if result.ty==n_t_unit() then cg_write(ready with { value=cg_unit() },concat("  ",call,"\n")) else cg_ins_value(ready,result,call)
      else let lowered=cg_expr(m,fns,sizes.env,ready,f.d) in if lowered.error>=0 then lowered else
        loop (i=len(p.env)-1, s=cg_own_view(lowered)) while i>=0
          next (i-1,let binding=cg_binding(owners.env,i) in
            if len(binding.moves)>0 || (lends && cg_parameter_lent(m,md_node(m,ast_list_at(m.ast,f.b,i)))) then s else
            cg_cleanup(m,s,binding,md_resource_drop(m,fns,binding.value.record))) yield s in
    if body.error>=0 then body else
    let finish=cg_write(body,concat("  ret ",if result.ty==n_t_unit() then "void" else cg_typed(body.value),"\n")) in
    ; `inline fn` is expanded at every call and `cold fn` stays out of its
    ; callers. A short pure function is marked as worth expanding: the build
    ; raises LLVM's limit for those (bd_compile_arguments), as its own is set
    ; for languages whose helpers are far larger than a Neo expression.
    let policy=if entry || exported then "" else if ast_flag(f,fl_cold()) then " cold noinline"
      else if ast_flag(f,fl_inline()) then " alwaysinline"
      else if !ast_flag(f,fl_effect()) && cg_short(finish.text,400) then " inlinehint" else "" in
    let lent=if clone then concat(symbol,".lent") else cg_lent_symbol(m,id) in
    let header=concat("; fn ",name,"\ndefine ",linkage,cg_return(result)," ",if lends then lent else symbol,"(",p.text,")",
      if libc then " \"no-builtins\"" else "",policy," {\nentry:\n") in
    let wrapper=if lends then cg_owning_wrapper(m,f,linkage,result,symbol,lent,p) else tx_empty() in
    finish with { text=concat(header,finish.allocas,finish.text,"}\n\n",wrapper) }

fn cg_slot_refs(borrow element:CgValue, retain:bool) -> Arr u8 _
  = let loaded=element with { operand="%value" } in
    concat("define internal void ",cg_slot_symbol(element,retain),"(ptr %slot) {\nentry:\n",
      "  %value = load ",cg_type_of(element),", ptr %slot, align 1\n",cg_ref_call(loaded,retain),"  ret void\n}\n")

; neo_unique: the value holds the only reference to a counted buffer.
; neo_spare: it also starts at the block's first element, and the block's
; size class (16 << class) holds %bytes after a %header-byte element header.
; counting: 0 plain loads and stores, for a module that cannot start a thread;
; 1 atomic; 2 decided as the program runs, for an object that is linked with
; code it cannot see: atomic once spawn_thread has set @neo_threads.
fn cg_count(counting:i64, add:bool) -> Arr u8 _
  = let word=if add then "add" else "sub" in let tag=if counting==2 then ".plain" else "" in
    let locked=concat("atomicrmw ",word," ptr %address, i64 1 ",if add then "monotonic" else "acq_rel","\n") in
    let plain=concat("load i64, ptr %address, align 8\n  %next",tag," = ",word," i64 %old",tag,", 1\n",
      "  store i64 %next",tag,", ptr %address, align 8\n") in
    if counting==1 then concat("  %old = ",locked) else if counting==0 then concat("  %old = ",plain) else
    concat("  %threads = load i64, ptr @neo_threads, align 8\n  %several = icmp ne i64 %threads, 0\n",
      "  br i1 %several, label %count.locked, label %count.plain\ncount.locked:\n  %old.locked = ",locked,"  br label %count.done\n",
      "count.plain:\n  %old.plain = ",plain,"  br label %count.done\n",
      "count.done:\n  %old = phi i64 [ %old.locked, %count.locked ], [ %old.plain, %count.plain ]\n")
fn cg_array_runtime(source_runtime:bool, counting:i64) -> Arr u8 _
  = concat(if source_runtime then "" else "declare ptr @ax_heap_alloc(i64)\ndeclare void @ax_free(ptr, i64)\n",
      "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)\n",
      "define internal void @neo.init.elements(ptr %payload, ptr %drop, i64 %stride, i64 %length) {\nentry:\n",
      "  store ptr %drop, ptr %payload, align 8\n",
      "  %stride_slot = getelementptr i8, ptr %payload, i64 8\n  store i64 %stride, ptr %stride_slot, align 8\n",
      "  %length_slot = getelementptr i8, ptr %payload, i64 16\n  store i64 %length, ptr %length_slot, align 8\n",
      "  ret void\n}\n",
      "define internal void @neo.visit.elements(ptr %data, ptr %action, i64 %stride, i64 %length) {\nentry:\n  br label %test\n",
      "test:\n  %i = phi i64 [ 0, %entry ], [ %next, %visit ]\n  %more = icmp ult i64 %i, %length\n",
      "  br i1 %more, label %visit, label %done\nvisit:\n  %offset = mul i64 %i, %stride\n",
      "  %slot = getelementptr i8, ptr %data, i64 %offset\n  call void %action(ptr %slot)\n",
      "  %next = add nuw i64 %i, 1\n  br label %test\ndone:\n  ret void\n}\n",
      "define internal void @neo_retain(%ax_arr %value) alwaysinline {\nentry:\n",
      "  %control = extractvalue %ax_arr %value, 3\n  %bits = ptrtoint ptr %control to i64\n",
      "  %counted = icmp ugt i64 %bits, 1\n  br i1 %counted, label %retain, label %done\n",
      "retain:\n  %raw = and i64 %bits, -4\n  %address = inttoptr i64 %raw to ptr\n",
      cg_count(counting,true),"  br label %done\ndone:\n  ret void\n}\n",
      "define internal void @neo_release(%ax_arr %value) alwaysinline {\nentry:\n",
      "  %control = extractvalue %ax_arr %value, 3\n  %bits = ptrtoint ptr %control to i64\n",
      "  %counted = icmp ugt i64 %bits, 1\n  br i1 %counted, label %release, label %done\n",
      "release:\n  %raw = and i64 %bits, -4\n  %address = inttoptr i64 %raw to ptr\n",
      cg_count(counting,false),"  %last = icmp eq i64 %old, 1\n",
      "  br i1 %last, label %destroy, label %done\ndestroy:\n",
      "  call void @neo.destroy(ptr %address, i64 %bits)\n  br label %done\ndone:\n  ret void\n}\n",
      ; The last release, kept out of line: every release site stays a count update.
      "define internal void @neo.destroy(ptr %address, i64 %bits) noinline {\nentry:\n",
      "  %payload = getelementptr i8, ptr %address, i64 16\n",
      "  %tag = and i64 %bits, 2\n  %aggregate = icmp ne i64 %tag, 0\n",
      "  br i1 %aggregate, label %children, label %free\nchildren:\n",
      "  %drop = load ptr, ptr %payload, align 8\n  %stride_slot = getelementptr i8, ptr %payload, i64 8\n",
      "  %stride = load i64, ptr %stride_slot, align 8\n  %length_slot = getelementptr i8, ptr %payload, i64 16\n",
      "  %length = load i64, ptr %length_slot, align 8\n  %data = getelementptr i8, ptr %payload, i64 32\n",
      "  call void @neo.visit.elements(ptr %data, ptr %drop, i64 %stride, i64 %length)\n  br label %free\n",
      "free:\n  call void @ax_free(ptr %payload, i64 0)\n  ret void\n}\n",
      "define internal i1 @neo_unique(%ax_arr %value) alwaysinline {\nentry:\n",
      "  %control = extractvalue %ax_arr %value, 3\n  %bits = ptrtoint ptr %control to i64\n",
      "  %counted = icmp ugt i64 %bits, 1\n  br i1 %counted, label %check, label %done\n",
      "check:\n  %raw = and i64 %bits, -4\n  %address = inttoptr i64 %raw to ptr\n",
      "  %count = load i64, ptr %address, align 8\n  %single = icmp eq i64 %count, 1\n  br label %done\n",
      "done:\n  %unique = phi i1 [ false, %entry ], [ %single, %check ]\n  ret i1 %unique\n}\n",
      "define internal i1 @neo_spare(%ax_arr %value, i64 %bytes, i64 %header) alwaysinline {\nentry:\n",
      "  %control = extractvalue %ax_arr %value, 3\n  %bits = ptrtoint ptr %control to i64\n",
      "  %counted = icmp ugt i64 %bits, 1\n  br i1 %counted, label %check, label %done\n",
      "check:\n  %raw = and i64 %bits, -4\n  %address = inttoptr i64 %raw to ptr\n",
      "  %count = load i64, ptr %address, align 8\n  %single = icmp eq i64 %count, 1\n",
      "  %class_slot = getelementptr i8, ptr %address, i64 8\n  %meta = load i64, ptr %class_slot, align 8\n",
      "  %class = lshr i64 %meta, 2\n  %capacity = shl i64 16, %class\n  %total = add i64 %bytes, %header\n",
      "  %fits = icmp ule i64 %total, %capacity\n  %first = add i64 %raw, 16\n  %start = add i64 %first, %header\n",
      "  %data = extractvalue %ax_arr %value, 0\n  %at = ptrtoint ptr %data to i64\n  %whole = icmp eq i64 %at, %start\n",
      "  %owned = and i1 %single, %fits\n  %room = and i1 %owned, %whole\n  br label %done\n",
      "done:\n  %spare = phi i1 [ false, %entry ], [ %room, %check ]\n  ret i1 %spare\n}\n",
      cg_slot_refs(cg_value(n_t_arr(),""),true),cg_slot_refs(cg_value(n_t_arr(),""),false))

fn cg_view_runtime() -> Arr u8 _
  = concat("define internal %ax_arr @neo_own_view(%ax_arr %value) {\nentry:\n",
      "  %control = extractvalue %ax_arr %value, 3\n  %borrowed = icmp eq ptr %control, null\n",
      "  br i1 %borrowed, label %copy, label %keep\nkeep:\n  ret %ax_arr %value\ncopy:\n",
      "  %data = extractvalue %ax_arr %value, 0\n  %length = extractvalue %ax_arr %value, 1\n",
      "  %owned = call ptr @ax_heap_alloc(i64 %length)\n",
      "  call void @llvm.memcpy.p0.p0.i64(ptr %owned, ptr %data, i64 %length, i1 false)\n",
      "  %header = getelementptr i8, ptr %owned, i64 -16\n",
      "  %buffer = insertvalue %ax_arr %value, ptr %owned, 0\n  %flag = insertvalue %ax_arr %buffer, i64 1, 2\n",
      "  %result = insertvalue %ax_arr %flag, ptr %header, 3\n  ret %ax_arr %result\n}\n")

fn cg_failure_runtime(executable:bool, source_runtime:bool) -> Arr u8 _
  = if executable then concat(if source_runtime then "" else "declare void @ax_trap(ptr)\ndeclare void @ax_precondition_failed(ptr)\ndeclare void @ax_exit(i64)\n",
      "define internal void @neo_runtime_trap(ptr %message) noreturn {\n  call void @ax_trap(ptr %message)\n  unreachable\n}\n",
      "define internal void @neo_precondition_trap(ptr %message) noreturn {\n  call void @ax_precondition_failed(ptr %message)\n",
      "  call void @ax_exit(i64 3)\n  unreachable\n}\n") else concat("declare void @llvm.trap()\n",
      "define internal void @neo_runtime_trap(ptr %message) noreturn {\n  call void @llvm.trap()\n  unreachable\n}\n",
      "define internal void @neo_precondition_trap(ptr %message) noreturn {\n  call void @llvm.trap()\n  unreachable\n}\n")

fn cg_byte_runtime() -> Arr u8 _
  = "define internal i1 @neo.bytes.equal(%ax_arr %a, %ax_arr %b) alwaysinline {
entry:
  %n = extractvalue %ax_arr %a, 1
  %m = extractvalue %ax_arr %b, 1
  %pa = extractvalue %ax_arr %a, 0
  %pb = extractvalue %ax_arr %b, 0
  %same = icmp eq i64 %n, %m
  br i1 %same, label %identity, label %no
identity:
  %identical = icmp eq ptr %pa, %pb
  %limit = sub i64 %n, 8
  br i1 %identical, label %yes, label %words
words:
  %at = phi i64 [ 0, %identity ], [ %advance, %word ]
  %full = icmp sle i64 %at, %limit
  br i1 %full, label %word, label %loop
word:
  %aw = getelementptr i8, ptr %pa, i64 %at
  %bw = getelementptr i8, ptr %pb, i64 %at
  %ax = load i64, ptr %aw, align 1
  %bx = load i64, ptr %bw, align 1
  %match = icmp eq i64 %ax, %bx
  %advance = add i64 %at, 8
  br i1 %match, label %words, label %no
loop:
  %i = phi i64 [ %at, %words ], [ %next, %byte ]
  %done = icmp eq i64 %i, %n
  br i1 %done, label %yes, label %byte
byte:
  %ap = getelementptr i8, ptr %pa, i64 %i
  %bp = getelementptr i8, ptr %pb, i64 %i
  %x = load i8, ptr %ap, align 1
  %y = load i8, ptr %bp, align 1
  %equal = icmp eq i8 %x, %y
  %next = add i64 %i, 1
  br i1 %equal, label %loop, label %no
yes:
  ret i1 true
no:
  ret i1 false
}

define internal void @neo.bytes.write(ptr %data, i64 %number, i64 %width) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %next, %byte ]
  %done = icmp eq i64 %i, %width
  br i1 %done, label %exit, label %byte
byte:
  %offset = mul i64 %i, 8
  %word = lshr i64 %number, %offset
  %value = trunc i64 %word to i8
  %dest = getelementptr i8, ptr %data, i64 %i
  store i8 %value, ptr %dest, align 1
  %next = add i64 %i, 1
  br label %loop
exit:
  ret void
}

define internal i64 @neo.bytes.read(ptr %data, i64 %width) {
entry:
  switch i64 %width, label %invalid [
    i64 1, label %one
    i64 2, label %two
    i64 4, label %four
    i64 8, label %eight
  ]
one:
  %a = load i8, ptr %data, align 1
  %a64 = zext i8 %a to i64
  ret i64 %a64
two:
  %b = load i16, ptr %data, align 1
  %b64 = zext i16 %b to i64
  ret i64 %b64
four:
  %c = load i32, ptr %data, align 1
  %c64 = zext i32 %c to i64
  ret i64 %c64
eight:
  %d = load i64, ptr %data, align 1
  ret i64 %d
invalid:
  unreachable
}
"

fn cg_record_refs(borrow m:Mods, id:i64, retain:bool) -> Arr u8 _
  = let fields=md_node(m,id).b in let record=cg_value(n_t_rec(),"%value") with { record=id } in
    let body=loop (i=0, out=tx_empty()) while i<ast_list_len(m.ast,fields)
      next (i+1,let field=cg_field_type(m,fields,i) with { operand=concat("%field",int_text(i)) } in
        if !cg_managed(field) then out else
        concat(out,"  ",field.operand," = extractvalue ",cg_typed(record),", ",int_text(i),"\n",cg_ref_call(field,retain))) yield out in
    concat("define internal void ",cg_ref_name(record,retain),"(",cg_typed(record),") {\nentry:\n",body,"  ret void\n}\n",
      cg_slot_refs(record,retain))

type CgLayout = { fields:Arr u8 _, ok:bool }
fn cg_record_layout(borrow m:Mods, move p:CgProgram, module:i64, id:i64) -> CgProgram
  = let fields=md_node(m,id).b in
    let layout=loop (i=0, layout=CgLayout { fields=tx_empty(), ok=true }) while layout.ok && i<ast_list_len(m.ast,fields)
      next (i+1,let field=cg_field_type(m,fields,i) in
        CgLayout { fields=concat(layout.fields,if i==0 then "" else ", ",cg_type_of(field)), ok=cg_supported(field) }) yield layout in
    if !layout.ok then CgProgram { text=tx_empty(), report=TcReport { result=tc_unsupported(id,"record layout outside the supported subset"), module=module } } else
    p with { text=concat(p.text,cg_record_name(id)," = type { ",layout.fields," }\n") }

fn cg_partition_module(borrow selected:Arr i64 _, module:i64, partition:i64) -> bool
  = partition!=2 || tx_at(selected,module)==1

; own: only the records of the cached runtime object's modules, whose code
; uses no others, so that object is the same for every program.
fn cg_records(borrow m:Mods, move p:CgProgram, own:bool) -> CgProgram
  = let layouts=loop (k=0, code=p) while code.report.result.value.ty>0 && k<len(m.paths)
      next (k+1,let ids=if own && tx_at(m.shared,k)!=1 then tx_ints() else md_list(m.types,k) in
        loop (i=0, out=code) while out.report.result.value.ty>0 && i<len(ids)
          next (i+1,cg_record_layout(m,out,k,tx_at(ids,i))) yield out) yield code in
    if layouts.report.result.value.ty<=0 then layouts else
    ; LLVM permits forward references in named layouts, but a by-value call
    ; in an ownership helper requires the argument layout to be defined first.
    let text=loop (k=0, out=layouts.text) while k<len(m.paths)
      next (k+1,let ids=if own && tx_at(m.shared,k)!=1 then tx_ints() else md_list(m.types,k) in loop (i=0, code=out) while i<len(ids)
        next (i+1,let id=tx_at(ids,i) in concat(code,cg_record_refs(m,id,true),cg_record_refs(m,id,false))) yield code) yield out in
    layouts with { text=text }

fn cg_import_function(borrow m:Mods, id:i64) -> Arr u8 _
  = let f=md_node(m,id) in
    let parameters=loop (i=0, text="") while i<ast_list_len(m.ast,f.b)
      next (i+1,let p=md_node(m,ast_list_at(m.ast,f.b,i)) in
        concat(text,if i==0 then "" else ", ",cg_type_of(cg_declaration(m,p.b)))) yield text in
    let rest=if !ast_flag(f,fl_variadic()) then "" else if len(parameters)==0 then "..." else ", ..." in
    let result=cg_return(cg_declaration(m,f.c)) in
    concat("declare ",if tc_abi_boundary(f) then "" else "hidden ",result," ",cg_symbol(m,id),"(",parameters,rest,")\n",
      if cg_lends(m,f) then concat("declare hidden ",result," ",cg_lent_symbol(m,id),"(",parameters,")\n") else "")

; Reachability. An executable's module keeps only the functions that its
; entry point, its exported interface or the startup code can reach, so Clang
; does not optimise the unused remainder of the runtime and the libraries.
; References are read from the lowered text: every use of a function names its
; symbol after an '@'.
; units: the piece that defines each function node, or -1. names and owners:
; the ABI symbols and their pieces. roots: the pieces that are always kept.
type CgPieces = { pieces:Arr Arr u8 _ _, report:TcReport, units:Arr i64 _, names:Arr Arr u8 _ _, owners:Arr i64 _, roots:Arr i64 _ }
type CgReach = { kept:Arr i64 _, queue:Arr i64 _ }

; A function that stays without a reference: a declaration, part of the
; program's own ABI, or a C library routine LLVM may call by itself.
fn cg_reach_root(borrow m:Mods, id:i64) -> bool
  = let f=md_node(m,id) in
    ast_flag(f,fl_external()) || (ast_flag(f,fl_exported()) && (!cg_runtime_owner(m,id) ||
      str_find(" memcpy memmove memset memcmp bcmp bzero memset_pattern16 ",concat(" ",md_str(m,f.a)," ")).present))

fn cg_piece_function(borrow m:Mods, move p:CgPieces, id:i64, borrow function:CgState) -> CgPieces
  = let index=len(p.pieces) in let text=concat(function.globals,function.text) in
    if id<0 || id>=len(p.units) then p with { pieces=push(p.pieces,text), roots=push(p.roots,index) } else
    let p=p with { pieces=push(p.pieces,text), units=set(p.units,id,index) } in
    let p=if cg_reach_root(m,id) then p with { roots=push(p.roots,index) } else p in
    let symbol=cg_symbol(m,id) in if len(symbol)<3 || tx_byte(symbol,1)!=34 then p else
    p with { names=push(p.names,pt_slice(symbol,2,len(symbol)-1)), owners=push(p.owners,index) }

; A par clone (cg_function_mode): kept when its symbol @neo_par_<id> is used.
fn cg_piece_par(move p:CgPieces, id:i64, borrow function:CgState) -> CgPieces
  = let index=len(p.pieces) in
    p with { pieces=push(p.pieces,concat(function.globals,function.text)), names=push(p.names,pt_slice(cg_par_symbol(id),1,len(cg_par_symbol(id)))),
      owners=push(p.owners,index) }

; The declaration of a function that lives in another object: kept when the
; module refers to its symbol.
fn cg_piece_import(borrow m:Mods, move p:CgPieces, id:i64) -> CgPieces
  = let index=len(p.pieces) in let symbol=cg_symbol(m,id) in
    let p=p with { pieces=push(p.pieces,cg_import_function(m,id)) } in
    if len(symbol)<3 || tx_byte(symbol,1)!=34 then p with { roots=push(p.roots,index) }
    else p with { names=push(p.names,pt_slice(symbol,2,len(symbol)-1)), owners=push(p.owners,index) }

fn cg_reach_mark(move r:CgReach, piece:i64) -> CgReach
  = if piece<0 || piece>=len(r.kept) || tx_at(r.kept,piece)==1 then r
    else r with { kept=set(r.kept,piece,1), queue=push(r.queue,piece) }

fn cg_reach_word(byte:i64) -> bool
  = (byte>=48 && byte<=57) || (byte>=65 && byte<=90) || (byte>=97 && byte<=122) || byte==95 || byte==46 || byte==36
; The piece that defines the symbol after the '@' before text[at], or -1.
fn cg_reach_symbol(borrow text:Arr u8 _, at:i64, borrow p:CgPieces) -> i64
  = if bytes_match_at(text,at,"neo_fn_") then
      let id=loop (j=at+7, id=0) while j<at+23 && tx_byte(text,j)>=48 && tx_byte(text,j)<=57
        next (j+1,id*10+tx_byte(text,j)-48) yield id in
      if id<len(p.units) then tx_at(p.units,id) else -1
    else let quoted=tx_byte(text,at)==34 in let start=if quoted then at+1 else at in
    ; An ABI symbol is written with or without quotes.
    let end=loop (j=start) while j<len(text) && (if quoted then tx_byte(text,j)!=34 else cg_reach_word(tx_byte(text,j)))
      next (j+1) yield j in
    let stop=if end-start>5 && bytes_match_at(text,end-5,".lent") then end-5 else end in
    loop (k=0, found=-1) while found<0 && k<len(p.names)
      next (k+1,let name=md_word(p.names,k) in
        if len(name)==stop-start && bytes_match_at(text,start,name) then tx_at(p.owners,k) else -1) yield found

fn cg_reach_scan(borrow text:Arr u8 _, borrow p:CgPieces, move found:CgReach) -> CgReach
  = loop (i=0, r=found) while i<len(text)
      next (i+1,if tx_byte(text,i)!=64 then r else cg_reach_mark(r,cg_reach_symbol(text,i+1,p))) yield r

; The named functions of the kept object that can start a thread: those that
; call spawn_thread and those that refer to one that can. A program that
; refers to none of them has one thread (see cg_program_part).
fn cg_refers(borrow text:Arr u8 _, borrow p:CgPieces, borrow flags:Arr i64 _) -> bool
  = loop (i=0, found=false) while !found && i<len(text)
      next (i+1,tx_byte(text,i)==64 && tx_at(flags,cg_reach_symbol(text,i+1,p))==1) yield found
type CgSpawn = { flags:Arr i64 _, changed:bool }
fn cg_spawn_round(borrow p:CgPieces, move s:CgSpawn) -> CgSpawn
  = loop (i=0, out=s with { changed=false }) while i<len(p.pieces)
      next (i+1,if tx_at(out.flags,i)==1 || !cg_refers(md_word(p.pieces,i),p,out.flags) then out
        else check i>=0 && i<len(out.flags) in CgSpawn { flags=set(out.flags,i,1), changed=true }) yield out
fn cg_spawners(borrow p:CgPieces) -> Arr u8 _
  = let direct=arr(i in 0..len(p.pieces)) if str_find(md_word(p.pieces,i),"call i64 @neo_spawn_thread(").present then 1 else 0 in
    let all=loop (s=CgSpawn { flags=direct, changed=true }) while s.changed next (cg_spawn_round(p,s)) yield s.flags in
    loop (k=0, out=" ") while k<len(p.names)
      next (k+1,if tx_at(all,tx_at(p.owners,k))==1 then concat(out,md_word(p.names,k)," ") else out) yield out
; Whether a program's text can start a thread: it calls spawn_thread or
; refers to one of the kept object's functions that can.
fn cg_threaded(borrow text:Arr u8 _, borrow list:Arr u8 _) -> bool
  = str_find(text,"call i64 @neo_spawn_thread(").present ||
    loop (i=1, found=false) while !found && i<len(list)
      next (md_word_end(list,i)+1,let name=pt_slice(list,i,md_word_end(list,i)) in
        len(name)>0 && (str_find(text,concat("@\"",name,"\"")).present || str_find(text,concat("@",name,"(")).present)) yield found

; The array helpers a module with this text is given (see cg_program_part).
fn cg_array_helpers(borrow text:Arr u8 _, source_runtime:bool, counting:i64) -> Arr u8 _
  = if str_find(text,"@neo_own_view(").present then concat(cg_array_runtime(source_runtime,counting),cg_view_runtime())
    else if str_find(text,"@neo_retain(").present || str_find(text,"@neo_release(").present ||
      str_find(text,"@ax_heap_alloc(").present || str_find(text,"define %ax_arr @neo_entry(").present then
      cg_array_runtime(source_runtime,counting) else tx_empty()

; The pieces an executable keeps. The array helpers call the allocator, and
; which of them a module needs depends on what it keeps: none, the counting
; helpers, or those and the view helper. The choice only grows, so it settles.
type CgKept = { helpers:Arr u8 _, pieces:Arr Arr u8 _ _, settled:bool }
fn cg_keep_more(borrow p:CgPieces, borrow startup:Arr u8 _, source_runtime:bool, move k:CgKept) -> CgKept
  = let helpers=cg_array_helpers(str_concat_parts(k.pieces),source_runtime,1) in
    if tx_equal(helpers,k.helpers) then k with { settled=true }
    else CgKept { helpers=helpers, pieces=cg_reachable(p,concat(startup,helpers)), settled=false }
fn cg_kept(borrow p:CgPieces, borrow startup:Arr u8 _, source_runtime:bool) -> Arr Arr u8 _ _
  = loop (k=CgKept { helpers=tx_empty(), pieces=cg_reachable(p,startup), settled=false }) while !k.settled
      next (cg_keep_more(p,startup,source_runtime,k)) yield k.pieces

fn cg_reachable(borrow p:CgPieces, borrow startup:Arr u8 _) -> Arr Arr u8 _ _
  = let none=CgReach { kept=arr(i in 0..len(p.pieces)) 0, queue=tx_ints() } in
    let rooted=loop (i=0, r=cg_reach_scan(startup,p,none)) while i<len(p.roots)
      next (i+1,cg_reach_mark(r,tx_at(p.roots,i))) yield r in
    let reach=loop (at=0, r=rooted) while at<len(r.queue)
      next (at+1,cg_reach_scan(md_word(p.pieces,tx_at(r.queue,at)),p,r)) yield r in
    loop (i=0, kept=md_words()) while i<len(p.pieces)
      next (i+1,if tx_at(reach.kept,i)==1 then push(kept,md_word(p.pieces,i)) else kept) yield kept

; startup: the text an executable adds after this module; what it calls stays.
fn cg_program_part(borrow m:Mods, borrow target:Arr u8 _, allocation_stats:bool, source_runtime:bool,
                   borrow selected:Arr i64 _, partition:i64, borrow startup:Arr u8 _) -> CgProgram
  = let fns=tc_functions(m) in
    let runtime=if source_runtime then cg_runtime_check(m,fns) else TcReport { result=tc_type(n_t_unit()), module=-1 } in
    if runtime.result.value.ty<=0 then CgProgram { text=tx_empty(), report=runtime } else
    let views=loop (i=0, found=partition!=0) while !found && i<len(m.ast.nodes)/11
      next (i+1,let n=md_node(m,i) in n.kind==n_call() &&
        (tx_equal(md_str(m,n.a),"view") || tx_equal(md_str(m,n.a),"handler_call"))) yield found in
    let header=concat("source_filename = \"neo\"\n",if len(target)==0 then "" else concat("target triple = \"",target,"\"\n"),
      "\n%ax_arr = type { ptr, i64, i64, ptr }\n\n",
      if partition==2 || (len(target)>0 && !source_runtime) then "@ax_runtime_state = external hidden global [256 x i64]\n"
      else concat("@ax_runtime_state = ",if partition==1 then "hidden" else "internal"," global [256 x i64] zeroinitializer, align ",
        if str_starts(target,"x86_64-") && str_find(target,"-linux").present then "4096\n" else "16\n"),
      if partition==2 then "@neo_threads = external hidden global i64\n"
      else concat("@neo_threads = ",if partition==1 then "hidden" else "internal"," global i64 0, align 8\n"),
      if partition==2 then "@ax_native_alloc_stats = external hidden constant i1\n" else
      concat("@ax_native_alloc_stats = ",if len(target)>0 then "hidden" else "internal",
        " constant i1 ",if allocation_stats then "true\n" else "false\n"),
      cg_failure_runtime(len(target)>0,source_runtime),
      "declare i64 @llvm.bswap.i64(i64)\ndeclare i64 @llvm.cttz.i64(i64, i1)\ndeclare double @llvm.sqrt.f64(double)\n",
      "declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)\n",
      "declare { i64, i1 } @llvm.ssub.with.overflow.i64(i64, i64)\n",
      "declare { i64, i1 } @llvm.smul.with.overflow.i64(i64, i64)\n\n",cg_byte_runtime()) in
    ; A library generic can be instantiated with an application record. Keep
    ; those layouts available to both LLVM modules for the shared ABI.
    let start=cg_records(m,CgProgram { text=header, report=TcReport { result=tc_type(n_t_unit()), module=-1 } },
      partition==2 && len(m.shared)>0) in
    let first=CgPieces { pieces=push(md_words(),start.text),report=start.report,units=arr(i in 0..len(m.ast.nodes)/11) -1,
      names=md_words(),owners=tx_ints(),roots=push(tx_ints(),0) } in
    let p=loop (k=0, p=first)
      while p.report.result.value.ty>0 && k<len(m.paths)
      next (k+1,if !cg_partition_module(selected,k,partition) then p else let ids=md_list(m.fns,k) in
        loop (i=0, out=p) while out.report.result.value.ty>0 && i<len(ids)
          next (i+1,let id=tx_at(ids,i) in
            if partition==1 && tx_at(selected,k)==1 then cg_piece_import(m,out,id) else
            let function=cg_function(m,fns,id,false,target,views,source_runtime,partition==2) in
            if function.error>=0 then out with { report=TcReport { result=tc_unsupported(function.error,"LLVM lowering outside the supported subset"), module=k } }
            else cg_piece_function(m,out,id,function)) yield out) yield p in
    if p.report.result.value.ty<=0 then CgProgram { text="",report=p.report } else
    let module=md_entry_module(m) in let id=md_find_decl(m,fns,bk_get(m.local,module,"main")) in
    ; Par clones (regions.neo) for a whole program or its part, built with
    ; the runtime's source, for Linux: the shared dispatcher needs its threads.
    let par=if partition==2 || !source_runtime || !str_find(target,"-linux").present then tx_ints() else rg_par_set(m,fns,id) in
    let p=loop (k=0, out=p) while out.report.result.value.ty>0 && k<len(par)
      next (k+1,if tx_at(par,k)!=1 then out else
        let clone=cg_function_mode(m,fns,k,false,target,views,source_runtime,false,par) in
        if clone.error>=0 then out with { report=TcReport { result=tc_unsupported(clone.error,"LLVM lowering outside the supported subset"), module=module } }
        else cg_piece_par(out,k,clone)) yield out in
    if p.report.result.value.ty<=0 then CgProgram { text="",report=p.report } else
    let entry=if partition==2 then p else let code=cg_function_mode(m,fns,id,true,target,views,source_runtime,false,par) in
      if code.error>=0 then p with { report=TcReport { result=tc_unsupported(code.error,"LLVM lowering outside the supported subset"), module=module } }
      else cg_piece_function(m,p,-1,code) in
    if entry.report.result.value.ty<=0 then CgProgram { text="",report=entry.report } else
    let prune=(partition==0 || (partition==1 && len(m.shared)>0)) && source_runtime && len(target)>0 && !m.stable_symbols in
    let text=str_concat_parts(if prune then cg_kept(entry,startup,source_runtime) else entry.pieces) in
    let text=concat(text,na_runtime(target,text,partition),na_crypto(target,text),
      if !source_runtime && str_find(text,"call ptr @ax_alloc(").present then "declare ptr @ax_alloc(i64)\n" else "",
      if !source_runtime && str_find(text,"call i64 @ax_serve(").present then "declare i64 @ax_serve(i64, ptr)\n" else "") in
    ; Threads start only through spawn_thread, so a whole program that never
    ; calls it has one thread and needs no atomic reference counts. An object
    ; linked with others tests the flag spawn_thread sets, unless it is the
    ; program itself and refers to nothing in the kept object that can start one.
    ; A forking region (cg_par_range) makes its children count references
    ; in shared pages, so its program counts atomically too.
    let forks=str_find(text,"call void @ax_par_for(").present in
    let alone=if partition==0 then prune && !str_find(text,"call i64 @neo_spawn_thread(").present && !forks
      else partition==1 && prune && len(m.threaded)>0 && !cg_threaded(concat(text,startup),m.threaded) && !forks in
    let counting=if alone then 0 else if partition==0 then 1 else 2 in
    let noted=if partition==2 && len(m.shared)>0 then concat("; neo-threads:",cg_spawners(entry),"\n") else tx_empty() in
    ; The startup presets the heap mode (runtime state 184): private pages
    ; (1) when every region runs on threads, as in the reference compiler.
    let heap=if partition==2 then tx_empty() else concat("@neo_heap_mode = internal constant i64 ",
      if str_find(text,"call void @ax_par_for_shared(").present && !forks then "1\n" else "0\n") in
    CgProgram { text=concat(text,cg_array_helpers(text,source_runtime,counting),noted,heap),report=entry.report }

fn cg_program(borrow m:Mods, borrow target:Arr u8 _, allocation_stats:bool, source_runtime:bool) -> CgProgram
  = cg_program_part(m,target,allocation_stats,source_runtime,tx_ints(),0,"")
