; Byte-buffer helpers shared by the compiler's stages.
import "std:strings"
import "std:unicode"

fn tx_empty() -> Arr u8 _ = arr(i in 0..0) u8(0)
fn tx_ints() -> Arr i64 _ = arr(i in 0..0) 0
fn tx_at(borrow a:Arr i64 _, i:i64) -> i64 = if i>=0 && i<len(a) then a[i] else 0

; The first count values of a, or all of a when it is shorter.
fn tx_take(borrow a:Arr i64 _, count:i64) -> Arr i64 _
  = let m=if count<0 then 0 else if count<len(a) then count else len(a) in
    arr(i in 0..m) if i>=0 && i<len(a) then a[i] else 0

fn tx_byte(borrow text:Arr u8 _, i:i64) -> i64 = if i>=0 && i<len(text) then i64(text[i]) else -1

fn tx_has(borrow text:Arr u8 _, byte:i64) -> bool
  = loop (i:i64{i>=0}=0, found=false) while !found && i<len(text) next (i+1, i64(text[i])==byte) yield found

fn tx_equal(borrow a:Arr u8 _, borrow b:Arr u8 _) -> bool = len(a)==len(b) && bytes_match_at(a,0,b)

; Python's str ordering: code point order, which is UTF-8 byte order.
fn tx_less(borrow a:Arr u8 _, borrow b:Arr u8 _) -> bool
  = let i=loop (i:i64{i>=0}=0) while i<len(a) && i<len(b) && a[i]==b[i] next (i+1) yield i in
    if i<len(a) && i<len(b) then tx_byte(a,i)<tx_byte(b,i) else len(a)<len(b)

fn tx_hex_digit(d:i64) -> u8 = u8(if d<10 then 48+d else 87+d)
fn tx_hex_byte(move out:Arr u8 _, b:i64) -> Arr u8 _
  = push(push(out,tx_hex_digit(bit_and(shift_right(b,4),15))),tx_hex_digit(bit_and(b,15)))
fn tx_hex_bytes(move out:Arr u8 _, borrow b:Arr u8 _) -> Arr u8 _
  = loop (o=out, i:i64{i>=0}=0) while i<len(b) next (tx_hex_byte(o,i64(b[i])), i+1) yield o
; The low 4*digits bits of x as lowercase hex, most significant digit first.
fn tx_hex(move out:Arr u8 _, x:i64, digits:i64) -> Arr u8 _
  = loop (o=out, k=digits-1) while k>=0 next (push(o,tx_hex_digit(bit_and(shift_right(x,k*4),15))), k-1) yield o

fn tx_int(move out:Arr u8 _, value:i64) -> Arr u8 _ = concat(out,int_text(value))

; Python's str.isprintable() for one code point above 0x7e: false for the
; Other and Separator categories. Exact for Latin-1; above it, covers the
; format, separator, surrogate and private-use code points (unassigned ones
; count as printable).
fn tx_printable(code:i64) -> bool
  = if code<=160 then false
    else if code<=255 then code!=173
    else !(code==1564 || code==5760 || code==6158 || (code>=8192 && code<=8207) || (code>=8232 && code<=8239)
           || (code>=8287 && code<=8292) || (code>=8294 && code<=8303) || code==12288 || (code>=55296 && code<=63743)
           || code==65279 || (code>=65529 && code<=65531) || code==65534 || code==65535 || code==69821
           || (code>=119155 && code<=119162) || code==917505 || (code>=917536 && code<=917631) || code>=983040)

fn tx_repr_char(move out:Arr u8 _, code:i64, quote:i64) -> Arr u8 _
  = if code==quote || code==92 then push(push(out,'\\'),u8(code))
    else if code==9 then concat(out,"\\t")
    else if code==10 then concat(out,"\\n")
    else if code==13 then concat(out,"\\r")
    else if code<32 || code==127 then tx_hex_byte(concat(out,"\\x"),code)
    else if code<127 then push(out,u8(code))
    else if tx_printable(code) then concat(out,utf8_encode(code).value)
    else if code<=255 then tx_hex_byte(concat(out,"\\x"),code)
    else if code<=65535 then tx_hex(concat(out,"\\u"),code,4)
    else tx_hex(concat(out,"\\U"),code,8)

; Python's repr() of a str, so diagnostics match neoc's byte for byte. With
; latin1 every byte is one character (neoc keeps string literal tokens as
; Latin-1 text); otherwise text is UTF-8.
fn tx_repr(borrow text:Arr u8 _, latin1:bool) -> Arr u8 _
  = let quote=if tx_has(text,39) && !tx_has(text,34) then 34 else 39 in
    let body=loop (o=push(tx_empty(),u8(quote)), i=0) while i>=0 && i<len(text)
      next (if latin1 then tx_repr_char(o,tx_byte(text,i),quote) else tx_repr_char(o,unicode_next(text,i).code,quote),
            if latin1 then i+1 else unicode_next(text,i).end)
      yield o in
    push(body,u8(quote))

; Python's universal newlines: CRLF and lone CR read as LF.
fn tx_newlines(move src:Arr u8 _) -> Arr u8 _
  = if !tx_has(src,13) then src else
    loop (o=tx_empty(), i:i64{i>=0}=0) while i<len(src)
      next (push(o,if src[i]=='\r' then '\n' else src[i]),
            if src[i]=='\r' && tx_byte(src,i+1)==10 then i+2 else i+1)
      yield o
