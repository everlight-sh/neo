; Lexer: Neo source bytes to tokens, as the Python reference lexed them
; (neoc/syntax.py lex(), v0.2.4 tag). Columns count code points; string
; literal tokens hold their decoded bytes, byte literal tokens their decimal
; value.
import "std:strings"
import "std:unicode"
import "text.neo"

; Tokens are stored flat, six numbers each in Tok's field order: push grows an
; array of numbers in place, but copies a whole array of records.
type Tok = { kind:i64, code:i64, start:i64, size:i64, line:i64, col:i64 }
type Lx = { src:Arr u8 _, i:i64, line:i64, col:i64, toks:Arr i64 _, text:Arr u8 _, buf:Arr u8 _, stop:bool,
            ok:bool, err:Arr u8 _, eline:i64, ecol:i64 }

; Token kinds. A keyword's or symbol's code is its index in lx_kw_text or
; lx_sym_text; a byte literal's code is its value.
fn tk_ident() -> i64 = 1
fn tk_int() -> i64 = 2
fn tk_float() -> i64 = 3
fn tk_str() -> i64 = 4
fn tk_char() -> i64 = 5
fn tk_kw() -> i64 = 6
fn tk_sym() -> i64 = 7
fn tk_eof() -> i64 = 8

fn lx_tok_count(borrow toks:Arr i64 _) -> i64 = len(toks)/6
fn lx_tok(borrow toks:Arr i64 _, k:i64) -> Tok
  = let at=k*6 in
    Tok { kind=tx_at(toks,at), code=tx_at(toks,at+1), start=tx_at(toks,at+2), size=tx_at(toks,at+3),
          line=tx_at(toks,at+4), col=tx_at(toks,at+5) }
fn lx_push_tok(move toks:Arr i64 _, kind:i64, code:i64, start:i64, size:i64, line:i64, col:i64) -> Arr i64 _
  = push(push(push(push(push(push(toks,kind),code),start),size),line),col)

fn lx_kind_name(kind:i64) -> Arr u8 _
  = if kind==1 then "IDENT" else if kind==2 then "INT" else if kind==3 then "FLOAT" else if kind==4 then "STR"
    else if kind==5 then "CHAR" else if kind==6 then "KW" else if kind==7 then "SYM" else "EOF"

fn lx_kw_count() -> i64 = 41
fn lx_kw_text(code:i64) -> Arr u8 _
  = if code==1 then "fn" else if code==2 then "let" else if code==3 then "in" else if code==4 then "if"
    else if code==5 then "then" else if code==6 then "else" else if code==7 then "sum" else if code==8 then "arr"
    else if code==9 then "loop" else if code==10 then "while" else if code==11 then "next" else if code==12 then "yield"
    else if code==13 then "check" else if code==14 then "true" else if code==15 then "false" else if code==16 then "len"
    else if code==17 then "i64" else if code==18 then "f64" else if code==19 then "u8" else if code==20 then "u16"
    else if code==21 then "bool" else if code==22 then "Arr" else if code==23 then "type" else if code==24 then "with"
    else if code==25 then "effect" else if code==26 then "extern" else if code==27 then "export" else if code==28 then "ptr"
    else if code==29 then "i32" else if code==30 then "unit" else if code==31 then "import" else if code==32 then "sealed"
    else if code==33 then "enum" else if code==34 then "match" else if code==35 then "as" else if code==36 then "move"
    else if code==37 then "pub" else if code==38 then "private" else if code==39 then "resource" else if code==40 then "drop"
    else if code==41 then "using" else ""

; In matching order: a longer symbol before its prefixes.
fn lx_sym_count() -> i64 = 30
fn lx_sym_text(code:i64) -> Arr u8 _
  = if code==1 then "..." else if code==2 then "::" else if code==3 then "=>" else if code==4 then "->"
    else if code==5 then ".." else if code==6 then "==" else if code==7 then "!=" else if code==8 then "<="
    else if code==9 then ">=" else if code==10 then "&&" else if code==11 then "||" else if code==12 then "?"
    else if code==13 then "(" else if code==14 then ")" else if code==15 then "{" else if code==16 then "}"
    else if code==17 then "[" else if code==18 then "]" else if code==19 then "," else if code==20 then ":"
    else if code==21 then "=" else if code==22 then "<" else if code==23 then ">" else if code==24 then "+"
    else if code==25 then "-" else if code==26 then "*" else if code==27 then "/" else if code==28 then "%"
    else if code==29 then "!" else if code==30 then "." else ""

fn lx_keyword(borrow text:Arr u8 _, start:i64, size:i64) -> i64
  = loop (code=1, found=0) while found==0 && code<=lx_kw_count()
      next (code+1, if size==len(lx_kw_text(code)) && bytes_match_at(text,start,lx_kw_text(code)) then code else 0)
      yield found

fn lx_symbol_at(borrow src:Arr u8 _, i:i64) -> i64
  = loop (code=1, found=0) while found==0 && code<=lx_sym_count()
      next (code+1, if bytes_match_at(src,i,lx_sym_text(code)) then code else 0)
      yield found

fn lx_digit(b:i64) -> bool = b>=48 && b<=57
fn lx_digits(borrow src:Arr u8 _, i:i64) -> i64 = loop (j=i) while lx_digit(tx_byte(src,j)) next (j+1) yield j

; Bytes in the code point starting at i.
fn lx_width(borrow src:Arr u8 _, i:i64) -> i64
  = let b=tx_byte(src,i) in
    let w=if b<128 then 1 else if b<224 then 2 else if b<240 then 3 else 4 in
    if i+w<=len(src) then w else if i<len(src) then len(src)-i else 0
fn lx_char_at(borrow src:Arr u8 _, i:i64) -> Arr u8 _
  = let w=lx_width(src,i) in if i>=0 && w>0 then byte_slice(src,i,i+w) else tx_empty()

; Width of an identifier character at i, 0 if there is none. neoc uses
; str.isalnum(); outside ASCII this uses Unicode word characters.
fn lx_word_at(borrow src:Arr u8 _, i:i64) -> i64
  = let b=tx_byte(src,i) in
    if b<0 then 0
    else if lx_digit(b) || (b>=65 && b<=90) || (b>=97 && b<=122) || b==95 then 1
    else if b<128 then 0
    else let rune=unicode_next(src,i) in if rune.ok && unicode_word(rune.code) && rune.end>i then rune.end-i else 0

; Columns count code points: a UTF-8 continuation byte does not move them.
fn lx_advance(move lx:Lx, j:i64) -> Lx
  = loop (s=lx) while s.i<j
      next (let b=tx_byte(s.src,s.i) in
            s with { i=s.i+1, line=if b==10 then s.line+1 else s.line,
                     col=if b==10 then 1 else if b>=128 && b<192 then s.col else s.col+1 })
      yield s

fn lx_fail(move lx:Lx, borrow msg:Arr u8 _, line:i64, col:i64) -> Lx
  = if !lx.ok then lx else lx with { ok=false, err=msg, eline=line, ecol=col }

fn lx_emit_src(move lx:Lx, kind:i64, code:i64, start:i64, end:i64, line:i64, col:i64) -> Lx
  = let at=len(lx.text) in
    let piece=if start>=0 && start<=end && end<=len(lx.src) then byte_slice(lx.src,start,end) else tx_empty() in
    lx with { toks=lx_push_tok(lx.toks,kind,code,at,len(piece),line,col), text=concat(lx.text,piece) }

fn lx_emit_text(move lx:Lx, kind:i64, code:i64, borrow piece:Arr u8 _, line:i64, col:i64) -> Lx
  = let at=len(lx.text) in
    lx with { toks=lx_push_tok(lx.toks,kind,code,at,len(piece),line,col), text=concat(lx.text,piece) }

fn lx_escape(e:i64) -> i64
  = if e==i64('n') then 10 else if e==i64('r') then 13 else if e==i64('t') then 9 else if e==i64('0') then 0
    else if e==i64('\\') then 92 else if e==i64('"') then 34 else if e==i64('\'') then 39 else -1

fn lx_hex_value(b:i64) -> i64
  = if b>=48 && b<=57 then b-48 else if b>=97 && b<=102 then b-87 else if b>=65 && b<=70 then b-55 else -1

; One step inside a string or byte literal opened at line:col.
fn lx_string_step(move lx:Lx, quote:i64, line:i64, col:i64) -> Lx
  = let b=tx_byte(lx.src,lx.i) in
    if b<0 then lx_fail(lx,"unterminated literal",line,col)
    else if b==quote then lx_advance(lx,lx.i+1) with { stop=true }
    else if b!=92 then let i=lx.i in lx_advance(lx with { buf=push(lx.buf,u8(b)) },i+1)
    else let lx=lx_advance(lx,lx.i+1) in
         let e=tx_byte(lx.src,lx.i) in
         if e<0 then lx_fail(lx,"unterminated escape",line,col)
         else let i=lx.i in let escaped=lx_char_at(lx.src,i) in
         let lx=lx_advance(lx,i+lx_width(lx.src,i)) in
         if e==i64('x') then
           let high=lx_hex_value(tx_byte(lx.src,lx.i)) in let low=lx_hex_value(tx_byte(lx.src,lx.i+1)) in
           if high<0 || low<0 then lx_fail(lx,"bad escape \\x",line,col)
           else let j=lx.i+2 in lx_advance(lx with { buf=push(lx.buf,u8(high*16+low)) },j)
         else let v=lx_escape(e) in
         if v<0 then lx_fail(lx,concat("bad escape \\",escaped),line,col)
         else lx with { buf=push(lx.buf,u8(v)) }

fn lx_string(move lx:Lx, quote:i64) -> Lx
  = let line=lx.line in let col=lx.col in
    let lx=lx_advance(lx,lx.i+1) with { buf=tx_empty(), stop=false } in
    let lx=loop (s=lx) while s.ok && !s.stop next (lx_string_step(s,quote,line,col)) yield s in
    if !lx.ok then lx
    else if quote==39 then
      (if len(lx.buf)!=1 then lx_fail(lx,"byte literal must be exactly one byte",line,col)
       else let value=tx_byte(lx.buf,0) in lx_emit_text(lx,tk_char(),value,int_text(value),line,col))
    else let piece=lx.buf in lx_emit_text(lx with { buf=tx_empty() },tk_str(),0,piece,line,col)

fn lx_number(move lx:Lx) -> Lx
  = let i=lx.i in let j=lx_digits(lx.src,i) in
    let float=tx_byte(lx.src,j)==i64('.') && lx_digit(tx_byte(lx.src,j+1)) in
    let j=if float then lx_digits(lx.src,j+1) else j in
    let e=tx_byte(lx.src,j) in
    let k=if tx_byte(lx.src,j+1)==i64('+') || tx_byte(lx.src,j+1)==i64('-') then j+2 else j+1 in
    let j=if float && (e==i64('e') || e==i64('E')) && lx_digit(tx_byte(lx.src,k)) then lx_digits(lx.src,k) else j in
    let line=lx.line in let col=lx.col in
    lx_advance(lx_emit_src(lx,if float then tk_float() else tk_int(),0,i,j,line,col),j)

fn lx_ident(move lx:Lx) -> Lx
  = let i=lx.i in
    let j=loop (j=i) while lx_word_at(lx.src,j)>0 next (j+lx_word_at(lx.src,j)) yield j in
    let code=lx_keyword(lx.src,i,j-i) in
    let line=lx.line in let col=lx.col in
    lx_advance(lx_emit_src(lx,if code>0 then tk_kw() else tk_ident(),code,i,j,line,col),j)

fn lx_symbol(move lx:Lx) -> Lx
  = let i=lx.i in let code=lx_symbol_at(lx.src,i) in
    let line=lx.line in let col=lx.col in
    if code>0 then let j=i+len(lx_sym_text(code)) in lx_advance(lx_emit_src(lx,tk_sym(),code,i,j,line,col),j)
    else let msg=concat("unexpected character ",tx_repr(lx_char_at(lx.src,i),false)) in lx_fail(lx,msg,line,col)

fn lx_line_end(borrow src:Arr u8 _, i:i64) -> i64 = loop (j=i) while j<len(src) && tx_byte(src,j)!=10 next (j+1) yield j

fn lx_step(move lx:Lx) -> Lx
  = let b=tx_byte(lx.src,lx.i) in
    if b==32 || b==9 || b==13 || b==10 then lx_advance(lx,lx.i+1)
    else if b==i64(';') || b==i64('#') then let j=lx_line_end(lx.src,lx.i) in lx_advance(lx,j)
    else if b==i64('"') || b==i64('\'') then lx_string(lx,b)
    else if lx_digit(b) then lx_number(lx)
    else if lx_word_at(lx.src,lx.i)>0 then lx_ident(lx)
    else lx_symbol(lx)

fn lx_lex(move src:Arr u8 _) -> Lx
  = let lx=Lx { src=src, i=0, line=1, col=1, toks=tx_ints(),
                text=tx_empty(), buf=tx_empty(), stop=false, ok=true, err=tx_empty(), eline=0, ecol=0 } in
    let lx=loop (s=lx) while s.ok && s.i<len(s.src) next (lx_step(s)) yield s in
    if !lx.ok then lx else let line=lx.line in let col=lx.col in lx_emit_src(lx,tk_eof(),0,0,0,line,col)
