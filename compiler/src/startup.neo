; The executable wrapper uses the same freestanding runtime ABI as Python
; neoc. The scalar emitter also works without the wrapper as a linkable IR module.
import "std:strings"
import "text.neo"
import "ast.neo"
import "modules.neo"
import "check.neo"
import "llvm.neo"

type StArgs = { globals:Arr u8 _, code:Arr u8 _, values:Arr u8 _, names:Arr u8 _ }
fn st_arguments(borrow m:Mods, f:Node) -> StArgs
  = loop (i=0, args=StArgs { globals=tx_empty(), code=tx_empty(), values=tx_empty(), names=tx_empty() })
      while i<ast_list_len(m.ast,f.b)
      next (i+1, let p=md_node(m,ast_list_at(m.ast,f.b,i)) in let name=md_str(m,p.a) in
        let index=int_text(i) in let symbol=concat("@neo_arg_",index) in
        StArgs { globals=concat(args.globals,cg_bytes(symbol,name,true)),
          code=concat(args.code,"  %slot",index," = getelementptr ptr, ptr %argv, i64 ",int_text(i+1),"\n",
            "  %arg",index," = load ptr, ptr %slot",index,"\n",
            "  %value",index," = call i64 @ax_parse_i64(ptr %arg",index,", ptr ",symbol,")\n"),
          values=concat(args.values,if i==0 then "" else ", ","i64 %value",index),
          names=concat(args.names,if i==0 then "" else " ",name) }) yield args

fn st_main(borrow m:Mods, id:i64) -> Arr u8 _
  = let f=md_node(m,id) in let result=md_node(m,f.c).kind in
    let args=st_arguments(m,f) in let count=ast_list_len(m.ast,f.b) in
    let usage=if count==0 then "" else concat(
      "  %argc_ok = icmp eq i32 %argc, ",int_text(count+1),"\n",
      "  br i1 %argc_ok, label %parse, label %usage\n",
      "usage:\n  %program = load ptr, ptr %argv\n  call void @ax_usage(ptr %program, ptr @neo_arg_names)\n  ret i32 2\nparse:\n") in
    let call=concat("call ",cg_return(cg_value(result,""))," @neo_entry(",args.values,")\n") in
    let output=if result==n_t_unit() then concat("  ",call) else concat("  %result = ",call,
      if result==n_t_f64() then "  call void @ax_print_f64(double %result)\n"
      else if result==n_t_arr() then concat("  %data = extractvalue %ax_arr %result, 0\n",
        "  %length = extractvalue %ax_arr %result, 1\n  call void @ax_print_bytes(ptr %data, i64 %length)\n",
        "  call void @neo_release(%ax_arr %result)\n")
      else "  call void @ax_print_i64(i64 %result)\n") in
    concat(args.globals,if count==0 then "" else cg_bytes("@neo_arg_names",args.names,true),
      "define i32 @main(i32 %argc, ptr %argv) {\nentry:\n",
      "  %count = zext i32 %argc to i64\n  %end = getelementptr ptr, ptr %argv, i64 %count\n",
      "  %envp = getelementptr ptr, ptr %end, i64 1\n  call void @ax_runtime_init(ptr %envp)\n",
      "  store i64 %count, ptr getelementptr (i8, ptr @ax_runtime_state, i64 40), align 8\n",
      "  store ptr %argv, ptr getelementptr (i8, ptr @ax_runtime_state, i64 48), align 8\n",
      usage,args.code,output,"  ret i32 0\n}\n")

fn st_linux(borrow target:Arr u8 _) -> Arr u8 _
  = let entry=if str_starts(target,"x86_64-") then "movq %rsp, %rdi\\0Aandq $$-16, %rsp\\0Acallq neo_process_start\\0Aud2"
      else "mov x0, sp\\0Abl neo_process_start\\0Abrk #0" in
    concat("define void @_start() naked noreturn {\n  call void asm sideeffect \"",entry,"\", \"~{memory}\"()\n  unreachable\n}\n",
      "define void @neo_process_start(ptr %stack) noreturn {\n  %count = load i64, ptr %stack\n",
      "  %argc = trunc i64 %count to i32\n  %argv = getelementptr i64, ptr %stack, i64 1\n",
      "  %status = call i32 @main(i32 %argc, ptr %argv)\n  %code = sext i32 %status to i64\n",
      "  call void @ax_exit(i64 %code)\n  unreachable\n}\n")

; The text an executable adds after the program's module: its C entry point
; and, on Linux, the process entry. The emitter's source_filename declaration
; must precede module declarations, so this follows the module.
fn st_startup(borrow m:Mods, borrow target:Arr u8 _, source_runtime:bool) -> Arr u8 _
  = let entry=bk_get(m.local,md_entry_module(m),"main") in let id=md_find_decl(m,tc_functions(m),entry) in
    let declarations=if source_runtime then "" else concat("declare void @ax_runtime_init(ptr)\ndeclare void @ax_usage(ptr, ptr)\n",
      "declare i64 @ax_parse_i64(ptr, ptr)\ndeclare void @ax_print_i64(i64)\n",
      "declare void @ax_print_f64(double)\ndeclare void @ax_print_bytes(ptr, i64)\n") in
    concat(declarations,st_main(m,id),if str_find(target,"linux").present then st_linux(target) else "")
