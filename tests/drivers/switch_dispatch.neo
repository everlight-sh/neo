; Ported from tests/test_switch_dispatch.py and the lowering checks of
; tests/opcode_vm.py and tests/deep_dispatch.py: else-if chains (and matches)
; over one scalar lower to one LLVM switch with a case per distinct value, as
; the native compiler's IR (--emit-llvm) and build report (switches) show;
; shapes that do not qualify stay compares; and the programs compute what the
; chains say. Prints "switch dispatch OK".
import "std:fs"
import "std:io"
import "std:strings"
import "../support/driver.neo"
import "../support/language.neo"
import "../support/runtime.neo"
import "../../compiler/src/modules.neo"
import "../../compiler/src/paths.neo"
import "../../compiler/src/test_process.neo"
import "../../compiler/src/text.neo"

; What the compiler prints for source with flag (--emit-llvm or --report).
effect fn sd_compile(borrow tools:DvTools, borrow source:Arr u8 _, borrow flag:Arr u8 _, borrow binary:Arr u8 _) -> Arr u8 _
  = let args=push(push(push(push(md_words(),"build"),tools.root),source),flag) in
    let args=if len(binary)>0 then push(push(args,"-o"),binary) else args in
    let args=if len(tools.target)>0 then push(push(args,"--target"),tools.target) else args in
    let run=nt_process(tools.compiler,args,dv_environment(md_words()),300000,268435456) in
    let ok=dv_expect(run.ok && run.code==0,concat(flag," of ",source," failed: ",nt_diagnostic(run))) in run.output

; Whether the "; fn" line of ir from start to end names the function name
; (a module's functions carry a __m<hash>_ prefix).
fn sd_named(borrow ir:Arr u8 _, start:i64, end:i64, borrow name:Arr u8 _) -> bool
  = let plain=start+5 in
    let local=if bytes_match_at(ir,plain,"__m") && end-plain>20 && tx_byte(ir,plain+19)==95 then plain+20 else plain in
    end-local==len(name) && bytes_match_at(ir,local,name)
; The IR of function name, from its "; fn" line to its closing brace.
effect fn sd_body(borrow ir:Arr u8 _, borrow name:Arr u8 _) -> Arr u8 _
  = let start=loop (at=0, found=-1) while found<0 && at<len(ir)
      next (lg_find_byte(ir,at,10)+1,
        if bytes_match_at(ir,at,"; fn ") && sd_named(ir,at,lg_find_byte(ir,at,10),name) then at else -1) yield found in
    let shown=dv_expect(start>=0,concat("no function ",name," in the IR")) in
    let close=str_find(pt_slice(ir,start,len(ir)),"\n}\n") in
    pt_slice(ir,start,if close.present then start+close.value else len(ir))

fn sd_count(borrow text:Arr u8 _, borrow needle:Arr u8 _) -> i64
  = loop (i=0, n=0) while i+len(needle)<=len(text)
      next (i+1,if bytes_match_at(text,i,needle) then n+1 else n) yield n
; The cases of the first switch in body (its targets but the default).
fn sd_cases(borrow body:Arr u8 _) -> i64
  = let at=str_find(body,"  switch ") in if !at.present then 0 else
    sd_count(pt_slice(body,at.value,lg_find_byte(body,at.value,10)),", label %")-1

effect fn sd_check(ok:bool, borrow what:Arr u8 _, borrow body:Arr u8 _) -> unit
  = dv_expect(ok,concat(what,"; IR ",tx_repr(lg_clip(body,600),true)))

; Builds source and requires main to print expected for each argument.
effect fn sd_runs(borrow tools:DvTools, borrow source:Arr u8 _, borrow args:Arr Arr u8 _ _, borrow expected:Arr Arr u8 _ _) -> unit
  = let binary=concat(source,".bin") in let built=dv_build(tools,source,binary,md_words()) in
    let ran=loop (i=0) while i<len(args)
      next (let arg=md_word(args,i) in
        let out=dv_output(binary,if len(arg)==0 then md_words() else push(md_words(),arg),md_words(),"") in
        let same=dv_expect(tx_equal(out,concat(md_word(expected,i),"\n")),
          concat(source," with ",tx_repr(arg,true)," printed ",tx_repr(out,true),", expected ",md_word(expected,i))) in i+1) yield i in noop()

fn sd_chain(n:i64, borrow var:Arr u8 _) -> Arr u8 _
  = let parts=loop (k=0, out=md_words()) while k<n
      next (k+1,push(out,concat("if ",var," == ",int_text(k)," then ",int_text(k*10+1)," else "))) yield out in
    concat(str_concat_parts(parts),"-1")

effect fn sd_write(borrow dir:Arr u8 _, borrow name:Arr u8 _, borrow text:Arr u8 _) -> Arr u8 _
  = let path=pt_join(dir,name) in let written=ru_write(path,text) in path

; A 40-arm chain is one switch with every case and no compare left.
effect fn sd_forty(borrow tools:DvTools, borrow dir:Arr u8 _) -> unit
  = let source=sd_write(dir,"forty.neo",concat("fn f(op:i64) -> i64 = ",sd_chain(40,"op"),"\nfn main(op:i64) -> i64 = f(op)\n")) in
    let f=sd_body(sd_compile(tools,source,"--emit-llvm",""),"f") in
    let a=sd_check(sd_count(f,"switch i64")==1 && sd_cases(f)==40 && sd_count(f,"icmp eq")==0,"forty: expected one 40-case switch and no compare",f) in
    sd_runs(tools,source,ru_words("-1 0 7 39 40"),ru_words("-1 1 71 391 -1"))

; A match on an enum, a byte chain (255 as the i8 literal -1) and grouped arms
; on a record field.
effect fn sd_shapes(borrow tools:DvTools, borrow dir:Arr u8 _) -> unit
  = let source=sd_write(dir,"shapes.neo",concat("enum E { A, B(i64), C, D(i64), F }\n",
      "fn f(e:E) -> i64 = match e { A => 1, B(x) => x, C => 3, D(y) => y + 1, F => 5 }\n",
      "fn g(c:u8) -> i64 = if c == 'a' then 1 else if c == 'b' then 2 else if c == 'c' then 3 else if c == '\\xff' then 4 else 0\n",
      "type R = { tag : i64 }\n",
      "fn h(r:R) -> i64 = if r.tag == 0 || r.tag == 5 then 1 else if r.tag == 1 then 2 else if r.tag == 2 || r.tag == 3 then 3 else 4\n",
      "fn main(k:i64) -> i64 = if k == 0 then f(A()) * 10000 + f(B(20)) * 1000 + f(C()) * 100 + f(D(40)) * 10 + f(F())\n",
      "  else if k == 1 then g(u8(97)) * 10000 + g(u8(98)) * 1000 + g(u8(99)) * 100 + g(u8(255)) * 10 + g(u8(122))\n",
      "  else h(R { tag = k - 2 })\n")) in
    let ir=sd_compile(tools,source,"--emit-llvm","") in
    let f=sd_body(ir,"f") in let g=sd_body(ir,"g") in let h=sd_body(ir,"h") in
    let a=sd_check(sd_count(f,"switch i64")==1,"match: expected one switch on the tag",f) in
    let b=sd_check(sd_count(g,"switch i8")==1 && str_find(g,"i8 -1, label %").present,"bytes: expected one i8 switch with case -1",g) in
    let c=sd_check(sd_count(h,"switch i64")==1 && sd_cases(h)==5,"grouped arms: expected one 5-case switch",h) in
    sd_runs(tools,source,ru_words("0 1 2 3 4 5 6 7 8"),ru_words("30715 12340 1 2 3 3 4 1 4"))

; A value tested again is dead, and an arm whose values all came before is
; dropped with its body.
effect fn sd_duplicates(borrow tools:DvTools, borrow dir:Arr u8 _) -> unit
  = let source=sd_write(dir,"duplicates.neo",concat("fn f(op:i64) -> i64 = if op == 1 then 10 else if op == 2 then 20 ",
      "else if op == 1 then 99 else if op == 3 || op == 2 then 30 else if op == 4 then 40 else 0\nfn main(op:i64) -> i64 = f(op)\n")) in
    let f=sd_body(sd_compile(tools,source,"--emit-llvm",""),"f") in
    let a=sd_check(sd_count(f,"switch i64")==1 && sd_cases(f)==4 && !str_find(f," 99").present,"duplicates: expected one 4-case switch without the dead arm",f) in
    ; The report counts the live arms and the default.
    let report=sd_compile(tools,source,"--report",pt_join(dir,"duplicates")) in
    let b=sd_check(str_find(report,"\"cases\":4,\"arms\":5}").present,"duplicates: expected 4 cases and 5 arms in the report",report) in
    sd_runs(tools,source,ru_words("0 1 2 3 4 5"),ru_words("0 10 20 30 40 0"))

; Shapes that stay branches: three values, a scrutinee that is not a plain
; read, and the tests before a binder; a chain switches on its first scalar.
effect fn sd_branches(borrow tools:DvTools, borrow dir:Arr u8 _) -> unit
  = let short=sd_write(dir,"short.neo",concat("fn f(op:i64) -> i64 = ",sd_chain(3,"op"),"\nfn main(op:i64) -> i64 = f(op)\n")) in
    let s=sd_body(sd_compile(tools,short,"--emit-llvm",""),"f") in
    let a=sd_check(!str_find(s,"switch").present,"three values: expected compares",s) in
    let call=sd_write(dir,"call.neo",concat("fn k(x:i64) -> i64 = x\nfn f(op:i64) -> i64 = ",sd_chain(6,"k(op)"),"\nfn main(op:i64) -> i64 = f(op)\n")) in
    let c=sd_body(sd_compile(tools,call,"--emit-llvm",""),"f") in
    let b=sd_check(!str_find(c,"switch").present,"a call as scrutinee: expected compares",c) in
    let binder=sd_write(dir,"binder.neo",concat("fn f(op:i64) -> i64 = if op == 0 then 1 else if op == 1 then 2 else if op == 2 then 3 ",
      "else let q = op in ",sd_chain(6,"q"),"\nfn main(op:i64) -> i64 = f(op)\n")) in
    let d=sd_body(sd_compile(tools,binder,"--emit-llvm",""),"f") in
    let e=sd_check(sd_count(d,"icmp eq")==3 && sd_count(d,"switch i64")==1 && sd_cases(d)==6,"binder: expected three compares, then a 6-case switch",d) in
    let ran=sd_runs(tools,binder,ru_words("0 2 3 5 8 9"),ru_words("1 3 31 51 -1 -1")) in
    let first=sd_write(dir,"first.neo",concat("fn f(op:i64,x:i64) -> i64 = if op == 0 then 1 else if op == 1 then 2 else if op == 2 then 3 ",
      "else if op == 3 then 4 else if x == 0 then 5 else if x == 1 then 6 else 7\n",
      "fn main(k:i64) -> i64 = f(k / 10, k % 10)\n")) in
    let g=sd_body(sd_compile(tools,first,"--emit-llvm",""),"f") in
    let h=sd_check(sd_count(g,"switch i64")==1 && sd_cases(g)==4,"first scalar: expected one 4-case switch on op",g) in
    sd_runs(tools,first,ru_words("31 90 91 99 5"),ru_words("4 5 6 7 1"))

; The opcode VM's step is one switch with a case per opcode; the 300-arm
; dispatch is a 300-case switch in the build report; the chains and the match
; whose arms the switch-arms case runs are switches.
effect fn sd_fixtures(borrow tools:DvTools, borrow dir:Arr u8 _) -> unit
  = let step=sd_body(sd_compile(tools,lg_fixture(tools,"fixtures/opcode_vm.neo"),"--emit-llvm",""),"step") in
    let a=sd_check(sd_count(step,"switch i64")==1 && sd_cases(step)>=39,"opcode VM: expected one switch with at least 39 cases",step) in
    let arms=sd_compile(tools,lg_fixture(tools,"fixtures/switch_arms.neo"),"--emit-llvm","") in
    let pick=sd_body(arms,"pick") in let run=sd_body(arms,"run") in let apply=sd_body(arms,"apply") in
    let b=sd_check(sd_count(pick,"switch i64")==1 && sd_cases(pick)==7,"switch arms: expected pick to be one 7-case switch",pick) in
    let c=sd_check(sd_count(run,"switch i64")==1 && sd_cases(run)==4,"switch arms: expected run to be one 4-case switch",run) in
    let d=sd_check(sd_count(apply,"switch i64")==1 && sd_cases(apply)==4,"switch arms: expected apply to be one 4-case switch (the last variant is the default)",apply) in
    let report=sd_compile(tools,lg_fixture(tools,"fixtures/deep_dispatch.neo"),"--report",pt_join(dir,"deep")) in
    dv_expect(str_find(report,"\"cases\":300,").present,concat("deep dispatch: no 300-case switch in ",tx_repr(lg_clip(report,600),true)))

effect fn main() -> unit
  = let tools=dv_tools() in let dir=dv_temp("switch-dispatch") in
    let a=sd_forty(tools,dir) in let b=sd_shapes(tools,dir) in let c=sd_duplicates(tools,dir) in
    let d=sd_branches(tools,dir) in let e=sd_fixtures(tools,dir) in
    let cleaned=dv_clean(dir) in let shown=print_out("switch dispatch OK\n") in noop()
