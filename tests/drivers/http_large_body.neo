; http_large_body.py: Content-Length bodies that std:https_client reads into
; one buffer (tests/fixtures/http_large_body.neo) from the Go peer
; (tests/fixtures/network_peer.go -mode largebody) over TCP, TLS 1.3 with
; AES-128-GCM (the client's order) and ChaCha20-Poly1305 (the server's,
; GODEBUG=cpu.aes=off), and TLS 1.2: sizes either side of a TLS record, a body
; in 997-byte writes, a close mid-body and bytes beyond the announced length.
import "std:io"
import "std:process"
import "../support/driver.neo"
import "../support/network.neo"
import "../../compiler/src/modules.neo"
import "../../compiler/src/paths.neo"
import "../../compiler/src/test_process.neo"
import "../../compiler/src/text.neo"

fn lb_body_fnv(size:i64) -> i64
  = loop (i=0, h=-3750763034362895579) while i<size next (i+1,wrapping_mul(bit_xor(h,bit_and(i*31+shift_right(i,8),255)),1099511628211)) yield h
fn lb_ok(size:i64, connections:i64) -> Arr u8 _
  = concat("200 ",int_text(size)," ",int_text(lb_body_fnv(size))," ",int_text(connections),"\n")
fn lb_sizes() -> Arr i64 _ = arr(i in 0..8) if i==0 then 1 else if i==1 then 100 else if i==2 then 16383 else if i==3 then 16384 else
  if i==4 then 16385 else if i==5 then 49152 else if i==6 then 100000 else 1048576
fn lb_paths() -> Arr Arr u8 _ _
  = let sizes=lb_sizes() in
    let paths=loop (i=0, out=md_words()) while i<len(sizes) next (i+1,push(out,concat("/n/",int_text(tx_at(sizes,i))))) yield out in
    push(push(push(push(push(paths,"/split/300000"),"/n/16384"),"/short/50000"),"/n/70000"),"/excess/70000")
; Each line the client prints: the excess bytes fail a TLS read; over TCP they
; stay unread on the socket after the announced body.
fn lb_expected(tls:bool) -> Arr u8 _
  = let sizes=lb_sizes() in
    let lines=loop (i=0, out=tx_empty()) while i<len(sizes) next (i+1,concat(out,lb_ok(tx_at(sizes,i),1))) yield out in
    concat(lines,lb_ok(300000,1),lb_ok(16384,1),"error:5 1\n",lb_ok(70000,2),if tls then "error:27 2\n" else lb_ok(70000,2))

effect fn lb_case(borrow binary:Arr u8 _, borrow peer:Arr u8 _, borrow dir:Arr u8 _, borrow name:Arr u8 _, borrow tls:Arr u8 _,
                  borrow environment:Arr Arr u8 _ _, borrow suite:Arr u8 _) -> unit
  = let problems=(using server=process_start(peer,nw_peer_args("largebody",tls,dir),dv_environment(environment)) in
      let up=nw_await(server,nw_child(),"\n",10000) in let port=nw_peer_port(up) in
      let args=push(push(md_words(),int_text(port)),if len(tls)>0 then pt_join(dir,"ca.der") else "-") in
      let paths=lb_paths() in
      let args=loop (i=0, out=args) while i<len(paths) next (i+1,push(out,md_word(paths,i))) yield out in
      let result=dv_run(binary,args,md_words(),"",120000,1048576) in
      let done=nw_peer_finish(server,up) in
      let expected=lb_expected(len(tls)>0) in
      let p=nw_note("",result.ok && result.code==0 && tx_equal(result.output,expected),
        concat("client: ",tx_repr(result.output,true)," expected ",tx_repr(expected,true)," ",nt_diagnostic(result))) in
      let p=nw_note(p,nw_contains(done.output,"\naccepted 2\n") && !nw_contains(done.output,"\nerror "),concat("peer: ",done.output)) in
      nw_note(p,len(suite)==0 || nw_contains(done.output,concat("\nsuite ",suite,"\n")),concat("expected ",suite,": ",done.output))) in
    let checked=dv_expect(len(problems)==0,concat(name,": ",problems)) in
    let shown=print_out(concat("PASS large bodies over ",name,": 13 requests, 1 B to 1 MiB, small writes, early close, excess bytes\n")) in noop()

effect fn main() -> unit
  = let tools=dv_tools() in let dir=dv_temp("http-large-body") in let binary=pt_join(dir,"large_body") in
    let built=dv_build(tools,pt_join(tools.here,"../fixtures/http_large_body.neo"),binary,md_words()) in
    let certificates=nw_certificates(dir) in let peer=nw_build_peer(tools,dir) in
    let a=lb_case(binary,peer,dir,"TCP","",md_words(),"") in
    ; With the CPU's AES instructions the client offers AES-128-GCM first, so
    ; both TLS 1.3 paths run: opened in place, and opened then copied.
    let b=lb_case(binary,peer,dir,"TLS 1.3 (client order)","1.3",md_words(),if aes_hardware() then "TLS_AES_128_GCM_SHA256" else "") in
    let c=lb_case(binary,peer,dir,"TLS 1.3 (server order)","1.3",push(md_words(),"GODEBUG=cpu.aes=off"),"TLS_CHACHA20_POLY1305_SHA256") in
    let d=lb_case(binary,peer,dir,"TLS 1.2","1.2",md_words(),"") in
    dv_clean(dir)
