; Ported from tests/kernel_runtime_smoke.py: the freestanding runtime fixtures
; build into static binaries without undefined symbols, an interpreter or
; shared libraries. Their outputs at 1 and 4 workers are plain cases in
; tests/runtime.neo.toml. The parallel parts: on Linux both comprehensions of
; parallel_runtime.neo are parallel regions on the worker threads (per the
; build report), and at n=1000000 four workers really dispatch the array
; (clone raising SIGSYS ends the run; runtime_exec.neo) and give the same
; total when clone fails with EAGAIN.
import "std:io"
import "std:strings"
import "../support/driver.neo"
import "../support/runtime.neo"
import "../../compiler/src/modules.neo"
import "../../compiler/src/paths.neo"
import "../../compiler/src/test_process.neo"
import "../../compiler/src/text.neo"

effect fn kr_audit(borrow tools:DvTools, borrow dir:Arr u8 _, borrow name:Arr u8 _) -> unit
  = let binary=pt_join(dir,name) in
    let built=dv_build(tools,pt_join(tools.here,concat("../fixtures/",name,".neo")),binary,md_words()) in
    dv_audit(tools,binary)

fn kr_count(borrow text:Arr u8 _, borrow needle:Arr u8 _) -> i64
  = loop (i=0, n=0) while i+len(needle)<=len(text) next (i+1,if bytes_match_at(text,i,needle) then n+1 else n) yield n

effect fn kr_parallel(borrow tools:DvTools, borrow dir:Arr u8 _) -> unit
  = let binary=pt_join(dir,"parallel_runtime") in
    let built=dv_build_with(tools,pt_join(tools.here,"../fixtures/parallel_runtime.neo"),binary,push(md_words(),"--report"),md_words()) in
    let ok=dv_expect(built.ok && built.code==0,concat("build of parallel_runtime.neo failed: ",nt_diagnostic(built))) in
    let regions=dv_expect(kr_count(built.output,"\"dispatcher\":\"ax_par_for_shared\"")==2 && kr_count(built.output,"\"dispatcher\":\"")==2,
      concat("expected two parallel regions on ax_par_for_shared: ",built.output)) in
    let wrapper=pt_join(dir,"exec") in
    let made=dv_build(tools,pt_join(tools.here,"../fixtures/runtime_exec.neo"),wrapper,md_words()) in
    let aarch64=ru_aarch64(tools) in let clone=if aarch64 then "220" else "56" in
    let arch=push(md_words(),if aarch64 then "aarch64" else "x86_64") in
    let four=push(md_words(),"NEO_THREADS=4") in
    let plain=dv_output(binary,push(md_words(),"1000000"),four,"") in
    let denied=dv_output(wrapper,push(push(push(push(push(arch,"deny"),clone),"11"),binary),"1000000"),four,"") in
    let a=dv_expect(tx_equal(plain,"1499999500000\n") && tx_equal(denied,"1499999500000\n"),
      concat("parallel_runtime 1000000 at four workers gave ",str_trim(plain)," and, with clone failing, ",str_trim(denied))) in
    let trapped=dv_run(wrapper,push(push(push(push(push(arch,"trap"),clone),"-"),binary),"1000000"),four,"",60000,1048576) in
    dv_expect(trapped.ok && trapped.code==0-31,concat("four workers did not clone: exit ",int_text(trapped.code),": ",nt_diagnostic(trapped)))

effect fn main() -> unit
  = let tools=dv_tools() in let dir=dv_temp("kernel-runtime") in
    let a=kr_audit(tools,dir,"kernel_runtime") in let b=kr_audit(tools,dir,"parallel_runtime") in
    let c=kr_audit(tools,dir,"memory_blocks") in
    let d=if dv_linux(tools) then kr_parallel(tools,dir) else noop() in
    let cleaned=dv_clean(dir) in let shown=print_out("kernel runtime audit OK\n") in noop()
