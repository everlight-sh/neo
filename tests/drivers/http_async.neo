; http_async.py: tests/fixtures/async_http.neo with 1, 2 and 4 workers and a
; 150 ms or 2 s shutdown grace. 32 connections wait on deferred fragments
; while 30 fast requests finish within 250 ms; on SIGTERM a long grace
; completes every deferred response and a short one cuts them off in time.
import "std:io"
import "std:process"
import "std:socket"
import "std:time"
import "../support/driver.neo"
import "../support/network.neo"
import "../../compiler/src/modules.neo"
import "../../compiler/src/paths.neo"
import "../../compiler/src/text.neo"

type HaHeld = { problems:Arr u8 _, begin:i64 }

; Opens count waiting connections (one per recursion level), then runs the
; fast requests and sends SIGTERM; each level then reads its socket to EOF.
effect fn ha_hold(server:Process, port:i64, count:i64, grace:i64) -> HaHeld
  = if count<=0 then
      let start=nw_now_ms() in
      let fast=loop (i=0, ok=true) while i<30 next (i+1, ok && nw_get_is(port,"/fast",200,"FAST")) yield ok in
      let elapsed=nw_now_ms()-start in
      let problems=nw_note(nw_note("",fast,"a /fast request failed"),elapsed<250,concat("30 fast requests took ",int_text(elapsed)," ms")) in
      let signalled=process_signal(server,15) in HaHeld { problems=problems, begin=nw_now_ms() }
    else
      let deadline=deadline_after(4000) in
      using socket=tcp_connect_ipv4("127.0.0.1",port,deadline.value) in
      let sent=socket_write(socket,"GET /wait HTTP/1.1\r\nHost: localhost\r\n\r\n",deadline.value) in
      let wire=nw_read_until(socket,"Shell ready",deadline.value) in
      let shell=nw_contains(wire,"Shell ready") && !nw_contains(wire,"deferred fragment") in
      let inner=ha_hold(server,port,count-1,grace) in
      let after=deadline_after(4000) in let all=concat(wire,nw_drain(socket,after.value)) in
      let finished=nw_ends(all,"0\r\n\r\n") in
      let complete=if grace>1000 then finished && nw_contains(all,"Second deferred") else !finished in
      let problems=nw_note(inner.problems,shell,concat("connection ",int_text(count),": no shell before the deferred fragments")) in
      HaHeld { problems=nw_note(problems,complete,concat("connection ",int_text(count),": ",
        if grace>1000 then "unfinished after the grace period: " else "finished despite the short grace: ",tx_repr(nw_after(all,len(all)-100),true))),
        begin=inner.begin }

effect fn ha_case(borrow binary:Arr u8 _, workers:i64, grace:i64) -> unit
  = let port=nw_port() in
    let problems=(using server=process_start(binary,push(push(md_words(),int_text(port)),int_text(grace)),
        dv_environment(push(md_words(),concat("NEO_THREADS=",int_text(workers))))) in
      let up=nw_await(server,nw_child(),"neo: serving",5000) in
      if !nw_contains(up.errors,"neo: serving") then concat("server did not start: ",up.errors,up.output) else
      let held=ha_hold(server,port,32,grace) in
      let done=nw_finish(server,up,4000) in let elapsed=nw_now_ms()-held.begin in
      let limit=if grace>1000 then 2000 else 750 in
      nw_note(nw_note(held.problems,!done.running && done.code==0,concat("server exit ",int_text(done.code),": ",done.errors)),
        elapsed<limit,concat("shutdown took ",int_text(elapsed)," ms"))) in
    let checked=dv_expect(len(problems)==0,concat(int_text(workers)," workers grace ",int_text(grace),": ",problems)) in
    let shown=print_out(concat("PASS ",int_text(workers)," workers grace ",int_text(grace),"\n")) in noop()

effect fn main() -> unit
  = let tools=dv_tools() in let dir=dv_temp("http-async") in let binary=pt_join(dir,"http-async") in
    let built=dv_build(tools,pt_join(tools.here,"../fixtures/async_http.neo"),binary,md_words()) in
    let a=ha_case(binary,1,150) in let b=ha_case(binary,1,2000) in
    let c=ha_case(binary,2,150) in let d=ha_case(binary,2,2000) in
    let e=ha_case(binary,4,150) in let f=ha_case(binary,4,2000) in
    dv_clean(dir)
