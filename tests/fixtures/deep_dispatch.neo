fn main (iterations : i64{iterations >= 0}) -> i64
  = let st = arr(i in 0..8) i * 100 in
    loop(i = 0, total = 0) while i >= 0 && i < iterations next(i + 1, wrapping_add(total, step(st, i % 7, i % 301))) yield total
