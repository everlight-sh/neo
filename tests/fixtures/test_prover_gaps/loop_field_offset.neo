; From tests/test_prover_gaps.py (tag v0.2.3): a loop state guard does not cover the next state.
type R = { pos : i64, size : i64, inner : Q }
type Q = { at : i64 }
fn walk(xs:Arr i64 n) -> i64
  = loop(r = R { pos = 0, size = 0, inner = Q { at = 0 } }, t = 0) while r.pos >= 0 && r.pos < n
      next(r with { pos = r.pos + 1 }, let q = r with { pos = r.pos + 1 } in t + xs[q.pos]) yield t
fn main() -> i64 = 0
