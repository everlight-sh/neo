; A parameter that its function hands on is owned (cg_handed): the caller's
; last use moves the array in and set updates it in place. Lent instead, it
; was retained by the callee and copied by its first set, once per call: Neo
; 0.2.8 ran the sieve below 20 times slower than 0.2.0, copying the whole
; array once per prime. forward only hands its parameter to mark, so it is
; owned once mark's is (the table's fixed point); pick hands on one of two.
; Prints "<primes up to n> OK", or the problem. Build with NEO_ALLOC_STATS=1.
import "std:io"

fn mark(m:Arr bool n, step:i64{step>=1}, start:i64{start>=0}) -> Arr bool n
  = loop (m2=m, j:i64{j>=0}=start) while j<n next (set(m2,j,false), j+step) yield m2
fn forward(m:Arr bool n, step:i64{step>=1}, start:i64{start>=0}) -> Arr bool n = mark(m,step,start)
fn pick(a:Arr bool n, b:Arr bool n, first:bool) -> Arr bool n = if first then a else b
fn count_primes(n:i64{n>=2}) -> i64
  = let marks=loop (m=arr(k in 0..n+1) k>=2, i:i64{i>=2}=2) while i<=n && i*i<=n
      next (if !m[i] then m else if i%4==1 then forward(m,i,i*i) else mark(m,i,i*i), i+1) yield m in
    sum(k in 0..n+1) if marks[k] then 1 else 0
fn picked(n:i64{n>=2}) -> i64
  = let kept=arr(k in 0..n) k%3==0 in
    let chosen=pick(kept,arr(k in 0..n) false,true) in
    let cleared=mark(chosen,3,0) in sum(k in 0..n) if cleared[k] then 1 else 0

effect fn main(n:i64{n>=2 && n<=10000000}) -> unit
  = let warm=count_primes(2) in
    let requests=load_i64(runtime_state(),64) in let bytes=load_i64(runtime_state(),80) in
    let primes=count_primes(n) in let left=picked(n) in
    let requests=load_i64(runtime_state(),64)-requests in let bytes=load_i64(runtime_state(),80)-bytes in
    let problem=if !allocation_stats_enabled() then "built without NEO_ALLOC_STATS=1"
      else if left!=0 then "pick and mark left a multiple of 3 set"
      else if requests>8 || bytes>4*n+65536 then
        concat(int_text(requests)," requests and ",int_text(bytes)," bytes: an array was copied")
      else "" in
    let shown=if len(problem)>0 then print_out(concat(problem,"\n"))
      else print_out(concat(int_text(primes)," OK\n")) in noop()
