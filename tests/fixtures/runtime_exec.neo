; Linux-only helper for the runtime drivers: restricts its own process, then
; replaces itself with a program, which inherits the restriction.
;   runtime_exec ARCH deny NUMBER ERRNO PROGRAM ARGS...
;     a seccomp filter makes system call NUMBER fail with ERRNO (a genuine
;     kernel failure, without a testing hook in the runtime).
;   runtime_exec ARCH trap NUMBER - PROGRAM ARGS...
;     system call NUMBER raises SIGSYS instead (SECCOMP_RET_TRAP), which
;     ends the program: a run that makes the call exits with signal 31.
;   runtime_exec ARCH fsize BYTES PATH PROGRAM ARGS...
;     stdout goes to PATH, RLIMIT_FSIZE is BYTES and SIGXFSZ is ignored, so
;     writes past BYTES are short writes.
; ARCH is x86_64 or aarch64 (system call numbers differ).
import "std:io"
import "std:strings"

fn re_number(arm:bool, x86:i64, aarch64:i64) -> i64 = if arm then aarch64 else x86

; struct sock_filter { u16 code; u8 jt; u8 jf; u32 k; }
effect(unsafe) fn re_instruction(filter:ptr, index:i64, code:i64, jump_true:i64, jump_false:i64, value:i64) -> unit
  = let a=store_u8(filter,index*8,u8(code)) in let b=store_u8(filter,index*8+1,u8(0)) in
    let c=store_u8(filter,index*8+2,u8(jump_true)) in let d=store_u8(filter,index*8+3,u8(jump_false)) in
    store_i32(filter,index*8+4,i32(value))

; Load the system call number, return action (SECCOMP_RET_ERRNO+ERRNO or
; SECCOMP_RET_TRAP) for NUMBER, allow the rest.
effect(unsafe) fn re_deny(arm:bool, number:i64, action:i64) -> bool
  = let filter=stack_alloc(32) in
    let a=re_instruction(filter,0,32,0,0,0) in
    let b=re_instruction(filter,1,21,0,1,number) in
    let c=re_instruction(filter,2,6,0,0,action) in
    let d=re_instruction(filter,3,6,0,0,2147418112) in
    let program=stack_alloc(16) in let e=store_i64(program,0,4) in let f=store_ptr(program,8,filter) in
    let prctl=re_number(arm,157,167) in
    syscall6(prctl,38,1,0,0,0,0)==0 && syscall6(prctl,22,2,ptr_to_i64(program),0,0,0)==0

effect(fs,unsafe) fn re_fsize(arm:bool, bytes:i64, borrow path:Arr u8 _) -> bool
  = let name=concat(path,"\0") in let fd=rt_open_mode(data(name),577,420) in
    let moved=if fd<0 then -1 else rt_dup_stdio(fd,1) in
    let action=stack_alloc(32) in let cleared=memset(action,i32(0),32) in let ignore=store_i64(action,0,1) in
    let ignored=syscall6(re_number(arm,13,134),25,ptr_to_i64(action),0,8,0,0) in
    let limit=stack_alloc(16) in let a=store_i64(limit,0,bytes) in let b=store_i64(limit,8,bytes) in
    let limited=syscall6(re_number(arm,302,261),0,1,ptr_to_i64(limit),0,0,0) in
    fd>=0 && moved>=0 && ignored==0 && limited==0

effect(fs,env,process,unsafe) fn main() -> unit
  = let arm=str_equal(cli_arg(1).value,"aarch64") in let mode=cli_arg(2).value in
    let first=int_parse(cli_arg(3).value) in let second=cli_arg(4).value in
    let deny=str_equal(mode,"deny") in
    let ready=if !first.ok then false else if deny then let errno=int_parse(second) in errno.ok && re_deny(arm,first.value,327680+errno.value)
      else if str_equal(mode,"trap") then re_deny(arm,first.value,196608)
      else str_equal(mode,"fsize") && re_fsize(arm,first.value,second) in
    if !ready || !cli_arg(5).present then let shown=print_error("runtime_exec: could not apply the restriction\n") in process_exit(126) else
    let program=concat(cli_arg(5).value,"\0") in let state=runtime_state() in
    let argv=ptr_add(load_ptr(state,48),5*8) in
    let failed=rt_exec(data(program),argv,load_ptr(state,0)) in
    let shown=print_error("runtime_exec: exec failed\n") in process_exit(127)
