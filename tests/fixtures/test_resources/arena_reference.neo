; From tests/test_resources.py (tag v0.2.3): (references, with std:arena in place of the test's own arena prelude) an
; adopted resource is borrowed back through a Ref in a record. Prints 42.
import "std:arena"
resource type Handle={value:i64} drop release
effect(fs) fn release(handle:Handle)->unit=noop()
effect(process) fn create()->Handle=Handle { value=42 }
fn inspect(handle:Handle)->i64=handle.value
type State={handle:Ref<Handle>}
effect(fs,net,process) fn main()->i64=using arena=new_arena(8) in using value=create() in
  let state=State { handle=adopt(value,arena) } in inspect(borrow_ref(state.handle))
