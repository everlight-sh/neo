; vector_sort on the shapes of input that take different paths through it:
; every size class, values that differ in few or many bits, long stretches
; that agree on their leading bits, both signs, and inputs already in order.
; The result must be in order and hold the same values. A mode of 100 or more
; is the same input with a second reference to it kept, which must then still
; read as it was. Prints "OK", or the problem.
import "std:collections"
import "std:io"

fn mix (x : i64) -> i64
  = let a = wrapping_mul(bit_xor(x, shift_right(x, 30)), -4658895280553007687) in
    let b = wrapping_mul(bit_xor(a, shift_right(a, 27)), -7723592293110705685) in
    bit_xor(b, shift_right(b, 31))

fn item (mode : i64, i : i64, n : i64{n >= 0}) -> i64
  = let h = mix(i + 1) in let p = bit_and(h, 4611686018427387903) in
    if mode == 0 then p
    else if mode == 1 then h
    else if mode == 2 then p % 100
    else if mode == 3 then (i * 7919 + 13) % (n + 1)
    else if mode == 4 then 1099511627776 + p % 2001 - 1000
    else if mode == 5 then shift_left(1, p % 62) + p % 7
    else if mode == 6 then 42
    else if mode == 7 then i * 3 - 1000
    else if mode == 8 then (n - i) * 5
    else if mode == 9 then if p % 2 == 0 then -5 else 1000000007
    else if mode == 10 then shift_left(p % 16, 40) + shift_right(p, 20) % 1000
    else if mode == 11 then
      if i == n / 2 then 9223372036854775807 else if i == n / 3 then -9223372036854775808 else p % 1000
    else shift_left(p % 3, 61) - h % 3

; The same for any order of the same values.
fn digest (borrow a : Arr i64 n) -> i64
  = loop (i : i64{i >= 0} = 0, acc = 0) while i < n next (i + 1, wrapping_add(acc, mix(a[i]))) yield acc

effect fn main (mode : i64{mode >= 0}, n : i64{n >= 0 && n <= 5000000}) -> unit
  = let shape = mode % 100 in
    let kept = arr(i in 0..n) item(shape, i, n) in
    let sorted = if mode >= 100 then vector_sort(IntVector { values = kept }).values
      else vector_sort(IntVector { values = arr(i in 0..n) item(shape, i, n) }).values in
    let m = len(sorted) in
    let ordered = loop (i : i64{i >= 1} = 1, ok = true) while ok && i < m
      next (i + 1, sorted[i - 1] <= sorted[i]) yield ok in
    let same = loop (i : i64{i >= 0} = 0, ok = true) while ok && i < n
      next (i + 1, kept[i] == item(shape, i, n)) yield ok in
    let problem = if m != n then "the result has another length"
      else if !ordered then "the result is not in order"
      else if digest(sorted) != digest(kept) then "the result holds other values"
      else if !same then "the input another name still reads was changed"
      else "" in
    let shown = if len(problem) > 0 then print_out(concat(problem, "\n")) else print_out("OK\n") in noop()
