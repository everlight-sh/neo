import "std:bitset"
import "std:json"
import "std:io"
fn bitset_json(borrow bits:BitSet) -> Json
  = loop(at=bitset_next(bits,0),out=json_array_builder()) while option_is_some::<i64>(at)
      next(match at {None=>None::<i64>(),Some(i)=>bitset_next(bits,i+1)},match at {None=>out,Some(i)=>json_array_builder_push(out,json_value_int(i))}) yield json_array_builder_finish(out).value
fn bitset_case(input:Json) -> Json
  = let operations=json_array_values(input) in
    loop(i=0,bits=bitset_empty(),out=json_array_builder()) while i<len(operations) next(i+1,
      check i>=0 && i<len(operations) in let op=operations[i] in let at=json_int(json_get(op,"index").value).value in
      if json_bool(json_get(op,"remove").value).value then bitset_remove(bits,at) else bitset_insert(bits,at),
      check i>=0 && i<len(operations) in let op=operations[i] in let at=json_int(json_get(op,"index").value).value in
      let old=bitset_json(bits) in let changed=if json_bool(json_get(op,"remove").value).value then bitset_remove(bits,at) else bitset_insert(bits,at) in
      check str_equal(old.raw,bitset_json(bits).raw) in
      json_array_builder_push(out,bitset_json(changed))) yield json_array_builder_finish(out).value
effect(fs) fn main() -> unit
  = let input=file_read(0,4194304) in let parsed=json_parse(input.value) in let result=bitset_case(parsed.value) in
    let shown=print_out(result.raw) in noop()
