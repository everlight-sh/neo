; Invalid-fd errors, allocation reuse, overlap copying and shared fork results.
effect fn main (n : i64{n >= 32, n <= 100000}) -> i64
  = let p = ax_alloc(n) in
    let filled = loop (i = 0) while i < n
      next (let stored = store_u8(p, i, u8(i % 251)) in i + 1) yield i in
    let q = ax_alloc(n + 8) in
    let copied = memcpy(q, p, n) in
    let moved = memmove(ptr_add(q, 3), q, n) in
    let set = memset(q, i32(-1), 3) in
    let bad = rt_read(-1, p, 1) in let error = load_i32(rt_errno(), 0) in
    check bad == -1 && error == i32(9) in
    let child = rt_fork() in
    if child == 0 then
      let changed = store_u8(p, 0, u8(99)) in let exited = ax_exit(0) in 0
    else check child > 0 in
      let status = rt_wait(child) in let shared = load_u8(p, 0) in
      check status == 0 && shared == u8(99) in
      let released = ax_release(p) in let reused = ax_alloc(n) in
      check reused == p in
      let total = loop (i = 0, total = 0) while i < n + 3
        next (i + 1, total + i64(load_u8(q, i))) yield total in
      let freed = ax_release(reused) in let output = ax_release(q) in total
