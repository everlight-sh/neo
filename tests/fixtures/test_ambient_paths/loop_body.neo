fn f(x : i64) -> i64 {result > x, result < 5} = check x < 4 in x + 1
fn g(xs:Arr i64 n,x:i64,m:i64{x >= 0,n >= 4}) -> i64 = let s = loop(i = 0,t = 0) while i < m next(i + 1,f(x)) yield t in xs[x]
fn main() -> i64 = 0
