; From tests/test_ambient_paths.py (tag v0.2.3): a fact holds wherever its condition holds again.
fn f(x : i64) -> i64 {result > x, result < 5} = check x < 4 in x + 1
fn g(xs:Arr i64 n,x:i64,m:i64{x >= 0,n >= 4}) -> i64 = let y = (if m > 0 then f(x) else 0) in if m > 0 then xs[x] else y
fn main() -> i64 = 0
