fn divide (x: i64, y: i64{y != 0}) -> i64 = x / y
fn remainder (x: i64, y: i64{y != 0}) -> i64 = x % y
fn overflowing_constant (x: i64) -> i64 = x + 1
fn shadowed_state (x: i64{x == 0}) -> i64
  = loop (x = 9223372036854775807) while x > 0 next (x + 1) yield x
fn main (mode: i64, x: i64, y: i64) -> i64
  = if mode == 0 then x + y else if mode == 1 then x - y else if mode == 2 then x * y
    else if mode == 3 then check y != 0 in divide(x,y)
    else if mode == 4 then check y != 0 in remainder(x,y)
    else if mode == 5 then wrapping_add(x,y)
    else if mode == 6 then sum(i in 0..3) x
    else if mode == 7 then sum(i in 0..3) if i < 2 then 1 else x + 1
    else if mode == 8 then sum(i in 0..2) if i < 2 then 1 else x + 1
    else if mode == 9 then overflowing_constant(9223372036854775807)
    else if mode == 10 then 0 - x
    else if mode == 11 then i64(f64(x) * 2.0)
    else if mode == 12 then sum(i in 0..2) if i < 0 && x + 1 > 0 then 999 else 1
    else if mode == 13 then sum(i in 0..2) if i >= 0 || x + 1 > 0 then 1 else 999
    else if mode == 14 then sum(i in 0..2) if i < 0 then -9223372036854775808 / -1 else 1
    else if mode == 15 then sum(i in 0..2) if i >= 0 then 1 else i64(1.0e300)
    else if mode == 16 then sum(i in 0..33) i
    else if mode == 17 then sum(i in 0..2048) x
    else shadowed_state(0)
