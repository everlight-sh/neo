import "std:io"
; Fields taken out of a record the function owns: the last use of a field that
; hands it on takes the record's reference to it, so push, set, concat and the
; byte writers update the buffer in place, while every name that is still read keeps the
; value it had. Run with a large count to check that nothing leaks.
type Rows = { slots:Arr i64 _, count:i64 }
type Pair = { left:Arr i64 _, right:Arr u8 _, tag:i64 }
type Nest = { inner:Rows, label:Arr u8 _ }
type Grid = { cells:Arr Rows _, n:i64 }
type Doc = { text:Arr u8 _, lines:i64 }
type Journal = { bytes:Arr u8 _, used:i64 }
fn mix(a:i64, b:i64) -> i64 = wrapping_add(wrapping_mul(a,1000003),b)
fn total(borrow a:Arr i64 _) -> i64 = loop(i:i64{i>=0}=0,acc=len(a)) while i<len(a) next(i+1,mix(acc,a[i])) yield acc
fn bytes(borrow a:Arr u8 _) -> i64 = loop(i:i64{i>=0}=0,acc=len(a)) while i<len(a) next(i+1,mix(acc,i64(a[i]))) yield acc
fn rows_total(borrow r:Rows) -> i64 = mix(total(r.slots),r.count)
fn rows_new(n:i64, k:i64) -> Rows = check n>=0 in Rows { slots=arr(i in 0..n) i*k, count=n }
fn pair_new(n:i64) -> Pair = check n>=0 in Pair { left=arr(i in 0..n) i+n, right=arr(i in 0..n) u8(97+i%26), tag=n }
; A reserved slot is written, or the buffer grows (zetaDB's DocumentRows).
fn rows_push(move rows:Rows, value:i64) -> Rows
  = let at=rows.count in let capacity=len(rows.slots) in check at>=0 && at<=capacity in
    let slots=if at<capacity then rows.slots else let grown=if capacity<4 then 4 else capacity*2 in check grown>=capacity in
      arr(i in 0..grown) if i<capacity then check i>=0 && i<capacity in rows.slots[i] else 0 in
    check at>=0 && at<len(slots) in Rows { slots=set(slots,at,value), count=at+1 }
; Another field is read after the take.
fn rows_put(move rows:Rows, index:i64, value:i64) -> Rows
  = if index<0 || index>=rows.count || index>=len(rows.slots) then rows else
    check index>=0 && index<len(rows.slots) in Rows { slots=set(rows.slots,index,value), count=rows.count }
; A let takes the field.
fn rows_bump(move rows:Rows) -> Rows = let slots=rows.slots in let n=len(slots) in Rows { slots=push(slots,n), count=rows.count+1 }
; Only one branch takes the field; the other reads it and releases it.
fn pick(move p:Pair, grow:bool) -> Arr i64 _ = if grow then push(p.left,p.tag) else arr(i in 0..len(p.left)) p.left[i]*2
; Both counted fields are taken.
fn swap_out(move p:Pair) -> Pair = Pair { left=push(p.left,len(p.right)), right=push(p.right,u8(65)), tag=p.tag+1 }
; A lent argument still points at the field that a later argument edits.
fn observe_then(borrow seen:Arr i64 _, move grown:Arr i64 _) -> i64 = mix(total(seen),total(grown))
fn pending(move p:Pair) -> i64 = observe_then(p.left,push(p.left,7))
; A whole use in one branch, a field edit in the other.
fn whole_or_field(move p:Pair, whole:bool) -> i64 = if whole then total(swap_out(p).left) else total(push(p.left,3))
; The two fields are taken one after the other.
fn keep_right(move p:Pair) -> Arr u8 _ = let l=push(p.left,1) in let t=total(l) in push(p.right,u8(t%200))
fn doc_add(move d:Doc, borrow line:Arr u8 _) -> Doc = Doc { text=concat(d.text,line,"\n"), lines=d.lines+1 }
; A loop state's buffer replaced by a byte write on itself (zetaDB's journal
; buffer): the write takes the field, so a unique buffer is written in place.
fn journal_span(move j:Journal, borrow raw:Arr u8 n) -> Journal
  = loop(at=0,state=j) while at<n next(
      let room=len(state.bytes)-state.used in at+(if room==0 then 0 else if n-at<room then n-at else room),
      if state.used==len(state.bytes) then state with {used=0} else
      let room=len(state.bytes)-state.used in let count=if n-at<room then n-at else room in
      let used=state.used in
      state with {used=used+count,bytes=byte_copy(state.bytes,used,byte_slice(raw,at,at+count))})
    yield state
fn journal_words(move j:Journal, k:i64) -> Journal
  = loop(i=0,state=j) while i<k && state.used>=0 && state.used+8<=len(state.bytes) next(i+1,
      let used=state.used in state with {used=used+8,bytes=byte_write_le(state.bytes,used,wrapping_mul(i,7919),8)}) yield state
; concat on the field it replaces; in doc_late a later value still reads the
; record, so the old text is kept until then.
fn doc_with(move d:Doc, borrow line:Arr u8 _) -> Doc = d with {lines=d.lines+1,text=concat(d.text,line)}
fn doc_late(move d:Doc, borrow line:Arr u8 _) -> Doc = d with {text=concat(d.text,line),lines=d.lines+len(d.text)}
fn grid_set(move g:Grid, at:i64, borrow r:Rows) -> Grid
  = if at<0 || at>=len(g.cells) then g else check at>=0 && at<len(g.cells) in Grid { cells=set(g.cells,at,r), n=g.n+1 }
; An alias of a field that is edited later keeps the old buffer.
fn alias(n:i64) -> i64
  = let r=rows_new(4,n) in let old=r.slots in
    let grown=Rows { slots=push(r.slots,99), count=5 } in mix(total(old),rows_total(grown))
; A field of a field.
fn nested(n:i64) -> i64
  = let x=Nest { inner=rows_new(3,n), label="ab" } in
    let inner=x.inner in let edited=rows_put(inner,1,n) in mix(rows_total(edited),bytes(x.label))
fn pushes(n:i64, reserve:i64) -> i64
  = let rows=loop(i=0,rows=rows_new(reserve,0) with { count=0 }) while i<n next(i+1,rows_push(rows,i*3+1)) yield rows in
    let put=rows_put(rows,n/2,-5) in rows_total(rows_bump(put))
fn states(n:i64) -> i64
  = let built=loop(i=0,st=rows_new(0,0)) while i<n next(i+1,Rows { slots=push(st.slots,i*i), count=st.count+1 }) yield st in
    let slots=loop(i=0,st=rows_new(1,1)) while i<n next(i+1,Rows { slots=push(st.slots,i), count=st.count+1 }) yield st.slots in
    mix(rows_total(built),total(slots))
fn texts(n:i64) -> i64
  = let d=loop(i=0,d=Doc { text="", lines=0 }) while i<n next(i+1,doc_add(d,int_text(i))) yield d in mix(bytes(d.text),d.lines)
fn grids(n:i64) -> i64
  = let g=loop(i=0,g=Grid { cells=arr(j in 0..4) rows_new(j,1), n=0 }) while i<n next(i+1,grid_set(g,i%4,rows_new(i%5,i))) yield g in
    loop(i:i64{i>=0}=0,acc=g.n) while i<len(g.cells) next(i+1,mix(acc,rows_total(g.cells[i]))) yield acc
fn journals(n:i64) -> i64
  = let j=Journal { bytes=arr(i in 0..16) u8(46), used=0 } in let before=j.bytes in
    let raw=concat("journal ",int_text(n*n)," entry") in
    let spanned=loop(i=0,j=j) while i<n%9 next(i+1,journal_span(j,raw)) yield j in
    let fresh=journal_span(Journal { bytes=arr(i in 0..24) u8(0), used=n%5 },raw) in
    let words=journal_words(Journal { bytes=arr(i in 0..40) u8(1), used=n%3 },n%6) in
    let kept=Journal { bytes=arr(i in 0..24) u8(2), used=0 } in let old=kept.bytes in let written=journal_words(kept,2) in
    let d=loop(i=0,d=Doc { text="", lines=0 }) while i<n%11 next(i+1,doc_with(d,int_text(i))) yield d in
    let e=loop(i=0,d=Doc { text="x", lines=0 }) while i<n%7 next(i+1,doc_late(d,int_text(i*3))) yield d in
    mix(mix(mix(mix(mix(mix(mix(mix(bytes(before),bytes(spanned.bytes)),spanned.used),bytes(fresh.bytes)),bytes(words.bytes)),
      bytes(old)),bytes(written.bytes)),mix(bytes(d.text),d.lines)),mix(bytes(e.text),e.lines))
fn pairs(n:i64) -> i64
  = let a=pair_new(n%7) in let b=pair_new(n%5) in let c=pair_new(n%3+1) in
    let s=swap_out(pair_new(n%4)) in
    mix(mix(mix(mix(mix(mix(mix(total(pick(a,n%2==0)),total(pick(b,n%2==1))),pending(c)),total(s.left)),bytes(s.right)),
      whole_or_field(pair_new(n%6),n%3==0)),whole_or_field(pair_new(n%6),n%3!=0)),bytes(keep_right(pair_new(n%9))))
fn round(n:i64) -> i64
  = mix(mix(mix(mix(mix(mix(mix(pushes(n%40,n%3*20),pushes(n%25,0)),states(n%30)),texts(n%20)),grids(n%12)),pairs(n)),alias(n)),mix(nested(n),journals(n)))
effect(fs) fn main(n:i64{n>=0,n<=10000000}) -> unit
  = let rounds=loop(i=0,acc=0) while i<n next(i+1,mix(acc,round(i))) yield acc in
    let printed=print_out(concat(int_text(round(n))," ",int_text(rounds),"\n")) in noop()
