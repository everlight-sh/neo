; A loop state that set updates on every turn is tested for a second
; reference once, as the loop is entered (cg_stable), not at every set. The
; array must still be copied exactly when it is shared: `a` below is read
; after fill(a, 7), so fill works on a copy and `a` keeps its values, while
; an array nothing else names is updated in place.
; Prints "OK", or the problem. Build with NEO_ALLOC_STATS=1.
import "std:io"

fn fill (m : Arr i64 n, v : i64) -> Arr i64 n
  = loop (out = m, i : i64{i >= 0} = 0) while i < n next (set(out, i, v), i + 1) yield out
; Some turns keep the state as it is.
fn evens (m : Arr i64 n, v : i64) -> Arr i64 n
  = loop (out = m, i : i64{i >= 0} = 0) while i < n
      next (if i % 2 == 0 then set(out, i, v) else out, i + 1) yield out
; The outer state moves into the inner loop and comes back as its yield.
fn grid (m : Arr i64 n, rows : i64{rows >= 0}) -> Arr i64 n
  = loop (out = m, r = 0) while r < rows
      next (loop (row = out, i : i64{i >= 0} = 0) while i < n next (set(row, i, row[i] + 1), i + 1) yield row, r + 1)
      yield out
; The state is read after the set that takes it: every turn works on a copy,
; and the read sees the element as it was.
fn before (m : Arr i64 n) -> i64
  = loop (out = m, i : i64{i >= 0} = 0, seen = 0) while i < n
      next (set(out, i, -1), i + 1, seen + out[i]) yield seen
; The set in the yield takes the state too.
fn last (m : Arr i64 n, v : i64) -> Arr i64 n
  = check n > 0 in
    loop (out = m, i : i64{i >= 0} = 0) while i + 1 < n next (set(out, i, v), i + 1)
      yield check i >= 0 && i < len(out) in set(out, i, 0 - v)

; No turn runs, so nothing was copied before the loop: the set in the yield
; still has to find out whether the array is shared.
fn none (m : Arr i64 n, v : i64) -> Arr i64 n
  = check n > 0 in
    loop (out = m, i : i64{i >= 0} = n) while i < n next (set(out, i, v), i + 1)
      yield set(out, 0, v)
; The loop is entered with a shared array and edits it on every turn: it
; works on one copy, made before the first turn.
fn shifted (m : Arr i64 n) -> Arr i64 n
  = loop (out = m, i : i64{i >= 1} = 1) while i < n next (set(out, i, out[i - 1] + 1), i + 1) yield out
effect fn main (n : i64{n >= 100000 && n <= 10000000}) -> unit
  = let requests = load_i64(runtime_state(), 64) in let bytes = load_i64(runtime_state(), 80) in
    let a = arr(i in 0..n) i in
    let b = fill(a, 7) in
    let kept = sum(i in 0..n) if a[i] == i then 1 else 0 in
    let sevens = sum(i in 0..n) if b[i] == 7 then 1 else 0 in
    let c = evens(fill(arr(i in 0..n) 0, 1), 5) in
    let fives = sum(i in 0..n) c[i] in
    let g = grid(arr(i in 0..n) 0, 3) in
    let threes = sum(i in 0..n) g[i] in
    let small = arr(i in 0..16) i in
    let seen = before(small) in
    let still = sum(i in 0..16) small[i] in
    let l = last(fill(arr(i in 0..n) 0, 2), 4) in
    let fours = sum(i in 0..n) l[i] in
    let kept2 = arr(i in 0..n) i in
    let changed = none(kept2, 9) in
    let unshared = none(arr(i in 0..n) i, 9) in
    let ramp = arr(i in 0..n) 5 in
    let risen = shifted(ramp) in
    let fivesleft = sum(i in 0..n) if ramp[i] == 5 then 1 else 0 in
    let climbed = sum(i in 0..n) if risen[i] == 5 + i then 1 else 0 in
    let requests = load_i64(runtime_state(), 64) - requests in let bytes = load_i64(runtime_state(), 80) - bytes in
    let problem = if !allocation_stats_enabled() then "built without NEO_ALLOC_STATS=1"
      else if kept != n then "fill changed the array its caller still reads"
      else if sevens != n then "fill left an element"
      else if fives != (n + 1) / 2 * 5 + n / 2 then "evens set the wrong elements"
      else if threes != 3 * n then "grid lost an update"
      else if seen != 120 || still != 120 then "a read after the set saw the new element"
      else if fours != 4 * (n - 1) - 4 then "last set the wrong elements"
      else if kept2[0] != 0 || changed[0] != 9 || unshared[0] != 9 then "a set in the yield of a loop that ran no turn changed a shared array"
      else if fivesleft != n || climbed != n then "a loop entered with a shared array changed it"
      else if requests > 96 || bytes > 84 * n + 65536 then
        concat(int_text(requests), " requests and ", int_text(bytes), " bytes: an array was copied")
      else "" in
    let shown = if len(problem) > 0 then print_out(concat(problem, "\n")) else print_out("OK\n") in noop()
