; A 40-opcode bytecode VM over an Arr i64: the dispatch shape a JavaScript
; interpreter needs. `step` compares one opcode against 40 constants; its
; if/else-if chain lowers to an LLVM switch (a jump table). Memory writes go
; through a conditional `set` of a loop-carried Arr i64.
type VM = { pc : i64, a : i64, b : i64, c : i64, d : i64, k : i64 }

fn fetch(code : Arr i64 n, pc : i64) -> i64 = if pc >= 0 && pc < n then code[pc] else 39
fn cell(mem : Arr i64 m, i : i64) -> i64 = let j = bit_and(i, 63) in if j >= 0 && j < m then mem[j] else 0
fn rotate(x : i64, r : i64) -> i64 = let s = bit_and(r, 63) in bit_or(shift_left(x, s), shift_right(x, 64 - s))

fn step(vm : VM, op : i64, arg : i64, mem : Arr i64 m) -> VM
  = let pc = wrapping_add(vm.pc, 2) in
    if op == 0 then vm with { pc = pc }
    else if op == 1 then vm with { pc = pc, a = wrapping_add(vm.a, arg) }
    else if op == 2 then vm with { pc = pc, a = wrapping_sub(vm.a, arg) }
    else if op == 3 then vm with { pc = pc, a = wrapping_mul(vm.a, arg) }
    else if op == 4 then vm with { pc = pc, a = bit_xor(vm.a, arg) }
    else if op == 5 then vm with { pc = pc, a = bit_and(vm.a, wrapping_mul(arg, 1023)) }
    else if op == 6 then vm with { pc = pc, a = bit_or(vm.a, arg) }
    else if op == 7 then vm with { pc = pc, a = shift_left(vm.a, arg) }
    else if op == 8 then vm with { pc = pc, a = shift_right(vm.a, arg) }
    else if op == 9 then vm with { pc = pc, a = wrapping_add(vm.a, vm.b) }
    else if op == 10 then vm with { pc = pc, a = wrapping_sub(vm.a, vm.b) }
    else if op == 11 then vm with { pc = pc, a = wrapping_mul(vm.a, bit_or(vm.b, 1)) }
    else if op == 12 then vm with { pc = pc, a = bit_xor(vm.a, vm.b) }
    else if op == 13 then vm with { pc = pc, a = bit_and(vm.a, bit_or(vm.b, 255)) }
    else if op == 14 then vm with { pc = pc, a = bit_or(vm.a, bit_and(vm.b, 65535)) }
    else if op == 15 then vm with { pc = pc, b = vm.a }
    else if op == 16 then vm with { pc = pc, c = vm.a }
    else if op == 17 then vm with { pc = pc, a = vm.c }
    else if op == 18 then vm with { pc = pc, a = vm.b, b = vm.a }
    else if op == 19 then vm with { pc = pc, c = wrapping_add(vm.c, 1) }
    else if op == 20 then vm with { pc = pc, c = wrapping_sub(vm.c, 1) }
    else if op == 21 then vm with { pc = pc, b = wrapping_add(vm.b, vm.c) }
    else if op == 22 then vm with { pc = pc, b = bit_xor(vm.b, vm.c) }
    else if op == 23 then vm with { pc = pc, a = wrapping_add(vm.a, cell(mem, arg)) }
    else if op == 24 then vm with { pc = pc }
    else if op == 25 then vm with { pc = pc, b = bit_xor(vm.b, cell(mem, vm.a)) }
    else if op == 26 then vm with { pc = pc }
    else if op == 27 then vm with { pc = pc, a = wrapping_sub(0, vm.a) }
    else if op == 28 then vm with { pc = pc, a = bit_xor(vm.a, -1) }
    else if op == 29 then vm with { pc = pc, a = rotate(vm.a, arg) }
    else if op == 30 then vm with { pc = pc, a = if vm.a > vm.b then vm.a else vm.b }
    else if op == 31 then vm with { pc = pc, a = if vm.a < vm.b then vm.a else vm.b }
    else if op == 32 then vm with { pc = pc, a = wrapping_add(vm.a, wrapping_mul(vm.b, arg)) }
    else if op == 33 then vm with { pc = pc, c = bit_xor(vm.c, vm.a) }
    else if op == 34 then vm with { pc = pc, d = wrapping_add(vm.d, 1) }
    else if op == 35 then vm with { pc = pc, a = wrapping_add(vm.b, vm.c) }
    else if op == 36 then vm with { pc = pc, b = bit_xor(vm.a, vm.d) }
    else if op == 37 then vm with { pc = pc, c = wrapping_add(shift_right(vm.a, 3), vm.b) }
    else if op == 38 then let k = wrapping_sub(vm.k, 1) in vm with { k = k, pc = if k > 0 then arg else pc }
    else vm with { pc = -1 }

; 62 ALU/memory instructions, a counted backward jump and a halt.
fn program() -> Arr i64 _
  = arr(i in 0..128)
      let at = i / 2 in
      if i % 2 == 0 then (if at < 62 then (at * 7 + 3) % 38 else if at == 62 then 38 else 39)
      else (if at == 62 then 0 else (at * 13 + 5) % 17 + 1)

fn run(code : Arr i64 n, iterations : i64) -> i64
  = let final = loop(vm = VM { pc = 0, a = 1, b = 2, c = 3, d = 4, k = iterations }, mem = arr(i in 0..64) i * 3)
      while vm.pc >= 0
      next(step(vm, fetch(code, vm.pc), fetch(code, wrapping_add(vm.pc, 1)), mem),
           let op = fetch(code, vm.pc) in
           if op == 24 then let j = bit_and(fetch(code, wrapping_add(vm.pc, 1)), 63) in if j >= 0 && j < len(mem) then set(mem, j, vm.a) else mem
           else if op == 26 then let j = bit_and(vm.b, 63) in if j >= 0 && j < len(mem) then set(mem, j, vm.c) else mem
           else mem)
      yield bit_xor(bit_xor(vm.a, vm.b), bit_xor(vm.c, wrapping_add(vm.d, sum(i in 0..len(mem)) bit_and(mem[i], 65535)))) in
    final

fn main (iterations : i64{iterations >= 0}) -> i64 = run(program(), iterations)
