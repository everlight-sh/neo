# threads, args (mode lo hi x), stdin, expected. See tests/fixtures/fold_loops.neo.
# The greatest number of Collatz steps: short ranges, ranges that are not a multiple of sixteen, more than one block of 65,536.
1	0 1 2 0		=0\n
1	0 1 17 0		=19\n
1	0 1 100 0		=118\n
1	0 5 37 0		=111\n
1	0 1 1000 0		=178\n
4	0 1 1000 0		=178\n
1	0 1 70000 0		=339\n
4	0 1 200001 0		=382\n
1	0 27 28 0		=111\n
1	0 9 9 0		=0\n
1	0 9 3 0		=0\n
# The least, with the states and the comparison the other way round.
1	1 1 2 0		=0\n
1	1 2 100 0		=1\n
1	1 1000 1040 0		=10\n
4	1 3 70003 0		=2\n
1	1 7 7 0		=1000000\n
# The loop's own yield sees the counter at the bound and the starting value when it is the greatest.
1	2 1 100 0		=218\n
1	2 1 100 500		=600\n
1	2 50 10 7		=57\n
4	2 1 100000 0		=100350\n
# (x + i) * 2^59 fits up to a factor of 15; a term that overflows traps.
1	3 1 15 1		=8646911284551352320\n
1	3 1 16 1		!integer overflow
4	3 1 40 1		!integer overflow
1	3 1 100000 1		!integer overflow
