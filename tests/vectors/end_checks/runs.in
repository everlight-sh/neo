# threads, args (mode n x), stdin, expected. See tests/fixtures/end_checks.neo.
# n rows of width x: the last index is (n - 1) * x.
1	0 10 100		=4500\n
1	0 11 100		!check failed
1	0 0 5000		=0\n
1	0 1 5000		=0\n
1	0 2 999		=999\n
1	0 2 1000		!check failed
# Column x of rows 10 wide: the first index is x, the last 990 + x.
1	1 100 0		=49500\n
1	1 100 9		=50400\n
1	1 100 10		!check failed
1	1 100 -1		!check failed
4	1 100 9		=50400\n
# An index that falls: x - k.
1	2 10 9		=45\n
1	2 10 8		!check failed
1	2 1 1000		!check failed
1	2 0 5000		=0\n
1	2 1000 999		=499500\n
1	2 1001 999		!check failed
# k * x overflows only at the last index, or is negative there.
1	3 2 4611686018427387904		=2\n
1	3 3 4611686018427387904		!integer overflow
1	3 3 -1		!check failed
1	3 1 -1		=1\n
# A comprehension: one run of the checks per worker's part.
1	4 100 0		=9900\n
1	4 500 1		=250000\n
1	4 500 2		!check failed
4	4 500 1		=250000\n
4	4 500 2		!check failed
4	4 500 -1		!check failed
# k * k is not linear: tested at every index.
1	5 10 82		=10\n
1	5 10 81		!check failed
# The check covers indexes whose element the body does not read.
1	6 10 0		=10\n
1	6 10 995		!check failed
