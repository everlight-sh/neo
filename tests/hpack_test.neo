; HPACK (RFC 7541) against the examples of its Appendix C, plus integer encodings,
; Huffman padding and malformed blocks. Run by `neo test`.
import "std:hpack"

fn fields(headers:Arr HttpHeader n) -> Arr u8 _
  = loop(i=0,out="") while i<n next(i+1,check i>=0 && i<n in concat(out,headers[i].name,": ",headers[i].value,"\n")) yield out
fn unhex(text:Arr u8 n) -> Arr u8 _
  = let digit=loop(i=0,out="") while i+1<n next(i+2,push(out,u8(hex_value(str_byte(text,i))*16+hex_value(str_byte(text,i+1))))) yield out in digit
fn hex_value(c:i64) -> i64 = if c>=48 && c<=57 then c-48 else if c>=97 && c<=102 then c-87 else 0
; Decodes block with table and checks the fields, the table size and its entry count.
type Step = { ok:bool, table:HpackTable }
fn step(s:Step,block:Arr u8 n,expected:Arr u8 m,size:i64,entries:i64) -> Step
  = if !s.ok then s else let decoded=hpack_decode(s.table,unhex(block),65536) in
    Step { ok=decoded.ok && str_equal(fields(decoded.headers),expected) && decoded.table.size==size && len(decoded.table.entries)==entries,table=decoded.table }

fn test_rfc7541_c2_1() -> bool
  = let s=Step { ok=true,table=hpack_table(4096) } in
    let s=step(s,"400a637573746f6d2d6b65790d637573746f6d2d686561646572","custom-key: custom-header\x0a",55,1) in
    s.ok
fn test_rfc7541_c2_2() -> bool
  = let s=Step { ok=true,table=hpack_table(4096) } in
    let s=step(s,"040c2f73616d706c652f70617468",":path: /sample/path\x0a",0,0) in
    s.ok
fn test_rfc7541_c2_3() -> bool
  = let s=Step { ok=true,table=hpack_table(4096) } in
    let s=step(s,"100870617373776f726406736563726574","password: secret\x0a",0,0) in
    s.ok
fn test_rfc7541_c2_4() -> bool
  = let s=Step { ok=true,table=hpack_table(4096) } in
    let s=step(s,"82",":method: GET\x0a",0,0) in
    s.ok
fn test_rfc7541_c3_requests() -> bool
  = let s=Step { ok=true,table=hpack_table(4096) } in
    let s=step(s,"828684410f7777772e6578616d706c652e636f6d",":method: GET\x0a:scheme: http\x0a:path: /\x0a:authority: www.example.com\x0a",57,1) in
    let s=step(s,"828684be58086e6f2d6361636865",":method: GET\x0a:scheme: http\x0a:path: /\x0a:authority: www.example.com\x0acache-control: no-cache\x0a",110,2) in
    let s=step(s,"828785bf400a637573746f6d2d6b65790c637573746f6d2d76616c7565",":method: GET\x0a:scheme: https\x0a:path: /index.html\x0a:authority: www.example.com\x0acustom-key: custom-value\x0a",164,3) in
    s.ok
fn test_rfc7541_c4_requests_huffman() -> bool
  = let s=Step { ok=true,table=hpack_table(4096) } in
    let s=step(s,"828684418cf1e3c2e5f23a6ba0ab90f4ff",":method: GET\x0a:scheme: http\x0a:path: /\x0a:authority: www.example.com\x0a",57,1) in
    let s=step(s,"828684be5886a8eb10649cbf",":method: GET\x0a:scheme: http\x0a:path: /\x0a:authority: www.example.com\x0acache-control: no-cache\x0a",110,2) in
    let s=step(s,"828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf",":method: GET\x0a:scheme: https\x0a:path: /index.html\x0a:authority: www.example.com\x0acustom-key: custom-value\x0a",164,3) in
    s.ok
fn test_rfc7541_c5_responses_eviction() -> bool
  = let s=Step { ok=true,table=hpack_table(256) } in
    let s=step(s,"4803333032580770726976617465611d4d6f6e2c203231204f637420323031332032303a31333a323120474d546e1768747470733a2f2f7777772e6578616d706c652e636f6d",":status: 302\x0acache-control: private\x0adate: Mon, 21 Oct 2013 20:13:21 GMT\x0alocation: https://www.example.com\x0a",222,4) in
    let s=step(s,"4803333037c1c0bf",":status: 307\x0acache-control: private\x0adate: Mon, 21 Oct 2013 20:13:21 GMT\x0alocation: https://www.example.com\x0a",222,4) in
    let s=step(s,"88c1611d4d6f6e2c203231204f637420323031332032303a31333a323220474d54c05a04677a69707738666f6f3d4153444a4b48514b425a584f5157454f50495541585157454f49553b206d61782d6167653d333630303b2076657273696f6e3d31",":status: 200\x0acache-control: private\x0adate: Mon, 21 Oct 2013 20:13:22 GMT\x0alocation: https://www.example.com\x0acontent-encoding: gzip\x0aset-cookie: foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1\x0a",215,3) in
    s.ok
fn test_rfc7541_c6_responses_huffman_eviction() -> bool
  = let s=Step { ok=true,table=hpack_table(256) } in
    let s=step(s,"488264025885aec3771a4b6196d07abe941054d444a8200595040b8166e082a62d1bff6e919d29ad171863c78f0b97c8e9ae82ae43d3",":status: 302\x0acache-control: private\x0adate: Mon, 21 Oct 2013 20:13:21 GMT\x0alocation: https://www.example.com\x0a",222,4) in
    let s=step(s,"4883640effc1c0bf",":status: 307\x0acache-control: private\x0adate: Mon, 21 Oct 2013 20:13:21 GMT\x0alocation: https://www.example.com\x0a",222,4) in
    let s=step(s,"88c16196d07abe941054d444a8200595040b8166e084a62d1bffc05a839bd9ab77ad94e7821dd7f2e6c7b335dfdfcd5b3960d5af27087f3672c1ab270fb5291f9587316065c003ed4ee5b1063d5007",":status: 200\x0acache-control: private\x0adate: Mon, 21 Oct 2013 20:13:22 GMT\x0alocation: https://www.example.com\x0acontent-encoding: gzip\x0aset-cookie: foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1\x0a",215,3) in
    s.ok
fn test_rfc7541_c6_table_entries() -> bool
  = let s=Step { ok=true,table=hpack_table(256) } in
    let s=step(s,"488264025885aec3771a4b6196d07abe941054d444a8200595040b8166e082a62d1bff6e919d29ad171863c78f0b97c8e9ae82ae43d3",":status: 302\x0acache-control: private\x0adate: Mon, 21 Oct 2013 20:13:21 GMT\x0alocation: https://www.example.com\x0a",222,4) in
    let s=step(s,"4883640effc1c0bf",":status: 307\x0acache-control: private\x0adate: Mon, 21 Oct 2013 20:13:21 GMT\x0alocation: https://www.example.com\x0a",222,4) in
    let s=step(s,"88c16196d07abe941054d444a8200595040b8166e084a62d1bffc05a839bd9ab77ad94e7821dd7f2e6c7b335dfdfcd5b3960d5af27087f3672c1ab270fb5291f9587316065c003ed4ee5b1063d5007",":status: 200\x0acache-control: private\x0adate: Mon, 21 Oct 2013 20:13:22 GMT\x0alocation: https://www.example.com\x0acontent-encoding: gzip\x0aset-cookie: foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1\x0a",215,3) in
    s.ok && str_equal(fields(s.table.entries),"set-cookie: foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1\x0acontent-encoding: gzip\x0adate: Mon, 21 Oct 2013 20:13:22 GMT\x0a")

fn test_rfc7541_c1_integers() -> bool
  = str_equal(hpack_integer(10,5,0),"\x0a") && str_equal(hpack_integer(1337,5,0),"\x1f\x9a\x0a") && str_equal(hpack_integer(42,8,0),"\x2a")
fn test_huffman_strings() -> bool
  = let www=hpack_huffman_decode(unhex("f1e3c2e5f23a6ba0ab90f4ff")) in let cache=hpack_huffman_decode(unhex("a8eb10649cbf")) in
    let empty=hpack_huffman_decode("") in
    www.ok && str_equal(www.value,"www.example.com") && cache.ok && str_equal(cache.value,"no-cache") && empty.ok && len(empty.value)==0 &&
    ; EOS inside the string, padding of zeros, and padding of 8 bits are errors.
    !hpack_huffman_decode("\xff\xff\xff\xff").ok && !hpack_huffman_decode("\x00").ok && !hpack_huffman_decode("\x07\xff").ok
fn test_every_byte_through_huffman() -> bool
  ; "0" (00000) then "a" (00011) and six bits of padding; then bytes 0 to 255 in order.
  = let pair=hpack_huffman_decode("\x00\xff") in let all=hpack_huffman_decode(unhex("")) in
    pair.ok && str_equal(pair.value,"0a") && all.ok && len(all.value)==256 &&
      loop(i=0,same=true) while same && i<256 next(i+1,str_byte(all.value,i)==i) yield same
fn test_malformed_blocks() -> bool
  = let table=hpack_table(4096) in
    ; index 0, an index past the tables, a size update after a field or over the
    ; ceiling, a truncated string and an over-long integer
    !hpack_decode(table,"\x80",65536).ok && !hpack_decode(table,"\xbf",65536).ok &&
    !hpack_decode(table,"\x82\x3f\xe1\x1f",65536).ok && !hpack_decode(table,"\x3f\xe2\x1f",65536).ok &&
    hpack_decode(table,"\x3f\xe1\x1f\x82",65536).ok && hpack_decode(table,"\x20\x82",65536).table.limit==0 &&
    !hpack_decode(table,"\x04\x05/ab",65536).ok && !hpack_decode(table,"\xff\xff\xff\xff\xff\xff\x01",65536).ok &&
    ; the header list limit
    hpack_decode(table,"\x82\x84",80).ok && !hpack_decode(table,"\x82\x84",79).ok
fn test_encoder_round_trip() -> bool
  = let headers=arr(i in 0..5) if i==0 then HttpHeader { name=":method",value="GET" } else if i==1 then HttpHeader { name=":scheme",value="https" }
      else if i==2 then HttpHeader { name=":authority",value="example.com:8443" } else if i==3 then HttpHeader { name=":path",value="/a/very/long/path/that/needs/more/than/one/hundred/and/twenty/seven/bytes/to/encode/its/length/with/a/continuation/byte/0123456789" }
      else HttpHeader { name="x-custom",value="value" } in
    let block=hpack_encode(headers) in let decoded=hpack_decode(hpack_table(4096),block,65536) in
    str_starts(block,"\x82\x87\x01") && decoded.ok && str_equal(fields(decoded.headers),fields(headers)) && len(decoded.table.entries)==0
