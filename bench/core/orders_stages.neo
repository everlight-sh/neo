; Cumulative cost of decoding stages for the 1,000-order array in orders_json.neo:
; mode 0 validates, 1 also splits elements, 2 also looks up four fields, 3 reads them.
import "std:json"
fn orders_append(move text:Arr u8 _,i:i64) -> Arr u8 _
  = concat(text,if i==0 then "" else ",","{\"customer\":",int_text(i%8),",\"qty\":",int_text(i%17),",\"price\":3,\"name\":\"user",int_text(i),"\"}")
fn orders_text(n:i64) -> Arr u8 _
  = concat(loop(i=0,text="[") while i<n next(i+1,orders_append(text,i)) yield text,"]")
fn stage(borrow text:Arr u8 _,mode:i64) -> i64
  = let parsed=json_parse(text) in if mode==0 then parsed.value.count else let rows=json_array_values(parsed.value) in
    if mode==1 then len(rows) else
    loop(i=0,total=0) while i<len(rows) next(i+1,check i>=0 && i<len(rows) in let row=rows[i] in
      if mode==2 then total+(if json_get(row,"qty").present then 1 else 0)+(if json_get(row,"price").present then 1 else 0)+(if json_get(row,"customer").present then 1 else 0)+(if json_get(row,"name").present then 1 else 0)
      else let qty=json_int(json_get(row,"qty").value) in let price=json_int(json_get(row,"price").value) in
      let customer=json_int(json_get(row,"customer").value) in let name=json_text(json_get(row,"name").value) in
      total+qty.value*price.value+customer.value+len(name.value)) yield total
fn main(mode:i64,iterations:i64{iterations > 0, iterations <= 1000000}) -> i64
  = let text=orders_text(1000) in loop(k=0,total=0) while k<iterations next(k+1,total+stage(text,mode)) yield total
