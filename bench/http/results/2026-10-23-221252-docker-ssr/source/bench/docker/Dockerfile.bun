FROM oven/bun:1.3.13-alpine AS base
WORKDIR /app
COPY server.ts /app/server.ts
ENV NODE_ENV=production
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/bun", "run", "/app/server.ts", "8080"]

FROM base AS direct
COPY direct.ts /app/direct.ts
ENV RENDERER=direct

FROM oven/bun:1.3.13-alpine AS install
WORKDIR /install
COPY package.json bun.lock ./
RUN bun install --production --frozen-lockfile

FROM base AS react
COPY --from=install /install/node_modules /app/node_modules
COPY reference.tsx page.tsx /app/
ENV RENDERER=react
