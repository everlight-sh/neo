; Freestanding Axon runtime. No extern declarations and no libc calls.
; Globals and syscalls are compiler primitives; policy and allocation are Axon.
; State: envp@0, errno@8, cpu cache@16, slab bump@24, remaining@32,
; free-list heads@256, free-list counts@768. One private state per process.

export effect fn ax_runtime_init (envp : ptr) -> unit
  = store_ptr(runtime_state(), 0, envp)

effect fn rt_errno () -> ptr = ptr_add(runtime_state(), 8)
effect fn rt_result (value : i64) -> i64
  = if value < 0 then let saved = store_i32(rt_errno(), 0, i32(0 - value)) in -1 else value

effect fn rt_cstrlen (text : ptr) -> i64
  = loop (i = 0) while volatile_load_u8(text, i) != u8(0) next (i + 1) yield i

effect fn rt_write_all (fd : i64, text : ptr, n : i64) -> unit
  = let done = loop (offset = 0) while offset >= 0 && offset < n
      next (let count = rt_write(fd, ptr_add(text, offset), n - offset) in
            if count > 0 then offset + count
            else if count < 0 && load_i32(rt_errno(), 0) == i32(4) then offset else -1)
      yield offset in noop()

effect fn rt_puts (fd : i64, text : ptr) -> unit = rt_write_all(fd, text, rt_cstrlen(text))

export effect fn ax_trap (message : ptr) -> unit
  = let prefix = rt_write_all(2, data("axon: trap: "), 12) in
    let body = rt_puts(2, message) in let newline = rt_write_all(2, data("\n"), 1) in ax_exit(1)

; Volatile word operations keep LLVM from replacing these implementations
; with recursive calls to an absent C library. Unaligned loads are permitted.
export effect fn memcpy (dst : ptr, src : ptr, n : i64) -> ptr
  = let words = loop (i = 0) while i + 8 <= n
      next (let copied = volatile_store_i64(dst, i, volatile_load_i64(src, i)) in i + 8) yield i in
    let tail = loop (i = words) while i < n
      next (let copied = volatile_store_u8(dst, i, volatile_load_u8(src, i)) in i + 1) yield i in dst

export effect fn memmove (dst : ptr, src : ptr, n : i64) -> ptr
  = if ptr_to_i64(dst) <= ptr_to_i64(src) then memcpy(dst, src, n)
    else let words = loop (left = n) while left >= 8
      next (let copied = volatile_store_i64(dst, left - 8, volatile_load_i64(src, left - 8)) in left - 8) yield left in
    let tail = loop (left = words) while left > 0
      next (let copied = volatile_store_u8(dst, left - 1, volatile_load_u8(src, left - 1)) in left - 1) yield left in dst

export effect fn memset (dst : ptr, byte : i32, n : i64) -> ptr
  = let b = (i64(byte) % 256 + 256) % 256 in
    let pattern = b * 72340172838076673 in
    let words = loop (i = 0) while i + 8 <= n
      next (let cleared = volatile_store_i64(dst, i, pattern) in i + 8) yield i in
    let tail = loop (i = words) while i < n
      next (let cleared = volatile_store_u8(dst, i, u8(b)) in i + 1) yield i in dst

export effect fn bzero (dst : ptr, n : i64) -> unit
  = let cleared = memset(dst, i32(0), n) in noop()

export fn ax_cap (bytes : i64) -> i64
  = loop (capacity = 16) while capacity < bytes && capacity <= 4611686018427387903
      next (capacity * 2) yield capacity

fn rt_class (capacity : i64) -> i64
  = loop (c = 16, k = 0) while c < capacity next (c * 2, k + 1) yield k

effect fn rt_map (bytes : i64) -> ptr
  = let address = rt_mmap(bytes) in
    if address < 0 then let failed = ax_trap(data("mmap failed\0")) in null() else ptr_from_i64(address)

export effect fn ax_alloc (bytes : i64) -> ptr
  = if bytes < 0 || bytes > 4611686018427387904 then
      let failed = ax_trap(data("allocation size out of range\0")) in null()
    else let capacity = ax_cap(bytes) in
      let k = rt_class(capacity) in
      let state = runtime_state() in
      let cached = load_ptr(state, 256 + k * 8) in
      if cached != null() then
        let popped = store_ptr(state, 256 + k * 8, load_ptr(cached, 0)) in
        let count = store_i64(state, 768 + k * 8, load_i64(state, 768 + k * 8) - 1) in cached
      else let header = if capacity > 32768 then rt_map(capacity + 16)
        else let available = load_i64(state, 32) in
          let refill = if available < capacity + 16 then
            let chunk = store_ptr(state, 24, rt_map(65536)) in store_i64(state, 32, 65536)
          else noop() in
          let p = load_ptr(state, 24) in
          let advanced = store_ptr(state, 24, ptr_add(p, capacity + 16)) in
          let remaining = store_i64(state, 32, load_i64(state, 32) - capacity - 16) in p in
        let size = store_i64(header, 0, capacity) in
        let pooled = store_i64(header, 8, if capacity <= 32768 then 1 else 0) in ptr_add(header, 16)

effect fn ax_release (p : ptr) -> unit
  = if p == null() then noop() else
    let capacity = load_i64(p, -16) in
    let k = rt_class(capacity) in
    let state = runtime_state() in
    let count = load_i64(state, 768 + k * 8) in
    if load_i64(p, -8) == 0 && count >= 8 then
      let unmapped = rt_munmap(ptr_add(p, -16), capacity + 16) in noop()
    else let link = store_ptr(p, 0, load_ptr(state, 256 + k * 8)) in
      let head = store_ptr(state, 256 + k * 8, p) in store_i64(state, 768 + k * 8, count + 1)

export effect fn ax_free (p : ptr, bytes : i64) -> unit = ax_release(p)

export effect fn calloc (n : i64, size : i64) -> ptr
  = if n < 0 || size < 0 || (size > 0 && n > 9223372036854775807 / size) then
      let failed = ax_trap(data("calloc overflow\0")) in null()
    else let bytes = n * size in let p = ax_alloc(bytes) in memset(p, i32(0), bytes)

; A forked child must not reuse a parent's shared allocator slab or free lists.
effect fn rt_fork () -> i64
  = let pid = fork_syscall() in
    if pid != 0 then pid else
      let reset = memset(ptr_add(runtime_state(), 24), i32(0), 2024) in 0

effect fn rt_env_match (entry : ptr, name : ptr) -> bool
  = let length = rt_cstrlen(name) in
    let matched = loop (i = 0, ok = true) while ok && i < length
      next (i + 1, load_u8(entry, i) == load_u8(name, i)) yield ok in
    matched && load_u8(entry, length) == '='

effect fn rt_getenv (name : ptr) -> ptr
  = let envp = load_ptr(runtime_state(), 0) in
    if envp == null() then null() else
      loop (i = 0, found = null()) while found == null() && load_ptr(envp, i * 8) != null()
        next (i + 1, let entry = load_ptr(envp, i * 8) in
              if rt_env_match(entry, name) then ptr_add(entry, rt_cstrlen(name) + 1) else null()) yield found

fn rt_digit_ok (acc : i64, digit : i64, negative : bool) -> bool
  = digit >= 0 && digit <= 9 && acc >= -922337203685477580 &&
    (acc != -922337203685477580 || digit <= (if negative then 8 else 7))

export effect fn ax_parse_i64 (text : ptr, name : ptr) -> i64
  = let first = load_u8(text, 0) in
    let negative = first == '-' in
    let start = if negative || first == '+' then 1 else 0 in
    loop (i = start, acc = 0, ok = true, digits = 0)
      while ok && load_u8(text, i) != u8(0)
      next (i + 1,
            let digit = i64(load_u8(text, i)) - 48 in if rt_digit_ok(acc, digit, negative) then acc * 10 - digit else acc,
            rt_digit_ok(acc, i64(load_u8(text, i)) - 48, negative), digits + 1)
      yield if !ok || digits == 0 then
        let prefix = rt_write_all(2, data("axon: argument "), 15) in
        let label = rt_puts(2, name) in let message = rt_write_all(2, data(": not an integer: "), 18) in
        let value = rt_puts(2, text) in let newline = rt_write_all(2, data("\n"), 1) in
        let stopped = ax_exit(2) in 0
      else if negative then acc else 0 - acc

effect fn rt_threads () -> i64 {result >= 1, result <= 256}
  = let e = rt_getenv(data("AXON_THREADS\0")) in
    let n = if e == null() then rt_ncpu() else ax_parse_i64(e, data("AXON_THREADS\0")) in
    if n < 1 then 1 else if n > 256 then 256 else n

export effect fn ax_chunks (n : i64) -> i64
  = let t = rt_threads() in if n <= 0 then 0 else if t == 1 || n < 1024 then 1
    else if n < t * 8 then n else t * 8

export effect fn ax_par_for (chunks : i64, work : ptr, context : ptr) -> unit
  = if chunks <= 0 then noop() else
    let configured = rt_threads() in
    let workers = if chunks < configured then chunks else configured in
    let pids = stack_alloc(2048) in
    let launched = loop (worker = 0) while worker + 1 < workers
      next (let pid = rt_fork() in
            if pid == 0 then
              let done = loop (i = chunks * worker / workers) while i < chunks * (worker + 1) / workers
                next (let ran = invoke_region(work, context, i) in i + 1) yield i in
              let exited = ax_exit(0) in workers
            else let saved = store_i64(pids, worker * 8, pid) in
              let fallback = if pid < 0 then
                let done = loop (i = chunks * worker / workers) while i < chunks * (worker + 1) / workers
                  next (let ran = invoke_region(work, context, i) in i + 1) yield i in noop()
              else noop() in worker + 1)
      yield worker in
    let done = loop (i = chunks * (workers - 1) / workers) while i < chunks
      next (let ran = invoke_region(work, context, i) in i + 1) yield i in
    let joined = loop (worker = 0) while worker + 1 < workers
      next (let pid = load_i64(pids, worker * 8) in
            let status = if pid > 0 then rt_wait(pid) else 0 in
            let failed = if status != 0 then ax_trap(data("parallel worker failed\0")) else noop() in worker + 1)
      yield worker in noop()

export effect fn ax_usage (program : ptr, names : ptr) -> unit
  = let prefix = rt_write_all(2, data("usage: "), 7) in let p = rt_puts(2, program) in
    let space = rt_write_all(2, data(" "), 1) in let n = rt_puts(2, names) in rt_write_all(2, data("\n"), 1)

export effect fn ax_precondition_failed (predicate : ptr) -> unit
  = let prefix = rt_write_all(2, data("axon: precondition failed: "), 27) in
    let p = rt_puts(2, predicate) in rt_write_all(2, data("\n"), 1)

effect fn rt_format_integer (buffer : ptr, end : i64, value : i64) -> i64
  = let negative = value < 0 in
    let mag = if negative then value else 0 - value in
    let start = loop (v = mag, i = end, again = true) while again
      next (v / 10, let written = store_u8(buffer, i - 1, u8(48 - v % 10)) in i - 1, v <= -10)
      yield i in
    if negative then let sign = store_u8(buffer, start - 1, '-') in start - 1 else start

export effect fn ax_print_i64 (v : i64) -> unit
  = let buffer = stack_alloc(64) in
    let start = rt_format_integer(buffer, 63, v) in
    let newline = store_u8(buffer, 63, '\n') in rt_write_all(1, ptr_add(buffer, start), 64 - start)

type RuntimeFloat = { value : f64, exponent : i64 }
fn rt_normalize_float (value : f64) -> RuntimeFloat
  = let high = loop (v = value, e = 0) while v >= 10.0 next (v / 10.0, e + 1)
      yield RuntimeFloat { value = v, exponent = e } in
    loop (v = high.value, e = high.exponent) while v < 1.0 next (v * 10.0, e - 1)
      yield RuntimeFloat { value = v, exponent = e }

export effect fn ax_print_f64 (v : f64) -> unit
  = if v != v then rt_write_all(1, data("nan\n"), 4)
    else let negative = float_bits(v) < 0 in
      let a = if negative then 0.0 - v else v in
      if a == 0.0 then if negative then rt_write_all(1, data("-0\n"), 3) else rt_write_all(1, data("0\n"), 2)
      else if a / 2.0 == a then if negative then rt_write_all(1, data("-inf\n"), 5) else rt_write_all(1, data("inf\n"), 4)
      else let normalized = rt_normalize_float(a) in
        let rounded = i64(normalized.value * 10000000000000000.0 + 0.5) in
        let digits = if rounded >= 100000000000000000 then rounded / 10 else rounded in
        let exponent = normalized.exponent + (if rounded >= 100000000000000000 then 1 else 0) in
        let buffer = stack_alloc(128) in
        let sign = if negative then let written = store_u8(buffer, 0, '-') in 1 else 0 in
        let point = store_u8(buffer, sign + 1, '.') in
        let written = loop (i = 0, divisor : i64{divisor >= 1} = 10000000000000000) while i < 17
          next (let digit = store_u8(buffer, sign + (if i == 0 then 0 else i + 1), u8(48 + digits / divisor % 10)) in i + 1,
                if divisor >= 10 then divisor / 10 else 1) yield i in
        let e = store_u8(buffer, sign + 18, 'e') in
        let prefix = rt_write_all(1, buffer, sign + 19) in
        let start = rt_format_integer(buffer, 127, exponent) in
        let newline = store_u8(buffer, 127, '\n') in rt_write_all(1, ptr_add(buffer, start), 128 - start)

export effect fn ax_print_bytes (p : ptr, n : i64) -> unit = rt_write_all(1, p, n)

effect fn rt_retry () -> bool
  = let error = i64(load_i32(rt_errno(), 0)) in error == 4 || error == rt_again()

effect fn rt_nonblock (fd : i64) -> i64
  = let flags = rt_fcntl(fd, 3, 0) in
    if flags < 0 then -1
    else rt_fcntl(fd, 4, if flags / rt_nonblock_flag() % 2 == 1 then flags else flags + rt_nonblock_flag())

effect fn rt_listener (port : i64) -> i64
  = let fd = rt_socket(2, 1, 0) in
    if fd < 0 then let failed = ax_trap(data("socket failed\0")) in -1 else
    let address = stack_alloc(32) in
    let cleared = memset(address, i32(0), 32) in
    let family = rt_address(address) in
    let high = store_u8(address, 2, u8(port / 256)) in
    let low = store_u8(address, 3, u8(port % 256)) in
    let one = store_i32(address, 16, i32(1)) in
    let reuse = rt_setsockopt(fd, rt_socket_level(), rt_reuseaddr(), ptr_add(address, 16), 4) in
    let bound = rt_bind(fd, address, 16) in
    if bound < 0 || rt_listen(fd, 4096) < 0 || rt_nonblock(fd) < 0 then
      let closed = rt_close(fd) in let failed = ax_trap(data("bind/listen failed\0")) in -1
    else fd
