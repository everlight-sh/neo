; Example HTML escaping and HTTP helpers. Ordinary Axon; no core extensions.
fn starts_with (a : Arr u8 n, b : Arr u8 m) -> bool
  = m <= n && loop (i : i64{i >= 0} = 0, ok = true)
                while ok && i < m
                next (i + 1, a[i] == b[i])
                yield ok

fn page_count (req : Arr u8 n) -> i64
  = loop (i : i64{i >= 0} = 10, value = 0, digits = 0)
      while i < n && req[i] >= '0' && req[i] <= '9' && digits < 12
      next (i + 1, value * 10 + i64(req[i]) - 48, digits + 1)
      yield if digits > 0 && i < n && (req[i] == ' ' || req[i] == '?') then value else -1

; v divided by 10, k times
fn shift10 (v : i64, k : i64) -> i64
  = loop (x = v, j = 0) while j < k next (x / 10, j + 1) yield x

fn utoa (v : i64{v >= 0}) -> Arr u8 _
  = let d = loop (x = v, d : i64{d >= 1} = 1) while x >= 10 next (x / 10, d + 1) yield d in
    arr(i in 0..d) u8(48 + shift10(v, d - 1 - i) % 10)

; ---- HTML escaping, React's rules (& < > " '), fully proven: the buffer is 6x the input,
;      the write cursor stays under 6 * i by invariant, and the exact length is a bounded sum.
fn esc_width (c : u8) -> i64 {result >= 1, result <= 6}
  = if c == '&' then 5 else if c == '<' || c == '>' then 4 else if c == '"' || c == '\'' then 6 else 1

fn put (out : Arr u8 m, j : i64{j >= 0}, s : Arr u8 k{j + k <= m}) -> Arr u8 m
  = loop (o = out, t : i64{t >= 0} = 0) while t < k next (set(o, j + t, s[t]), t + 1) yield o

fn esc_char (out : Arr u8 m, j : i64{j >= 0, j + 6 <= m}, c : u8) -> Arr u8 m
  = if c == '&' then put(out, j, "&amp;")
    else if c == '<' then put(out, j, "&lt;")
    else if c == '>' then put(out, j, "&gt;")
    else if c == '"' then put(out, j, "&quot;")
    else if c == '\'' then put(out, j, "&#x27;")
    else set(out, j, c)

fn escape (s : Arr u8 n) -> Arr u8 _
  = let total = sum(i in 0..n) esc_width(s[i]) in
    let buf = loop (o = arr(k in 0..6 * n) u8(32), i : i64{i >= 0, i <= n} = 0, j : i64{j >= 0, j <= 6 * i} = 0)
                while i < n
                next (esc_char(o, j, s[i]), i + 1, j + esc_width(s[i]))
                yield o in
    arr(k in 0..total) buf[k]


; Generated by examples/jsx-ssr/compile.ts. Do not edit.
fn jsx_Badge (p_label : Arr u8 n0) -> Arr u8 _
  = concat("<span class=\"badge\">", escape(p_label), "</span>")

fn jsx_Card (p_title : Arr u8 n0, p_children : Arr u8 n1) -> Arr u8 _
  = let jsx_cached0 = escape(p_title) in
    concat("<article class=\"card\" title=\"", jsx_cached0, "\"><h2>", jsx_cached0, "</h2><div>", p_children, "</div></article>")

fn jsx_Page (p_name : Arr u8 n0, p_count : i64{p_count >= 0}, p_featured : bool) -> Arr u8 _
  = let jsx_cached0 = escape(p_name) in
    let jsx_cached1 = utoa(p_count) in
    concat("<html lang=\"en\"><head><title>JSX on Axon</title></head><body><main><h1>JSX on Axon</h1><article class=\"card\" title=\"", jsx_cached0, "\"><h2>", jsx_cached0, "</h2><div><p>Hello, ", jsx_cached0, "!</p><p data-count=\"", jsx_cached1, "\">Requests: ", jsx_cached1, "</p>", (if p_featured then "<span class=\"badge\">Featured &amp; independent</span>" else ""), "<p>", (if (p_count == 1) then "One item" else "Many items"), "</p><p>Compiled components &amp; escaped props.</p></div></article></main><footer>No browser JavaScript required.</footer></body></html>")

; Example route shell: props are supplied at request time, not prerendered.
fn page (n : i64{n >= 0}) -> Arr u8 _
  = concat("<!DOCTYPE html>", jsx_Page(
      if n == 13 then "<script>alert(\"x\")</script> & \' café 🚀"
      else "Axon & React\'s \"JSX\" <components>", n, n % 2 == 0))

fn page_response (n : i64{n >= 0}) -> Arr u8 _
  = let body = page(n) in
    let clen = utoa(len(body)) in
    concat("HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: ", clen, "\r\n\r\n", body)

fn handle (req : Arr u8 n) -> Arr u8 _
  = let home = starts_with(req, "GET / ") || starts_with(req, "GET /?") in
    if home || starts_with(req, "GET /page/") then
      let count = if home then 3 else page_count(req) in
      if count < 1 || count > 1000 then
        "HTTP/1.1 400 Bad Request\r\nContent-Type: text/plain\r\nContent-Length: 30\r\n\r\nusage: /page/N, 1 <= N <= 1000"
      else page_response(count)
    else if starts_with(req, "GET ") then
      "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nContent-Length: 9\r\n\r\nNot Found"
    else "HTTP/1.1 405 Method Not Allowed\r\nContent-Length: 0\r\n\r\n"

effect fn main (port : i64{port > 0, port < 65536}) -> i64
  = serve(port, handle)
