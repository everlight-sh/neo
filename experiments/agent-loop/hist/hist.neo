; Histogram over values v[i] = (i * 2654435761) % 1000003 for i in 0..n,
; bucketed into 16 buckets by v * 16 / 1000003, built with in-place `set`
; in a single pass, returning the largest bucket count.

fn build_hist (n : i64{n >= 1}) -> Arr i64 (16)
  = loop (h = arr(k in 0..16) 0, i : i64{i >= 0} = 0)
      while i < n
      next (let v = (i * 2654435761) % 1000003 in
            let b = v * 16 / 1000003 in
            check 0 <= b && b < 16 in
            set(h, b, h[b] + 1), i + 1)
      yield h

fn main (n : i64{n >= 1}) -> i64
  = let h = build_hist(n) in
    let m0 = h[0] in
    let m1 = if h[1] > m0 then h[1] else m0 in
    let m2 = if h[2] > m1 then h[2] else m1 in
    let m3 = if h[3] > m2 then h[3] else m2 in
    let m4 = if h[4] > m3 then h[4] else m3 in
    let m5 = if h[5] > m4 then h[5] else m4 in
    let m6 = if h[6] > m5 then h[6] else m5 in
    let m7 = if h[7] > m6 then h[7] else m6 in
    let m8 = if h[8] > m7 then h[8] else m7 in
    let m9 = if h[9] > m8 then h[9] else m8 in
    let m10 = if h[10] > m9 then h[10] else m9 in
    let m11 = if h[11] > m10 then h[11] else m10 in
    let m12 = if h[12] > m11 then h[12] else m11 in
    let m13 = if h[13] > m12 then h[13] else m12 in
    let m14 = if h[14] > m13 then h[14] else m13 in
    let m15 = if h[15] > m14 then h[15] else m14 in
    m15
