#!/bin/sh
# Locate the native compiler beside the real launcher, including after install.
set -eu
case $0 in
  */*) self=$0 ;;
  *) self=$(command -v "$0") ;;
esac
case $self in */*) ;; *) self=./$self ;; esac
while [ -h "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=${self%/*}/$link ;;
  esac
done
launcher_root=$(CDPATH= cd -- "${self%/*}" && pwd -P)
export NEO_ROOT=${NEO_ROOT:-$launcher_root}

# Large source files can exhaust the platform's default soft stack limit.
if stack=$(ulimit -S -s 2>/dev/null) && hard_stack=$(ulimit -H -s 2>/dev/null); then
  wanted_stack=65536
  case $hard_stack in
    ''|unlimited) ;;
    *) [ "$hard_stack" -ge "$wanted_stack" ] || wanted_stack=$hard_stack ;;
  esac
  case $stack in
    ''|unlimited) ;;
    *) [ "$stack" -ge "$wanted_stack" ] || ulimit -S -s "$wanted_stack" 2>/dev/null || : ;;
  esac
fi

if [ -n "${NEOC:-}" ]; then
  exec "$NEOC" "$@"
elif [ -x "$launcher_root/bin/neoc" ]; then
  exec "$launcher_root/bin/neoc" "$@"
elif [ -x "$launcher_root/.neo-build/bin/neoc" ]; then
  exec "$launcher_root/.neo-build/bin/neoc" "$@"
else
  printf '%s\n' 'neo: native neoc executable missing. Install a native bundle or set NEOC to an existing native compiler.' >&2
  exit 1
fi
