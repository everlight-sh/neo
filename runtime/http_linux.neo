; Linux level-triggered epoll backend, entirely Neo + direct kernel syscalls.
; Tokens: listener=0, worker notification=1, connections rt_http_token(index).
; Registration persists across waits. Ordinary read/render/write requests keep
; EPOLLIN registered without epoll_ctl per request. EPOLLOUT is armed only for
; backpressure or complete buffered requests that exceed the 64-response batch.
; It serves where io_uring (http_uring.neo) is off or unavailable;
; NEO_HTTP_URING=0 selects it, NEO_HTTP_POLL=1 the older ppoll loop.

effect fn rt_epoll_apply (epfd : i64, op : i64, fd : i64, mask : i64, token : i64) -> unit
  = let result = rt_epoll_ctl(epfd, op, fd, mask, token) in
    if result < 0 then ax_trap(data("epoll_ctl syscall failed\0")) else noop()

effect fn rt_epoll_sync (epfd : i64, state : ptr, interests : ptr, index : i64) -> unit
  = if load_i64(state, 0) < 0 then noop() else
    let wanted = if load_i64(state,48)==2 then (if load_i64(state,32)>0 then 8197 else 8193) else if load_i64(state, 32) > 0 || load_i64(state, 56) == 1 then 4 else 1 in
    if wanted == load_i64(interests, index * 8) then noop() else
      let updated = rt_epoll_apply(epfd, 3, load_i64(state, 0), wanted, rt_http_token(index)) in
      store_i64(interests, index * 8, wanted)

; Finish the entire returned event batch before compacting or accepting.
; Thus a cached event's old index can never identify a newly moved/reused slot.
; MOD refreshes moved registrations' tokens before the next epoll_wait.
effect fn rt_epoll_compact (epfd : i64, states : ptr, interests : ptr, n : i64) -> i64
  = loop (i = 0, used = 0) while i < n
      next (i + 1,
        if load_i64(states, i * 128) < 0 then used else
          let moved = if i == used then noop() else
            let state = ptr_add(states, i * 128) in
            let copied = memcpy(ptr_add(states, used * 128), state, 128) in
            let mask = load_i64(interests, i * 8) in
            let interest = store_i64(interests, used * 8, mask) in
            rt_epoll_apply(epfd, 3, load_i64(state, 0), mask, rt_http_token(used)) in used + 1)
      yield used

effect fn rt_epoll_listener (epfd : i64, listener : i64, control : ptr, worker : i64, local : ptr) -> unit
  = let wanted = if load_i64(control, 0) == worker then 1 else 0 in
    if atomic_load_i64(control,8)>0 || wanted == load_i64(local, 8) then noop() else
      let changed = rt_epoll_apply(epfd, if wanted == 1 then 1 else 2, listener, 1, 0) in
      store_i64(local, 8, wanted)

; Registers every connection accepted while this worker holds the accept
; turn (with one worker, until the listener is drained), not one per event.
effect fn rt_epoll_accept (epfd : i64, listener : i64, states : ptr, interests : ptr, local : ptr,
                         control : ptr, worker : i64, workers : i64{workers >= 1}) -> unit
  = let drained = loop (more = true) while more
      next (let previous = load_i64(local, 0) in
            let accepted = rt_accept(listener, states, local, control, worker, workers) in
            if previous == load_i64(local, 0) then false else
              let saved = store_i64(interests, previous * 8, 1) in
              let applied = rt_epoll_apply(epfd, 1, load_i64(states, previous * 128), 1, rt_http_token(previous)) in true)
      yield more in noop()

effect fn rt_http_epoll_worker (listener : i64, handler : ptr, control : ptr, worker : i64,
                              workers : i64{workers >= 1}, parent : i64) -> i64
  = let epfd = rt_epoll_create() in
    let valid = if epfd < 0 then ax_trap(data("epoll_create1 syscall failed\0")) else noop() in
    let backend=store_i64(runtime_state(),1768,epfd+1) in
    let states = ax_alloc(rt_http_limit(control) * 128) in
    let interests = ax_alloc(rt_http_limit(control) * 8) in
    let events = ax_alloc(1026 * rt_epoll_event_bytes()) in
    ; local: active count@0, listener registered@8, closed@16, accept-ready@24.
    let local = stack_alloc(32) in let cleared = memset(local, i32(0), 32) in
    let notification = stack_alloc(64) in
    let registered = rt_epoll_apply(epfd, 1, load_i64(control, 256 + worker * 16), 1, 1) in
    ; Up to 32 ready connections per wait: unserved ones stay level-triggered
    ; ready, and new requests interleave instead of waiting out a full sweep.
    ; With one worker and 64 busy connections this cut p99 from 1.38 to 0.87 ms.
    let signal=load_i64(runtime_state(),1696)-1 in
    let monitored=if signal<0 then noop() else rt_epoll_apply(epfd,1,signal,1,1026) in
    let batch = 32 in
    loop (running = true) while running
      next (let pending=load_i64(runtime_state(),1640)>0 || load_i64(runtime_state(),1784)>0 in let ticks=rt_async_tick(states,load_i64(local,0)) in
            let draining=if signal<0 then false else rt_http_draining(control,states,load_i64(local,0),listener) in
            if draining then false else
            let synced=if !pending then noop() else
              let changed=loop(i=0) while i<load_i64(local,0) next(let state=ptr_add(states,i*128) in let sync=if load_i64(state,0)>=0 then rt_epoll_sync(epfd,state,interests,i) else noop() in i+1) yield i in noop() in
            let swept=if rt_http_sweep_due() then rt_http_sweep(states,load_i64(local,0),control,parent) else 0 in
            let compacted=if !pending && swept==0 then noop() else let used=rt_epoll_compact(epfd,states,interests,load_i64(local,0)) in store_i64(local,0,used) in
            let listening = rt_epoll_listener(epfd, listener, control, worker, local) in
            let delay=rt_async_timeout(if signal<0 then 1000 else 100) in
            let ready = rt_epoll_wait_timeout(epfd,events,batch,delay) in
            let tick = rt_http_tick() in
            if ready < 0 then if load_i32(rt_errno(), 0) == i32(4) then true
              else let failed = ax_trap(data("epoll_pwait syscall failed\0")) in false
            else let reset = store_i64(local, 16, 0) in let reset_accept = store_i64(local, 24, 0) in
              let n = load_i64(local, 0) in
              let served = loop (i = 0) while i < ready
                next (let token = load_i64(events, i * rt_epoll_event_bytes() + rt_epoll_data_offset()) in
                      let mask = i64(load_i32(events, i * rt_epoll_event_bytes())) in
                      let stepped = if token == 0 then store_i64(local, 24, 1)
                        else if bit_and(token,4095)>=2048 then rt_fiber_notify(token)
                        else if token==1026 then rt_http_shutdown_signal(control,signal)
                        else if token == 1 then
                          let drained = rt_read(load_i64(control, 256 + worker * 16), notification, 64) in rt_async_notified()
                        else let index = rt_http_token_index(token) in
                          if index < 0 || index >= n then ax_trap(data("invalid epoll token\0")) else
                            let state = ptr_add(states, index * 128) in
                            if load_i64(state, 0) < 0 then noop() else
                              let done = rt_step(state, mask, handler) in
                              if load_i64(state, 0) < 0 then store_i64(local, 16, 1)
                              else rt_epoll_sync(epfd, state, interests, index) in i + 1)
                yield i in
              let compacted = if load_i64(local, 16) == 0 then noop() else
                let used = rt_epoll_compact(epfd, states, interests, n) in store_i64(local, 0, used) in
              let accepted = if atomic_load_i64(control,8)==0 && load_i64(local, 24) == 1 then
                rt_epoll_accept(epfd, listener, states, interests, local, control, worker, workers) else noop() in true)
      yield 0

effect fn rt_serve_worker (listener : i64, handler : ptr, control : ptr, worker : i64,
                         workers : i64{workers >= 1}, parent : i64) -> i64
  = let fallback = rt_getenv_legacy(data("NEO_HTTP_POLL\0"), data("AXON_HTTP_POLL\0")) in
    let uring = rt_getenv_legacy(data("NEO_HTTP_URING\0"), data("AXON_HTTP_URING\0")) in
    let requested = uring != null() && load_u8(uring, 0) == '1' in
    if load_i64(control,16)>0 then rt_http_epoll_worker(listener,handler,control,worker,workers,parent) else
    if fallback != null() && load_u8(fallback, 0) == '1' then
      rt_http_worker(listener, handler, control, worker, workers, parent)
    else if uring != null() && load_u8(uring, 0) == '0' then
      rt_http_epoll_worker(listener, handler, control, worker, workers, parent)
    else if requested || rt_uring_default() then
      rt_serve_uring(listener, handler, control, worker, workers, parent, requested)
    else rt_http_epoll_worker(listener, handler, control, worker, workers, parent)
