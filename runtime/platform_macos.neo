; Darwin ARM64 kernel ABI. The OS loader still requires libSystem, but this
; runtime imports no library functions. Raw syscall ABI is platform-specific.
effect fn rt_read (fd : i64, p : ptr, n : i64) -> i64 = rt_result(syscall6(3, fd, ptr_to_i64(p), n, 0, 0, 0))
effect fn rt_write (fd : i64, p : ptr, n : i64) -> i64 = rt_result(syscall6(4, fd, ptr_to_i64(p), n, 0, 0, 0))
effect fn rt_writev (fd : i64, iov : ptr, count : i64) -> i64 = rt_result(syscall6(121, fd, ptr_to_i64(iov), count, 0, 0, 0))
effect fn rt_close (fd : i64) -> i64 = rt_result(syscall6(6, fd, 0, 0, 0, 0, 0))
export effect fn ax_exit (status : i64) -> unit = let result = syscall6(1, status, 0, 0, 0, 0, 0) in noop()
effect fn rt_mmap (n : i64) -> i64 = syscall6(197, 0, n, 3, 4097, -1, 0)
effect fn rt_private_map(n:i64) -> i64 = syscall6(197,0,n,3,4098,-1,0)
effect fn rt_random(p:ptr,n:i64) -> i64
  = let result=rt_result(syscall6(500,ptr_to_i64(p),n,0,0,0,0)) in if result<0 then -1 else n
effect fn rt_word_wake(p:ptr) -> i64 = 0
effect fn rt_word_wait(p:ptr,expected:i64,milliseconds:i64) -> i64 = rt_wait_ready(-1,0,milliseconds)
effect fn rt_munmap (p : ptr, n : i64) -> i64 = syscall6(73, ptr_to_i64(p), n, 0, 0, 0, 0)
; Darwin has no transparent huge page advice for anonymous memory.
effect fn rt_advise_huge (p : ptr, n : i64) -> i64 = 0
effect fn rt_populate (p : ptr, n : i64) -> i64 = 0
effect fn rt_getpid () -> i64 = syscall6(20, 0, 0, 0, 0, 0, 0)
effect fn rt_getppid () -> i64 = syscall6(39, 0, 0, 0, 0, 0, 0)
effect fn rt_socket (domain : i64, kind : i64, protocol : i64) -> i64 = rt_cloexec(rt_result(syscall6(97, domain, kind, protocol, 0, 0, 0)))
effect fn rt_setsockopt (fd : i64, level : i64, option : i64, value : ptr, n : i64) -> i64
  = rt_result(syscall6(105, fd, level, option, ptr_to_i64(value), n, 0))
effect fn rt_bind (fd : i64, p : ptr, n : i64) -> i64 = rt_result(syscall6(104, fd, ptr_to_i64(p), n, 0, 0, 0))
effect fn rt_listen (fd : i64, backlog : i64) -> i64 = rt_result(syscall6(106, fd, backlog, 0, 0, 0, 0))
effect fn rt_accept_fd (fd : i64) -> i64 = rt_cloexec(rt_result(syscall6(30, fd, 0, 0, 0, 0, 0)))
effect fn rt_fcntl (fd : i64, command : i64, arg : i64) -> i64 = rt_result(syscall6(92, fd, command, arg, 0, 0, 0))
effect fn rt_send (fd : i64, p : ptr, n : i64) -> i64 = rt_result(syscall6(133, fd, ptr_to_i64(p), n, 524288, 0, 0))
; Like rt_send, but never blocks (MSG_DONTWAIT): returns what the kernel takes now.
effect fn rt_send_now (fd : i64, p : ptr, n : i64) -> i64 = rt_result(syscall6(133, fd, ptr_to_i64(p), n, 524416, 0, 0))
effect fn rt_poll (fds : ptr, count : i64) -> i64 = rt_result(syscall6(230, ptr_to_i64(fds), count, 1000, 0, 0, 0))
; HTTP workers serve with kqueue; NEO_HTTP_POLL=1 selects the older poll loop.
effect fn rt_serve_worker (listener : i64, handler : ptr, control : ptr, worker : i64, workers : i64{workers >= 1}, parent : i64) -> i64
  = let fallback = rt_getenv_legacy(data("NEO_HTTP_POLL\0"), data("AXON_HTTP_POLL\0")) in
    if fallback != null() && load_u8(fallback, 0) == '1' then rt_http_worker(listener, handler, control, worker, workers, parent)
    else rt_http_kqueue_worker(listener, handler, control, worker, workers, parent)
effect fn rt_socketpair_raw (p : ptr) -> i64 = rt_result(syscall6(135, 1, 1, 0, ptr_to_i64(p), 0, 0))
effect fn rt_wait (pid : i64) -> i64
  = let status = stack_alloc(24) in
    let cleared = store_i64(status, 0, 0) in
    let result = loop (r = -1, again = true) while again
      next (let waited = rt_result(syscall6(7, pid, ptr_to_i64(status), 0, 0, 0, 0)) in let saved = store_i64(status, 16, waited) in waited,
            load_i32(rt_errno(), 0) == i32(4) && load_i64(status, 16) < 0) yield r in
    if result < 0 then 1 else i64(load_i32(status, 0))
effect fn rt_ncpu () -> i64
  = let cache = load_i64(runtime_state(), 16) in
    if cache > 0 then cache else
      let p = stack_alloc(32) in
      let first = store_i32(p, 0, i32(6)) in let second = store_i32(p, 4, i32(3)) in
      let length = store_i64(p, 16, 4) in
      let result = syscall6(202, ptr_to_i64(p), 2, ptr_to_i64(ptr_add(p, 8)), ptr_to_i64(ptr_add(p, 16)), 0, 0) in
      let n = if result < 0 then 1 else i64(load_i32(p, 8)) in
      let saved = store_i64(runtime_state(), 16, n) in n
fn rt_again () -> i64 = 35
fn rt_nonblock_flag () -> i64 {result > 0} = 4
fn rt_socket_level () -> i64 = 65535
fn rt_reuseaddr () -> i64 = 4
effect fn rt_address (p : ptr) -> unit
  = let length = store_u8(p, 0, u8(16)) in store_u8(p, 1, u8(2))

; Files, time, and outbound sockets; all direct kernel calls.
effect fn rt_open (path: ptr, flags: i64) -> i64 = rt_result(syscall6(5, ptr_to_i64(path), bit_or(flags,16777216), 384, 0, 0, 0))
effect fn rt_flock (fd: i64, mode: i64) -> i64 = rt_result(syscall6(131, fd, mode, 0, 0, 0, 0))
effect fn rt_fsync (fd: i64) -> i64 = rt_result(syscall6(95, fd, 0, 0, 0, 0, 0))
effect fn rt_truncate (fd: i64, length: i64) -> i64 = rt_result(syscall6(201, fd, length, 0, 0, 0, 0))
effect fn rt_connect (fd: i64, address: ptr) -> i64 = rt_result(syscall6(98, fd, ptr_to_i64(address), 16, 0, 0, 0))
fn rt_open_write () -> i64 = 1537
fn rt_open_append () -> i64 = 521
fn rt_open_update () -> i64 = 514
effect fn rt_now_ms () -> i64
  = let buffer = stack_alloc(32) in let cleared = memset(buffer, i32(0), 32) in
    let result = rt_result(syscall6(116, ptr_to_i64(buffer), 0, 0, 0, 0, 0)) in
    if result < 0 then -1 else load_i64(buffer, 0) * 1000 + i64(load_i32(buffer, 8)) / 1000
effect fn rt_wait_ready (fd: i64, events: i64, milliseconds: i64) -> i64
  = let fds = stack_alloc(16) in let descriptor = store_i32(fds, 0, i32(fd)) in let mask = store_i32(fds, 4, i32(events)) in
    rt_result(syscall6(230, ptr_to_i64(fds), if fd < 0 then 0 else 1, milliseconds, 0, 0, 0))

effect fn rt_seek (fd: i64, offset: i64) -> i64 = rt_result(syscall6(199, fd, offset, 0, 0, 0, 0))

effect fn rt_socket_error (fd: i64) -> i64
  = let buffer = stack_alloc(16) in let clear = store_i64(buffer, 0, 0) in let length = store_i32(buffer, 8, i32(4)) in
    let result = rt_result(syscall6(118, fd, rt_socket_level(), 4103, ptr_to_i64(buffer), ptr_to_i64(ptr_add(buffer, 8)), 0)) in
    if result < 0 then -1 else i64(load_i32(buffer, 0))

; macOS keeps the isolated fork path; no shared-address clone ABI is used.
effect fn rt_thread_spawn(pool: ptr, top: ptr) -> i64 = -1
effect fn rt_futex_wait(word: ptr, expected: i64) -> i64 = -1
effect fn rt_futex_wake(word: ptr, count: i64) -> i64 = -1

effect fn rt_file_size(fd: i64) -> i64 = rt_result(syscall6(199, fd, 0, 2, 0, 0, 0))
effect fn rt_map_file(fd: i64, size: i64) -> i64 = syscall6(197, 0, size, 1, 2, fd, 0)
effect fn rt_mkdir(path: ptr) -> i64 = rt_result(syscall6(136, ptr_to_i64(path), 448, 0, 0, 0, 0))
; F_FULLFSYNC (51): on Darwin a full sync must also flush the device cache.
effect fn rt_sync_full(fd: i64) -> i64 = rt_result(syscall6(92, fd, 51, 0, 0, 0, 0))
; The ARM64 architectural timebase is readable at EL0 on Apple Silicon.
; Conversion uses the architectural frequency, not a CPU-frequency assumption.
effect fn rt_clock_ns() -> i64
  = let ticks = counter_ticks() in let frequency = counter_frequency() in
    if ticks < 0 || frequency <= 0 || frequency > 9000000000 then -1 else
      ticks / frequency * 1000000000 + ticks % frequency * 1000000000 / frequency
effect fn rt_cpu_ns() -> i64
  = let p = stack_alloc(256) in let r = syscall6(117, 0, ptr_to_i64(p), 0, 0, 0, 0) in
    if r < 0 then -1 else (load_i64(p,0) + load_i64(p,16)) * 1000000000 + (i64(load_i32(p,8)) + i64(load_i32(p,24))) * 1000

; Stable file identity/timestamps used to reject stale storage checkpoints.
effect fn rt_file_identity(fd: i64, out: ptr) -> i64
  = let raw = stack_alloc(256) in let r = rt_result(syscall6(339,fd,ptr_to_i64(raw),0,0,0,0)) in
    if r < 0 then -1 else
    let v0 = store_i64(out,0,i64(load_i32(raw,0))) in
    let v1 = store_i64(out,8,load_i64(raw,8)) in
    let v2 = store_i64(out,16,load_i64(raw,96)) in
    let v3 = store_i64(out,24,load_i64(raw,48)) in
    let v4 = store_i64(out,32,load_i64(raw,56)) in
    let v5 = store_i64(out,40,load_i64(raw,64)) in
    let v6 = store_i64(out,48,load_i64(raw,72)) in
    0
effect fn rt_rename(old: ptr, new: ptr) -> i64 = rt_result(syscall6(128,ptr_to_i64(old),ptr_to_i64(new),0,0,0,0))
effect fn rt_unlink(path: ptr) -> i64 = rt_result(syscall6(10,ptr_to_i64(path),0,0,0,0,0))
; A symbolic link's target bytes (not terminated): their count, or -1 with errno.
effect fn rt_readlink(path: ptr, out: ptr, n: i64) -> i64 = rt_result(syscall6(58,ptr_to_i64(path),ptr_to_i64(out),n,0,0,0))
; The working directory, NUL-terminated: its size with the NUL, or -1 with errno.
; Darwin has no getcwd call; libc asks for the path of an open "." (F_GETPATH,
; which needs MAXPATHLEN bytes).
effect fn rt_getcwd(out: ptr, n: i64) -> i64
  = if n < 1024 then rt_result(-34) else
    let dot = stack_alloc(8) in let a = store_u8(dot, 0, u8(46)) in let b = store_u8(dot, 1, u8(0)) in
    let fd = rt_open(dot, 0) in if fd < 0 then -1 else
    let got = rt_fcntl(fd, 50, ptr_to_i64(out)) in let closed = rt_close(fd) in
    if got < 0 then -1 else rt_cstrlen(out) + 1

; Darwin private views must be refreshed after appending past their EOF.
fn rt_file_remap_each_write() -> bool = true

; Subprocess primitives. argv/envp are prepared before fork; no child heap work.
effect fn rt_exec(path:ptr,argv:ptr,envp:ptr) -> i64 = rt_result(syscall6(59,ptr_to_i64(path),ptr_to_i64(argv),ptr_to_i64(envp),0,0,0))
effect fn rt_dup_stdio(source:i64,destination:i64) -> i64 = if source==destination then rt_fcntl(source,2,0) else rt_result(syscall6(90,source,destination,0,0,0,0))
effect fn rt_kill(pid:i64,signal:i64) -> i64 = rt_result(syscall6(37,pid,signal,0,0,0,0))
effect fn rt_wait_status(pid:i64,status:ptr,options:i64) -> i64 = rt_result(syscall6(7,pid,ptr_to_i64(status),options,0,0,0))

fn rt_open_exclusive() -> i64 = 2562

; General bounded multi-descriptor readiness and half-close.
effect fn rt_poll_timeout(fds:ptr,count:i64,milliseconds:i64) -> i64
  = rt_result(syscall6(230,ptr_to_i64(fds),count,milliseconds,0,0,0))
effect fn rt_shutdown_write(fd:i64) -> i64 = rt_result(syscall6(134,fd,1,0,0,0,0))

; Scoped UDP transport primitives (IPv4 sockaddr lengths supplied explicitly).
effect fn rt_recvfrom(fd:i64,p:ptr,n:i64,address:ptr,length:ptr) -> i64 = rt_result(syscall6(29,fd,ptr_to_i64(p),n,0,ptr_to_i64(address),ptr_to_i64(length)))
effect fn rt_sendto(fd:i64,p:ptr,n:i64,address:ptr,length:i64) -> i64 = rt_result(syscall6(133,fd,ptr_to_i64(p),n,524288,ptr_to_i64(address),length))
effect fn rt_socket_name(fd:i64,address:ptr,length:ptr) -> i64 = rt_result(syscall6(32,fd,ptr_to_i64(address),ptr_to_i64(length),0,0,0))

; Persist data and all metadata required to retrieve it. Directory names need
; a separate directory sync. Darwin retains its full hardware-cache barrier.
effect fn rt_sync_data(fd:i64) -> i64 = rt_sync_full(fd)

; HTTP worker backend: one kqueue per worker process (a kqueue is not
; inherited across fork). Filters persist across waits. A connection's read
; filter is enabled and its write filter disabled except for backpressure or
; buffered complete requests beyond one batch, the interest rule of the Linux
; epoll backend. Slots are reused through a free list and never move, so a
; filter's udata (slot + 3) holds for the connection's whole life; closing a
; descriptor removes its filters and its queued events.
; udata: listener=0, notification socket=1, parent exit=2, slot i=i+3.
; struct kevent: ident@0, filter@8 (i16), flags@10 (u16), fflags@12, data@16, udata@24.
effect fn rt_kevent_set (change : ptr, ident : i64, filter : i64, flags : i64, fflags : i64, udata : i64) -> unit
  = let a = store_i64(change, 0, ident) in
    let b = store_i32(change, 8, i32(bit_or(bit_and(filter, 65535), shift_left(flags, 16)))) in
    let c = store_i32(change, 12, i32(fflags)) in
    let d = store_i64(change, 16, 0) in store_i64(change, 24, udata)

effect fn rt_kevent_change (kq : i64, changes : ptr, count : i64) -> unit
  = let result = rt_result(syscall6(363, kq, ptr_to_i64(changes), count, 0, 0, 0)) in
    if result < 0 then ax_trap(data("kevent registration failed\0")) else noop()

; EVFILT_READ (-1) and EVFILT_WRITE (-2) with EV_ENABLE (4) or EV_DISABLE (8).
effect fn rt_kqueue_sync (kq : i64, state : ptr, interests : ptr, slot : i64, changes : ptr) -> unit
  = let wanted = if load_i64(state, 32) > 0 || load_i64(state, 56) == 1 then 4 else 1 in
    if wanted == load_i64(interests, slot * 8) then noop() else
      let fd = load_i64(state, 0) in
      let r = rt_kevent_set(changes, fd, -1, if wanted == 1 then 4 else 8, 0, slot + 3) in
      let w = rt_kevent_set(ptr_add(changes, 32), fd, -2, if wanted == 4 then 4 else 8, 0, slot + 3) in
      let applied = rt_kevent_change(kq, changes, 2) in
      store_i64(interests, slot * 8, wanted)

; local: slots in use@0, listener enabled@8, free slots@16, pending
; connections@32, notification ready@40, queued changes@48, set TCP_NODELAY
; on each connection@56.
; Registrations of new connections and the listener's toggle are queued and
; submitted with the next wait: nothing queued can be closed before it.
effect fn rt_kqueue_queue (kq : i64, queue : ptr, local : ptr, ident : i64, filter : i64, flags : i64, udata : i64) -> unit
  = let count = load_i64(local, 48) in
    let room = if count < 2056 then count else let flushed = rt_kevent_change(kq, queue, count) in 0 in
    let set = rt_kevent_set(ptr_add(queue, room * 32), ident, filter, flags, 0, udata) in
    store_i64(local, 48, room + 1)

; Takes an accepted or received connection into a free slot, read filter
; added enabled (EV_ADD|EV_ENABLE) and write filter added disabled. Accepted
; sockets inherit O_NONBLOCK and TCP_NODELAY from the listener on Darwin.
effect fn rt_kqueue_adopt (kq : i64, fd : i64, states : ptr, interests : ptr, free : ptr, local : ptr, queue : ptr) -> unit
  = let spare = load_i64(local, 16) in
    let slot = if spare > 0 then load_i64(free, (spare - 1) * 8) else load_i64(local, 0) in
    if slot >= 1024 then let closed = rt_close(fd) in noop() else
      let taken = if spare > 0 then store_i64(local, 16, spare - 1) else store_i64(local, 0, slot + 1) in
      let state = ptr_add(states, slot * 64) in
      let cleared = memset(state, i32(0), 64) in
      let nodelay = if load_i64(local, 56) == 0 then 0 else
        let one = stack_alloc(8) in let value = store_i32(one, 0, i32(1)) in rt_setsockopt(fd, 6, 1, one, 4) in
      let input = store_ptr(state, 8, ax_alloc(65536)) in
      let output = store_ptr(state, 24, ax_alloc(4096)) in
      let descriptor = store_i64(state, 0, fd) in
      let interest = store_i64(interests, slot * 8, 1) in
      let r = rt_kqueue_queue(kq, queue, local, fd, -1, 5, slot + 3) in
      rt_kqueue_queue(kq, queue, local, fd, -2, 9, slot + 3)

; Sends a connection to worker `target` over its notification socket as
; SCM_RIGHTS with one byte; false when the socket does not take it now.
; msghdr@0, iovec@48, cmsghdr (12 bytes, then the descriptor)@64, byte@88.
effect fn rt_kqueue_pass (control : ptr, target : i64, fd : i64) -> bool
  = let message = stack_alloc(96) in let cleared = memset(message, i32(0), 96) in
    let byte = store_u8(message, 88, u8(1)) in
    let base = store_ptr(message, 48, ptr_add(message, 88)) in let length = store_i64(message, 56, 1) in
    let iov = store_ptr(message, 16, ptr_add(message, 48)) in let iovlen = store_i32(message, 24, i32(1)) in
    let size = store_i32(message, 64, i32(16)) in let level = store_i32(message, 68, i32(65535)) in
    let rights = store_i32(message, 72, i32(1)) in let passed = store_i32(message, 76, i32(fd)) in
    let ancillary = store_ptr(message, 32, ptr_add(message, 64)) in let room = store_i32(message, 40, i32(16)) in
    rt_result(syscall6(28, load_i64(control, 264 + target * 16), ptr_to_i64(message), 0, 0, 0, 0)) == 1

; Drains this worker's notification socket: wake bytes, and connections
; passed by the accepting worker. msghdr@0, iovec@48, bytes@64, control@128.
effect fn rt_kqueue_receive (kq : i64, reader : i64, states : ptr, interests : ptr, free : ptr, local : ptr, queue : ptr) -> unit
  = let message = stack_alloc(1152) in
    let drained = loop (more = true) while more
      next (let cleared = memset(message, i32(0), 64) in
            let base = store_ptr(message, 48, ptr_add(message, 64)) in let length = store_i64(message, 56, 64) in
            let iov = store_ptr(message, 16, ptr_add(message, 48)) in let iovlen = store_i32(message, 24, i32(1)) in
            let ancillary = store_ptr(message, 32, ptr_add(message, 128)) in let room = store_i32(message, 40, i32(1024)) in
            let count = rt_result(syscall6(27, reader, ptr_to_i64(message), 0, 0, 0, 0)) in
            if count <= 0 then false else
              let received = i64(load_i32(message, 40)) in
              let adopted = loop (offset = 0) while offset + 12 <= received
                next (let header = ptr_add(message, 128 + offset) in
                      let size = i64(load_i32(header, 0)) in
                      let end = if offset + size < received then offset + size else received in
                      let rights = i64(load_i32(header, 4)) == 65535 && i64(load_i32(header, 8)) == 1 in
                      let taken = if !rights then 0 else loop (k = 0) while offset + 16 + k * 4 <= end
                        next (let fd = rt_cloexec(i64(load_i32(header, 12 + k * 4))) in
                              let placed = if fd < 0 then noop() else rt_kqueue_adopt(kq, fd, states, interests, free, local, queue) in k + 1)
                        yield k in
                      if size < 12 then received else offset + (size + 3) / 4 * 4)
                yield offset in true)
      yield more in noop()

effect fn rt_kqueue_wake (control : ptr, target : i64) -> unit
  = let byte = stack_alloc(8) in let ready = store_u8(byte, 0, u8(1)) in
    let wrote = rt_write(load_i64(control, 264 + target * 16), byte, 1) in noop()

; Accepting. control: turn@0, connection counter@8 (connection number c
; belongs to worker c % workers), burst flag@16. The worker holding the turn
; takes what its listener reported. When more than one connection was waiting
; it raises the burst flag and wakes every worker, and each accepts until the
; queue is empty: the listen queue (capped by kern.ipc.somaxconn, 128 by
; default) drains in parallel rather than one process wakeup per connection.
; A connection that belongs to another worker is passed over that worker's
; notification socket. Each acceptor then hands the turn to the owner of the
; next number and wakes it.
effect fn rt_kqueue_take (kq : i64, listener : i64, states : ptr, interests : ptr, free : ptr, local : ptr,
                          control : ptr, worker : i64, workers : i64{workers >= 1}, queue : ptr, limit : i64) -> unit
  = let taken = loop (k = 0) while k >= 0 && k < limit
      next (let fd = rt_result(syscall6(30, listener, 0, 0, 0, 0, 0)) in
            if fd < 0 then let calm = store_i64(control, 16, 0) in -1 else
              let target = ax_claim_chunk(ptr_add(control, 8)) % workers in
              let served = if target != worker && rt_kqueue_pass(control, target, fd) then let closed = rt_close(fd) in noop()
                else let kept = rt_cloexec(fd) in
                  if kept < 0 then noop() else rt_kqueue_adopt(kq, kept, states, interests, free, local, queue) in k + 1)
      yield k in
    let successor = atomic_load_i64(control, 8) % workers in
    let moved = store_i64(control, 0, successor) in
    if successor == worker then noop() else rt_kqueue_wake(control, successor)

effect fn rt_kqueue_accept (kq : i64, listener : i64, states : ptr, interests : ptr, free : ptr, local : ptr,
                            control : ptr, worker : i64, workers : i64{workers >= 1}, queue : ptr) -> unit
  = if load_i64(control, 0) != worker then noop() else
    let pending = load_i64(local, 32) in
    let burst = if pending < 2 || workers == 1 then noop() else
      let raised = store_i64(control, 16, 1) in
      let woken = loop (i = 0) while i < workers
        next (let wake = if i == worker then noop() else rt_kqueue_wake(control, i) in i + 1) yield i in noop() in
    rt_kqueue_take(kq, listener, states, interests, free, local, control, worker, workers, queue,
                   if pending < 2 then pending else 1048576)

; One readiness event for slot `slot`: EV_EOF (0x8000) maps to hang-up and
; EV_ERROR (0x4000) to error, as poll reports them to rt_step.
effect fn rt_kqueue_event (kq : i64, states : ptr, interests : ptr, free : ptr, local : ptr, event : ptr,
                           slot : i64, handler : ptr, changes : ptr) -> unit
  = if slot < 0 || slot >= load_i64(local, 0) then ax_trap(data("invalid kevent udata\0")) else
    let state = ptr_add(states, slot * 64) in
    if load_i64(state, 0) < 0 then noop() else
      let high = i64(load_u8(event, 11)) in
      let mask = (if load_u8(event, 8) == u8(255) then 1 else 4) + (if high >= 128 then 16 else 0) + (if high / 64 % 2 == 1 then 8 else 0) in
      let stepped = rt_step(state, mask, handler) in
      if load_i64(state, 0) < 0 then
        let spare = load_i64(local, 16) in let pushed = store_i64(free, spare * 8, slot) in store_i64(local, 16, spare + 1)
      else rt_kqueue_sync(kq, state, interests, slot, changes)

; The listener filter follows the accept turn. Every returned event is
; handled before accepting or adopting, so a slot freed in this batch is never
; reused while a later event still names it.
effect fn rt_http_kqueue_worker (listener : i64, handler : ptr, control : ptr, worker : i64,
                                 workers : i64{workers >= 1}, parent : i64) -> i64
  = let kq = rt_cloexec(rt_result(syscall6(362, 0, 0, 0, 0, 0, 0))) in
    let valid = if kq < 0 then ax_trap(data("kqueue syscall failed\0")) else noop() in
    let states = ax_alloc(1024 * 64) in
    let interests = ax_alloc(1024 * 8) in
    let free = ax_alloc(1024 * 8) in
    let events = ax_alloc(32 * 32) in
    let queue = ax_alloc(2056 * 32) in
    let changes = stack_alloc(64) in
    let local = stack_alloc(64) in let cleared = memset(local, i32(0), 64) in
    let one = stack_alloc(8) in let value = store_i32(one, 0, i32(1)) in
    let inherited = store_i64(local, 56, if rt_setsockopt(listener, 6, 1, one, 4) < 0 then 1 else 0) in
    let reader = load_i64(control, 256 + worker * 16) in
    let notify = rt_kevent_set(changes, reader, -1, 1, 0, 1) in
    let registered = rt_kevent_change(kq, changes, 1) in
    ; Other workers end with the parent: EVFILT_PROC (-5) NOTE_EXIT, not a getppid per
    ; wait, so a wait needs no timeout.
    let watched = if worker == 0 then noop() else
      let exit = rt_kevent_set(changes, parent, -5, 1, 2147483648, 2) in
      if rt_getppid() != parent || rt_result(syscall6(363, kq, ptr_to_i64(changes), 1, 0, 0, 0)) < 0 then ax_exit(0) else noop() in
    loop (running = true) while running
      next (let wanted = if load_i64(control, 0) == worker then 1 else 0 in
            let toggled = if wanted == load_i64(local, 8) then noop() else
              let set = rt_kqueue_queue(kq, queue, local, listener, -1, if wanted == 1 then 5 else 9, 0) in
              store_i64(local, 8, wanted) in
            let ready = rt_result(syscall6(363, kq, ptr_to_i64(queue), load_i64(local, 48), ptr_to_i64(events), 32, 0)) in
            let submitted = store_i64(local, 48, 0) in
            if ready < 0 then if load_i32(rt_errno(), 0) == i32(4) then true
              else let failed = ax_trap(data("kevent syscall failed\0")) in false
            else let reset = store_i64(local, 32, 0) in let quiet = store_i64(local, 40, 0) in
              let served = loop (i = 0) while i < ready
                next (let event = ptr_add(events, i * 32) in
                      let token = load_i64(event, 24) in
                      let handled = if token == 0 then store_i64(local, 32, if load_i64(event, 16) > 0 then load_i64(event, 16) else 1)
                        else if token == 1 then store_i64(local, 40, 1)
                        else if token == 2 then ax_exit(0)
                        else rt_kqueue_event(kq, states, interests, free, local, event, token - 3, handler, changes) in i + 1)
                yield i in
              let received = if load_i64(local, 40) == 1 then rt_kqueue_receive(kq, reader, states, interests, free, local, queue) else noop() in
              let accepted = if load_i64(local, 32) > 0 then rt_kqueue_accept(kq, listener, states, interests, free, local, control, worker, workers, queue)
                else if load_i64(local, 40) == 1 && load_i64(control, 16) == 1 then
                  rt_kqueue_take(kq, listener, states, interests, free, local, control, worker, workers, queue, 1048576)
                else noop() in true)
      yield 0
