; Process-owned short timer callbacks. Slots are private and forgotten by a
; forked child; an interval registered before HTTP startup runs in worker zero.
; State: table@1880, executing slot@1888, live count@1904.
effect fn rt_timer_table()->ptr
  = let table=load_ptr(runtime_state(),1880) in if table!=null() then table else
    let table=ax_alloc(16*64) in let cleared=memset(table,i32(0),16*64) in
    let saved=store_ptr(runtime_state(),1880,table) in table
effect fn rt_timer_start(interval:i64,callback:ptr,capture:Arr u8 n)->i64
  = if interval<1 || interval>86400000 || callback==null() || n>16384 then -22 else
    let table=rt_timer_table() in let index=loop(i=0) while i<16 && load_ptr(table,i*64)!=null() next(i+1) yield i in
    if index==16 then -11 else let slot=ptr_add(table,index*64) in
    let token=rt_handle_new(ptr_to_i64(slot),23) in if token<0 then token else
    let bytes=ax_alloc(if n<1 then 1 else n) in let copied=memcpy(bytes,data(capture),n) in
    let a=store_ptr(slot,0,callback) in let b=store_ptr(slot,8,bytes) in let c=store_i64(slot,16,n) in
    let d=store_i64(slot,24,interval) in let e=store_i64(slot,32,rt_clock_ns()/1000000+interval) in
    let f=store_i64(slot,40,token) in let counted=store_i64(runtime_state(),1904,load_i64(runtime_state(),1904)+1) in token
effect fn rt_timer_stop(token:i64)->unit
  = let address=rt_handle_fd(token,23) in if address<0 then noop() else
    let slot=ptr_from_i64(address) in
    if load_ptr(runtime_state(),1888)==slot then store_i64(slot,48,1) else
    let released=ax_release(load_ptr(slot,8)) in let dropped=rt_handle_drop(token,23) in let cleared=memset(slot,i32(0),64) in
    store_i64(runtime_state(),1904,load_i64(runtime_state(),1904)-1)
effect fn rt_timer_stop_all()->unit
  = let table=load_ptr(runtime_state(),1880) in if table==null() then noop() else
    let cleared=loop(i=0) while i<16 next(let slot=ptr_add(table,i*64) in
      let stopped=if load_ptr(slot,0)==null() then noop() else rt_timer_stop(load_i64(slot,40)) in i+1) yield i in noop()
effect fn rt_timer_tick()->unit
  = if load_i64(runtime_state(),1904)==0 || load_ptr(runtime_state(),1888)!=null() then noop() else
    let now=rt_clock_ns()/1000000 in let table=load_ptr(runtime_state(),1880) in
    let stepped=loop(i=0) while i<16 next(let slot=ptr_add(table,i*64) in
      let ran=if load_ptr(slot,0)==null() || load_i64(slot,32)>now then noop() else
        let current=store_ptr(runtime_state(),1888,slot) in
        let result=handler_call(load_ptr(slot,0),load_ptr(slot,8),load_i64(slot,16)) in
        let cleared=store_ptr(runtime_state(),1888,null()) in
        if load_i64(slot,48)!=0 then rt_timer_stop(load_i64(slot,40)) else store_i64(slot,32,rt_clock_ns()/1000000+load_i64(slot,24)) in i+1) yield i in noop()
effect fn rt_timer_timeout(maximum:i64)->i64
  = if load_i64(runtime_state(),1904)==0 then maximum else
    let now=rt_clock_ns()/1000000 in let table=load_ptr(runtime_state(),1880) in
    let nearest=loop(i=0,wait=if maximum<0 then 86400000 else maximum) while i<16 next(i+1,
      let slot=ptr_add(table,i*64) in let remaining=load_i64(slot,32)-now in
      if load_ptr(slot,0)!=null() && remaining<wait then remaining else wait) yield wait in if nearest<0 then 0 else nearest
