; Linux x86-64 kernel ABI. This executable links statically with no CRT/libc.
effect fn rt_read (fd : i64, p : ptr, n : i64) -> i64 = rt_result(syscall6(0, fd, ptr_to_i64(p), n, 0, 0, 0))
effect fn rt_write (fd : i64, p : ptr, n : i64) -> i64 = rt_result(syscall6(1, fd, ptr_to_i64(p), n, 0, 0, 0))
effect fn rt_writev (fd : i64, iov : ptr, count : i64) -> i64 = rt_result(syscall6(20, fd, ptr_to_i64(iov), count, 0, 0, 0))
effect fn rt_close (fd : i64) -> i64 = rt_result(syscall6(3, fd, 0, 0, 0, 0, 0))
export effect fn ax_exit (status : i64) -> unit = let result = syscall6(231, status, 0, 0, 0, 0, 0) in noop()
effect fn rt_mmap (n : i64) -> i64 = syscall6(9, 0, n, 3, 33, -1, 0)
effect fn rt_private_map(n:i64) -> i64 = syscall6(9,0,n,3,34,-1,0)
; Shared, prefaulted mapping of a kernel object (io_uring rings).
effect fn rt_map_ring(fd:i64,n:i64,offset:i64) -> i64 = syscall6(9,0,n,3,32769,fd,offset)
; HTTP serves with io_uring unless NEO_HTTP_URING=0 (measured and tested on x86-64).
fn rt_uring_default () -> bool = true
effect fn rt_random(p:ptr,n:i64) -> i64 = rt_result(syscall6(318,ptr_to_i64(p),n,0,0,0,0))
effect fn rt_word_wake(p:ptr) -> i64 = syscall6(202,ptr_to_i64(p),1,1,0,0,0)
effect fn rt_word_wait(p:ptr,expected:i64,milliseconds:i64) -> i64
  = let timeout=stack_alloc(16) in let seconds=store_i64(timeout,0,milliseconds/1000) in let nanos=store_i64(timeout,8,milliseconds%1000*1000000) in
    syscall6(202,ptr_to_i64(p),0,bit_and(expected,4294967295),ptr_to_i64(timeout),0,0)
effect fn rt_munmap (p : ptr, n : i64) -> i64 = syscall6(11, ptr_to_i64(p), n, 0, 0, 0, 0)
; madvise(MADV_HUGEPAGE): large private blocks ask for transparent huge pages.
effect fn rt_advise_huge (p : ptr, n : i64) -> i64 = syscall6(28, ptr_to_i64(p), n, 14, 0, 0, 0)
; madvise(MADV_POPULATE_WRITE, Linux 5.14+): fault a fresh block in with one call. Older kernels fail it harmlessly.
effect fn rt_populate (p : ptr, n : i64) -> i64 = syscall6(28, ptr_to_i64(p), n, 23, 0, 0, 0)
; madvise(MADV_COLLAPSE, Linux 6.1+): back populated 2 MiB regions with huge pages, whatever the THP setting.
effect fn rt_collapse (p : ptr, n : i64) -> i64 = syscall6(28, ptr_to_i64(p), n, 25, 0, 0, 0)
effect fn rt_huge_fallback () -> bool = rt_thp_never()
effect fn rt_getpid () -> i64 = syscall6(39, 0, 0, 0, 0, 0, 0)
effect fn rt_getppid () -> i64 = syscall6(110, 0, 0, 0, 0, 0, 0)
effect fn rt_socket (domain : i64, kind : i64, protocol : i64) -> i64 = rt_cloexec(rt_result(syscall6(41, domain, kind, protocol, 0, 0, 0)))
effect fn rt_setsockopt (fd : i64, level : i64, option : i64, value : ptr, n : i64) -> i64
  = rt_result(syscall6(54, fd, level, option, ptr_to_i64(value), n, 0))
effect fn rt_bind (fd : i64, p : ptr, n : i64) -> i64 = rt_result(syscall6(49, fd, ptr_to_i64(p), n, 0, 0, 0))
effect fn rt_listen (fd : i64, backlog : i64) -> i64 = rt_result(syscall6(50, fd, backlog, 0, 0, 0, 0))
effect fn rt_accept_fd (fd : i64) -> i64 = rt_cloexec(rt_result(syscall6(43, fd, 0, 0, 0, 0, 0)))
effect fn rt_fcntl (fd : i64, command : i64, arg : i64) -> i64 = rt_result(syscall6(72, fd, command, arg, 0, 0, 0))
effect fn rt_send (fd : i64, p : ptr, n : i64) -> i64 = rt_result(syscall6(44, fd, ptr_to_i64(p), n, 16384, 0, 0))
; Like rt_send, but never blocks (MSG_DONTWAIT): returns what the kernel takes now.
effect fn rt_send_now (fd : i64, p : ptr, n : i64) -> i64 = rt_result(syscall6(44, fd, ptr_to_i64(p), n, 16448, 0, 0))
effect fn rt_poll (fds : ptr, count : i64) -> i64
  = let timeout = stack_alloc(16) in let seconds = store_i64(timeout, 0, 1) in let nanos = store_i64(timeout, 8, 0) in
    rt_result(syscall6(271, ptr_to_i64(fds), count, ptr_to_i64(timeout), 0, 0, 0))
; x86-64 epoll_event is packed: events@0, data@4 (12 bytes).
; Unaligned loads/stores use the compiler primitive with align 1.
effect fn rt_epoll_create () -> i64 = rt_result(syscall6(291, 524288, 0, 0, 0, 0, 0))
effect fn rt_epoll_ctl (epfd : i64, op : i64, fd : i64, mask : i64, token : i64) -> i64
  = let event = stack_alloc(16) in
    let flags = store_i64(event, 0, mask) in let key = store_i64(event, 4, token) in
    rt_result(syscall6(233, epfd, op, fd, ptr_to_i64(event), 0, 0))
effect fn rt_epoll_wait (epfd : i64, events : ptr, maximum : i64) -> i64
  = rt_result(syscall6(281, epfd, ptr_to_i64(events), maximum, 1000, 0, 8))
effect fn rt_socketpair_raw (p : ptr) -> i64 = rt_result(syscall6(53, 1, 1, 0, ptr_to_i64(p), 0, 0))
effect fn rt_wait (pid : i64) -> i64
  = let status = stack_alloc(24) in let cleared = store_i64(status, 0, 0) in
    let result = loop (r = -1, again = true) while again
      next (let waited = rt_result(syscall6(61, pid, ptr_to_i64(status), 0, 0, 0, 0)) in let saved = store_i64(status, 16, waited) in waited,
            load_i32(rt_errno(), 0) == i32(4) && load_i64(status, 16) < 0) yield r in
    if result < 0 then 1 else i64(load_i32(status, 0))
effect fn rt_ncpu () -> i64
  = let cache = load_i64(runtime_state(), 16) in if cache > 0 then cache else
    let mask = stack_alloc(128) in
    let cleared = memset(mask, i32(0), 128) in
    let result = syscall6(204, 0, 128, ptr_to_i64(mask), 0, 0, 0) in
    let count = loop (i = 0, total = 0) while i < 128
      next (i + 1, total + loop (bits = i64(load_u8(mask, i)), n = 0) while bits > 0 next (bits / 2, n + bits % 2) yield n)
      yield total in
    let n = if result < 0 || count < 1 then 1 else count in
    let saved = store_i64(runtime_state(), 16, n) in n
fn rt_again () -> i64 = 11
fn rt_nonblock_flag () -> i64 {result > 0} = 2048
fn rt_socket_level () -> i64 = 1
fn rt_reuseaddr () -> i64 = 2
effect fn rt_address (p : ptr) -> unit
  = let low = store_u8(p, 0, u8(2)) in store_u8(p, 1, u8(0))

fn rt_epoll_event_bytes () -> i64 = 12
fn rt_epoll_data_offset () -> i64 = 4

; Files, time, and outbound sockets; all direct kernel calls.
effect fn rt_open (path: ptr, flags: i64) -> i64 = rt_result(syscall6(257, -100, ptr_to_i64(path), bit_or(flags,524288), 384, 0, 0))
effect fn rt_flock (fd: i64, mode: i64) -> i64 = rt_result(syscall6(73, fd, mode, 0, 0, 0, 0))
effect fn rt_fsync (fd: i64) -> i64 = rt_result(syscall6(74, fd, 0, 0, 0, 0, 0))
effect fn rt_truncate (fd: i64, length: i64) -> i64 = rt_result(syscall6(77, fd, length, 0, 0, 0, 0))
effect fn rt_connect (fd: i64, address: ptr) -> i64 = rt_result(syscall6(42, fd, ptr_to_i64(address), 16, 0, 0, 0))
fn rt_open_write () -> i64 = 577
fn rt_open_append () -> i64 = 1089
fn rt_open_update () -> i64 = 66
effect fn rt_now_ms () -> i64
  = let buffer = stack_alloc(32) in let cleared = memset(buffer, i32(0), 32) in
    let result = rt_result(syscall6(228, 0, ptr_to_i64(buffer), 0, 0, 0, 0)) in
    if result < 0 then -1 else load_i64(buffer, 0) * 1000 + load_i64(buffer, 8) / 1000000
effect fn rt_wait_ready (fd: i64, events: i64, milliseconds: i64) -> i64
  = let fds = stack_alloc(16) in let descriptor = store_i32(fds, 0, i32(fd)) in let mask = store_i32(fds, 4, i32(events)) in
    let timeout = stack_alloc(16) in let seconds = store_i64(timeout, 0, milliseconds / 1000) in let nanos = store_i64(timeout, 8, milliseconds % 1000 * 1000000) in
    rt_result(syscall6(271, ptr_to_i64(fds), if fd < 0 then 0 else 1, ptr_to_i64(timeout), 0, 0, 0))

effect fn rt_seek (fd: i64, offset: i64) -> i64 = rt_result(syscall6(8, fd, offset, 0, 0, 0, 0))

effect fn rt_socket_error (fd: i64) -> i64
  = let buffer = stack_alloc(16) in let clear = store_i64(buffer, 0, 0) in let length = store_i32(buffer, 8, i32(4)) in
    let result = rt_result(syscall6(55, fd, rt_socket_level(), 4, ptr_to_i64(buffer), ptr_to_i64(ptr_add(buffer, 8)), 0)) in
    if result < 0 then -1 else i64(load_i32(buffer, 0))

; The compiler emits the x86-64 raw-clone stack-switch boundary.
; Only compiler-certified allocation-free regions run on the shared-address
; worker pool. Workers are threads of this process; see kernel_workers.py.
effect fn rt_thread_spawn(pool: ptr, top: ptr) -> i64 = spawn_thread(pool, top)
; Private futex wait/wake on the low 32 bits of an i64 word.
effect fn rt_futex_wait(word: ptr, expected: i64) -> i64 = syscall6(202, ptr_to_i64(word), 128, bit_and(expected, 4294967295), 0, 0, 0)
effect fn rt_futex_wake(word: ptr, count: i64) -> i64 = syscall6(202, ptr_to_i64(word), 129, count, 0, 0, 0)

effect fn rt_file_size(fd: i64) -> i64 = rt_result(syscall6(8, fd, 0, 2, 0, 0, 0))
effect fn rt_map_file(fd: i64, size: i64) -> i64 = syscall6(9, 0, size, 1, 2, fd, 0)
effect fn rt_mkdir(path: ptr) -> i64 = rt_result(syscall6(83, ptr_to_i64(path), 448, 0, 0, 0, 0))
effect fn rt_sync_full(fd: i64) -> i64 = rt_fsync(fd)
effect fn rt_clock_ns() -> i64
  = let p = stack_alloc(16) in let result = syscall6(228, 1, ptr_to_i64(p), 0, 0, 0, 0) in
    if result < 0 then -1 else load_i64(p,0) * 1000000000 + load_i64(p,8)
effect fn rt_cpu_ns() -> i64
  = let p = stack_alloc(256) in let r = syscall6(98, 0, ptr_to_i64(p), 0, 0, 0, 0) in
    if r < 0 then -1 else (load_i64(p,0) + load_i64(p,16)) * 1000000000 + (load_i64(p,8) + load_i64(p,24)) * 1000

; Stable file identity/timestamps used to reject stale storage checkpoints.
effect fn rt_file_identity(fd: i64, out: ptr) -> i64
  = let raw = stack_alloc(256) in let r = rt_result(syscall6(5,fd,ptr_to_i64(raw),0,0,0,0)) in
    if r < 0 then -1 else
    let v0 = store_i64(out,0,load_i64(raw,0)) in
    let v1 = store_i64(out,8,load_i64(raw,8)) in
    let v2 = store_i64(out,16,load_i64(raw,48)) in
    let v3 = store_i64(out,24,load_i64(raw,88)) in
    let v4 = store_i64(out,32,load_i64(raw,96)) in
    let v5 = store_i64(out,40,load_i64(raw,104)) in
    let v6 = store_i64(out,48,load_i64(raw,112)) in
    0
effect fn rt_rename(old: ptr, new: ptr) -> i64 = rt_result(syscall6(82,ptr_to_i64(old),ptr_to_i64(new),0,0,0,0))
effect fn rt_unlink(path: ptr) -> i64 = rt_result(syscall6(87,ptr_to_i64(path),0,0,0,0,0))
; A symbolic link's target bytes (not terminated): their count, or -1 with errno.
effect fn rt_readlink(path: ptr, out: ptr, n: i64) -> i64 = rt_result(syscall6(89,ptr_to_i64(path),ptr_to_i64(out),n,0,0,0))
; The working directory, NUL-terminated: its size with the NUL, or -1 with errno.
effect fn rt_getcwd(out: ptr, n: i64) -> i64 = rt_result(syscall6(79,ptr_to_i64(out),n,0,0,0,0))

; Darwin private views must be refreshed after appending past their EOF.
fn rt_file_remap_each_write() -> bool = false

; Subprocess primitives. argv/envp are prepared before fork; no child heap work.
effect fn rt_exec(path:ptr,argv:ptr,envp:ptr) -> i64 = rt_result(syscall6(59,ptr_to_i64(path),ptr_to_i64(argv),ptr_to_i64(envp),0,0,0))
effect fn rt_dup_stdio(source:i64,destination:i64) -> i64 = if source==destination then rt_fcntl(source,2,0) else rt_result(syscall6(33,source,destination,0,0,0,0))
effect fn rt_kill(pid:i64,signal:i64) -> i64 = rt_result(syscall6(62,pid,signal,0,0,0,0))
effect fn rt_wait_status(pid:i64,status:ptr,options:i64) -> i64 = rt_result(syscall6(61,pid,ptr_to_i64(status),options,0,0,0))

fn rt_open_exclusive() -> i64 = 194

; General bounded multi-descriptor readiness and half-close.
effect fn rt_poll_timeout(fds:ptr,count:i64,milliseconds:i64) -> i64
  = rt_result(syscall6(7,ptr_to_i64(fds),count,milliseconds,0,0,0))
effect fn rt_shutdown_write(fd:i64) -> i64 = rt_result(syscall6(48,fd,1,0,0,0,0))

; Scoped UDP transport primitives (IPv4 sockaddr lengths supplied explicitly).
effect fn rt_recvfrom(fd:i64,p:ptr,n:i64,address:ptr,length:ptr) -> i64 = rt_result(syscall6(45,fd,ptr_to_i64(p),n,0,ptr_to_i64(address),ptr_to_i64(length)))
effect fn rt_sendto(fd:i64,p:ptr,n:i64,address:ptr,length:i64) -> i64 = rt_result(syscall6(44,fd,ptr_to_i64(p),n,16384,ptr_to_i64(address),length))
effect fn rt_socket_name(fd:i64,address:ptr,length:ptr) -> i64 = rt_result(syscall6(51,fd,ptr_to_i64(address),ptr_to_i64(length),0,0,0))

; Persist data and all metadata required to retrieve it. Directory names need
; a separate directory sync. Darwin retains its full hardware-cache barrier.
effect fn rt_sync_data(fd:i64) -> i64 = rt_result(syscall6(75,fd,0,0,0,0,0))
