; Regular file transfers remain synchronous. Contended advisory locks use
; nonblocking attempts inside a task, so document-store writers do not park
; the HTTP worker while another process owns the lock.
effect fn rt_flock(fd:i64,mode:i64)->i64
  = if rt_fiber_current()==null() || mode!=1 && mode!=2 then rt_flock_kernel(fd,mode) else
    loop(result= -4) while result== -4 || result==0-rt_again() next(
      if rt_fiber_cancelled() then -125 else
      let value=rt_flock_kernel(fd,bit_or(mode,4)) in if value>=0 then 0 else
      let code=i64(load_i32(rt_errno(),0)) in if code!=4 && code!=rt_again() then 0-code else
      let paused=rt_fiber_wait(-1,0,2) in if paused<0 then -125 else 0-code) yield
      if result<0 then rt_result(result) else result
