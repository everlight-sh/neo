; HTTP/1.x connection lifecycle and framing, written in Neo.
; Each worker owns its connections (Linux io_uring or epoll, macOS kqueue, or poll on
; request). No C HTTP implementation.
; Each connection has a 128-byte state (laid out above rt_drop) and an
; initially 64 KiB input buffer, growing on demand to a bounded 16 MiB body
; plus 16 KiB headers.

fn rt_lower (c : u8) -> u8
  = if c >= 'A' && c <= 'Z' then u8(i64(c) + 32) else c

fn rt_match (a : Arr u8 n, at : i64{at >= 0}, b : Arr u8 m) -> bool
  = at <= n - m &&
    (if m==4 then byte_read_le(a,at,4)==byte_read_le(b,0,4)
     else if m==8 then byte_read_le(a,at,8)==byte_read_le(b,0,8)
     else loop (i : i64{i >= 0} = 0, ok = true)
       while ok && i < m next (i + 1, a[at + i] == b[i]) yield ok)

fn rt_match_ci (a : Arr u8 n, at : i64{at >= 0}, b : Arr u8 m) -> bool
  = at + m <= n && loop (i : i64{i >= 0} = 0, ok = true)
      while ok && i < m next (i + 1, rt_lower(a[at + i]) == rt_lower(b[i])) yield ok

fn rt_find (a : Arr u8 n, b : Arr u8 m, start : i64{start >= 0}) -> i64 {result >= -1}
  = if m==4 then let word=byte_read_le(b,0,4) in
      loop (i:i64{i>=0}=start, found:i64{found>= -1}= -1) while found<0 && i<=n-4
        next (i+1,if byte_read_le(a,i,4)==word then i else -1) yield found
    else if m==8 then let word=byte_read_le(b,0,8) in
      loop (i:i64{i>=0}=start, found:i64{found>= -1}= -1) while found<0 && i<=n-8
        next (i+1,if byte_read_le(a,i,8)==word then i else -1) yield found
    else loop (i : i64{i >= 0} = start, found : i64{found >= -1} = -1)
      while found < 0 && i <= n-m
      next (i + 1, if rt_match(a, i, b) then i else -1) yield found

private type RuntimeFraming = { length_field:i64, transfer_field:i64, connection_field:i64, expect_field:i64, invalid:bool }

fn rt_framing(borrow headers:Arr u8 n) -> RuntimeFraming
  = let length="content-length:" in let transfer="transfer-encoding:" in let connection="connection:" in
    let initial=RuntimeFraming { length_field= -1,transfer_field= -1,connection_field= -1,expect_field= -1,invalid=false } in
    loop (i:i64{i>=0}=0, state=initial) while i<n && !state.invalid
      next (i+1,if i>0 && headers[i-1]!='\n' then state else
        let first=rt_lower(headers[i]) in
        if first=='c' && rt_match_ci(headers,i,length) then
          state with { length_field=i+len(length),invalid=state.length_field>=0 }
        else if first=='t' && rt_match_ci(headers,i,transfer) then
          state with { transfer_field=i+len(transfer),invalid=state.transfer_field>=0 }
        else if first=='c' && state.connection_field<0 && rt_match_ci(headers,i,connection) then
          state with { connection_field=i+len(connection) }
        else if first=='e' && state.expect_field<0 && rt_match_ci(headers,i,"expect:") then
          state with { expect_field=i+7 }
        else state) yield state

fn rt_skip_space (a : Arr u8 n, start : i64{start >= 0}) -> i64 {result >= 0}
  = loop (i : i64{i >= 0} = start) while i < n && (a[i] == ' ' || a[i] == '\t')
      next (i + 1) yield i

; The declared body length: -1 invalid framing, -2 chunked, -3 over 16 MiB.
fn rt_body_length (headers : Arr u8 n, framing:RuntimeFraming) -> i64
  = let field=framing.length_field in let encoding=framing.transfer_field in
    if framing.invalid then -1 else if encoding>=0 then
      let start=rt_skip_space(headers,encoding) in let end=rt_skip_space(headers,start+7) in
      if field>=0 || !rt_match_ci(headers,start,"chunked") then -1 else
      if end>=0 && end+1<n then if headers[end]=='\r' && headers[end+1]=='\n' then -2 else -1 else -1
    else if field < 0 then 0
    else let start = rt_skip_space(headers, field) in
      let value = loop (i : i64{i >= 0} = start, acc = 0, digits = 0)
        while i < n && headers[i] >= '0' && headers[i] <= '9' && acc <= 16777216
        next (i + 1, acc * 10 + i64(headers[i]) - 48, digits + 1)
        yield if digits == 0 then -1 else if acc > 16777216 then -3
          else let end = rt_skip_space(headers, i) in
            if end + 1 < n && headers[end] == '\r' && headers[end + 1] == '\n' then acc else -1 in value

fn rt_connection_token (headers : Arr u8 n, field:i64, token : Arr u8 m) -> bool
  = if field < 0 then false else
      loop (i : i64{i >= 0} = field, found = false)
        while !found && i < n && headers[i] != '\r' && headers[i] != '\n'
        next (i + 1, rt_match_ci(headers, i, token) &&
          (i == field || (i > 0 && (headers[i - 1] == ' ' || headers[i - 1] == ',' || headers[i - 1] == '\t'))) &&
          i + m < n && (headers[i + m] == '\r' || headers[i + m] == ' ' || headers[i + m] == ',' || headers[i + m] == '\t'))
        yield found

; Dense per-worker connection vector. Each state is 128 bytes:
; fd@0, input@8, have@16, output@24, length@32, sent@40, close@48,
; buffered-complete-work@56, request start ms@64, last progress ms@72,
; peer family (4, 6 or 0)@80, peer address@88 (16 bytes, IPv4 in the first 4),
; peer port@104, flags@112 (1: 100 Continue sent, 2: reading the body,
; 4: timed out), bytes discarded while lingering@120.
; close: 0 keep-alive, 1 close after the output, 2 async owner, 3 linger after
; the output (a refused request), 4 lingering: reading and discarding.
; Input and output buffers persist across requests. Times come from the
; worker's loop clock (rt_http_now), read once per wait.
effect fn rt_drop (state : ptr) -> unit
  = let fd = load_i64(state, 0) in
    if fd < 0 then noop() else
      let tasks=rt_http_render_cancel(fd) in
      let cancelled = rt_async_cancel(fd) in
      let closed = rt_close(fd) in
      let input = ax_release(load_ptr(state, 8)) in
      let output = ax_release(load_ptr(state, 24)) in
      let cleared = memset(state, i32(0), 128) in store_i64(state, 0, -1)

; Milliseconds on the monotonic clock as of this worker's latest wait.
effect fn rt_http_now() -> i64 = load_i64(runtime_state(),2008)
effect fn rt_http_tick() -> unit = store_i64(runtime_state(),2008,rt_clock_ns()/1000000)

; Bytes arrived: they are progress, and the first bytes of a request start its clock.
effect fn rt_http_received(state:ptr, before:i64) -> unit
  = let now=rt_http_now() in let active=store_i64(state,72,now) in
    if before==0 then store_i64(state,64,now) else noop()

; Refused requests get a status line and Connection: close, then the connection
; lingers: after the reply, the write side is shut and what the client still
; sends is read and discarded (up to 1 MiB or 2 s), so a client that is still
; uploading reads the reply instead of a reset.
private fn rt_http_refusal(status:i64) -> Arr u8 _
  = if status==413 then "HTTP/1.1 413 Content Too Large\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
    else if status==431 then "HTTP/1.1 431 Request Header Fields Too Large\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
    else if status==408 then "HTTP/1.1 408 Request Timeout\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
    else if status==503 then "HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nRetry-After: 1\r\nConnection: close\r\n\r\n"
    else "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
cold effect fn rt_http_refuse(state:ptr, status:i64) -> i64
  = let reply=rt_http_refusal(status) in
    let queued=rt_async_queue(state,data(reply),len(reply)) in let closing=store_i64(state,48,3) in 0
; Best effort on a socket the worker does not keep (a full worker, an expired request).
cold effect fn rt_http_refuse_now(fd:i64, status:i64) -> unit
  = let reply=rt_http_refusal(status) in let sent=rt_send_now(fd,data(reply),len(reply)) in noop()
effect fn rt_http_linger(state:ptr) -> unit
  = let shut=rt_shutdown_write(load_i64(state,0)) in let lingering=store_i64(state,48,4) in
    let started=store_i64(state,64,rt_http_now()) in let discarded=store_i64(state,120,0) in store_i64(state,16,0)
; One read while lingering: end of input, an error or 1 MiB closes the connection.
cold effect fn rt_http_discard(state:ptr) -> unit
  = let room=ax_allocation_capacity(load_ptr(state,8)) in
    let count=rt_read(load_i64(state,0),load_ptr(state,8),room) in
    if count==0 then rt_drop(state) else if count<0 then (if rt_retry() then noop() else rt_drop(state)) else
    let total=load_i64(state,120)+count in if total>1048576 then rt_drop(state) else store_i64(state,120,total)

effect fn rt_request (state : ptr, handler : ptr, input : ptr, n : i64, offset : i64) -> i64
  = check offset >= 0 && offset <= n in
    let bytes = view(ptr_add(input, offset), n - offset) in
    let end = rt_find(bytes, "\r\n\r\n", 0) in
    if end < 0 then
      if n - offset >= 16384 then rt_http_refuse(state, 431) else 0
    else let header_bytes = end + 4 in
      check header_bytes >= 0 && header_bytes <= n - offset in
      let headers = view(ptr_add(input, offset), header_bytes) in
      let framing=rt_framing(headers) in
      let declared = rt_body_length(headers,framing) in
      let framed = if declared== -2 then rt_chunked_end(bytes,header_bytes) else 0 in
      let body_bytes = if declared== -2 && framed>=0 then framed-header_bytes else declared in
      if header_bytes > 16384 then rt_http_refuse(state, 431) else
      if declared== -3 || declared== -2 && framed== -2 && n-offset-header_bytes>=16777216 then rt_http_refuse(state, 413) else
      if declared== -2 && framed== -2 then rt_http_body_wait(state, headers, framing) else
      if body_bytes < 0 then rt_http_refuse(state, 400) else if body_bytes > 16777216 then rt_http_refuse(state, 413)
      else let total = header_bytes + body_bytes in
        if total > n - offset then rt_http_body_wait(state, headers, framing) else
          let fresh = store_i64(state, 112, 0) in
          let context = store_ptr(runtime_state(), 1616, state) in
          let generation = store_i64(runtime_state(), 1624, wrapping_add(load_i64(runtime_state(), 1624), 1)) in
          let response = handler_call(handler, ptr_add(input, offset), total) in
          let cleared = store_ptr(runtime_state(), 1616, null()) in
          if len(response)==0 && load_i64(state,48)==2 then total else
          if len(response) == 0 then let dropped = rt_drop(state) in 0 else
            let closing = rt_connection_token(headers,framing.connection_field,"close") ||
              (rt_find(headers,"HTTP/1.0",0)>=0 && !rt_connection_token(headers,framing.connection_field,"keep-alive")) in
            let length = load_i64(state, 32) in
            ; A large keep-alive response with nothing queued ahead of it goes straight
            ; to the socket without waiting. Only what the kernel does not take now is
            ; copied into the connection's buffer, which then stays small: one response
            ; at a time is held, not one per connection.
            let early = if !closing && length == 0 && len(response) >= 16384
              then rt_send_now(load_i64(state, 0), data(response), len(response)) else 0 in
            let skip = if early > 0 then early else 0 in
            let rest = len(response) - skip in
            let queued = if rest <= 0 then noop() else
              let old = load_ptr(state, 24) in
              let capacity = ax_allocation_capacity(old) in
              let grown = if length + rest > capacity then
                let bigger = ax_alloc(length + rest) in
                let copied = memcpy(bigger, old, length) in
                let released = ax_release(old) in store_ptr(state, 24, bigger)
              else noop() in
              let copied = memcpy(ptr_add(load_ptr(state, 24), length), ptr_add(data(response), skip), rest) in
              store_i64(state, 32, length + rest) in
            let closed = store_i64(state, 48, if load_i64(state,48)==2 then 2 else if closing then 1 else 0) in total

; Headers are complete and the body is not: the body timeout applies from now
; on, and an HTTP/1.1 "Expect: 100-continue" is answered once with 100 Continue.
; (A declared body over the limit was answered 413 before this.)
effect fn rt_http_body_wait(state:ptr, borrow headers:Arr u8 n, framing:RuntimeFraming) -> i64
  = let flags=load_i64(state,112) in let reading=store_i64(state,112,bit_or(flags,2)) in
    if bit_and(flags,1)!=0 || framing.expect_field<0 || !rt_connection_token(headers,framing.expect_field,"100-continue") || rt_find(headers,"HTTP/1.0",0)>=0 then 0 else
    let reply="HTTP/1.1 100 Continue\r\n\r\n" in let queued=rt_async_queue(state,data(reply),len(reply)) in
    let sent=store_i64(state,112,bit_or(flags,3)) in 0

type RuntimeBatch = { offset : i64, more : bool, count : i64 }
effect fn rt_batch_next (state : ptr, handler : ptr, input : ptr, n : i64, batch : RuntimeBatch) -> RuntimeBatch
  = let consumed = rt_request(state, handler, input, n, batch.offset) in
    RuntimeBatch { offset = batch.offset + consumed,
      more = consumed > 0 && load_i64(state, 0) >= 0 && load_i64(state, 48) == 0,
      count = batch.count + 1 }

effect fn rt_prepare (state : ptr, handler : ptr) -> unit
  = let n = load_i64(state, 16) in
    check n >= 0 && n <= 16793600 in
    let input = load_ptr(state, 8) in
    let reset = store_i64(state, 56, 0) in
    let batch = loop (b = RuntimeBatch { offset = 0, more = true, count = 0 })
      while b.more && b.offset < n && b.count < 64 && load_i64(state, 32) < 262144
      next (rt_batch_next(state, handler, input, n, b)) yield b in
    if load_i64(state, 0) < 0 || load_i64(state, 48) >= 3 then noop() else
      let shifted = memmove(input, ptr_add(input, batch.offset), n - batch.offset) in
      let saved = store_i64(state, 16, n - batch.offset) in
      ; Bytes left after a consumed request begin the next one now.
      let started = if batch.offset > 0 && batch.offset < n then store_i64(state, 64, rt_http_now()) else noop() in
      store_i64(state, 56, if batch.more && batch.offset < n then 1 else 0)

effect fn rt_flush (state : ptr) -> unit
  = let length = load_i64(state, 32) in
    let offset = load_i64(state, 40) in
    let count = rt_send(load_i64(state, 0), ptr_add(load_ptr(state, 24), offset), length - offset) in
    if count < 0 then if rt_retry() then noop() else rt_drop(state)
    else if count == 0 then rt_drop(state)
    else let progress = store_i64(state, 72, rt_http_now()) in let sent = offset + count in
      if sent < length then store_i64(state, 40, sent)
      else rt_http_sent(state)

; The whole output went out.
effect fn rt_http_sent (state : ptr) -> unit
  = let reset = store_i64(state, 32, 0) in let rewound = store_i64(state, 40, 0) in
    let close = load_i64(state, 48) in
    if close == 1 then rt_drop(state) else if close == 3 then rt_http_linger(state) else noop()

; A synchronous handler may explicitly take over its response transport. Drain
; earlier pipelined replies first, then mark this connection close-after-handler.
; The standard library bounds writes by a monotonic deadline. No fd ownership
; escapes: the runtime closes it when the handler returns an empty response.
effect fn rt_http_stream_fd(deadline:i64) -> i64
  = let state=load_ptr(runtime_state(),1616) in if state==null() || rt_fiber_current()!=null() then -1 else
    let fd=load_i64(state,0) in if fd<0 || rt_nonblock(fd)<0 then -1 else
    let drained=loop(done=load_i64(state,32)==0,alive=true) while !done && alive
      next(let flushed=rt_flush(state) in load_i64(state,32)==0,
        let remaining=deadline-rt_clock_ns()/1000000 in
        load_i64(state,0)>=0 && remaining>0 && (load_i64(state,32)==0 || rt_wait_ready(fd,4,if remaining>2147483647 then 2147483647 else remaining)>0)) yield done && alive in
    if !drained then -1 else let close=store_i64(state,48,1) in fd

effect fn rt_http_stream_current(fd:i64,generation:i64) -> bool
  = let state=load_ptr(runtime_state(),1616) in state!=null() &&
    load_i64(runtime_state(),1624)==generation && load_i64(state,0)==fd && load_i64(state,48)==1

effect fn rt_http_generation() -> i64 = load_i64(runtime_state(),1624)

cold effect fn rt_http_discard_async(state:ptr)->unit
  = let scratch=stack_alloc(4096) in let received=rt_read(load_i64(state,0),scratch,4096) in
    if received==0 then rt_drop(state) else if received<0 && !rt_retry() then rt_drop(state) else noop()

effect fn rt_step (state : ptr, events : i64, handler : ptr) -> unit
  = if events / 8 % 2 == 1 || events / 32 % 2 == 1 || load_i64(state,48)==2 && (events / 16 % 2==1 || bit_and(events,8192)!=0) then rt_drop(state) else
    if load_i64(state,48)==4 then (if events % 2 == 1 || events / 16 % 2 == 1 then rt_http_discard(state) else noop()) else
    let discarded=if load_i64(state,48)!=2 || events%2!=1 then noop() else
      rt_http_discard_async(state) in
    let flushed = if load_i64(state,0)>=0 && load_i64(state, 32) > 0 && events / 4 % 2 == 1 then rt_flush(state) else noop() in
    if load_i64(state, 0) < 0 then noop() else
      let prepared = if load_i64(state, 48)<2 && load_i64(state, 32) == 0 && load_i64(state, 16) > 0 then rt_prepare(state, handler) else noop() in
      if load_i64(state, 0) < 0 then noop() else
        let received = if load_i64(state, 48)<2 && load_i64(state, 32) == 0 && (events % 2 == 1 || events / 16 % 2 == 1) then
          let n = load_i64(state, 16) in
          let room = rt_http_input_room(state) in
          let count = if room>0 then rt_read(load_i64(state, 0), ptr_add(load_ptr(state, 8), n), room) else 0 in
          if count > 0 then
            let saved = store_i64(state, 16, n + count) in let stamped = rt_http_received(state, n) in rt_prepare(state, handler)
          else if count == 0 then rt_drop(state)
          else if rt_retry() then noop() else rt_drop(state)
        else noop() in
        if load_i64(state, 0) >= 0 && load_i64(state, 32) > 0 then rt_flush(state) else noop()

; Only one worker accepts each connection. A shared turn and inherited
; socketpairs wake the next worker, distributing connections round-robin.
; The connection takes state `slot` (the count at local@0 grows when slot is
; that count); readiness backends need a non-blocking socket, completion
; backends (io_uring) a blocking one. Returns the slot, or -1.
effect fn rt_accept_at (listener : i64, states : ptr, slot : i64, blocking : bool, local : ptr,
                        control : ptr, worker : i64, workers : i64{workers >= 1}) -> i64
  = if load_i64(control, 0) != worker then -1 else
    let address = stack_alloc(128) in let size = stack_alloc(8) in let sized = store_i64(size, 0, 128) in
    let fd = rt_accept_peer(listener, address, size) in
    if fd < 0 then -1 else
      let placed = if slot < 0 || slot >= rt_http_limit(control) || (!blocking && rt_nonblock(fd) < 0) then
          let refused = if slot >= rt_http_limit(control) then rt_http_refuse_now(fd, 503) else noop() in let closed = rt_close(fd) in -1
        else let state = ptr_add(states, slot * 128) in
          let cleared = memset(state, i32(0), 128) in
          let one = stack_alloc(8) in let value = store_i32(one, 0, i32(1)) in
          let nodelay = rt_setsockopt(fd, 6, 1, one, 4) in
          let input = store_ptr(state, 8, ax_alloc(65536)) in
          let output = store_ptr(state, 24, ax_alloc(4096)) in
          let peer = rt_http_peer_save(state, address) in
          let active = store_i64(state, 72, rt_http_now()) in
          let descriptor = store_i64(state, 0, fd) in
          let counted = if slot == load_i64(local, 0) then store_i64(local, 0, slot + 1) else noop() in slot in
      let successor = rt_http_successor(control, worker, workers) in
      let advanced = store_i64(control, 0, successor) in
      let notified = if workers > 1 then
        let byte = stack_alloc(8) in let ready = store_u8(byte, 0, u8(1)) in
        let wrote = rt_write(load_i64(control, 264 + successor * 16), byte, 1) in noop()
      else noop() in placed

; The next worker to take the accept turn: supervised workers that are gone
; (pid 0 at 8192+8i while they are replaced) are skipped.
effect fn rt_http_successor(control:ptr, worker:i64, workers:i64{workers>=1}) -> i64
  = loop (k = 1, candidate = (worker + 1) % workers) while k < workers && load_i64(control, 8192 + candidate * 8) == 0
      next (k + 1, (candidate + 1) % workers) yield candidate

; Event tokens of connection `index` (epoll data, kevent udata): the low 12 bits
; are 1024, apart from the listener (0), notifications (1), the kqueue parent
; watch (2), signals (1026, 1027) and fiber waits (2048 and up).
fn rt_http_token(index:i64) -> i64 = index*4096+1024
fn rt_http_token_index(token:i64) -> i64 = if bit_and(token,4095)==1024 then shift_right(token,12) else -1

effect fn rt_accept (listener : i64, states : ptr, local : ptr, control : ptr, worker : i64, workers : i64{workers >= 1}) -> unit
  = let slot = rt_accept_at(listener, states, load_i64(local, 0), false, local, control, worker, workers) in noop()

effect fn rt_compact (states : ptr, n : i64) -> i64
  = loop (i = 0, used = 0) while i < n
      next (i + 1,
            if load_i64(states, i * 128) < 0 then used
            else let moved = if i != used then let copied = memcpy(ptr_add(states, used * 128), ptr_add(states, i * 128), 128) in noop()
                             else noop() in used + 1)
      yield used

effect fn rt_events (polls : ptr, states : ptr, n : i64, listener : i64, control : ptr, worker : i64) -> unit
  = let fd = store_i32(polls, 0, i32(if load_i64(control, 0) == worker then listener else -1)) in
    let events = store_i32(polls, 4, i32(1)) in
    let notify = store_i32(polls, 8, i32(load_i64(control, 256 + worker * 16))) in
    let mask = store_i32(polls, 12, i32(1)) in
    let built = loop (i = 0) while i < n
      next (let state = ptr_add(states, i * 128) in
            let fd = store_i32(polls, (i + 2) * 8, i32(load_i64(state, 0))) in
            let events = store_i32(polls, (i + 2) * 8 + 4,
              i32(if load_i64(state, 32) > 0 || load_i64(state, 56) == 1 then 4 else 1)) in i + 1)
      yield i in noop()

effect fn rt_http_worker (listener : i64, handler : ptr, control : ptr, worker : i64, workers : i64{workers >= 1}, parent : i64) -> i64
  = let states = ax_alloc(rt_http_limit(control) * 128) in
    let local = stack_alloc(16) in let count = store_i64(local, 0, 0) in
    let polls = ax_alloc((rt_http_limit(control) + 2) * 8) in
    let notification = stack_alloc(64) in
    loop (running = true) while running
      next (let swept = if rt_http_sweep_due() then rt_http_sweep(states, load_i64(local, 0), control, parent) else 0 in
            let n = rt_compact(states, load_i64(local, 0)) in
            let saved = store_i64(local, 0, n) in
            let built = rt_events(polls, states, n, listener, control, worker) in
            let ready = rt_poll(polls, n + 2) in
            let tick = rt_http_tick() in
            if ready < 0 then if load_i32(rt_errno(), 0) == i32(4) then true
              else let failed = ax_trap(data("poll syscall failed\0")) in false
            else let notified = if i64(load_u8(polls, 14)) % 2 == 1 then
              let drained = rt_read(load_i64(control, 256 + worker * 16), notification, 64) in noop()
              else noop() in
              let accepted = if i64(load_u8(polls, 6)) % 2 == 1 then rt_accept(listener, states, local, control, worker, workers) else noop() in
              let served = loop (i = 0) while i < n
                next (let state = ptr_add(states, i * 128) in
                      let events = i64(load_u8(polls, (i + 2) * 8 + 6)) in
                      let stepped = if load_i64(state, 0) >= 0 && events > 0 then rt_step(state, events, handler) else noop() in i + 1)
                yield i in true)
      yield 0

; Limits and timeouts, read by the parent before any worker starts and kept in
; the shared control page: connections per worker@16384 (NEO_HTTP_CONNECTIONS,
; default 1024), and in milliseconds, 0 for none: complete headers@16392
; (NEO_HTTP_HEADER_TIMEOUT_MS, 10 s from a request's first byte), body
; progress@16400 (NEO_HTTP_BODY_TIMEOUT_MS, 30 s between reads), keep-alive
; idle@16408 (NEO_HTTP_IDLE_TIMEOUT_MS, 60 s), response progress@16416
; (NEO_HTTP_WRITE_TIMEOUT_MS, 30 s between writes). Supervision: worker start
; times@16448+8i, replacement due times@18496+8i (both ms; 256 workers at most).
effect fn rt_http_setting(name:ptr, fallback:i64, lowest:i64, highest:i64) -> i64
  = let text=rt_getenv(name) in if text==null() then fallback else
    let value=ax_parse_i64(text,name) in if value<lowest then lowest else if value>highest then highest else value
effect fn rt_http_configure(control:ptr) -> unit
  = let a=store_i64(control,16384,rt_http_setting(data("NEO_HTTP_CONNECTIONS\0"),1024,1,65536)) in
    let b=store_i64(control,16392,rt_http_setting(data("NEO_HTTP_HEADER_TIMEOUT_MS\0"),10000,0,3600000)) in
    let c=store_i64(control,16400,rt_http_setting(data("NEO_HTTP_BODY_TIMEOUT_MS\0"),30000,0,3600000)) in
    let d=store_i64(control,16408,rt_http_setting(data("NEO_HTTP_IDLE_TIMEOUT_MS\0"),60000,0,86400000)) in
    store_i64(control,16416,rt_http_setting(data("NEO_HTTP_WRITE_TIMEOUT_MS\0"),30000,0,3600000))
effect fn rt_http_limit(control:ptr) -> i64 = load_i64(control,16384)

; The peer address from accept's sockaddr.
effect fn rt_http_peer_save(state:ptr, address:ptr) -> unit
  = let family=rt_sockaddr_family(address) in let saved=store_i64(state,80,family) in
    let port=store_i64(state,104,i64(load_u8(address,2))*256+i64(load_u8(address,3))) in
    let copied=if family==6 then memcpy(ptr_add(state,88),ptr_add(address,8),16)
      else memcpy(ptr_add(state,88),ptr_add(address,4),if family==4 then 4 else 0) in noop()
; The peer of the request being handled (4 bytes for IPv4, 16 for IPv6, or
; none), for std:http_server's web_peer. Async continuations use their job's connection.
effect fn rt_http_peer() -> Arr u8 _
  = let current=load_ptr(runtime_state(),1616) in let job=load_ptr(runtime_state(),1864) in
    let state=if current!=null() then current else if job!=null() then load_ptr(job,48) else null() in
    if state==null() || load_i64(state,0)<0 then "" else
    let family=load_i64(state,80) in let size=if family==4 then 4 else if family==6 then 16 else 0 in
    check size>=0 in let bytes=view(ptr_add(state,88),size) in arr(i in 0..size) bytes[i]

; Timeouts are checked once a second; every worker's wait wakes at least that often.
effect fn rt_http_sweep_due() -> bool
  = let now=rt_http_now() in if now<load_i64(runtime_state(),2016) then false else
    let later=store_i64(runtime_state(),2016,now+1000) in true
; What the sweep does with a connection: 0 keeps it, 1 closes it, 2 answers 408 and closes it.
effect fn rt_http_expiry(state:ptr, now:i64, control:ptr) -> i64
  = let close=load_i64(state,48) in
    if load_i64(state,0)<0 || close==2 || bit_and(load_i64(state,112),4)!=0 || load_i64(state,56)==1 then 0
    else if close==4 then (if now-load_i64(state,64)>2000 then 1 else 0)
    else if load_i64(state,32)>0 then rt_http_late(now-load_i64(state,72),load_i64(control,16416),1)
    else if load_i64(state,16)>0 then
      if bit_and(load_i64(state,112),2)!=0 then rt_http_late(now-load_i64(state,72),load_i64(control,16400),1)
      else rt_http_late(now-load_i64(state,64),load_i64(control,16392),2)
    else rt_http_late(now-load_i64(state,72),load_i64(control,16408),1)
fn rt_http_late(elapsed:i64, limit:i64, action:i64) -> i64 = if limit>0 && elapsed>limit then action else 0
; Readiness backends close expired connections in place; returns how many.
; A supervised worker whose parent is gone exits here.
effect fn rt_http_sweep(states:ptr, n:i64, control:ptr, parent:i64) -> i64
  = let orphaned=if load_i64(runtime_state(),2024)!=0 && rt_getppid()!=parent then ax_exit(0) else noop() in
    let now=rt_http_now() in
    loop (i = 0, closed = 0) while i < n
      next (i + 1, let state=ptr_add(states,i*128) in let action=rt_http_expiry(state,now,control) in
        if action==0 then closed else
        let answered=if action==2 then rt_http_refuse_now(load_i64(state,0),408) else noop() in
        let dropped=rt_drop(state) in closed+1)
      yield closed

; With more than one worker the parent only supervises and every worker is a
; child. A worker that exits while the server is not shutting down is replaced
; (a second later when it lived less than one), and the accept turn skips it
; meanwhile. A worker stopped by SIGINT or SIGTERM is not replaced.
effect fn rt_http_spawn(listener:i64, handler:ptr, control:ptr, worker:i64, workers:i64{workers>=1}, parent:i64) -> i64
  = let monitor=load_i64(runtime_state(),1728) in
    let pid=rt_fork() in
    if pid<0 then -1 else if pid>0 then
      let saved=store_i64(control,8192+worker*8,pid) in let born=store_i64(control,16448+worker*8,rt_clock_ns()/1000000) in pid
    else
      ; rt_fork forgot the parent's signal monitor; close its descriptor.
      let closed=if monitor>0 then rt_close(monitor-1) else 0 in
      let supervised=store_i64(runtime_state(),2024,1) in
      let signal=rt_http_worker_signals(control) in
      let result=rt_serve_worker(listener,handler,control,worker,workers,parent) in
      let exited=ax_exit(result) in 0
; The accept turn never rests with a worker that is gone.
effect fn rt_http_turn_check(control:ptr, workers:i64{workers>=1}) -> unit
  = let turn=load_i64(control,0) in if load_i64(control,8192+turn*8)!=0 then noop() else
    let successor=rt_http_successor(control,turn,workers) in
    if successor==turn then noop() else
    let turned=store_i64(control,0,successor) in
    let byte=stack_alloc(8) in let one=store_u8(byte,0,u8(1)) in let wrote=rt_write(load_i64(control,264+successor*16),byte,1) in noop()
; A worker exited: forget it, move the turn on, and schedule its replacement
; (due@18496+8i) unless the server is stopping or a signal stopped it.
effect fn rt_http_replace(control:ptr, workers:i64{workers>=1}, pid:i64, status:i64) -> unit
  = let index=loop(i=0) while i<workers && load_i64(control,8192+i*8)!=pid next(i+1) yield i in
    if index>=workers then noop() else
    let gone=store_i64(control,8192+index*8,0) in
    let turned=rt_http_turn_check(control,workers) in
    let signal=bit_and(status,127) in
    if atomic_load_i64(control,8)>0 || signal==2 || signal==15 then noop() else
    let noted=rt_write_all(2,data("neo: an HTTP worker exited; starting another\n"),46) in
    let now=rt_clock_ns()/1000000 in let young=now-load_i64(control,16448+index*8)<1000 in
    store_i64(control,18496+index*8,if young then now+1000 else now)
effect fn rt_http_respawn(listener:i64, handler:ptr, control:ptr, workers:i64{workers>=1}, parent:i64) -> bool
  = let now=rt_clock_ns()/1000000 in
    loop(i=0,pending=false) while i<workers next(i+1,
      let due=load_i64(control,18496+i*8) in
      if due==0 || load_i64(control,8192+i*8)!=0 then pending else
      if now<due then true else
      let cleared=store_i64(control,18496+i*8,0) in
      let spawned=rt_http_spawn(listener,handler,control,i,workers,parent) in
      if spawned>0 then pending else
      let noted=rt_write_all(2,data("neo: cannot start an HTTP worker\n"),33) in let retry=store_i64(control,18496+i*8,now+1000) in true)
      yield pending
effect fn rt_http_supervise(listener:i64, handler:ptr, control:ptr, workers:i64{workers>=1}, parent:i64) -> i64
  = let signal=rt_http_worker_signals(control) in
    let status=stack_alloc(8) in
    let done=loop(running=true) while running next(
      let cleared=store_i64(status,0,0) in
      let pid=rt_wait_status(-1,status,1) in
      if pid>0 then let replaced=rt_http_replace(control,workers,pid,i64(load_i32(status,0))) in true
      else if atomic_load_i64(control,8)>0 then
        ; Shutting down: the workers drain; past the grace period they are killed.
        if pid<0 && i64(load_i32(rt_errno(),0))!=4 then false else
        let late=rt_clock_ns()/1000000>=atomic_load_i64(control,8) in
        let killed=if !late then noop() else
          let each=loop(i=0) while i<workers next(let pid=load_i64(control,8192+i*8) in let k=if pid>0 then rt_kill(pid,9) else 0 in i+1) yield i in noop() in
        let paused=rt_wait_ready(-1,0,10) in true
      else
        let turned=rt_http_turn_check(control,workers) in
        let pending=rt_http_respawn(listener,handler,control,workers,parent) in
        if pid<0 && i64(load_i32(rt_errno(),0))!=4 && !pending then false else
        let woke=if signal<0 then rt_wait_ready(-1,0,100) else rt_wait_ready(signal,1,100) in
        let taken=if signal>=0 && woke>0 then rt_http_shutdown_signal(control,signal) else noop() in true)
      yield 0 in
    let restored=if signal>=0 then rt_signal_monitor_close(signal,load_i64(control,48)) else noop() in 0

export effect fn ax_serve (port : i64, handler : ptr) -> i64
  = let listener = rt_listener(port) in
    let workers = rt_threads() in
    let parent = rt_getpid() in
    let control = rt_map(65536) in
    let flags=store_i64(control,16,load_i64(runtime_state(),1680)) in let grace=store_i64(control,24,load_i64(runtime_state(),1688)) in let count=store_i64(control,40,workers) in
    let configured=rt_http_configure(control) in
    let mask=stack_alloc(8) in let set=store_i64(mask,0,16386) in let old=ptr_add(control,48) in
    let blocked=if load_i64(control,16)>0 then rt_signal_mask(rt_signal_block_mode(),mask,old) else 0 in
    let checked=if blocked<0 then ax_trap(data("HTTP signal mask failed\0")) else noop() in
    let descriptors = stack_alloc(8) in
    let initialized = loop (i = 0) while i < workers
      next (let pair = rt_socketpair(descriptors) in
            let checked = if pair < 0 then ax_trap(data("worker notification socketpair failed\0")) else noop() in
            let reader = i64(load_i32(descriptors, 0)) in let writer = i64(load_i32(descriptors, 4)) in
            let r = store_i64(control, 256 + i * 16, reader) in let w = store_i64(control, 264 + i * 16, writer) in
            let rn = rt_nonblock(reader) in let wn = rt_nonblock(writer) in i + 1)
      yield i in
    let event_wakeups=rt_events_bind(control) in
    let prefix = rt_write_all(2, data("neo: serving, workers="), 22) in
    let buffer = stack_alloc(64) in let start = rt_format_integer(buffer, 63, workers) in
    let newline = store_u8(buffer, 63, '\n') in let printed = rt_write_all(2, ptr_add(buffer, start), 64 - start) in
    let result = if workers > 1 then
      let started = loop (i = 0) while i < workers
        next (let pid = rt_http_spawn(listener, handler, control, i, workers, parent) in
              let failed = if pid < 0 then ax_trap(data("HTTP worker fork failed\0")) else noop() in i + 1)
        yield i in
      rt_http_supervise(listener, handler, control, workers, parent)
    else
      let signal=rt_http_worker_signals(control) in
      let served=rt_serve_worker(listener, handler, control, 0, 1, parent) in
      let restored=if signal>=0 then rt_signal_monitor_close(signal,load_i64(control,48)) else noop() in served in
    let unbound=rt_events_bind(null()) in result

; Input storage grows only for requests that fill the initial 64 KiB buffer.
; Header and body bounds are independent; ordinary GETs retain their allocation.
effect fn rt_http_input_room(state:ptr) -> i64
  = let have=load_i64(state,16) in let input=load_ptr(state,8) in let cap=ax_allocation_capacity(input) in
    let limit=16793600 in
    if have>=limit then 0 else if have<cap then (if cap<limit then cap else limit)-have else
      let target=if cap*2<limit then cap*2 else limit in let grown=ax_alloc(target) in
      let copied=memcpy(grown,input,have) in let saved=store_ptr(state,8,grown) in let released=ax_release(input) in target-have

; Returns the exact wire end for one chunked request, -2 for incomplete input,
; -1 for invalid framing. A following pipelined request is never consumed.
private fn rt_chunk_hex(byte:u8)->i64
  = if byte>='0' && byte<='9' then i64(byte)-48 else if byte>='A' && byte<='F' then i64(byte)-55 else if byte>='a' && byte<='f' then i64(byte)-87 else -1
type RuntimeChunked = {at:i64,result:i64,done:bool}
private fn rt_chunked_step(bytes:Arr u8 n,state:RuntimeChunked)->RuntimeChunked
  = if state.at<0 || state.at>n then state with {result= -1,done=true} else let end=rt_find(bytes,"\r\n",state.at) in
    if end<0 then state with {result=if n-state.at>1024 then -1 else -2,done=true} else
    if end<state.at || end+2>n then state with {result= -1,done=true} else
    let parsed=loop(i:i64{i>=0}=state.at,value=0,digits=0,ok=true) while ok && i<end && i<n && bytes[i]!=';' next(i+1,
      if value<=16777216 && rt_chunk_hex(bytes[i])>=0 then value*16+rt_chunk_hex(bytes[i]) else value,digits+1,rt_chunk_hex(bytes[i])>=0 && value<=16777216 && digits<8) yield if ok && digits>0 && value<=16777216 then value else -1 in
    if parsed<0 || end-state.at>1024 then state with {result= -1,done=true} else
    let from=end+2 in
    if parsed==0 then
      if from+2<=n && rt_match(bytes,from,"\r\n") then state with {result=from+2,done=true} else
      let trailers=rt_find(bytes,"\r\n\r\n",from) in
      if trailers>=0 then state with {result=if trailers-from<=16384 then trailers+4 else -1,done=true} else state with {result=if n-from>16384 then -1 else -2,done=true} else
    if from+parsed+2>n then state with {result= -2,done=true} else
    if !rt_match(bytes,from+parsed,"\r\n") then state with {result= -1,done=true} else state with {at=from+parsed+2}
fn rt_chunked_end(bytes:Arr u8 n,start:i64{start>=0})->i64
  = loop(state=RuntimeChunked {at=start,result= -2,done=false},count=0) while !state.done && count<4096 next(rt_chunked_step(bytes,state),count+1) yield if state.done then state.result else -1
