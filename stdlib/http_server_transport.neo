import "std:transport"
import "std:net"

; Borrowed response transport, live only inside the current serve_effect handler.
; Calls fail after the callback ends or another request takes over the descriptor.
; Streaming is synchronous per worker; use multiple workers for slow endpoints.
sealed type ServerHTTPCapture = { fd:i64,generation:i64 }
private effect(net,time,process) fn server_transport_write(capture:ServerHTTPCapture,bytes:Arr u8 n,deadline:i64) -> IntResult
  = if !rt_http_stream_current(capture.fd,capture.generation) then int_error(9,"expired server transport",0) else net_send(capture.fd,bytes,deadline)
private effect(net,time,process) fn server_transport_read(capture:ServerHTTPCapture,deadline:i64) -> BytesResult
  = bytes_error(22,"server response transport is write-only",0)
effect(net,time,process) fn http_server_transport(deadline:i64) -> HttpIO<ServerHTTPCapture>
  = HttpIO::<ServerHTTPCapture> { context=ServerHTTPCapture { fd=rt_http_stream_fd(deadline),generation=rt_http_generation() },read=function(server_transport_read),write=function(server_transport_write) }
