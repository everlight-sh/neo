private fn sha_high(value:i64) -> i64 = shift_right(value,32)
; A big-endian word of the padded message: text, the 0x80 marker, zeros, and
; the bit length in the last 8 bytes. padded leaves at least nine bytes after
; the text, so the length words never share a word with text or the marker.
; Only the word that holds the end of the text is assembled byte by byte.
private fn sha_pad_word(borrow text:Arr u8 n,at:i64,padded:i64) -> i64
  = check n<=1152921504606846975 in
    if at>=0 && at<=n-4 then sha_high(byte_swap64(byte_read_le(text,at,4)))
    else if at==padded-8 then shift_right(n*8,32)
    else if at==padded-4 then sha_u32(n*8)
    else if at>n then 0
    else loop(k=0,value=0) while k<4
      next(k+1,let p=at+k in
        let byte=if p>=0 && p<n then i64(text[p]) else if p==n then 128 else 0 in
        bit_or(shift_left(value,8),byte)) yield value
private fn sha_block(state:Sha256State,borrow text:Arr u8 n,block:i64,padded:i64) -> Sha256State
  = let at=block*64 in
    let w=if at>=0 && at+64<=n then
      let v0=byte_swap64(byte_read_le(text,at,8)) in let v1=byte_swap64(byte_read_le(text,at+8,8)) in
      let v2=byte_swap64(byte_read_le(text,at+16,8)) in let v3=byte_swap64(byte_read_le(text,at+24,8)) in
      let v4=byte_swap64(byte_read_le(text,at+32,8)) in let v5=byte_swap64(byte_read_le(text,at+40,8)) in
      let v6=byte_swap64(byte_read_le(text,at+48,8)) in let v7=byte_swap64(byte_read_le(text,at+56,8)) in
      ShaWords { w0=sha_high(v0),w1=sha_u32(v0),w2=sha_high(v1),w3=sha_u32(v1),w4=sha_high(v2),w5=sha_u32(v2),w6=sha_high(v3),w7=sha_u32(v3),
        w8=sha_high(v4),w9=sha_u32(v4),w10=sha_high(v5),w11=sha_u32(v5),w12=sha_high(v6),w13=sha_u32(v6),w14=sha_high(v7),w15=sha_u32(v7) }
    else ShaWords { w0=sha_pad_word(text,at,padded),w1=sha_pad_word(text,at+4,padded),w2=sha_pad_word(text,at+8,padded),w3=sha_pad_word(text,at+12,padded),
      w4=sha_pad_word(text,at+16,padded),w5=sha_pad_word(text,at+20,padded),w6=sha_pad_word(text,at+24,padded),w7=sha_pad_word(text,at+28,padded),
      w8=sha_pad_word(text,at+32,padded),w9=sha_pad_word(text,at+36,padded),w10=sha_pad_word(text,at+40,padded),w11=sha_pad_word(text,at+44,padded),
      w12=sha_pad_word(text,at+48,padded),w13=sha_pad_word(text,at+52,padded),w14=sha_pad_word(text,at+56,padded),w15=sha_pad_word(text,at+60,padded) } in
    sha_compress(state,w)
fn sha256(text:Arr u8 n) -> Arr u8 _
  = check n<=1152921504606846975 in let padded=(n+72)/64*64 in
    let initial=Sha256State { a=1779033703,b=3144134277,c=1013904242,d=2773480762,e=1359893119,f=2600822924,g=528734635,h=1541459225 } in
    let result=loop(i=0,state=initial) while i<padded/64 next(i+1,sha_block(state,text,i,padded)) yield state in
    arr(i in 0..32) u8(shift_right(sha_word(result,i/4),(3-i%4)*8))
; SHA-256 of a message that grows by appending, such as a TLS transcript: the state
; after the message's first `blocks` 64-byte blocks. sha256_absorb compresses the
; whole blocks text adds; sha256_finish pads and digests text from there, so digests
; of successive prefixes of one message compress each block once. text must start
; with the bytes absorbed so far.
type Sha256Running = { state:Sha256State,blocks:i64 }
fn sha256_start() -> Sha256Running
  = Sha256Running { state=Sha256State { a=1779033703,b=3144134277,c=1013904242,d=2773480762,e=1359893119,f=2600822924,g=528734635,h=1541459225 },blocks=0 }
fn sha256_absorb(running:Sha256Running,text:Arr u8 n) -> Sha256Running
  = check n<=1152921504606846975 in let padded=(n+72)/64*64 in
    let from=if running.blocks<0 || running.blocks>n/64 then sha256_start() else running in
    let state=loop(i=from.blocks,state=from.state) while i<n/64 next(i+1,sha_block(state,text,i,padded)) yield state in
    Sha256Running { state=state,blocks=n/64 }
fn sha256_finish(running:Sha256Running,text:Arr u8 n) -> Arr u8 _
  = check n<=1152921504606846975 in let padded=(n+72)/64*64 in
    if running.blocks<0 || running.blocks>n/64 then sha256(text) else
    let result=loop(i=running.blocks,state=running.state) while i<padded/64 next(i+1,sha_block(state,text,i,padded)) yield state in
    arr(i in 0..32) u8(shift_right(sha_word(result,i/4),(3-i%4)*8))
; Incremental hashing of disjoint chunks. Only the last partial block
; stays buffered between calls.
type Sha256Stream = { state:Sha256State, tail:Arr u8 _, size:i64 }
fn sha256_stream_start() -> Sha256Stream
  = Sha256Stream { state=sha256_start().state, tail="", size=0 }
fn sha256_stream_add(borrow stream:Sha256Stream, borrow bytes:Arr u8 n) -> Sha256Stream
  = let text=concat(stream.tail,bytes) in
    let step=sha256_absorb(Sha256Running { state=stream.state, blocks=0 },text) in
    Sha256Stream { state=step.state, tail=str_slice(text,step.blocks*64,len(text)), size=wrapping_add(stream.size,n) }
fn sha256_stream_finish(borrow stream:Sha256Stream) -> Arr u8 _
  = let size=if len(stream.tail)<56 then 64 else 128 in
    let padding=arr(i in 0..size) if i<len(stream.tail) then u8(str_byte(stream.tail,i))
      else if i==len(stream.tail) then u8(128) else if i<size-8 then u8(0)
      else u8(shift_right(wrapping_mul(stream.size,8),(size-1-i)*8)) in
    let block=sha_block(stream.state,padding,0,size) in
    let final=if size==64 then block else sha_block(block,padding,1,size) in
    arr(i in 0..32) u8(shift_right(sha_word(final,i/4),(3-i%4)*8))
fn hmac_sha256(key:Arr u8 n,message:Arr u8 m) -> Arr u8 _
  = let bounded=if n>64 then sha256(key) else key in
    let inner=arr(i in 0..64) u8(bit_xor(if i<len(bounded) then i64(bounded[i]) else 0,54)) in
    let outer=arr(i in 0..64) u8(bit_xor(if i<len(bounded) then i64(bounded[i]) else 0,92)) in
    sha256(concat(outer,sha256(concat(inner,message))))
type HkdfState = { previous:Arr u8 _,out:Arr u8 _,index:i64 }
private fn hkdf_step(move state:HkdfState,key:Arr u8 n,info:Arr u8 m) -> HkdfState
  = let block=hmac_sha256(key,concat(state.previous,info,arr(i in 0..1) u8(state.index))) in
    HkdfState { previous=block,out=concat(state.out,block),index=state.index+1 }
fn hkdf_extract(salt:Arr u8 n,key:Arr u8 m) -> Arr u8 _ = hmac_sha256(salt,key)
fn hkdf_expand(key:Arr u8 n,info:Arr u8 m,count:i64{count>=0 && count<=8160}) -> Arr u8 _
  = let result=loop(state=HkdfState { previous="",out="",index=1 }) while len(state.out)<count next(hkdf_step(state,key,info)) yield state.out in str_slice(result,0,count)
fn hkdf_label(key:Arr u8 n,label:Arr u8 m,context:Arr u8 k,count:i64{count>=0 && count<=8160}) -> Arr u8 _
  = check m<=249 && k<=255 in
    let header=arr(i in 0..3) u8(if i==0 then count/256 else if i==1 then count%256 else m+6) in
    hkdf_expand(key,concat(header,"tls13 ",label,arr(i in 0..1) u8(k),context),count)


; Reusable HMAC key schedule for KDFs and protocols with repeated MACs.
; Prehash the ipad/opad blocks once; every message keeps its own hash state.
sealed type HMACSHA256 = { inner:Sha256Running,outer:Sha256Running,ipad:Arr u8 _,opad:Arr u8 _ }
fn hmac_sha256_prepare(key:Arr u8 n) -> HMACSHA256
  = let bounded=if n>64 then sha256(key) else key in
    let ipad=arr(i in 0..64) u8(bit_xor(if i<len(bounded) then i64(bounded[i]) else 0,54)) in
    let opad=arr(i in 0..64) u8(bit_xor(if i<len(bounded) then i64(bounded[i]) else 0,92)) in
    HMACSHA256 {inner=sha256_absorb(sha256_start(),ipad),outer=sha256_absorb(sha256_start(),opad),ipad=ipad,opad=opad}
fn hmac_sha256_prepared(key:HMACSHA256,message:Arr u8 n) -> Arr u8 _
  = sha256_finish(key.outer,concat(key.opad,sha256_finish(key.inner,concat(key.ipad,message))))

; Chained MACs for key derivation. Each round MACs the previous 32-byte digest,
; so digests stay as state words and both compressions hash one fixed layout:
; eight message words, the 0x80 marker and a 768-bit length (the 64-byte pad
; block plus the digest). A round allocates nothing and reads no byte array,
; which keeps a derivation's uninterruptible CPU time to the compressions.
private fn sha_digest_state(digest:Arr u8 n) -> Sha256State
  = check n==32 in
    let v0=byte_swap64(byte_read_le(digest,0,8)) in let v1=byte_swap64(byte_read_le(digest,8,8)) in
    let v2=byte_swap64(byte_read_le(digest,16,8)) in let v3=byte_swap64(byte_read_le(digest,24,8)) in
    Sha256State { a=sha_u32(sha_high(v0)),b=sha_u32(v0),c=sha_u32(sha_high(v1)),d=sha_u32(v1),
      e=sha_u32(sha_high(v2)),f=sha_u32(v2),g=sha_u32(sha_high(v3)),h=sha_u32(v3) }
private fn sha_digest_block(state:Sha256State,m:Sha256State) -> Sha256State
  = sha_compress(state,ShaWords { w0=m.a,w1=m.b,w2=m.c,w3=m.d,w4=m.e,w5=m.f,w6=m.g,w7=m.h,
      w8=2147483648,w9=0,w10=0,w11=0,w12=0,w13=0,w14=0,w15=768 })
private fn sha_state_xor(x:Sha256State,y:Sha256State) -> Sha256State
  = Sha256State { a=bit_xor(x.a,y.a),b=bit_xor(x.b,y.b),c=bit_xor(x.c,y.c),d=bit_xor(x.d,y.d),
      e=bit_xor(x.e,y.e),f=bit_xor(x.f,y.f),g=bit_xor(x.g,y.g),h=bit_xor(x.h,y.h) }
; XOR of the chained MACs U1..U(rounds), where U1=first and each later MAC keys
; the digest before it: PBKDF2's block function after its first MAC. first must
; be a 32-byte digest; fewer than two rounds return it unchanged.
fn hmac_sha256_xor_chain(key:HMACSHA256,first:Arr u8 n,rounds:i64) -> Arr u8 _
  = check n==32 && key.inner.blocks==1 && key.outer.blocks==1 in
    let inner=key.inner.state in let outer=key.outer.state in let start=sha_digest_state(first) in
    let none=Sha256State { a=0,b=0,c=0,d=0,e=0,f=0,g=0,h=0 } in
    let total=loop(round=1,previous=start,earlier=none) while round<rounds
      next(round+1,sha_digest_block(outer,sha_digest_block(inner,previous)),sha_state_xor(earlier,previous))
      yield sha_state_xor(earlier,previous) in
    arr(i in 0..32) u8(shift_right(sha_word(total,i/4),(3-i%4)*8))
