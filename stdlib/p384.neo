; generated: end p6_constants
private fn p384_generator(index:i64) -> P384Affine
  = let t=p384_generator_bytes(index) in check len(t)==96 in
    P384Affine { x=P6 { l0=byte_read_le(t,0,8),l1=byte_read_le(t,8,8),l2=byte_read_le(t,16,8),l3=byte_read_le(t,24,8),l4=byte_read_le(t,32,8),l5=byte_read_le(t,40,8) },
      y=P6 { l0=byte_read_le(t,48,8),l1=byte_read_le(t,56,8),l2=byte_read_le(t,64,8),l3=byte_read_le(t,72,8),l4=byte_read_le(t,80,8),l5=byte_read_le(t,88,8) } }
private fn p6_zero() -> P6 = P6 { l0=0,l1=0,l2=0,l3=0,l4=0,l5=0 }
private fn p6_small(value:i64) -> P6 = P6 { l0=value,l1=0,l2=0,l3=0,l4=0,l5=0 }
private fn p6_is_zero(a:P6) -> bool = bit_or(bit_or(bit_or(a.l0,a.l1),bit_or(a.l2,a.l3)),bit_or(a.l4,a.l5))==0
private fn p6_equal(a:P6,b:P6) -> bool
  = p6_is_zero(P6 { l0=bit_xor(a.l0,b.l0),l1=bit_xor(a.l1,b.l1),l2=bit_xor(a.l2,b.l2),l3=bit_xor(a.l3,b.l3),l4=bit_xor(a.l4,b.l4),l5=bit_xor(a.l5,b.l5) })
private fn p6_less(a:P6,m:P6) -> bool = p6_sub_borrow(a,m).carry==1
; Values below m: (a+b) mod m and (a-b) mod m.
private fn p6_add_mod(a:P6,b:P6,m:P6) -> P6
  = let total=p6_add_carry(a,b) in let less=p6_sub_borrow(total.value,m) in p6_select(total.value,less.value,bit_or(total.carry,bit_xor(less.carry,1)))
private fn p6_sub_mod(a:P6,b:P6,m:P6) -> P6
  = let difference=p6_sub_borrow(a,b) in p6_add_carry(difference.value,p6_mask(m,wrapping_sub(0,difference.carry))).value
; a mod m for a below 2m.
private fn p6_reduce(a:P6,m:P6) -> P6 = let less=p6_sub_borrow(a,m) in p6_select(a,less.value,bit_xor(less.carry,1))
private fn p6_fadd(a:P6,b:P6) -> P6 = p6_add_mod(a,b,p6_prime())
private fn p6_fsub(a:P6,b:P6) -> P6 = p6_sub_mod(a,b,p6_prime())
; Big-endian 48 bytes to limbs, and back.
private fn p6_words(bytes:Arr u8 n) -> P6
  = check n==48 in P6 { l0=byte_swap64(byte_read_le(bytes,40,8)),l1=byte_swap64(byte_read_le(bytes,32,8)),l2=byte_swap64(byte_read_le(bytes,24,8)),
      l3=byte_swap64(byte_read_le(bytes,16,8)),l4=byte_swap64(byte_read_le(bytes,8,8)),l5=byte_swap64(byte_read_le(bytes,0,8)) }
private fn p6_bytes(a:P6) -> Arr u8 _
  = let out=arr(i in 0..48) u8(0) in
    let out=byte_write_le(out,40,byte_swap64(a.l0),8) in let out=byte_write_le(out,32,byte_swap64(a.l1),8) in
    let out=byte_write_le(out,24,byte_swap64(a.l2),8) in let out=byte_write_le(out,16,byte_swap64(a.l3),8) in
    let out=byte_write_le(out,8,byte_swap64(a.l4),8) in let out=byte_write_le(out,0,byte_swap64(a.l5),8) in out
private fn p6_shift1(a:P6) -> P6
  = P6 { l0=bit_or(shift_right(a.l0,1),shift_left(a.l1,63)),l1=bit_or(shift_right(a.l1,1),shift_left(a.l2,63)),
      l2=bit_or(shift_right(a.l2,1),shift_left(a.l3,63)),l3=bit_or(shift_right(a.l3,1),shift_left(a.l4,63)),
      l4=bit_or(shift_right(a.l4,1),shift_left(a.l5,63)),l5=shift_right(a.l5,1) }

; a^-1 mod n by the binary extended Euclidean algorithm. It branches on the
; value, which is public (the signature's s). Invariants: x1*a = u and
; x2*a = v (mod n); the loop ends at u = 0 with v = gcd(a,n) = 1.
type P6Gcd = { u:P6,v:P6,x1:P6,x2:P6,steps:i64 }
type P6Odd = { value:P6,x:P6 }
; x/2 mod n for x below n.
private fn p6_order_half(x:P6) -> P6
  = if bit_and(x.l0,1)==0 then p6_shift1(x) else
    let wide=p6_add_carry(x,p6_order()) in let half=p6_shift1(wide.value) in half with { l5=bit_or(half.l5,shift_left(wide.carry,63)) }
; Divides a nonzero value by its factors of two, and x by as many (mod n).
private fn p6_order_odd(value:P6,x:P6) -> P6Odd
  = loop(value=value,x=x) while bit_and(value.l0,1)==0 next(p6_shift1(value),p6_order_half(x)) yield P6Odd { value=value,x=x }
private fn p6_gcd_step(state:P6Gcd) -> P6Gcd
  = let a=p6_order_odd(state.u,state.x1) in let b=p6_order_odd(state.v,state.x2) in let difference=p6_sub_borrow(a.value,b.value) in
    if difference.carry==0 then P6Gcd { u=difference.value,v=b.value,x1=p6_sub_mod(a.x,b.x,p6_order()),x2=b.x,steps=state.steps+1 } else
    P6Gcd { u=a.value,v=p6_sub_borrow(b.value,a.value).value,x1=a.x,x2=p6_sub_mod(b.x,a.x,p6_order()),steps=state.steps+1 }
; For a in [1,n-1]: a^-1 in Montgomery form. Each step shrinks u*v by at least
; a factor of two (768 bits in all), so 800 steps are never reached; zero is
; returned if they were.
private fn p6_order_inverse(a:P6) -> P6
  = let state=loop(state=P6Gcd { u=a,v=p6_order(),x1=p6_small(1),x2=p6_zero(),steps=0 }) while !p6_is_zero(state.u) && state.steps<800
      next(p6_gcd_step(state)) yield state in
    if p6_is_zero(state.u) then p6_order_mul(state.x2,p6_order_r2()) else p6_zero()

; Point formulas over the field, in Jacobian coordinates (a = -3); a point at
; infinity has z = 0. neoc force-inlines small pure functions: these stay
; inline in the hot loop (p384_combination), which is kept out of line itself,
; while the table build and the exceptional cases call the `_call` copies (see
; the note above p256_double). The products are out-of-line calls.
private fn p384_infinity() -> P384Point = P384Point { x=p6_field_one(),y=p6_field_one(),z=p6_zero() }
; dbl-2001-b.
private fn p384_double(a:P384Point) -> P384Point
  = let delta=p6_field_square(a.z) in let gamma=p6_field_square(a.y) in let beta=p6_field_mul(a.x,gamma) in
    let alpha=p6_field_mul(p6_fsub(a.x,delta),p6_fadd(a.x,delta)) in let alpha=p6_fadd(p6_fadd(alpha,alpha),alpha) in
    let beta2=p6_fadd(beta,beta) in let beta4=p6_fadd(beta2,beta2) in let beta8=p6_fadd(beta4,beta4) in
    let x=p6_fsub(p6_field_square(alpha),beta8) in
    let yz=p6_fadd(a.y,a.z) in let z=p6_fsub(p6_fsub(p6_field_square(yz),gamma),delta) in
    let gamma2=p6_field_square(gamma) in let gamma2=p6_fadd(gamma2,gamma2) in let gamma2=p6_fadd(gamma2,gamma2) in let gamma2=p6_fadd(gamma2,gamma2) in
    let y=p6_fsub(p6_field_mul(alpha,p6_fsub(beta4,x)),gamma2) in P384Point { x=x,y=y,z=z }
; Mixed addition of an affine point (madd-2007-bl, with Z3 = 2*Z1*H) for a not at infinity.
private fn p384_add_affine(a:P384Point,b:P384Affine) -> P384Point
  = let z1z1=p6_field_square(a.z) in
    let u2=p6_field_mul(b.x,z1z1) in let s2=p6_field_mul(b.y,p6_field_mul(a.z,z1z1)) in
    let h=p6_fsub(u2,a.x) in let r=p6_fsub(s2,a.y) in
    if p6_is_zero(h) then
      (if p6_is_zero(r) then p384_double_call(P384Point { x=b.x,y=b.y,z=p6_field_one() }) else p384_infinity()) else
    let hh=p6_field_square(h) in let i=p6_fadd(p6_fadd(hh,hh),p6_fadd(hh,hh)) in let j=p6_field_mul(h,i) in
    let r=p6_fadd(r,r) in let v=p6_field_mul(a.x,i) in
    let x=p6_fsub(p6_fsub(p6_field_square(r),j),p6_fadd(v,v)) in
    let yj=p6_field_mul(a.y,j) in let y=p6_fsub(p6_field_mul(r,p6_fsub(v,x)),p6_fadd(yj,yj)) in
    let zh=p6_field_mul(a.z,h) in P384Point { x=x,y=y,z=p6_fadd(zh,zh) }
; General addition (add-2007-bl, with Z3 = Z1*Z2*2H) for a and b not at infinity.
private fn p384_add_general(a:P384Point,b:P384Point) -> P384Point
  = let z1z1=p6_field_square(a.z) in let z2z2=p6_field_square(b.z) in
    let u1=p6_field_mul(a.x,z2z2) in let u2=p6_field_mul(b.x,z1z1) in
    let s1=p6_field_mul(a.y,p6_field_mul(b.z,z2z2)) in let s2=p6_field_mul(b.y,p6_field_mul(a.z,z1z1)) in
    let h=p6_fsub(u2,u1) in let r=p6_fsub(s2,s1) in
    if p6_is_zero(h) then
      (if p6_is_zero(r) then p384_double_call(b) else p384_infinity()) else
    let h2=p6_fadd(h,h) in let i=p6_field_square(h2) in let j=p6_field_mul(h,i) in
    let r=p6_fadd(r,r) in let v=p6_field_mul(u1,i) in
    let x=p6_fsub(p6_fsub(p6_field_square(r),j),p6_fadd(v,v)) in
    let sj=p6_field_mul(s1,j) in let y=p6_fsub(p6_field_mul(r,p6_fsub(v,x)),p6_fadd(sj,sj)) in
    P384Point { x=x,y=y,z=p6_field_mul(p6_field_mul(a.z,b.z),h2) }
private cold fn p384_double_call(a:P384Point) -> P384Point = p384_double(a)
private cold fn p384_add_general_call(a:P384Point,b:P384Point) -> P384Point = p384_add_general(a,b)

; Width-w NAF digits of a scalar below 2^384: odd digits below 2^(w-1) in
; absolute value, 385 positions. A positive digit clears the low bits; a
; negative one adds up to the next multiple of 2^w (no overflow: scalars are
; below n < 2^384-64).
type P384Naf = { k:P6,digits:Arr i64 _ }
private fn p384_naf_step(move state:P384Naf,i:i64,width:i64) -> P384Naf
  = let k=state.k in let low=bit_and(k.l0,shift_left(1,width)-1) in
    let digit=if bit_and(low,1)==0 then 0 else if low>=shift_left(1,width-1) then low-shift_left(1,width) else low in
    let k=if digit==0 then k else if digit>0 then k with { l0=wrapping_sub(k.l0,digit) } else p6_add_carry(k,p6_small(0-digit)).value in
    let digits=state.digits in check i>=0 && i<len(digits) in P384Naf { k=p6_shift1(k),digits=set(digits,i,digit) }
private fn p384_naf(scalar:P6,width:i64) -> Arr i64 _
  = let state=loop(i=0,state=P384Naf { k=scalar,digits=arr(j in 0..385) 0 }) while i<385 next(i+1,p384_naf_step(state,i,width)) yield state in state.digits
type P384Odd = { p1:P384Point,p3:P384Point,p5:P384Point,p7:P384Point,p9:P384Point,p11:P384Point,p13:P384Point,p15:P384Point }
private fn p384_odd_multiples(point:P384Point) -> P384Odd
  = let twice=p384_double_call(point) in let p3=p384_add_general_call(twice,point) in let p5=p384_add_general_call(twice,p3) in
    let p7=p384_add_general_call(twice,p5) in let p9=p384_add_general_call(twice,p7) in let p11=p384_add_general_call(twice,p9) in
    let p13=p384_add_general_call(twice,p11) in
    P384Odd { p1=point,p3=p3,p5=p5,p7=p7,p9=p9,p11=p11,p13=p13,p15=p384_add_general_call(twice,p13) }
private fn p384_odd_pick(table:P384Odd,index:i64) -> P384Point
  = if index==0 then table.p1 else if index==1 then table.p3 else if index==2 then table.p5 else if index==3 then table.p7 else
    if index==4 then table.p9 else if index==5 then table.p11 else if index==6 then table.p13 else table.p15
type P384Sum = { point:P384Point,empty:bool }
private fn p384_sum_add(total:P384Sum,b:P384Point) -> P384Sum
  = if total.empty then P384Sum { point=b,empty=false } else
    let added=p384_add_general(total.point,b) in P384Sum { point=added,empty=p6_is_zero(added.z) }
private fn p384_sum_affine(total:P384Sum,b:P384Affine) -> P384Sum
  = if total.empty then P384Sum { point=P384Point { x=b.x,y=b.y,z=p6_field_one() },empty=false } else
    let added=p384_add_affine(total.point,b) in P384Sum { point=added,empty=p6_is_zero(added.z) }
private fn p384_verify_step(total:P384Sum,g:i64,q:i64,table:P384Odd) -> P384Sum
  = let doubled=if total.empty then total else P384Sum { point=p384_double(total.point),empty=false } in
    let with_g=if g==0 then doubled else let base=p384_generator(if g>0 then (g-1)/2 else (0-g-1)/2) in
      p384_sum_affine(doubled,if g>0 then base else P384Affine { x=base.x,y=p6_fsub(p6_zero(),base.y) }) in
    if q==0 then with_g else let base=p384_odd_pick(table,if q>0 then (q-1)/2 else (0-q-1)/2) in
      p384_sum_add(with_g,if q>0 then base else base with { y=p6_fsub(p6_zero(),base.y) })
; u1*G + u2*Q by interleaved NAF digits: width 7 for the fixed generator
; table, width 5 for the table of Q built here.
private cold fn p384_combination(u1:P6,u2:P6,point:P384Point) -> P384Sum
  = let g=p384_naf(u1,7) in let q=p384_naf(u2,5) in let table=p384_odd_multiples(point) in
    loop(i=384,total=P384Sum { point=p384_infinity(),empty=true }) while i>=0
      next(i-1,check i>=0 && i<len(g) && i<len(q) in p384_verify_step(total,g[i],q[i],table)) yield total
; x(point) = r (mod n) without inverting z: X = r*Z^2, or (r+n)*Z^2 when r+n < p.
private fn p384_x_matches(point:P384Point,r:P6) -> bool
  = let zz=p6_field_square(point.z) in
    p6_equal(point.x,p6_field_mul(p6_field_mul(r,p6_field_r2()),zz)) ||
      (let wide=p6_add_carry(r,p6_order()) in wide.carry==0 && p6_less(wide.value,p6_prime()) &&
        p6_equal(point.x,p6_field_mul(p6_field_mul(wide.value,p6_field_r2()),zz)))

; Uncompressed SEC1 point (0x04 || X || Y, 97 bytes) with coordinates below p on the curve.
private fn p384_point_valid(public:Arr u8 n) -> bool
  = if n!=97 || str_byte(public,0)!=4 then false else
    let x=p6_words(str_slice(public,1,49)) in let y=p6_words(str_slice(public,49,97)) in
    if !p6_less(x,p6_prime()) || !p6_less(y,p6_prime()) then false else
    let mx=p6_field_mul(x,p6_field_r2()) in let my=p6_field_mul(y,p6_field_r2()) in
    let x3=p6_field_mul(p6_field_square(mx),mx) in let triple=p6_fadd(p6_fadd(mx,mx),mx) in
    p6_equal(p6_field_square(my),p6_fadd(p6_fsub(x3,triple),p6_curve_b()))
private fn p384_point_decode(public:Arr u8 n) -> P384Point
  = check n==97 in P384Point { x=p6_field_mul(p6_words(str_slice(public,1,49)),p6_field_r2()),
      y=p6_field_mul(p6_words(str_slice(public,49,97)),p6_field_r2()),z=p6_field_one() }
private fn p384_scalar_valid(value:P6) -> bool = !p6_is_zero(value) && p6_less(value,p6_order())
private fn p384_der_scalar(signature:Arr u8 n,node:DerNode) -> BytesResult
  = let bytes=der_value(signature,node) in let count=len(bytes) in
    if !node.ok || node.tag!=2 || count<1 || count>49 || str_byte(bytes,0)>=128 || count>1 && str_byte(bytes,0)==0 && str_byte(bytes,1)<128 ||
      count==49 && str_byte(bytes,0)!=0 then bytes_error(74,"invalid ECDSA DER integer",0) else
    bytes_ok(arr(i in 0..48) u8(if i+count<48 then 0 else str_byte(bytes,i+count-48)))
; The leftmost 384 bits of the digest (FIPS 186-5 6.4.2); a shorter digest is
; its own value, left-padded with zeros.
private fn p384_digest_bytes(digest:Arr u8 m) -> Arr u8 _
  = let take=if m<48 then m else 48 in arr(i in 0..48) u8(if i<48-take then 0 else str_byte(digest,i-(48-take)))

; Uncompressed SEC1 point (0x04 || X || Y, 97 bytes) on P-384, coordinates below p.
fn p384_public_valid(public:Arr u8 n) -> bool = p384_point_valid(public)
; ECDSA verification (FIPS 186-5 6.4.2) of a DER signature over a precomputed digest.
fn ecdsa_p384_verify_digest(public:Arr u8 n,digest:Arr u8 m,signature:Arr u8 k) -> bool
  = if m<1 || m>64 || k<8 || k>104 || !p384_point_valid(public) then false else
    let seq=der_node(signature,0,k) in let first=der_node(signature,seq.body,seq.end) in let second=der_node(signature,first.end,seq.end) in
    if !seq.ok || seq.tag!=48 || seq.end!=k || !first.ok || !second.ok || second.end!=seq.end then false else
    let raw_r=p384_der_scalar(signature,first) in let raw_s=p384_der_scalar(signature,second) in
    if !raw_r.ok || !raw_s.ok then false else
    let r=p6_words(raw_r.value) in let s=p6_words(raw_s.value) in
    if !p384_scalar_valid(r) || !p384_scalar_valid(s) then false else
    ; w is s^-1 in Montgomery form, so its product with a plain value is plain.
    let w=p6_order_inverse(s) in
    let z=p6_reduce(p6_words(p384_digest_bytes(digest)),p6_order()) in
    let total=p384_combination(p6_order_mul(z,w),p6_order_mul(r,w),p384_point_decode(public)) in
    !total.empty && p384_x_matches(total.point,r)
fn ecdsa_p384_verify_sha384(public:Arr u8 n,message:Arr u8 m,signature:Arr u8 k) -> bool = ecdsa_p384_verify_digest(public,sha384(message),signature)
fn ecdsa_p384_verify_sha256(public:Arr u8 n,message:Arr u8 m,signature:Arr u8 k) -> bool = ecdsa_p384_verify_digest(public,sha256(message),signature)
fn ecdsa_p384_verify_sha512(public:Arr u8 n,message:Arr u8 m,signature:Arr u8 k) -> bool = ecdsa_p384_verify_digest(public,sha512(message),signature)
; P-256 (65-byte uncompressed key) with a digest other than SHA-256, e.g. ecdsa-with-SHA384 certificates.
; Digests of 32 bytes or more use their leftmost 256 bits (FIPS 186-5 6.4.2);
; a shorter digest is its own value, left-padded with zeros. Both go to the
; std:p256 verifier.
fn ecdsa_p256_verify_digest(public:Arr u8 n,digest:Arr u8 m,signature:Arr u8 k) -> bool
  = if m>=32 then ecdsa_p256_verify_digest32(public,str_slice(digest,0,32),signature) else
    m>=1 && ecdsa_p256_verify_digest32(public,arr(i in 0..32) u8(if i<32-m then 0 else str_byte(digest,i-(32-m))),signature)
fn ecdsa_p256_verify_sha384(public:Arr u8 n,message:Arr u8 m,signature:Arr u8 k) -> bool = ecdsa_p256_verify_digest(public,sha384(message),signature)
fn ecdsa_p256_verify_sha512(public:Arr u8 n,message:Arr u8 m,signature:Arr u8 k) -> bool = ecdsa_p256_verify_digest(public,sha512(message),signature)
