import "std:sha256"
import "std:sha512"
import "std:der"
import "std:p256"

; ECDSA signature verification on P-384 with SHA-256/384/512 digests, and on
; P-256 with digests other than the SHA-256 path of std:p256 (which does the
; P-256 arithmetic). Field and order values are records of six unsigned 64-bit
; limbs (no allocation per operation) in Montgomery form with R = 2^384, fully
; reduced between operations; tests/generate_p384_fields.py writes the
; unrolled products and the constants. Limb arithmetic is exact: wrapping
; sums with unsigned comparisons for carries, and wrapping_mul/mul_high for
; the two words of each 128-bit product.
; Verification works only on public data, so it uses ordinary branches, NAF
; digits, precomputed odd multiples of the generator and a variable-time
; inversion; it is not constant time. There is no P-384 signing or key
; agreement here. It has not been independently audited.
type P6 = { l0:i64,l1:i64,l2:i64,l3:i64,l4:i64,l5:i64 }
type P6Carry = { value:P6,carry:i64 }
; Product-scanning state: a signed three-word column accumulator c0..c2 (two's
; complement), the quotient digits w0..w5 while reducing, then the low result
; words.
type P6Acc = { c0:i64,c1:i64,c2:i64,w0:i64,w1:i64,w2:i64,w3:i64,w4:i64,w5:i64 }
type P384Affine = { x:P6,y:P6 }
type P384Point = { x:P6,y:P6,z:P6 }

; 1 when a < b as unsigned 64-bit words, else 0.
private fn p6_below(a:i64,b:i64) -> i64 = if bit_xor(a,-9223372036854775808)<bit_xor(b,-9223372036854775808) then 1 else 0
; Adds the 128-bit product x*y to the accumulator.
private fn p6_mac(s:P6Acc,x:i64,y:i64) -> P6Acc
  = let lo=wrapping_mul(x,y) in let hi=mul_high(x,y) in
    let c0=wrapping_add(s.c0,lo) in let t=wrapping_add(s.c1,hi) in let c1=wrapping_add(t,p6_below(c0,lo)) in
    s with { c0=c0,c1=c1,c2=wrapping_add(s.c2,bit_or(p6_below(t,hi),p6_below(c1,t))) }
private fn p6_mac2(s:P6Acc,x:i64,y:i64) -> P6Acc = p6_mac(p6_mac(s,x,y),x,y)
; Adds or subtracts one word, or subtracts the two-word value hi*2^64+lo.
private fn p6_add1(s:P6Acc,x:i64) -> P6Acc
  = let c0=wrapping_add(s.c0,x) in let k=p6_below(c0,x) in let c1=wrapping_add(s.c1,k) in
    s with { c0=c0,c1=c1,c2=wrapping_add(s.c2,p6_below(c1,k)) }
private fn p6_sub1(s:P6Acc,x:i64) -> P6Acc
  = let k=p6_below(s.c0,x) in s with { c0=wrapping_sub(s.c0,x),c1=wrapping_sub(s.c1,k),c2=wrapping_sub(s.c2,p6_below(s.c1,k)) }
private fn p6_sub2(s:P6Acc,lo:i64,hi:i64) -> P6Acc
  = let k=p6_below(s.c0,lo) in let t=wrapping_sub(s.c1,hi) in
    s with { c0=wrapping_sub(s.c0,lo),c1=wrapping_sub(t,k),c2=wrapping_sub(s.c2,bit_or(p6_below(s.c1,hi),p6_below(t,k))) }
; Adds q*m0, where q = c0*(-m^-1) mod 2^64: its low word cancels c0 (a carry
; unless c0 is 0) and hi is its high word. The zero word is shifted out.
private fn p6_fold(s:P6Acc,hi:i64) -> P6Acc
  = let t=wrapping_add(hi,if s.c0==0 then 0 else 1) in let c1=wrapping_add(s.c1,t) in let c2=wrapping_add(s.c2,p6_below(c1,t)) in
    s with { c0=c1,c1=c2,c2=arithmetic_shift_right(c2,63) }
; generated: begin p6_carries
private fn p6_add_carry(a:P6,b:P6) -> P6Carry
  = let s0=wrapping_add(a.l0,b.l0) in let c=p6_below(s0,a.l0) in
    let t=wrapping_add(a.l1,b.l1) in let s1=wrapping_add(t,c) in let c=bit_or(p6_below(t,a.l1),p6_below(s1,t)) in
    let t=wrapping_add(a.l2,b.l2) in let s2=wrapping_add(t,c) in let c=bit_or(p6_below(t,a.l2),p6_below(s2,t)) in
    let t=wrapping_add(a.l3,b.l3) in let s3=wrapping_add(t,c) in let c=bit_or(p6_below(t,a.l3),p6_below(s3,t)) in
    let t=wrapping_add(a.l4,b.l4) in let s4=wrapping_add(t,c) in let c=bit_or(p6_below(t,a.l4),p6_below(s4,t)) in
    let t=wrapping_add(a.l5,b.l5) in let s5=wrapping_add(t,c) in let c=bit_or(p6_below(t,a.l5),p6_below(s5,t)) in
    P6Carry { value=P6 { l0=s0,l1=s1,l2=s2,l3=s3,l4=s4,l5=s5 },carry=c }
private fn p6_sub_borrow(a:P6,b:P6) -> P6Carry
  = let d0=wrapping_sub(a.l0,b.l0) in let c=p6_below(a.l0,b.l0) in
    let t=wrapping_sub(a.l1,b.l1) in let d1=wrapping_sub(t,c) in let c=bit_or(p6_below(a.l1,b.l1),p6_below(t,c)) in
    let t=wrapping_sub(a.l2,b.l2) in let d2=wrapping_sub(t,c) in let c=bit_or(p6_below(a.l2,b.l2),p6_below(t,c)) in
    let t=wrapping_sub(a.l3,b.l3) in let d3=wrapping_sub(t,c) in let c=bit_or(p6_below(a.l3,b.l3),p6_below(t,c)) in
    let t=wrapping_sub(a.l4,b.l4) in let d4=wrapping_sub(t,c) in let c=bit_or(p6_below(a.l4,b.l4),p6_below(t,c)) in
    let t=wrapping_sub(a.l5,b.l5) in let d5=wrapping_sub(t,c) in let c=bit_or(p6_below(a.l5,b.l5),p6_below(t,c)) in
    P6Carry { value=P6 { l0=d0,l1=d1,l2=d2,l3=d3,l4=d4,l5=d5 },carry=c }
; generated: end p6_carries
; a when bit is 0, b when bit is 1 (public data only: LLVM lowers this to
; conditional moves, but nothing secret is selected in this module).
private fn p6_select(a:P6,b:P6,bit:i64) -> P6 = if bit==1 then b else a
private fn p6_mask(a:P6,m:i64) -> P6
  = P6 { l0=bit_and(a.l0,m),l1=bit_and(a.l1,m),l2=bit_and(a.l2,m),l3=bit_and(a.l3,m),l4=bit_and(a.l4,m),l5=bit_and(a.l5,m) }
; The product's low words (w0..w4, c0) plus c1*2^384 are below twice the
; modulus: one conditional subtraction reduces them.
private fn p6_final(s:P6Acc,m:P6) -> P6
  = let t=P6 { l0=s.w0,l1=s.w1,l2=s.w2,l3=s.w3,l4=s.w4,l5=s.c0 } in let d=p6_sub_borrow(t,m) in
    p6_select(t,d.value,bit_or(s.c1,bit_xor(d.carry,1)))
; generated: begin p6_products
private inline fn p6_field_mul1(a:P6,b:P6,s:P6Acc) -> P6Acc
  = let s=p6_mac(s,a.l0,b.l4) in
    let s=p6_mac(s,a.l1,b.l3) in
    let s=p6_mac(s,a.l2,b.l2) in
    let s=p6_mac(s,a.l3,b.l1) in
    let s=p6_mac(s,a.l4,b.l0) in
    let s=p6_sub2(s,shift_left(s.w3,32),shift_right(s.w3,32)) in
    let s=p6_sub1(s,s.w2) in
    let q=wrapping_add(s.c0,shift_left(s.c0,32)) in let s=p6_fold(s,wrapping_sub(shift_right(q,32),p6_below(shift_left(q,32),q))) with { w4=q } in
    let s=p6_mac(s,a.l0,b.l5) in
    let s=p6_mac(s,a.l1,b.l4) in
    let s=p6_mac(s,a.l2,b.l3) in
    let s=p6_mac(s,a.l3,b.l2) in
    let s=p6_mac(s,a.l4,b.l1) in
    let s=p6_mac(s,a.l5,b.l0) in
    let s=p6_sub2(s,shift_left(s.w4,32),shift_right(s.w4,32)) in
    let s=p6_sub1(s,s.w3) in
    let q=wrapping_add(s.c0,shift_left(s.c0,32)) in let s=p6_fold(s,wrapping_sub(shift_right(q,32),p6_below(shift_left(q,32),q))) with { w5=q } in
    s
private inline fn p6_field_mul2(a:P6,b:P6,s:P6Acc) -> P6Acc
  = let s=p6_mac(s,a.l1,b.l5) in
    let s=p6_mac(s,a.l2,b.l4) in
    let s=p6_mac(s,a.l3,b.l3) in
    let s=p6_mac(s,a.l4,b.l2) in
    let s=p6_mac(s,a.l5,b.l1) in
    let s=p6_sub2(s,shift_left(s.w5,32),shift_right(s.w5,32)) in
    let s=p6_sub1(s,s.w4) in
    let s=p6_add1(s,s.w0) in
    let s=s with { c0=s.c1,c1=s.c2,c2=arithmetic_shift_right(s.c2,63),w0=s.c0 } in
    let s=p6_mac(s,a.l2,b.l5) in
    let s=p6_mac(s,a.l3,b.l4) in
    let s=p6_mac(s,a.l4,b.l3) in
    let s=p6_mac(s,a.l5,b.l2) in
    let s=p6_sub1(s,s.w5) in
    let s=p6_add1(s,s.w1) in
    let s=s with { c0=s.c1,c1=s.c2,c2=arithmetic_shift_right(s.c2,63),w1=s.c0 } in
    s
private inline fn p6_field_mul3(a:P6,b:P6,s:P6Acc) -> P6Acc
  = let s=p6_mac(s,a.l3,b.l5) in
    let s=p6_mac(s,a.l4,b.l4) in
    let s=p6_mac(s,a.l5,b.l3) in
    let s=p6_add1(s,s.w2) in
    let s=s with { c0=s.c1,c1=s.c2,c2=arithmetic_shift_right(s.c2,63),w2=s.c0 } in
    let s=p6_mac(s,a.l4,b.l5) in
    let s=p6_mac(s,a.l5,b.l4) in
    let s=p6_add1(s,s.w3) in
    let s=s with { c0=s.c1,c1=s.c2,c2=arithmetic_shift_right(s.c2,63),w3=s.c0 } in
    let s=p6_mac(s,a.l5,b.l5) in
    let s=p6_add1(s,s.w4) in
    let s=s with { c0=s.c1,c1=s.c2,c2=arithmetic_shift_right(s.c2,63),w4=s.c0 } in
    s
private fn p6_field_mul(a:P6,b:P6) -> P6
  = let s=P6Acc { c0=0,c1=0,c2=0,w0=0,w1=0,w2=0,w3=0,w4=0,w5=0 } in
    let s=p6_mac(s,a.l0,b.l0) in
    let q=wrapping_add(s.c0,shift_left(s.c0,32)) in let s=p6_fold(s,wrapping_sub(shift_right(q,32),p6_below(shift_left(q,32),q))) with { w0=q } in
    let s=p6_mac(s,a.l0,b.l1) in
    let s=p6_mac(s,a.l1,b.l0) in
    let s=p6_sub2(s,shift_left(s.w0,32),shift_right(s.w0,32)) in
    let q=wrapping_add(s.c0,shift_left(s.c0,32)) in let s=p6_fold(s,wrapping_sub(shift_right(q,32),p6_below(shift_left(q,32),q))) with { w1=q } in
    let s=p6_mac(s,a.l0,b.l2) in
    let s=p6_mac(s,a.l1,b.l1) in
    let s=p6_mac(s,a.l2,b.l0) in
    let s=p6_sub2(s,shift_left(s.w1,32),shift_right(s.w1,32)) in
    let s=p6_sub1(s,s.w0) in
    let q=wrapping_add(s.c0,shift_left(s.c0,32)) in let s=p6_fold(s,wrapping_sub(shift_right(q,32),p6_below(shift_left(q,32),q))) with { w2=q } in
    let s=p6_mac(s,a.l0,b.l3) in
    let s=p6_mac(s,a.l1,b.l2) in
    let s=p6_mac(s,a.l2,b.l1) in
    let s=p6_mac(s,a.l3,b.l0) in
    let s=p6_sub2(s,shift_left(s.w2,32),shift_right(s.w2,32)) in
    let s=p6_sub1(s,s.w1) in
    let q=wrapping_add(s.c0,shift_left(s.c0,32)) in let s=p6_fold(s,wrapping_sub(shift_right(q,32),p6_below(shift_left(q,32),q))) with { w3=q } in
    let s=p6_field_mul1(a,b,s) in
    let s=p6_field_mul2(a,b,s) in
    let s=p6_field_mul3(a,b,s) in
    p6_final(p6_add1(s,s.w5),P6 { l0=4294967295,l1=-4294967296,l2=-2,l3=-1,l4=-1,l5=-1 })
private inline fn p6_field_square1(a:P6,s:P6Acc) -> P6Acc
  = let s=p6_mac2(s,a.l0,a.l4) in
    let s=p6_mac2(s,a.l1,a.l3) in
    let s=p6_mac(s,a.l2,a.l2) in
    let s=p6_sub2(s,shift_left(s.w3,32),shift_right(s.w3,32)) in
    let s=p6_sub1(s,s.w2) in
    let q=wrapping_add(s.c0,shift_left(s.c0,32)) in let s=p6_fold(s,wrapping_sub(shift_right(q,32),p6_below(shift_left(q,32),q))) with { w4=q } in
    let s=p6_mac2(s,a.l0,a.l5) in
    let s=p6_mac2(s,a.l1,a.l4) in
    let s=p6_mac2(s,a.l2,a.l3) in
    let s=p6_sub2(s,shift_left(s.w4,32),shift_right(s.w4,32)) in
    let s=p6_sub1(s,s.w3) in
    let q=wrapping_add(s.c0,shift_left(s.c0,32)) in let s=p6_fold(s,wrapping_sub(shift_right(q,32),p6_below(shift_left(q,32),q))) with { w5=q } in
    s
private inline fn p6_field_square2(a:P6,s:P6Acc) -> P6Acc
  = let s=p6_mac2(s,a.l1,a.l5) in
    let s=p6_mac2(s,a.l2,a.l4) in
    let s=p6_mac(s,a.l3,a.l3) in
