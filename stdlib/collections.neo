import "std:strings"
import "std:hashmap"
import "std:bytesmap"

type IntVector = { values: Arr i64 _ }
type BytesVector = { values: Arr OptionBytes _ }
type MapEntry = { key: Arr u8 _, value: Arr u8 _ }
sealed type StringMap = { table: BytesMap }
fn vector_empty () -> IntVector = IntVector { values = arr(i in 0..0) i }
fn vector_push (move vector: IntVector, value: i64) -> IntVector
  = IntVector { values = push(vector.values,value) }
fn vector_get (vector: IntVector, index: i64) -> OptionInt
  = let a = vector.values in if index >= 0 && index < len(a) then some_int(a[index]) else none_int()
; Sorting. Fewer than 32 values are sorted by insertion. More are sorted by
; a radix sort on only their leading bits: one pass finds the bits in which
; the values differ at all, two counting passes then put the values in order
; by the top 10, 12, 16 or 22 of those bits (5, 6, 8 or 11 bits a pass, by
; how many values there are), which is enough to tell nearly all of them apart, and a
; last pass sorts each stretch of values those bits could not tell apart: by
; insertion when it is short, by the same steps when it is long. A long
; stretch differs only in lower bits than the ones just used, so the steps
; nest at most six deep and the whole stays linear on any input.
; More than 1,048,576 values are first moved by their top 11 differing bits
; into 2,048 stretches that each fit in the cache.
; Flipping the sign bit makes the unsigned digit order the signed order. The
; masks are literals and the index ranges are stated, so the checker proves
; the bounds of every access in the inner loops but one: where a value goes
; in a pass is read from the bucket starts.
private fn vs_key(value:i64) -> i64 = bit_xor(value,-9223372036854775808)

; Sorts values[lo..hi) by insertion.
private fn vs_insertion(move values:Arr i64 n,lo:i64,hi:i64) -> Arr i64 n
  = check lo>=0 && hi<=n in
    loop(i:i64{i>=lo}=lo+1,row=values) while i<hi
      next(i+1,let held=row[i] in
        loop(j:i64{j>=lo && j<=i}=i,inner=row) while j>lo && inner[j-1]>held
          next(j-1,set(inner,j,inner[j-1]))
          yield set(inner,j,held))
      yield row

; The bits in which any two of values[lo..hi) differ.
private fn vs_spread(borrow values:Arr i64 n,lo:i64,hi:i64) -> i64
  = check lo>=0 && lo<hi && hi<=n in
    let first=values[lo] in
    loop(i:i64{i>=lo}=lo,differ=0) while i<hi
      next(i+1,bit_or(differ,bit_xor(values[i],first))) yield differ

; How many bits x takes read as unsigned: 0 for 0, 64 with the top bit set.
private fn vs_width(x:i64) -> i64
  = let a=if shift_right(x,32)!=0 then 32 else 0 in let above=shift_right(x,a) in
    let b=if shift_right(above,16)!=0 then 16 else 0 in let wide=shift_right(above,b) in
    let c=if shift_right(wide,8)!=0 then 8 else 0 in let byte=shift_right(wide,c) in
    let d=if shift_right(byte,4)!=0 then 4 else 0 in let half=shift_right(byte,d) in
    let e=if shift_right(half,2)!=0 then 2 else 0 in let pair=shift_right(half,e) in
    let f=if shift_right(pair,1)!=0 then 1 else 0 in
    if x==0 then 0 else bit_or(bit_or(bit_or(a,b),bit_or(c,d)),bit_or(e,f))+1

; A sort of m values works in one second array: the counts of the low digit,
; the counts of the high digit, then the m values on their way. Each step
; loads what it needs before it stores, so nothing is read twice.

; Turns both rows of counts into where each bucket starts: the low row's
; first right after the counts, the high row's at `base`.
private fn vs_offsets(move work:Arr i64 w,buckets:i64,base:i64) -> Arr i64 w
  = check buckets>=0 && 2*buckets<=w in
    loop(slot:i64{slot>=0}=0,low=2*buckets,high=base,row=work) while slot<buckets
      next(slot+1,wrapping_add(low,row[slot]),wrapping_add(high,row[buckets+slot]),
        set(set(row,slot,low),buckets+slot,high))
      yield row

; One set of steps per digit width. Counting: how many of values[lo..hi)
; have each digit at `shift` (low) and at `above` (high).
private fn vs_count5(borrow values:Arr i64 n,lo:i64,hi:i64,shift:i64,above:i64) -> Arr i64 _
  = check lo>=0 && lo<=hi && hi<=n in
    loop(i:i64{i>=lo}=lo,work=arr(k in 0..hi-lo+64) 0) while i<hi
      next(i+1,let key=bit_xor(values[i],-9223372036854775808) in
        let a=bit_and(shift_right(key,shift),31) in let b=32+bit_and(shift_right(key,above),31) in
        let low=work[a] in let high=work[b] in
        set(set(work,a,wrapping_add(low,1)),b,wrapping_add(high,1)))
      yield work
private fn vs_count6(borrow values:Arr i64 n,lo:i64,hi:i64,shift:i64,above:i64) -> Arr i64 _
  = check lo>=0 && lo<=hi && hi<=n in
    loop(i:i64{i>=lo}=lo,work=arr(k in 0..hi-lo+128) 0) while i<hi
      next(i+1,let key=bit_xor(values[i],-9223372036854775808) in
        let a=bit_and(shift_right(key,shift),63) in let b=64+bit_and(shift_right(key,above),63) in
        let low=work[a] in let high=work[b] in
        set(set(work,a,wrapping_add(low,1)),b,wrapping_add(high,1)))
      yield work
private fn vs_count8(borrow values:Arr i64 n,lo:i64,hi:i64,shift:i64,above:i64) -> Arr i64 _
  = check lo>=0 && lo<=hi && hi<=n in
    loop(i:i64{i>=lo}=lo,work=arr(k in 0..hi-lo+512) 0) while i<hi
      next(i+1,let key=bit_xor(values[i],-9223372036854775808) in
        let a=bit_and(shift_right(key,shift),255) in let b=256+bit_and(shift_right(key,above),255) in
        let low=work[a] in let high=work[b] in
        set(set(work,a,wrapping_add(low,1)),b,wrapping_add(high,1)))
      yield work
private fn vs_count11(borrow values:Arr i64 n,lo:i64,hi:i64,shift:i64,above:i64) -> Arr i64 _
  = check lo>=0 && lo<=hi && hi<=n in
    loop(i:i64{i>=lo}=lo,work=arr(k in 0..hi-lo+4096) 0) while i<hi
      next(i+1,let key=bit_xor(values[i],-9223372036854775808) in
        let a=bit_and(shift_right(key,shift),2047) in let b=2048+bit_and(shift_right(key,above),2047) in
        let low=work[a] in let high=work[b] in
        set(set(work,a,wrapping_add(low,1)),b,wrapping_add(high,1)))
      yield work
; Moves from[lo..hi) into the work array, each value to the next free place
; of its low digit's bucket, so equal digits keep their order.
private fn vs_out5(borrow from:Arr i64 n,lo:i64,hi:i64,move work:Arr i64 w,shift:i64) -> Arr i64 w
  = check lo>=0 && hi<=n && w>=64 in
    loop(i:i64{i>=lo}=lo,row=work) while i<hi
      next(i+1,let value=from[i] in let slot=bit_and(shift_right(bit_xor(value,-9223372036854775808),shift),31) in
        let position=row[slot] in check position>=0 && position<w in
        set(set(row,position,value),slot,wrapping_add(position,1)))
      yield row
private fn vs_out6(borrow from:Arr i64 n,lo:i64,hi:i64,move work:Arr i64 w,shift:i64) -> Arr i64 w
  = check lo>=0 && hi<=n && w>=128 in
    loop(i:i64{i>=lo}=lo,row=work) while i<hi
      next(i+1,let value=from[i] in let slot=bit_and(shift_right(bit_xor(value,-9223372036854775808),shift),63) in
        let position=row[slot] in check position>=0 && position<w in
        set(set(row,position,value),slot,wrapping_add(position,1)))
      yield row
private fn vs_out8(borrow from:Arr i64 n,lo:i64,hi:i64,move work:Arr i64 w,shift:i64) -> Arr i64 w
  = check lo>=0 && hi<=n && w>=512 in
    loop(i:i64{i>=lo}=lo,row=work) while i<hi
      next(i+1,let value=from[i] in let slot=bit_and(shift_right(bit_xor(value,-9223372036854775808),shift),255) in
        let position=row[slot] in check position>=0 && position<w in
        set(set(row,position,value),slot,wrapping_add(position,1)))
      yield row
private fn vs_out11(borrow from:Arr i64 n,lo:i64,hi:i64,move work:Arr i64 w,shift:i64) -> Arr i64 w
  = check lo>=0 && hi<=n && w>=4096 in
    loop(i:i64{i>=lo}=lo,row=work) while i<hi
      next(i+1,let value=from[i] in let slot=bit_and(shift_right(bit_xor(value,-9223372036854775808),shift),2047) in
        let position=row[slot] in check position>=0 && position<w in
        set(set(row,position,value),slot,wrapping_add(position,1)))
      yield row
; Moves the values back into `to` by their high digit. Each value is stored
; one turn after it is read (the first store, of nothing, lands where a value
; will be stored later), so a turn does all its loads before its two stores.
private fn vs_back5(move work:Arr i64 w,move to:Arr i64 n,lo:i64,shift:i64) -> Arr i64 n
  = check w>=64 && lo>=0 && lo<n in
    loop(i:i64{i>=64}=64,at:i64{at>=0 && at<n}=lo,held=0,row=work,out=to) while i<w
      next(i+1,
        let slot=32+bit_and(shift_right(bit_xor(row[i],-9223372036854775808),shift),31) in let position=row[slot] in
          check position>=0 && position<n in position,
        row[i],
        let slot=32+bit_and(shift_right(bit_xor(row[i],-9223372036854775808),shift),31) in let position=row[slot] in
          set(row,slot,wrapping_add(position,1)),
        set(out,at,held))
      yield set(out,at,held)
private fn vs_back6(move work:Arr i64 w,move to:Arr i64 n,lo:i64,shift:i64) -> Arr i64 n
  = check w>=128 && lo>=0 && lo<n in
    loop(i:i64{i>=128}=128,at:i64{at>=0 && at<n}=lo,held=0,row=work,out=to) while i<w
      next(i+1,
        let slot=64+bit_and(shift_right(bit_xor(row[i],-9223372036854775808),shift),63) in let position=row[slot] in
          check position>=0 && position<n in position,
        row[i],
        let slot=64+bit_and(shift_right(bit_xor(row[i],-9223372036854775808),shift),63) in let position=row[slot] in
          set(row,slot,wrapping_add(position,1)),
        set(out,at,held))
      yield set(out,at,held)
private fn vs_back8(move work:Arr i64 w,move to:Arr i64 n,lo:i64,shift:i64) -> Arr i64 n
  = check w>=512 && lo>=0 && lo<n in
    loop(i:i64{i>=512}=512,at:i64{at>=0 && at<n}=lo,held=0,row=work,out=to) while i<w
      next(i+1,
        let slot=256+bit_and(shift_right(bit_xor(row[i],-9223372036854775808),shift),255) in let position=row[slot] in
          check position>=0 && position<n in position,
        row[i],
        let slot=256+bit_and(shift_right(bit_xor(row[i],-9223372036854775808),shift),255) in let position=row[slot] in
          set(row,slot,wrapping_add(position,1)),
        set(out,at,held))
      yield set(out,at,held)
private fn vs_back11(move work:Arr i64 w,move to:Arr i64 n,lo:i64,shift:i64) -> Arr i64 n
  = check w>=4096 && lo>=0 && lo<n in
    loop(i:i64{i>=4096}=4096,at:i64{at>=0 && at<n}=lo,held=0,row=work,out=to) while i<w
      next(i+1,
        let slot=2048+bit_and(shift_right(bit_xor(row[i],-9223372036854775808),shift),2047) in let position=row[slot] in
          check position>=0 && position<n in position,
        row[i],
        let slot=2048+bit_and(shift_right(bit_xor(row[i],-9223372036854775808),shift),2047) in let position=row[slot] in
          set(row,slot,wrapping_add(position,1)),
        set(out,at,held))
      yield set(out,at,held)
; Sorts values[lo..hi), which differ only below bit `top`, by two digits.
private fn vs_pass5(move values:Arr i64 n,lo:i64,hi:i64,top:i64) -> Arr i64 n
  = check lo>=0 && lo<hi && hi<=n in
    let shift=if top>10 then top-10 else 0 in
    let work=vs_out5(values,lo,hi,vs_offsets(vs_count5(values,lo,hi,shift,shift+5),32,lo),shift) in
    let back=vs_back5(work,values,lo,shift+5) in
    if shift==0 then back else vs_finish(back,lo,hi,shift)
private fn vs_pass6(move values:Arr i64 n,lo:i64,hi:i64,top:i64) -> Arr i64 n
  = check lo>=0 && lo<hi && hi<=n in
    let shift=if top>12 then top-12 else 0 in
    let work=vs_out6(values,lo,hi,vs_offsets(vs_count6(values,lo,hi,shift,shift+6),64,lo),shift) in
    let back=vs_back6(work,values,lo,shift+6) in
    if shift==0 then back else vs_finish(back,lo,hi,shift)
private fn vs_pass8(move values:Arr i64 n,lo:i64,hi:i64,top:i64) -> Arr i64 n
  = check lo>=0 && lo<hi && hi<=n in
    let shift=if top>16 then top-16 else 0 in
    let work=vs_out8(values,lo,hi,vs_offsets(vs_count8(values,lo,hi,shift,shift+8),256,lo),shift) in
    let back=vs_back8(work,values,lo,shift+8) in
    if shift==0 then back else vs_finish(back,lo,hi,shift)
private fn vs_pass11(move values:Arr i64 n,lo:i64,hi:i64,top:i64) -> Arr i64 n
  = check lo>=0 && lo<hi && hi<=n in
    let shift=if top>22 then top-22 else 0 in
    let work=vs_out11(values,lo,hi,vs_offsets(vs_count11(values,lo,hi,shift,shift+11),2048,lo),shift) in
    let back=vs_back11(work,values,lo,shift+11) in
    if shift==0 then back else vs_finish(back,lo,hi,shift)
; values[lo..hi) is in order by the bits from `shift` up, so nearly sorted.
; One pass looks for a value below the one before it and puts it in place:
; by insertion when its place is fewer than 16 back, else by sorting the whole
; stretch of values that agree with it on those bits, which is that long.
private fn vs_far(move values:Arr i64 n,lo:i64,hi:i64,i:i64,shift:i64) -> Arr i64 n
  = check lo>=0 && lo<=i && i<hi && hi<=n in
    let held=values[i] in
    let first=loop(j:i64{j>=lo && j<=i}=i) while j>lo && shift_right(bit_xor(values[j-1],held),shift)==0 next(j-1) yield j in
    let after=loop(j:i64{j>i && j<=hi}=i+1) while j<hi && shift_right(bit_xor(values[j],held),shift)==0 next(j+1) yield j in
    vs_stretch(values,first,after)
private fn vs_finish(move values:Arr i64 n,lo:i64,hi:i64,shift:i64) -> Arr i64 n
  = check lo>=0 && lo<hi && hi<=n in
    loop(i:i64{i>lo}=lo+1,before:i64{before>=lo && before<i}=lo,row=values) while i<hi
      next(i+1,before+1,
        if row[before]<=row[i] then row
        else if i-16>=lo && row[i-16]>row[i] then vs_far(row,lo,hi,i,shift)
        else let held=row[i] in
          loop(j:i64{j>=lo && j<=i}=i,inner=row) while j>lo && inner[j-1]>held
            next(j-1,set(inner,j,inner[j-1]))
            yield set(inner,j,held))
      yield row

; More than 1,048,576 values: one pass moves them into a second array by
; their top 11 differing bits, and each of its 2,048 stretches is sorted there.
private fn vs_tally(borrow values:Arr i64 n,lo:i64,hi:i64,shift:i64) -> Arr i64 _
  = check lo>=0 && hi<=n in
    loop(i:i64{i>=lo}=lo,counts=arr(slot in 0..2048) 0) while i<hi
      next(i+1,let slot=bit_and(shift_right(bit_xor(values[i],-9223372036854775808),shift),2047) in let count=counts[slot] in set(counts,slot,wrapping_add(count,1)))
      yield counts
private fn vs_starts(move counts:Arr i64 c) -> Arr i64 c
  = loop(slot:i64{slot>=0}=0,at=0,row=counts) while slot<c
      next(slot+1,wrapping_add(at,row[slot]),set(row,slot,at)) yield row
private fn vs_scatter(borrow from:Arr i64 n,lo:i64,hi:i64,move to:Arr i64 m,move starts:Arr i64 b,shift:i64) -> Arr i64 m
  = check lo>=0 && hi<=n && b>=2048 in
    loop(i:i64{i>=lo}=lo,out=to,at=starts) while i<hi
      next(i+1,
        let slot=bit_and(shift_right(bit_xor(from[i],-9223372036854775808),shift),2047) in let position=at[slot] in
          check position>=0 && position<len(out) in set(out,position,from[i]),
        let slot=bit_and(shift_right(bit_xor(from[i],-9223372036854775808),shift),2047) in set(at,slot,wrapping_add(at[slot],1)))
      yield out
private fn vs_split(borrow values:Arr i64 n,lo:i64,hi:i64,top:i64) -> Arr i64 _
  = check lo>=0 && lo<hi && hi<=n in
    let shift=if top>11 then top-11 else 0 in
    let bounds=vs_starts(vs_tally(values,lo,hi,shift)) in
    check len(bounds)>=2048 in
    let moved=vs_scatter(values,lo,hi,arr(i in 0..hi-lo) 0,arr(k in 0..2048) bounds[k],shift) in
    loop(slot:i64{slot>=0}=0,row=moved) while slot<2048
      next(slot+1,let from=bounds[slot] in let to=if slot+1<2048 then bounds[slot+1] else len(row) in
        if to-from<2 then row else vs_stretch(row,from,to))
      yield row
private fn vs_restore(move values:Arr i64 n,lo:i64,borrow sorted:Arr i64 m) -> Arr i64 n
  = check lo>=0 && lo+m<=n in
    loop(i:i64{i>=0}=0,row=values) while i<m next(i+1,set(row,lo+i,sorted[i])) yield row

private fn vs_range(move values:Arr i64 n,lo:i64,hi:i64) -> Arr i64 n
  = let differ=vs_spread(values,lo,hi) in
    if differ==0 then values else
    let top=vs_width(differ) in let count=hi-lo in
    if count<128 then vs_pass5(values,lo,hi,top)
    else if count<512 then vs_pass6(values,lo,hi,top)
    else if count<4096 then vs_pass8(values,lo,hi,top)
    else if count<=1048576 then vs_pass11(values,lo,hi,top)
    else let sorted=vs_split(values,lo,hi,top) in vs_restore(values,lo,sorted)
private fn vs_stretch(move values:Arr i64 n,lo:i64,hi:i64) -> Arr i64 n
  = if hi-lo<32 then vs_insertion(values,lo,hi) else vs_range(values,lo,hi)
private fn vs_whole(move values:Arr i64 n) -> Arr i64 _
  = check n>0 in
    let differ=vs_spread(values,0,n) in
    if differ==0 then values else vs_split(values,0,n,vs_width(differ))

fn vector_sort (move vector: IntVector) -> IntVector
  = let initial = vector.values in let n = len(initial) in
    IntVector { values = if n <= 1048576 then vs_stretch(initial,0,n) else vs_whole(initial) }
; Compatibility wrappers use deterministic seeds. For untrusted keys use
; hashmap_random to obtain a kernel-seeded map with the typed Result API.
fn map_empty () -> StringMap
  = StringMap { table = bytesmap_empty(0,0) }
fn map_get (map: StringMap, key: Arr u8 n) -> OptionBytes
  = bytesmap_get(map.table,key)
fn map_put (move map: StringMap, key: Arr u8 n, value: Arr u8 m) -> StringMap
  = StringMap { table = bytesmap_put(map.table,key,value) }
