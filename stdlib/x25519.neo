import "std:sha256"

; X25519 (RFC 7748). Field elements are records of five unsigned limbs in radix
; 2^51, so field operations allocate nothing. Products are 128-bit columns of
; hi and lo words (mul_high and wrapping_mul); the unrolled products come from
; tests/generate_crypto_fields.py. Limbs below 2^53 keep every column below
; 2^113. The ladder swaps with masks and runs a fixed 255 steps: no branch or
; address depends on the scalar, and carries are compares LLVM lowers to adc.
type XFe = { f0:i64,f1:i64,f2:i64,f3:i64,f4:i64 }
type XWide = { hi:i64,lo:i64 }
type XLadder = { x2:XFe,z2:XFe,x3:XFe,z3:XFe,swap:i64 }
private fn xf_small(value:i64) -> XFe = XFe { f0=value,f1=0,f2=0,f3=0,f4=0 }
private fn xf_add(a:XFe,b:XFe) -> XFe
  = XFe { f0=wrapping_add(a.f0,b.f0),f1=wrapping_add(a.f1,b.f1),f2=wrapping_add(a.f2,b.f2),f3=wrapping_add(a.f3,b.f3),f4=wrapping_add(a.f4,b.f4) }
; a - b + 2p, nonnegative for b's limbs below 2^52 - 38.
private fn xf_sub(a:XFe,b:XFe) -> XFe
  = XFe { f0=wrapping_sub(wrapping_add(a.f0,4503599627370458),b.f0),f1=wrapping_sub(wrapping_add(a.f1,4503599627370494),b.f1),
      f2=wrapping_sub(wrapping_add(a.f2,4503599627370494),b.f2),f3=wrapping_sub(wrapping_add(a.f3,4503599627370494),b.f3),
      f4=wrapping_sub(wrapping_add(a.f4,4503599627370494),b.f4) }
; bit is 0 or 1; returns a when 0 and b when 1.
private fn xf_select(a:XFe,b:XFe,bit:i64) -> XFe
  = let m=0-bit in
    XFe { f0=bit_xor(a.f0,bit_and(bit_xor(a.f0,b.f0),m)),f1=bit_xor(a.f1,bit_and(bit_xor(a.f1,b.f1),m)),f2=bit_xor(a.f2,bit_and(bit_xor(a.f2,b.f2),m)),
      f3=bit_xor(a.f3,bit_and(bit_xor(a.f3,b.f3),m)),f4=bit_xor(a.f4,bit_and(bit_xor(a.f4,b.f4),m)) }
; Unsigned a < b: the carry out of the addition that produced a from b.
private fn xw_below(a:i64,b:i64) -> i64 = if bit_xor(a,shift_left(1,63))<bit_xor(b,shift_left(1,63)) then 1 else 0
private fn xw_product(a:i64,b:i64) -> XWide = XWide { hi=mul_high(a,b),lo=wrapping_mul(a,b) }
private fn xw_mac(w:XWide,a:i64,b:i64) -> XWide
  = let lo=wrapping_add(w.lo,wrapping_mul(a,b)) in XWide { hi=wrapping_add(wrapping_add(w.hi,mul_high(a,b)),xw_below(lo,w.lo)),lo=lo }
private fn xw_add(w:XWide,c:i64) -> XWide = let lo=wrapping_add(w.lo,c) in XWide { hi=wrapping_add(w.hi,xw_below(lo,w.lo)),lo=lo }
private fn xw_shift51(w:XWide) -> i64 = bit_or(shift_left(w.hi,13),shift_right(w.lo,51))
; generated: begin xf_reduce
private fn xf_reduce(h0:XWide,h1:XWide,h2:XWide,h3:XWide,h4:XWide) -> XFe
  = let h1=xw_add(h1,xw_shift51(h0)) in let h2=xw_add(h2,xw_shift51(h1)) in let h3=xw_add(h3,xw_shift51(h2)) in
    let h4=xw_add(h4,xw_shift51(h3)) in let r0=wrapping_add(bit_and(h0.lo,2251799813685247),wrapping_mul(xw_shift51(h4),19)) in
    XFe { f0=bit_and(r0,2251799813685247),f1=wrapping_add(bit_and(h1.lo,2251799813685247),shift_right(r0,51)),f2=bit_and(h2.lo,2251799813685247),f3=bit_and(h3.lo,2251799813685247),f4=bit_and(h4.lo,2251799813685247) }
; generated: end xf_reduce
; generated: begin xf_mul
private fn xf_mul(f:XFe,g:XFe) -> XFe
  = let g1=wrapping_mul(g.f1,19) in let g2=wrapping_mul(g.f2,19) in let g3=wrapping_mul(g.f3,19) in let g4=wrapping_mul(g.f4,19) in
    xf_reduce(xw_mac(xw_mac(xw_mac(xw_mac(xw_product(f.f0,g.f0),f.f1,g4),f.f2,g3),f.f3,g2),f.f4,g1),
      xw_mac(xw_mac(xw_mac(xw_mac(xw_product(f.f0,g.f1),f.f1,g.f0),f.f2,g4),f.f3,g3),f.f4,g2),
      xw_mac(xw_mac(xw_mac(xw_mac(xw_product(f.f0,g.f2),f.f1,g.f1),f.f2,g.f0),f.f3,g4),f.f4,g3),
      xw_mac(xw_mac(xw_mac(xw_mac(xw_product(f.f0,g.f3),f.f1,g.f2),f.f2,g.f1),f.f3,g.f0),f.f4,g4),
      xw_mac(xw_mac(xw_mac(xw_mac(xw_product(f.f0,g.f4),f.f1,g.f3),f.f2,g.f2),f.f3,g.f1),f.f4,g.f0))
; generated: end xf_mul
; generated: begin xf_sq
private fn xf_sq(f:XFe) -> XFe
  = let d0=shift_left(f.f0,1) in let d1=shift_left(f.f1,1) in let s3=wrapping_mul(f.f3,19) in let s4=wrapping_mul(f.f4,19) in let t3=wrapping_mul(f.f3,38) in let t4=wrapping_mul(f.f4,38) in
    xf_reduce(xw_mac(xw_mac(xw_product(f.f0,f.f0),f.f1,t4),f.f2,t3),
      xw_mac(xw_mac(xw_product(d0,f.f1),f.f2,t4),f.f3,s3),
      xw_mac(xw_mac(xw_product(d0,f.f2),f.f1,f.f1),f.f3,t4),
      xw_mac(xw_mac(xw_product(d0,f.f3),d1,f.f2),f.f4,s4),
      xw_mac(xw_mac(xw_product(d0,f.f4),d1,f.f3),f.f2,f.f2))
; generated: end xf_sq
private fn xf_mul_small(f:XFe,k:i64) -> XFe
  = xf_reduce(xw_product(f.f0,k),xw_product(f.f1,k),xw_product(f.f2,k),xw_product(f.f3,k),xw_product(f.f4,k))
private fn xf_sqn(f:XFe,n:i64) -> XFe = loop(i=0,f=f) while i<n next(i+1,xf_sq(f)) yield f
; z^(p-2) by ref10's addition chain: 254 squarings and 11 multiplications.
private fn xf_invert(z:XFe) -> XFe
  = let z2=xf_sq(z) in let z9=xf_mul(xf_sqn(z2,2),z) in let z11=xf_mul(z9,z2) in
    let z5=xf_mul(xf_sq(z11),z9) in let z10=xf_mul(xf_sqn(z5,5),z5) in let z20=xf_mul(xf_sqn(z10,10),z10) in
    let z40=xf_mul(xf_sqn(z20,20),z20) in let z50=xf_mul(xf_sqn(z40,10),z10) in let z100=xf_mul(xf_sqn(z50,50),z50) in
    let z200=xf_mul(xf_sqn(z100,100),z100) in let z250=xf_mul(xf_sqn(z200,50),z50) in xf_mul(xf_sqn(z250,5),z11)
; generated: begin xf_unpack
private fn xf_unpack(w0:i64,w1:i64,w2:i64,w3:i64) -> XFe
  = XFe { f0=bit_and(w0,2251799813685247),f1=bit_and(bit_or(shift_right(w0,51),shift_left(w1,13)),2251799813685247),f2=bit_and(bit_or(shift_right(w1,38),shift_left(w2,26)),2251799813685247),f3=bit_and(bit_or(shift_right(w2,25),shift_left(w3,39)),2251799813685247),f4=bit_and(shift_right(w3,12),2251799813685247) }
; generated: end xf_unpack
; One carry pass, the top carry folded back times 19 (donna-c64's fcontract_carry_full).
private fn xf_carry_full(f:XFe) -> XFe
  = let f1=wrapping_add(f.f1,shift_right(f.f0,51)) in let f2=wrapping_add(f.f2,shift_right(f1,51)) in
    let f3=wrapping_add(f.f3,shift_right(f2,51)) in let f4=wrapping_add(f.f4,shift_right(f3,51)) in
    XFe { f0=wrapping_add(bit_and(f.f0,2251799813685247),wrapping_mul(shift_right(f4,51),19)),f1=bit_and(f1,2251799813685247),
      f2=bit_and(f2,2251799813685247),f3=bit_and(f3,2251799813685247),f4=bit_and(f4,2251799813685247) }
; The unique representative below 2^255-19 (donna-c64's fcontract): after two carry
; passes the value v is below 2^255; v+19 carried is (v mod p)+19, and adding
; 2^255-19 then dropping bit 255 leaves v mod p.
private fn xf_canonical(f:XFe) -> XFe
  = let t=xf_carry_full(xf_carry_full(f)) in let t=xf_carry_full(t with { f0=wrapping_add(t.f0,19) }) in
    let f0=wrapping_add(t.f0,2251799813685229) in let f1=wrapping_add(wrapping_add(t.f1,2251799813685247),shift_right(f0,51)) in
    let f2=wrapping_add(wrapping_add(t.f2,2251799813685247),shift_right(f1,51)) in let f3=wrapping_add(wrapping_add(t.f3,2251799813685247),shift_right(f2,51)) in
    let f4=wrapping_add(wrapping_add(t.f4,2251799813685247),shift_right(f3,51)) in
    XFe { f0=bit_and(f0,2251799813685247),f1=bit_and(f1,2251799813685247),f2=bit_and(f2,2251799813685247),f3=bit_and(f3,2251799813685247),f4=bit_and(f4,2251799813685247) }
; generated: begin xf_words
private fn xf_bytes(h:XFe) -> Arr u8 _
  = let out=arr(i in 0..32) u8(0) in
    let out=byte_write_le(out,0,bit_or(h.f0,shift_left(h.f1,51)),8) in
    let out=byte_write_le(out,8,bit_or(shift_right(h.f1,13),shift_left(h.f2,38)),8) in
    let out=byte_write_le(out,16,bit_or(shift_right(h.f2,26),shift_left(h.f3,25)),8) in
    let out=byte_write_le(out,24,bit_or(shift_right(h.f3,39),shift_left(h.f4,12)),8) in out
; generated: end xf_words
; One ladder step (RFC 7748 section 5), after swapping in the next scalar bit.
private fn xf_step(state:XLadder,x1:XFe,bit:i64) -> XLadder
  = let swap=bit_xor(state.swap,bit) in
    let x2=xf_select(state.x2,state.x3,swap) in let x3=xf_select(state.x3,state.x2,swap) in
    let z2=xf_select(state.z2,state.z3,swap) in let z3=xf_select(state.z3,state.z2,swap) in
    let a=xf_add(x2,z2) in let aa=xf_sq(a) in let b=xf_sub(x2,z2) in let bb=xf_sq(b) in let e=xf_sub(aa,bb) in
    let c=xf_add(x3,z3) in let d=xf_sub(x3,z3) in let da=xf_mul(d,a) in let cb=xf_mul(c,b) in
    XLadder { x3=xf_sq(xf_add(da,cb)),z3=xf_mul(x1,xf_sq(xf_sub(da,cb))),x2=xf_mul(aa,bb),
      z2=xf_mul(e,xf_add(aa,xf_mul_small(e,121665))),swap=bit }
private fn xf_scalar(key:Arr u8 n,point:Arr u8 m) -> Arr u8 _
  = check n==32 && m==32 in
    let k0=bit_and(byte_read_le(key,0,8),-8) in let k1=byte_read_le(key,8,8) in let k2=byte_read_le(key,16,8) in
    let k3=bit_or(bit_and(byte_read_le(key,24,8),9223372036854775807),4611686018427387904) in
    let x1=xf_unpack(byte_read_le(point,0,8),byte_read_le(point,8,8),byte_read_le(point,16,8),bit_and(byte_read_le(point,24,8),9223372036854775807)) in
    let initial=XLadder { x2=xf_small(1),z2=xf_small(0),x3=x1,z3=xf_small(1),swap=0 } in
    let state=loop(t=254,state=initial) while t>=0
      next(t-1,let word=if t<64 then k0 else if t<128 then k1 else if t<192 then k2 else k3 in
        xf_step(state,x1,bit_and(shift_right(word,bit_and(t,63)),1))) yield state in
    let x2=xf_select(state.x2,state.x3,state.swap) in let z2=xf_select(state.z2,state.z3,state.swap) in
    xf_bytes(xf_canonical(xf_mul(x2,xf_invert(z2))))
fn x25519(key:Arr u8 n,point:Arr u8 m) -> BytesResult
  = if n!=32 || m!=32 then bytes_error(22,"X25519 keys require 32 bytes",0) else
    let result=xf_scalar(key,point) in
    let nonzero=bit_or(bit_or(byte_read_le(result,0,8),byte_read_le(result,8,8)),bit_or(byte_read_le(result,16,8),byte_read_le(result,24,8)))!=0 in
    if !nonzero then bytes_error(74,"X25519 low-order point",0) else bytes_ok(result)
; Fixed-base key generation (ref10's ge_scalarmult_base, regrouped): k*B on
; edwards25519, where B is the point with u = 9, then u = (Z+Y)/(Z-Y). The
; clamped scalar becomes 64 signed radix-16 digits e_i in -8..8. Row j of
; xb_row holds 1..8 times 16^(4j)*B as (y+x, y-x, 2dxy); pass o = 3..0 adds
; e_(4j+o) times row j's point for every j, and passes are separated by four
; doublings. A digit picks its multiple by reading all eight entries under
; masks and negates it under a mask: no branch or address depends on the key.
; Multiplication inputs stay below 3*2^52, which keeps xf_reduce's columns below
; 2^114, and xf_sub only ever subtracts a product (limbs below 2^51+2^13).
type XNiels = { yp:XFe,ym:XFe,t2d:XFe }
; Extended (x = X/Z, y = Y/Z, xy = T/Z) or, straight out of an addition or a
; doubling, completed ((X:Z),(Y:T)).
type XPoint = { x:XFe,y:XFe,z:XFe,t:XFe }
type XDigits = { carry:i64,digits:Arr i64 _ }
; generated: begin xb_table
