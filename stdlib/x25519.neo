    let x2=xf_select(state.x2,state.x3,swap) in let x3=xf_select(state.x3,state.x2,swap) in
    let z2=xf_select(state.z2,state.z3,swap) in let z3=xf_select(state.z3,state.z2,swap) in
    let a=xf_add(x2,z2) in let aa=xf_sq(a) in let b=xf_sub(x2,z2) in let bb=xf_sq(b) in let e=xf_sub(aa,bb) in
    let c=xf_add(x3,z3) in let d=xf_sub(x3,z3) in let da=xf_mul(d,a) in let cb=xf_mul(c,b) in
    XLadder { x3=xf_sq(xf_add(da,cb)),z3=xf_mul(x1,xf_sq(xf_sub(da,cb))),x2=xf_mul(aa,bb),
      z2=xf_mul(e,xf_add(aa,xf_mul_small(e,121665))),swap=bit }
private fn xf_scalar(key:Arr u8 n,point:Arr u8 m) -> Arr u8 _
  = check n==32 && m==32 in
    let k0=bit_and(byte_read_le(key,0,8),-8) in let k1=byte_read_le(key,8,8) in let k2=byte_read_le(key,16,8) in
    let k3=bit_or(bit_and(byte_read_le(key,24,8),9223372036854775807),4611686018427387904) in
    let x1=xf_unpack(byte_read_le(point,0,8),byte_read_le(point,8,8),byte_read_le(point,16,8),bit_and(byte_read_le(point,24,8),9223372036854775807)) in
    let initial=XLadder { x2=xf_small(1),z2=xf_small(0),x3=x1,z3=xf_small(1),swap=0 } in
    let state=loop(t=254,state=initial) while t>=0
      next(t-1,let word=if t<64 then k0 else if t<128 then k1 else if t<192 then k2 else k3 in
        xf_step(state,x1,bit_and(shift_right(word,bit_and(t,63)),1))) yield state in
    let x2=xf_select(state.x2,state.x3,state.swap) in let z2=xf_select(state.z2,state.z3,state.swap) in
    xf_bytes(xf_canonical(xf_mul(x2,xf_invert(z2))))
fn x25519(key:Arr u8 n,point:Arr u8 m) -> BytesResult
  = if n!=32 || m!=32 then bytes_error(22,"X25519 keys require 32 bytes",0) else
    let result=xf_scalar(key,point) in
    let nonzero=bit_or(bit_or(byte_read_le(result,0,8),byte_read_le(result,8,8)),bit_or(byte_read_le(result,16,8),byte_read_le(result,24,8)))!=0 in
    if !nonzero then bytes_error(74,"X25519 low-order point",0) else bytes_ok(result)
fn x25519_public(key:Arr u8 n) -> BytesResult
  = x25519(key,arr(i in 0..32) u8(if i==0 then 9 else 0))
