    let t=loop(k=0,t=XNiels { yp=xf_small(1),ym=xf_small(1),t2d=xf_small(0) }) while k<8
      next(k+1,xn_select(t,xb_entry(row,k),shift_right(wrapping_sub(bit_xor(size,k+1),1),63))) yield t in
    XNiels { yp=xf_select(t.yp,t.ym,negative),ym=xf_select(t.ym,t.yp,negative),t2d=xf_select(t.t2d,xf_sub(xf_small(0),t.t2d),negative) }
; p + q (ge_madd), p extended, completed result.
private fn xb_madd(p:XPoint,q:XNiels) -> XPoint
  = let a=xf_mul(xf_add(p.y,p.x),q.yp) in let b=xf_mul(xf_sub(p.y,p.x),q.ym) in let c=xf_mul(q.t2d,p.t) in let d=xf_add(p.z,p.z) in
    XPoint { x=xf_sub(a,b),y=xf_add(a,b),z=xf_add(d,c),t=xf_sub(d,c) }
; 2p (ge_p2_dbl), p's T unused, completed result. ref10's X-Y-Z and 2Z^2-(Y^2-X^2)
; are regrouped as two subtractions of products each.
private fn xb_double(p:XPoint) -> XPoint
  = let xx=xf_sq(p.x) in let yy=xf_sq(p.y) in let zz=xf_sq(p.z) in let s=xf_sq(xf_add(p.x,p.y)) in
    XPoint { x=xf_sub(xf_sub(s,yy),xx),y=xf_add(yy,xx),z=xf_sub(yy,xx),t=xf_sub(xf_add(xf_add(zz,zz),xx),yy) }
private fn xb_extended(r:XPoint) -> XPoint = XPoint { x=xf_mul(r.x,r.t),y=xf_mul(r.y,r.z),z=xf_mul(r.z,r.t),t=xf_mul(r.x,r.y) }
private fn xb_times16(p:XPoint) -> XPoint = xb_extended(xb_double(xb_extended(xb_double(xb_extended(xb_double(xb_extended(xb_double(p))))))))
private fn xb_recode(move state:XDigits,i:i64,nibble:i64) -> XDigits
  = let e=wrapping_add(nibble,state.carry) in let carry=if i==63 then 0 else shift_right(wrapping_add(e,8),4) in
    let digits=state.digits in check i>=0 && i<len(digits) in XDigits { carry=carry,digits=set(digits,i,wrapping_sub(e,shift_left(carry,4))) }
private fn xb_pass(p:XPoint,digits:Arr i64 n,o:i64) -> XPoint
  = loop(j=0,q=p) while j<16 next(j+1,let at=4*j+o in check at>=0 && at<n in xb_extended(xb_madd(q,xb_lookup(xb_row(j),digits[at])))) yield q
private fn xb_scalar(key:Arr u8 n) -> Arr u8 _
  = check n==32 in
    let k0=bit_and(byte_read_le(key,0,8),-8) in let k1=byte_read_le(key,8,8) in let k2=byte_read_le(key,16,8) in
    let k3=bit_or(bit_and(byte_read_le(key,24,8),9223372036854775807),4611686018427387904) in
    let recoded=loop(i=0,state=XDigits { carry=0,digits=arr(j in 0..64) 0 }) while i<64
      next(i+1,xb_recode(state,i,bit_and(shift_right(if i<16 then k0 else if i<32 then k1 else if i<48 then k2 else k3,i%16*4),15))) yield state in
    let digits=recoded.digits in check len(digits)==64 in
    let identity=XPoint { x=xf_small(0),y=xf_small(1),z=xf_small(1),t=xf_small(0) } in
    let p=loop(o=3,p=identity) while o>=0 next(o-1,xb_pass(if o==3 then p else xb_times16(p),digits,o)) yield p in
    xf_bytes(xf_canonical(xf_mul(xf_add(p.z,p.y),xf_invert(xf_sub(p.z,p.y)))))
; The same as x25519(key, 9): k*B is never the identity for a clamped k (a multiple
; of 8 below 2^255, while B's order is a prime near 2^252), so u is defined.
fn x25519_public(key:Arr u8 n) -> BytesResult
  = if n!=32 then bytes_error(22,"X25519 keys require 32 bytes",0) else bytes_ok(xb_scalar(key))
