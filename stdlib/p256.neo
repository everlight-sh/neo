    let t=wrapping_add(a.l1,b.l1) in let s1=wrapping_add(t,c) in let c=bit_or(p4_below(t,a.l1),p4_below(s1,t)) in
    let t=wrapping_add(a.l2,b.l2) in let s2=wrapping_add(t,c) in let c=bit_or(p4_below(t,a.l2),p4_below(s2,t)) in
    let t=wrapping_add(a.l3,b.l3) in let s3=wrapping_add(t,c) in let c=bit_or(p4_below(t,a.l3),p4_below(s3,t)) in
    P4Carry { value=P4 { l0=s0,l1=s1,l2=s2,l3=s3 },carry=c }
private fn p4_sub_borrow(a:P4,b:P4) -> P4Carry
  = let d0=wrapping_sub(a.l0,b.l0) in let c=p4_below(a.l0,b.l0) in
    let t=wrapping_sub(a.l1,b.l1) in let d1=wrapping_sub(t,c) in let c=bit_or(p4_below(a.l1,b.l1),p4_below(t,c)) in
    let t=wrapping_sub(a.l2,b.l2) in let d2=wrapping_sub(t,c) in let c=bit_or(p4_below(a.l2,b.l2),p4_below(t,c)) in
    let t=wrapping_sub(a.l3,b.l3) in let d3=wrapping_sub(t,c) in let c=bit_or(p4_below(a.l3,b.l3),p4_below(t,c)) in
    P4Carry { value=P4 { l0=d0,l1=d1,l2=d2,l3=d3 },carry=c }
