; bit is 0 or 1; returns a when 0 and b when 1, without branching.
private fn p4_select(a:P4,b:P4,bit:i64) -> P4
  = let m=0-bit in
    P4 { l0=bit_xor(a.l0,bit_and(bit_xor(a.l0,b.l0),m)),l1=bit_xor(a.l1,bit_and(bit_xor(a.l1,b.l1),m)),
      l2=bit_xor(a.l2,bit_and(bit_xor(a.l2,b.l2),m)),l3=bit_xor(a.l3,bit_and(bit_xor(a.l3,b.l3),m)) }
private fn p4_mask(a:P4,m:i64) -> P4 = P4 { l0=bit_and(a.l0,m),l1=bit_and(a.l1,m),l2=bit_and(a.l2,m),l3=bit_and(a.l3,m) }
; t + top*2^256, below twice m, reduced by one masked subtraction.
private fn p4_final(t:P4,top:i64,m:P4) -> P4
  = let d=p4_sub_borrow(t,m) in p4_select(t,d.value,bit_or(top,bit_xor(d.carry,1)))
