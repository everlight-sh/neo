  = check n==32 in p9_unpack(byte_swap64(byte_read_le(bytes,24,8)),byte_swap64(byte_read_le(bytes,16,8)),
      byte_swap64(byte_read_le(bytes,8,8)),byte_swap64(byte_read_le(bytes,0,8)))
private fn p256_mod(order:bool) -> P256Mod = if order then p9_order() else p9_field()
private fn p256_add(a:P9,b:P9,modulus:P9) -> P9
  = let total=p9_add_raw(a,b) in let less=p9_sub_raw(total,p9_add_raw(modulus,modulus)) in p256_select(less,total,p9_negative(less))
private fn p256_sub(a:P9,b:P9,modulus:P9) -> P9
  = let difference=p9_sub_raw(a,b) in p256_select(difference,p9_add_raw(difference,p9_add_raw(modulus,modulus)),p9_negative(difference))
; The prime is the only modulus whose Montgomery digit inverse is 1 (the order's
; is not); its products use the specialised p9_field_* forms. The choice is
; public, so the branch leaks nothing.
private fn p256_multiply(a:P9,b:P9,mod:P256Mod) -> P9 = if mod.inverse==1 then p9_field_mont(a,b) else p9_mont(a,b,mod.modulus,mod.inverse)
private fn p256_square(a:P9,mod:P256Mod) -> P9 = if mod.inverse==1 then p9_field_square(a) else p9_mont(a,a,mod.modulus,mod.inverse)
private fn p256_montgomery(value:P9,mod:P256Mod) -> P9 = p9_mont(value,mod.r2,mod.modulus,mod.inverse)
private fn p256_normal(value:P9,mod:P256Mod) -> P9 = p256_reduce(p9_mont(value,p9_small(1),mod.modulus,mod.inverse),mod.modulus)
private fn p9_limb(a:P9,index:i64) -> i64
  = if index==0 then a.l0 else if index==1 then a.l1 else if index==2 then a.l2 else if index==3 then a.l3 else
    if index==4 then a.l4 else if index==5 then a.l5 else if index==6 then a.l6 else if index==7 then a.l7 else a.l8
private fn p9_bit(a:P9,index:i64) -> i64 = bit_and(shift_right(p9_limb(a,index/29),index%29),1)
; value^(modulus-2) in Montgomery form. The exponent is public, so the
; sequence of operations does not depend on value.
private fn p256_inverse(value:P9,mod:P256Mod) -> P9
  = let exponent=p9_sub_raw(mod.modulus,p9_small(2)) in
    loop(i=255,out=mod.one) while i>=0 next(i-1,
      let square=p256_square(out,mod) in if p9_bit(exponent,i)==1 then p256_multiply(square,value,mod) else square) yield out

sealed type P256Point = { x:P9,y:P9,z:P9 }
private fn p256_infinity(mod:P256Mod) -> P256Point = P256Point { x=p9_zero(),y=mod.one,z=p9_zero() }
private fn p256_point_select(a:P256Point,b:P256Point,bit:i64) -> P256Point
  = P256Point { x=p256_select(a.x,b.x,bit),y=p256_select(a.y,b.y,bit),z=p256_select(a.z,b.z,bit) }
; Point formulas, always over the field. neoc force-inlines small pure
; functions: these stay inline in the two hot loops (p256_scalar and
; p256_combination), which are kept out of line themselves, while the table
; builds and the exceptional cases call the `_call` copies. Inlined at every
; call site they made clang take minutes on TLS programs; called from the loops
; they cost 15%. `cold` is how neoc spells noinline.
private fn p256_double(a:P256Point) -> P256Point
  = let mod=p9_field() in let p=mod.modulus in
    let delta=p256_square(a.z,mod) in let gamma=p256_square(a.y,mod) in let beta=p256_multiply(a.x,gamma,mod) in
    let alpha=p256_multiply(p256_sub(a.x,delta,p),p256_add(a.x,delta,p),mod) in let alpha=p256_add(p256_add(alpha,alpha,p),alpha,p) in
    let beta2=p256_add(beta,beta,p) in let beta4=p256_add(beta2,beta2,p) in let beta8=p256_add(beta4,beta4,p) in
    let x=p256_sub(p256_square(alpha,mod),beta8,p) in
    let yz=p256_add(a.y,a.z,p) in let z=p256_sub(p256_sub(p256_square(yz,mod),gamma,p),delta,p) in
    let gamma2=p256_square(gamma,mod) in let gamma2=p256_add(gamma2,gamma2,p) in let gamma2=p256_add(gamma2,gamma2,p) in let gamma2=p256_add(gamma2,gamma2,p) in
    let y=p256_sub(p256_multiply(alpha,p256_sub(beta4,x,p),mod),gamma2,p) in P256Point { x=x,y=y,z=z }
private fn p256_zero_value(a:P9,mod:P256Mod) -> i64 = p256_is_zero(p256_reduce(a,mod.modulus))
; The multiples 0P..15P of a point for the fixed window (0P is infinity).
type P256Window = { p0:P256Point,p1:P256Point,p2:P256Point,p3:P256Point,p4:P256Point,p5:P256Point,p6:P256Point,p7:P256Point,
  p8:P256Point,p9:P256Point,p10:P256Point,p11:P256Point,p12:P256Point,p13:P256Point,p14:P256Point,p15:P256Point }
; Sum of a and b where either may be infinity (z = 0) but a != +-b, so the
; doubling case never arises.
private fn p256_add_distinct(a:P256Point,b:P256Point) -> P256Point
  = let mod=p9_field() in let p=mod.modulus in let zz1=p256_square(a.z,mod) in let zz2=p256_square(b.z,mod) in
    let u1=p256_multiply(a.x,zz2,mod) in let u2=p256_multiply(b.x,zz1,mod) in
    let s1=p256_multiply(p256_multiply(a.y,b.z,mod),zz2,mod) in let s2=p256_multiply(p256_multiply(b.y,a.z,mod),zz1,mod) in
    let h=p256_sub(u2,u1,p) in let r=p256_sub(s2,s1,p) in let hh=p256_square(h,mod) in let hhh=p256_multiply(h,hh,mod) in let v=p256_multiply(u1,hh,mod) in
    let x=p256_sub(p256_sub(p256_square(r,mod),hhh,p),p256_add(v,v,p),p) in
    let y=p256_sub(p256_multiply(r,p256_sub(v,x,p),mod),p256_multiply(s1,hhh,mod),p) in let z=p256_multiply(p256_multiply(h,a.z,mod),b.z,mod) in
    let combined=p256_point_select(P256Point { x=x,y=y,z=z },b,p256_zero_value(a.z,mod)) in p256_point_select(combined,a,p256_zero_value(b.z,mod))
; Built from the public point alone: kP for k>=3 adds P to (k-1)P, never +-P.
private fn p256_window(point:P256Point,mod:P256Mod) -> P256Window
  = let p2=p256_double_call(point) in let p3=p256_add_distinct_call(p2,point) in let p4=p256_add_distinct_call(p3,point) in
    let p5=p256_add_distinct_call(p4,point) in let p6=p256_add_distinct_call(p5,point) in let p7=p256_add_distinct_call(p6,point) in
    let p8=p256_add_distinct_call(p7,point) in let p9=p256_add_distinct_call(p8,point) in let p10=p256_add_distinct_call(p9,point) in
    let p11=p256_add_distinct_call(p10,point) in let p12=p256_add_distinct_call(p11,point) in let p13=p256_add_distinct_call(p12,point) in
    let p14=p256_add_distinct_call(p13,point) in let p15=p256_add_distinct_call(p14,point) in
    P256Window { p0=p256_infinity(mod),p1=point,p2=p2,p3=p3,p4=p4,p5=p5,p6=p6,p7=p7,p8=p8,p9=p9,p10=p10,p11=p11,p12=p12,p13=p13,p14=p14,p15=p15 }
; 1 when the secret digit equals the public index k, else 0, without branching.
private fn p256_digit_is(digit:i64,k:i64) -> i64 = let x=bit_xor(digit,k) in 1-shift_right(bit_or(x,wrapping_sub(0,x)),63)
; Every entry is read; the digit only drives the masks.
private fn p256_window_pick(t:P256Window,digit:i64) -> P256Point
  = let r=p256_point_select(t.p0,t.p1,p256_digit_is(digit,1)) in let r=p256_point_select(r,t.p2,p256_digit_is(digit,2)) in
    let r=p256_point_select(r,t.p3,p256_digit_is(digit,3)) in let r=p256_point_select(r,t.p4,p256_digit_is(digit,4)) in
    let r=p256_point_select(r,t.p5,p256_digit_is(digit,5)) in let r=p256_point_select(r,t.p6,p256_digit_is(digit,6)) in
    let r=p256_point_select(r,t.p7,p256_digit_is(digit,7)) in let r=p256_point_select(r,t.p8,p256_digit_is(digit,8)) in
    let r=p256_point_select(r,t.p9,p256_digit_is(digit,9)) in let r=p256_point_select(r,t.p10,p256_digit_is(digit,10)) in
    let r=p256_point_select(r,t.p11,p256_digit_is(digit,11)) in let r=p256_point_select(r,t.p12,p256_digit_is(digit,12)) in
    let r=p256_point_select(r,t.p13,p256_digit_is(digit,13)) in let r=p256_point_select(r,t.p14,p256_digit_is(digit,14)) in
    p256_point_select(r,t.p15,p256_digit_is(digit,15))
private fn p256_digit(scalar:P9,window:i64) -> i64
  = let at=window*4 in p9_bit(scalar,at)+2*p9_bit(scalar,at+1)+4*p9_bit(scalar,at+2)+8*p9_bit(scalar,at+3)
; Fixed 4-bit window from the top: 64 rounds of four doublings and one masked
; table add, the same for every scalar. For a scalar in [1,n-1] and a point of
; order n, the running sum 16a·P never equals +-d·P for a digit d in 1..15
; (that needs 16a = d or 16a + d = n), so additions never meet the doubling case.
private cold fn p256_scalar(point:P256Point,scalar:P9,mod:P256Mod) -> P256Point
  = let t=p256_window(point,mod) in
    loop(i=63,out=p256_infinity(mod)) while i>=0 next(i-1,
      let shifted=loop(j=0,acc=out) while j<4 next(j+1,p256_double(acc)) yield acc in
      p256_add_distinct(shifted,p256_window_pick(t,p256_digit(scalar,i)))) yield out
private fn p256_affine(point:P256Point,mod:P256Mod) -> P256Point
  = let inverse=p256_inverse(point.z,mod) in let square=p256_square(inverse,mod) in
    P256Point { x=p256_multiply(point.x,square,mod),y=p256_multiply(p256_multiply(point.y,square,mod),inverse,mod),z=mod.one }
private fn p256_generator(mod:P256Mod) -> P256Point
  = let g=p9_generator(0) in P256Point { x=g.x,y=g.y,z=mod.one }
private fn p256_scalar_valid(value:P9,mod:P256Mod) -> bool = p256_is_zero(value)==0 && p9_negative(p9_sub_raw(value,mod.modulus))==1
private fn p256_point_decode(bytes:Arr u8 n,mod:P256Mod) -> P256Point
  = check n==65 in P256Point { x=p256_montgomery(p256_words(str_slice(bytes,1,33)),mod),y=p256_montgomery(p256_words(str_slice(bytes,33,65)),mod),z=mod.one }
private fn p256_point_valid(bytes:Arr u8 n,mod:P256Mod) -> bool
  = if n!=65 || str_byte(bytes,0)!=4 then false else
    let x=p256_words(str_slice(bytes,1,33)) in let y=p256_words(str_slice(bytes,33,65)) in
    if p9_negative(p9_sub_raw(x,mod.modulus))!=1 || p9_negative(p9_sub_raw(y,mod.modulus))!=1 then false else
    let point=p256_point_decode(bytes,mod) in let p=mod.modulus in
    let x3=p256_multiply(p256_square(point.x,mod),point.x,mod) in let triple=p256_add(p256_add(point.x,point.x,p),point.x,p) in
    p256_zero_value(p256_sub(p256_square(point.y,mod),p256_add(p256_sub(x3,triple,p),p9_curve_b(),p),p),mod)==1
private fn p256_encode(point:P256Point,mod:P256Mod) -> Arr u8 _
  = let normal=p256_affine(point,mod) in concat("\x04",p9_bytes(p256_normal(normal.x,mod)),p9_bytes(p256_normal(normal.y,mod)))
private fn p256_bytes(value:P9) -> Arr u8 _ = p9_bytes(value)
fn p256_public(secret:Arr u8 n) -> BytesResult
  = if n!=32 then bytes_error(22,"P-256 private key requires 32 bytes",0) else
    let scalar=p256_words(secret) in if !p256_scalar_valid(scalar,p256_mod(true)) then bytes_error(22,"invalid P-256 private scalar",0) else
    let mod=p256_mod(false) in bytes_ok(p256_encode(p256_scalar(p256_generator(mod),scalar,mod),mod))
fn p256_public_valid(public:Arr u8 n) -> bool = p256_point_valid(public,p256_mod(false))
fn p256_ecdh(secret:Arr u8 n,public:Arr u8 m) -> BytesResult
  = if n!=32 then bytes_error(22,"P-256 private key requires 32 bytes",0) else
    let scalar=p256_words(secret) in let mod=p256_mod(false) in
    if !p256_scalar_valid(scalar,p256_mod(true)) || !p256_point_valid(public,mod) then bytes_error(22,"invalid P-256 ECDH key",0) else
    let shared=p256_scalar(p256_point_decode(public,mod),scalar,mod) in
    if p256_zero_value(shared.z,mod)==1 then bytes_error(74,"P-256 ECDH infinity",0) else bytes_ok(p9_bytes(p256_normal(p256_affine(shared,mod).x,mod)))

; Verification (public inputs only). Mixed addition of an affine point
; (madd-2007-bl) and general addition (add-2007-bl) branch on the exceptional
; cases; a result at infinity has z = 0.
private fn p256_negate(a:P9,mod:P256Mod) -> P9 = p256_sub(p9_zero(),a,mod.modulus)
private fn p256_add_affine(a:P256Point,b:P9Affine) -> P256Point
  = let mod=p9_field() in let p=mod.modulus in let z1z1=p256_square(a.z,mod) in
    let u2=p256_multiply(b.x,z1z1,mod) in let s2=p256_multiply(b.y,p256_multiply(a.z,z1z1,mod),mod) in
    let h=p256_sub(u2,a.x,p) in let r=p256_sub(s2,a.y,p) in
    if p256_zero_value(h,mod)==1 then
      (if p256_zero_value(r,mod)==1 then p256_double_call(P256Point { x=b.x,y=b.y,z=mod.one }) else P256Point { x=mod.one,y=mod.one,z=p9_zero() }) else
    let hh=p256_square(h,mod) in let i=p256_add(p256_add(hh,hh,p),p256_add(hh,hh,p),p) in let j=p256_multiply(h,i,mod) in
    let r=p256_add(r,r,p) in let v=p256_multiply(a.x,i,mod) in
    let x=p256_sub(p256_sub(p256_square(r,mod),j,p),p256_add(v,v,p),p) in
    let yj=p256_multiply(a.y,j,mod) in let y=p256_sub(p256_multiply(r,p256_sub(v,x,p),mod),p256_add(yj,yj,p),p) in
    let z=p256_sub(p256_sub(p256_square(p256_add(a.z,h,p),mod),z1z1,p),hh,p) in P256Point { x=x,y=y,z=z }
private fn p256_add_general(a:P256Point,b:P256Point) -> P256Point
  = let mod=p9_field() in let p=mod.modulus in let z1z1=p256_square(a.z,mod) in let z2z2=p256_square(b.z,mod) in
    let u1=p256_multiply(a.x,z2z2,mod) in let u2=p256_multiply(b.x,z1z1,mod) in
    let s1=p256_multiply(a.y,p256_multiply(b.z,z2z2,mod),mod) in let s2=p256_multiply(b.y,p256_multiply(a.z,z1z1,mod),mod) in
    let h=p256_sub(u2,u1,p) in let r=p256_sub(s2,s1,p) in
    if p256_zero_value(h,mod)==1 then
      (if p256_zero_value(r,mod)==1 then p256_double_call(b) else P256Point { x=mod.one,y=mod.one,z=p9_zero() }) else
    let h2=p256_add(h,h,p) in let i=p256_square(h2,mod) in let j=p256_multiply(h,i,mod) in
    let r=p256_add(r,r,p) in let v=p256_multiply(u1,i,mod) in
    let x=p256_sub(p256_sub(p256_square(r,mod),j,p),p256_add(v,v,p),p) in
    let sj=p256_multiply(s1,j,mod) in let y=p256_sub(p256_multiply(r,p256_sub(v,x,p),mod),p256_add(sj,sj,p),p) in
    let zz=p256_sub(p256_sub(p256_square(p256_add(a.z,b.z,p),mod),z1z1,p),z2z2,p) in
    P256Point { x=x,y=y,z=p256_multiply(zz,h,mod) }
private cold fn p256_double_call(a:P256Point) -> P256Point = p256_double(a)
private cold fn p256_add_distinct_call(a:P256Point,b:P256Point) -> P256Point = p256_add_distinct(a,b)
private cold fn p256_add_general_call(a:P256Point,b:P256Point) -> P256Point = p256_add_general(a,b)
; Width-5 NAF digits of a scalar below 2^256: odd digits in -15..15, 257 positions.
private fn p9_shift1(a:P9) -> P9
  = P9 { l0=bit_or(shift_right(a.l0,1),shift_left(bit_and(a.l1,1),28)),l1=bit_or(shift_right(a.l1,1),shift_left(bit_and(a.l2,1),28)),
      l2=bit_or(shift_right(a.l2,1),shift_left(bit_and(a.l3,1),28)),l3=bit_or(shift_right(a.l3,1),shift_left(bit_and(a.l4,1),28)),
      l4=bit_or(shift_right(a.l4,1),shift_left(bit_and(a.l5,1),28)),l5=bit_or(shift_right(a.l5,1),shift_left(bit_and(a.l6,1),28)),
      l6=bit_or(shift_right(a.l6,1),shift_left(bit_and(a.l7,1),28)),l7=bit_or(shift_right(a.l7,1),shift_left(bit_and(a.l8,1),28)),l8=shift_right(a.l8,1) }
type P256Naf = { k:P9,digits:Arr i64 _ }
private fn p256_naf_step(move state:P256Naf,i:i64) -> P256Naf
  = let k=state.k in let low=bit_and(k.l0,31) in let digit=if bit_and(low,1)==0 then 0 else if low>=16 then low-32 else low in
    let k=if digit==0 then k else p9_sub_raw(k,p9_small(digit)) in let digits=state.digits in
    check i>=0 && i<len(digits) in P256Naf { k=p9_shift1(k),digits=set(digits,i,digit) }
private fn p256_naf(scalar:P9) -> Arr i64 _
  = let state=loop(i=0,state=P256Naf { k=scalar,digits=arr(j in 0..257) 0 }) while i<257 next(i+1,p256_naf_step(state,i)) yield state in state.digits
type P256Odd = { p1:P256Point,p3:P256Point,p5:P256Point,p7:P256Point,p9:P256Point,p11:P256Point,p13:P256Point,p15:P256Point }
private fn p256_odd_multiples(point:P256Point,mod:P256Mod) -> P256Odd
  = let twice=p256_double_call(point) in let p3=p256_add_general_call(twice,point) in let p5=p256_add_general_call(twice,p3) in
    let p7=p256_add_general_call(twice,p5) in let p9=p256_add_general_call(twice,p7) in let p11=p256_add_general_call(twice,p9) in
    let p13=p256_add_general_call(twice,p11) in
    P256Odd { p1=point,p3=p3,p5=p5,p7=p7,p9=p9,p11=p11,p13=p13,p15=p256_add_general_call(twice,p13) }
private fn p256_odd_pick(table:P256Odd,index:i64) -> P256Point
  = if index==0 then table.p1 else if index==1 then table.p3 else if index==2 then table.p5 else if index==3 then table.p7 else
    if index==4 then table.p9 else if index==5 then table.p11 else if index==6 then table.p13 else table.p15
type P256Sum = { point:P256Point,empty:bool }
private fn p256_sum_add(total:P256Sum,b:P256Point,mod:P256Mod) -> P256Sum
  = if total.empty then P256Sum { point=b,empty=false } else
    let added=p256_add_general(total.point,b) in P256Sum { point=added,empty=p256_zero_value(added.z,mod)==1 }
private fn p256_sum_affine(total:P256Sum,b:P9Affine,mod:P256Mod) -> P256Sum
  = if total.empty then P256Sum { point=P256Point { x=b.x,y=b.y,z=mod.one },empty=false } else
    let added=p256_add_affine(total.point,b) in P256Sum { point=added,empty=p256_zero_value(added.z,mod)==1 }
private fn p256_verify_step(total:P256Sum,g:i64,q:i64,table:P256Odd,mod:P256Mod) -> P256Sum
  = let doubled=if total.empty then total else P256Sum { point=p256_double(total.point),empty=false } in
    let with_g=if g==0 then doubled else let base=p9_generator(if g>0 then (g-1)/2 else (0-g-1)/2) in
      p256_sum_affine(doubled,if g>0 then base else P9Affine { x=base.x,y=p256_negate(base.y,mod) },mod) in
    if q==0 then with_g else let base=p256_odd_pick(table,if q>0 then (q-1)/2 else (0-q-1)/2) in
      p256_sum_add(with_g,if q>0 then base else base with { y=p256_negate(base.y,mod) },mod)
; u1*G + u2*Q by interleaved NAF digits.
private cold fn p256_combination(u1:P9,u2:P9,point:P256Point,mod:P256Mod) -> P256Sum
  = let g=p256_naf(u1) in let q=p256_naf(u2) in let table=p256_odd_multiples(point,mod) in
    loop(i=256,total=P256Sum { point=p256_infinity(mod),empty=true }) while i>=0
      next(i-1,check i>=0 && i<len(g) && i<len(q) in p256_verify_step(total,g[i],q[i],table,mod)) yield total
; x(point) = r (mod n) without inverting z: X = r*Z^2, or (r+n)*Z^2 when r+n < p.
private fn p256_x_matches(point:P256Point,r:P9,field:P256Mod,order:P256Mod) -> bool
  = let zz=p256_square(point.z,field) in let x=p256_reduce(point.x,field.modulus) in
    let direct=p256_reduce(p256_multiply(p256_montgomery(r,field),zz,field),field.modulus) in
    let lifted=p9_add_raw(r,order.modulus) in
    p256_is_zero(p9_sub_raw(x,direct))==1 ||
      p9_negative(p9_sub_raw(lifted,field.modulus))==1 &&
        p256_is_zero(p9_sub_raw(x,p256_reduce(p256_multiply(p256_montgomery(lifted,field),zz,field),field.modulus)))==1

private fn p256_der_scalar(signature:Arr u8 n,node:DerNode) -> BytesResult
  = let bytes=der_value(signature,node) in let count=len(bytes) in
    if !node.ok || node.tag!=2 || count<1 || count>33 || str_byte(bytes,0)>=128 || count>1 && str_byte(bytes,0)==0 && str_byte(bytes,1)<128 || count==33 && str_byte(bytes,0)!=0 then bytes_error(74,"invalid ECDSA DER integer",0) else
    bytes_ok(arr(i in 0..32) u8(if i+count<32 then 0 else str_byte(bytes,i+count-32)))
private fn p256_der_encode(value:Arr u8 n) -> Arr u8 _
  = check n==32 in let first=loop(i=0) while i<31 && str_byte(value,i)==0 next(i+1) yield i in
    let tail=str_slice(value,first,n) in let positive=if str_byte(tail,0)>=128 then concat("\x00",tail) else tail in
    concat("\x02",arr(i in 0..1) u8(len(positive)),positive)
; ECDSA verification of a 32-byte big-endian digest (SHA-256, or the leftmost
; 256 bits of a longer one) against a DER signature and an uncompressed key.
fn ecdsa_p256_verify_digest32(public:Arr u8 n,digest:Arr u8 d,signature:Arr u8 k) -> bool
  = let field=p256_mod(false) in
    if d!=32 || k<8 || k>72 || !p256_point_valid(public,field) then false else
    let seq=der_node(signature,0,k) in let first=der_node(signature,seq.body,seq.end) in let second=der_node(signature,first.end,seq.end) in
    if !seq.ok || seq.tag!=48 || seq.end!=k || !first.ok || !second.ok || second.end!=seq.end then false else
    let raw_r=p256_der_scalar(signature,first) in let raw_s=p256_der_scalar(signature,second) in
    if !raw_r.ok || !raw_s.ok then false else
    let r=p256_words(raw_r.value) in let s=p256_words(raw_s.value) in let order=p256_mod(true) in
    if !p256_scalar_valid(r,order) || !p256_scalar_valid(s,order) then false else
    let inverse=p256_inverse(p256_montgomery(s,order),order) in
    let z=p256_reduce(p256_words(digest),order.modulus) in
    let u1=p256_reduce(p256_multiply(inverse,z,order),order.modulus) in
    let u2=p256_reduce(p256_multiply(inverse,r,order),order.modulus) in
    let total=p256_combination(u1,u2,p256_point_decode(public,field),field) in
    !total.empty && p256_x_matches(total.point,r,field,order)
fn ecdsa_p256_verify_sha256(public:Arr u8 n,message:Arr u8 m,signature:Arr u8 k) -> bool
  = ecdsa_p256_verify_digest32(public,sha256(message),signature)
private fn p256_sign_candidate(secret:P9,digest:P9,nonce:Arr u8 n,order:P256Mod,field:P256Mod) -> Arr u8 _
  = check n==32 in let scalar=p256_words(nonce) in if !p256_scalar_valid(scalar,order) then "" else
    let point=p256_affine(p256_scalar(p256_generator(field),scalar,field),field) in let r=p256_reduce(p256_normal(point.x,field),order.modulus) in
    let mixed=p256_add(p256_montgomery(digest,order),p256_multiply(p256_montgomery(r,order),p256_montgomery(secret,order),order),order.modulus) in
    let s=p256_normal(p256_multiply(p256_inverse(p256_montgomery(scalar,order),order),mixed,order),order) in
    if p256_is_zero(r)==1 || p256_is_zero(s)==1 then "" else
    let integers=concat(p256_der_encode(p9_bytes(r)),p256_der_encode(p9_bytes(s))) in concat("\x30",arr(i in 0..1) u8(len(integers)),integers)
fn ecdsa_p256_sign_sha256(secret:Arr u8 n,message:Arr u8 m) -> BytesResult
  = if n!=32 then bytes_error(22,"P-256 private key requires 32 bytes",0) else
    let scalar=p256_words(secret) in let order=p256_mod(true) in
    if !p256_scalar_valid(scalar,order) then bytes_error(22,"invalid P-256 private scalar",0) else
    let digest=p256_reduce(p256_words(sha256(message)),order.modulus) in let context=concat(secret,p9_bytes(digest)) in
    let zeros=arr(i in 0..32) u8(0) in let ones=arr(i in 0..32) u8(1) in
    let key=hmac_sha256(zeros,concat(ones,"\x00",context)) in let value=hmac_sha256(key,ones) in
    let key=hmac_sha256(key,concat(value,"\x01",context)) in let value=hmac_sha256(key,value) in let field=p256_mod(false) in
    let result=loop(i=0,key=key,value=value,signature="") while i<16 && len(signature)==0 next(i+1,
      hmac_sha256(key,concat(hmac_sha256(key,value),"\x00")),
      let next_key=hmac_sha256(key,concat(hmac_sha256(key,value),"\x00")) in hmac_sha256(next_key,hmac_sha256(key,value)),
      p256_sign_candidate(scalar,digest,hmac_sha256(key,value),order,field)) yield signature in
    if len(result)==0 then bytes_error(74,"P-256 deterministic nonce retry limit",0) else bytes_ok(result)
