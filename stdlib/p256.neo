; P-256 arithmetic for ECDSA/ECDH protocol libraries. Field and order values
; are records of four unsigned 64-bit limbs (no allocation per operation) in
; Montgomery form with R = 2^256, fully reduced between operations;
; tests/generate_crypto_fields.py (v0.2.3 tag) wrote the unrolled products and
; the constants. Limb arithmetic is exact: wrapping sums with unsigned comparisons
; for carries, and wrapping_mul/mul_high for the two words of each 128-bit
; product. p256_normal returns a value out of Montgomery form.
; Secret scalars (key generation, ECDH, signing) use a fixed 4-bit window with
; mask selections. Signature verification works on public data and uses
; ordinary branches with NAF digits: width 7 against a precomputed table of
; odd multiples of the generator, width 5 for the public key. Independent
; vectors are required; no security or constant-time audit is claimed.
type P4 = { l0:i64,l1:i64,l2:i64,l3:i64 }
type P4Carry = { value:P4,carry:i64 }
; Product-scanning column: c0 + c1*2^64 + c2*2^128.
type P4Acc = { c0:i64,c1:i64,c2:i64 }
type P256Mod = { modulus:P4,r2:P4,one:P4,inverse:i64 }
type P4Affine = { x:P4,y:P4 }

; 1 when a < b as unsigned 64-bit words, else 0.
private fn p4_below(a:i64,b:i64) -> i64 = if bit_xor(a,-9223372036854775808)<bit_xor(b,-9223372036854775808) then 1 else 0
; Adds the 128-bit product x*y to the column (the high word plus a carry
; still fits: it is at most 2^64-2).
private fn p4_mac(s:P4Acc,x:i64,y:i64) -> P4Acc
  = let lo=wrapping_mul(x,y) in let hi=mul_high(x,y) in
    let c0=wrapping_add(s.c0,lo) in let t=wrapping_add(hi,p4_below(c0,lo)) in let c1=wrapping_add(s.c1,t) in
    P4Acc { c0=c0,c1=c1,c2=wrapping_add(s.c2,p4_below(c1,t)) }
private fn p4_mac2(s:P4Acc,x:i64,y:i64) -> P4Acc = p4_mac(p4_mac(s,x,y),x,y)
; Adds q*m0 for the column's Montgomery digit q and shifts out the low word,
; which that cancels: t is the high word of q*m0 plus the carry out of the low
; word (none when c0 is 0).
private fn p4_fold(s:P4Acc,t:i64) -> P4Acc
  = let c1=wrapping_add(s.c1,t) in P4Acc { c0=c1,c1=wrapping_add(s.c2,p4_below(c1,t)),c2=0 }
private fn p4_shift(s:P4Acc) -> P4Acc = P4Acc { c0=s.c1,c1=s.c2,c2=0 }
