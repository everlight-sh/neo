import "std:sha256"

; RFC 8018 PBKDF2-HMAC-SHA256. Password storage should use >=600000 rounds.
; Only a block's first MAC handles bytes; the remaining rounds run on digest
; words in hmac_sha256_xor_chain.
private fn pbkdf2_block(key:HMACSHA256,salt:Arr u8 n,iterations:i64,index:i64) -> Arr u8 _
  = let counter=arr(i in 0..4) u8(bit_and(shift_right(index,(3-i)*8),255)) in
    hmac_sha256_xor_chain(key,hmac_sha256_prepared(key,concat(salt,counter)),iterations)
fn pbkdf2_sha256(password:Arr u8 n,salt:Arr u8 m,iterations:i64,length:i64) -> BytesResult
  = if iterations<1 || iterations>10000000 || length<1 || length>1024 || n>4096 || m>4096 then bytes_error(22,"invalid PBKDF2 bounds",0) else
    let key=hmac_sha256_prepare(password) in
    let bytes=loop(block=1,out="") while len(out)<length
      next(block+1,concat(out,pbkdf2_block(key,salt,iterations,block))) yield out in bytes_ok(str_slice(bytes,0,length))
